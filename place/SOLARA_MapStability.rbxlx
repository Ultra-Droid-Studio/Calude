<Item class="ModuleScript" referent="RBXE2E55FAAN"><Properties>
<string name="Name">AmbientDebug</string>

<ProtectedString name="Source"><![CDATA[-- AmbientDebug: trafik ve yaya yapay zekâsı için hata ayıklama görünümü (Aşama 6). F7 ile aç/kapa.
--
-- Çizer (oyuncunun çevresinde, AmbientConfig.Debug.DrawRadius):
--   * şerit merkezleri (mavi), kavşak bağlantı eğrileri (yeşil), durma çizgileri (ışık durumuna göre kırmızı/sarı/yeşil,
--     dur levhasında beyaz, yol ver'de turuncu)
--   * kaldırım yürüyüş çizgileri (beyaz) ve karşıya geçitler (yaya yeşilinde yeşil, değilse turuncu)
--   * her aracın üstünde durum etiketi (Sür / Kırmızı / Dur / Sıra / Çakışma / Dolu / Engel / SolDönüş / YolVer)
--   * her yayanın üstünde durum (Yürü / Bekle / Geç / Mola)
-- ve ekranda bir istatistik paneli (sayılar, havuz, adım süresi, doğurma/kaldırma, geçişler, takılanlar).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local AmbientDebug = {}

local folder: Folder? = nil
local statics: Folder? = nil
local gui: ScreenGui? = nil
local label: TextLabel? = nil
local stopLines: { { Part: BasePart, Node: any, Phase: number, Control: string } } = {}
local crossings: { { Part: BasePart, Link: any } } = {}
local tags: { [any]: BillboardGui } = {}
local lastStaticFocus: Vector3? = nil

local STATE_COLOR = {
	["Sür"] = Color3.fromRGB(120, 230, 140), ["Kırmızı"] = Color3.fromRGB(255, 80, 70), ["Sarı"] = Color3.fromRGB(255, 200, 60),
	["Dur"] = Color3.fromRGB(255, 255, 255), ["Engel"] = Color3.fromRGB(255, 140, 40), ["Dolu"] = Color3.fromRGB(200, 120, 255),
	["Çakışma"] = Color3.fromRGB(255, 120, 200), ["Sıra"] = Color3.fromRGB(200, 200, 200), ["Sırada"] = Color3.fromRGB(170, 170, 170),
}

local function line(parent: Instance, a: Vector3, b: Vector3, color: Color3, thickness: number): Part?
	local d = b - a
	local len = d.Magnitude
	if len < 0.05 then
		return nil
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.25
	p.Size = Vector3.new(thickness, thickness, len)
	p.CFrame = CFrame.lookAt(a + d / 2, b)
	p.Parent = parent
	return p
end

local function ensure()
	if folder then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "SolaraAmbientDebug"
	folder.Parent = Workspace
	gui = Instance.new("ScreenGui")
	gui.Name = "SolaraAmbientDebug"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 99
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(1, 0)
	l.Position = UDim2.new(1, -12, 0, 60)
	l.Size = UDim2.fromOffset(330, 250)
	l.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
	l.BackgroundTransparency = 0.25
	l.TextColor3 = Color3.fromRGB(230, 235, 240)
	l.Font = Enum.Font.Code
	l.TextSize = 13
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.AutoLocalize = false
	l.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.Parent = l
	label = l
end

function AmbientDebug.Disable()
	if folder then
		folder:Destroy()
	end
	if gui then
		gui:Destroy()
	end
	folder, statics, gui, label = nil, nil, nil, nil
	table.clear(stopLines)
	table.clear(crossings)
	table.clear(tags)
	lastStaticFocus = nil
end

local function drawStatics(env, focus: Vector3, radius: number)
	if statics then
		statics:Destroy()
	end
	table.clear(stopLines)
	table.clear(crossings)
	local f = Instance.new("Folder")
	f.Name = "Static"
	f.Parent = folder
	statics = f
	local graph, TG = env.Graph, env.TG
	local r2 = radius * radius
	local lift = Vector3.new(0, 0.35, 0)
	for _, lane in TG.LanesNear(graph, focus.X, focus.Z, radius) do
		local a = Vector3.new(lane.X0, lane.Y0, lane.Z0) + lift
		local b = Vector3.new(lane.X1, lane.Y1, lane.Z1) + lift
		if (a - focus).Magnitude < radius * 1.5 or (b - focus).Magnitude < radius * 1.5 then
			line(f, a, b, Color3.fromRGB(70, 150, 255), 0.25)
			-- durma çizgisi
			local node = graph.Nodes[lane.To]
			if node.Control ~= "Free" then
				local x, y, z = TG.LanePoint(lane, lane.StopS)
				local c = Vector3.new(x, y, z) + lift
				local r = Vector3.new(lane.RX, 0, lane.RZ) * (lane.LaneWidth / 2)
				local part = line(f, c - r, c + r, Color3.new(1, 1, 1), 0.5)
				if part then
					table.insert(stopLines, { Part = part, Node = node, Phase = node.ArmPhase[lane.Edge] or 1, Control = node.Control })
				end
			end
		end
	end
	for _, node in graph.Nodes do
		local dx, dz = node.X - focus.X, node.Z - focus.Z
		if dx * dx + dz * dz < r2 * 0.4 then
			for _, c in node.Connectors do
				for i = 1, #c.PX - 1 do
					line(f, Vector3.new(c.PX[i], c.PY[i], c.PZ[i]) + lift, Vector3.new(c.PX[i + 1], c.PY[i + 1], c.PZ[i + 1]) + lift, Color3.fromRGB(80, 220, 120), 0.18)
				end
			end
		end
	end
	local pg = env.PedGraph
	if pg then
		for _, l in env.PG.LinksNear(pg, focus.X, focus.Z, radius) do
			local a = Vector3.new(l.A.X, pg.Top + 0.3, l.A.Z)
			local b = Vector3.new(l.B.X, pg.Top + 0.3, l.B.Z)
			line(f, a, b, Color3.fromRGB(235, 235, 235), 0.2)
		end
		for _, l in pg.Links do
			if l.Crossing then
				local dx, dz = l.A.X - focus.X, l.A.Z - focus.Z
				if dx * dx + dz * dz < r2 then
					local part = line(f, Vector3.new(l.A.X, pg.Top + 0.4, l.A.Z), Vector3.new(l.B.X, pg.Top + 0.4, l.B.Z), Color3.fromRGB(255, 150, 40), 0.45)
					if part then
						table.insert(crossings, { Part = part, Link = l })
					end
				end
			end
		end
	end
end

local function tag(agent, adornee: BasePart, text: string, color: Color3)
	local bb = tags[agent]
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(150, 22)
		bb.StudsOffset = Vector3.new(0, 6, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Name = "T"
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.Code
		t.TextSize = 13
		t.TextStrokeTransparency = 0.4
		t.AutoLocalize = false
		t.Parent = bb
		bb.Parent = folder
		tags[agent] = bb
	end
	bb.Adornee = adornee
	local t = bb:FindFirstChild("T") :: TextLabel
	t.Text = text
	t.TextColor3 = color
end

-- env: Graph, TG, PedGraph, PG, Traffic, Peds, VehicleModels, PedModels, Focus, Time, Stats (tablo), Config
function AmbientDebug.Update(env)
	ensure()
	local focus = env.Focus
	if not focus then
		return
	end
	local radius = env.Config.Debug.DrawRadius
	if not lastStaticFocus or (lastStaticFocus - focus).Magnitude > radius * 0.35 then
		lastStaticFocus = focus
		drawStatics(env, focus, radius)
	end
	local TG, graph = env.TG, env.Graph
	for _, s in stopLines do
		if s.Control == "Signal" then
			local state = TG.SignalState(graph, s.Node, s.Phase, env.Time)
			s.Part.Color = if state == "G" then Color3.fromRGB(60, 230, 110) elseif state == "Y" then Color3.fromRGB(255, 190, 40) else Color3.fromRGB(255, 50, 40)
		elseif s.Control == "Yield" then
			s.Part.Color = Color3.fromRGB(255, 150, 40)
		end
	end
	for _, c in crossings do
		local l = c.Link
		local node = graph.Nodes[l.Node]
		local walk = (not l.Signal) or (node and TG.WalkAllowed(graph, node, l.ArmPhase, env.Time, 0))
		c.Part.Color = if walk then Color3.fromRGB(60, 230, 110) else Color3.fromRGB(255, 150, 40)
	end
	-- etiketler
	local alive = {}
	for v, model in env.VehicleModels do
		if model.PrimaryPart then
			alive[v] = true
			tag(v, model.PrimaryPart, string.format("#%d %s %d", v.Id, v.State or "?", math.floor(v.V * 1.008 + 0.5)), STATE_COLOR[v.State] or Color3.fromRGB(255, 230, 120))
		end
	end
	for p, model in env.PedModels do
		if model.PrimaryPart then
			alive[p] = true
			tag(p, model.PrimaryPart, p.State or "?", Color3.fromRGB(200, 220, 255))
		end
	end
	for agent, bb in tags do
		if not alive[agent] then
			bb:Destroy()
			tags[agent] = nil
		end
	end
	if label then
		label.Text = env.Stats
	end
end

return AmbientDebug
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXBE229078N"><Properties>
<string name="Name">DoorRenderer</string>

<ProtectedString name="Source"><![CDATA[-- DoorRenderer: bina kapıları (Yaşayan Şehir). Sadece bu istemcide, sadece oyuncunun yakınında, HAVUZLU.
--
-- Dünya (sunucunun ürettiği binalar) DEĞİŞMEZ: kapı, Shared/Ambient/Entrances kaydındaki noktaya yerel bir model
-- olarak konur (kasa + kanat + kapı boşluğu). Binanın kendi kapı parçası olan stillerde (ev, sıra ev, dükkân, tuğla
-- apartman) kanat o parçanın hemen önüne oturur; cam lobili binalarda cam kapı. Bir yaya kapıya yaklaşıp girerken ya
-- da binadan çıkarken (PedSim: entrance.OpenUntil) kanat dışarı doğru açılır, içerisi karanlık görünür, sonra kapanır.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Entrances = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ambient"):WaitForChild("Entrances"))

local DoorRenderer = {}

local RADIUS = 130 -- bu yarıçaptaki kapılar çizilir
local RELEASE = 150
local OPEN_ANGLE = math.rad(82)
local SPEED = math.rad(220) -- açılma hızı (°/sn)

local rgb = Color3.fromRGB
local LEAF = {
	house_a = { rgb(110, 76, 52), Enum.Material.Wood },
	house_b = { rgb(96, 70, 52), Enum.Material.Wood },
	townhouse = { rgb(40, 48, 60), Enum.Material.Wood },
	apartment_brick = { rgb(90, 64, 46), Enum.Material.Wood },
	deco_lowrise = { rgb(236, 236, 232), Enum.Material.SmoothPlastic },
	storefront = { rgb(60, 60, 64), Enum.Material.Metal },
	storefront_plain = { rgb(60, 60, 64), Enum.Material.Metal },
}
local GLASS = { rgb(150, 190, 210), Enum.Material.Glass } -- lobi/AVM/ofis cam kapısı

local folder: Folder?
local reg = nil
local pool: { Model } = {}
local active: { [any]: { Model: Model, Angle: number, Hinge: CFrame, Leaf: BasePart, Dark: BasePart } } = {}
local lastScan, lastFocus = 0, nil
local simTime = 0

function DoorRenderer.Init(registry)
	reg = registry
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "SolaraDoors"
		f.Parent = Workspace
		folder = f
	end
end

local function newPart(model: Model, name: string): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function build(): Model
	local m = Instance.new("Model")
	m.Name = "NPC_Door"
	newPart(m, "JambL")
	newPart(m, "JambR")
	newPart(m, "Head")
	newPart(m, "Dark")
	newPart(m, "Leaf")
	return m
end

-- e: Entrances kaydı. Kapı düzlemi e.(X, Y, Z), dışa normal (NX, NZ)
local function place(model: Model, e)
	local w, h = e.Width, e.Height
	local out = Vector3.new(e.NX, 0, e.NZ)
	local right = Vector3.new(-e.NZ, 0, e.NX) -- dışarıdan bakınca sağ (normal × yukarı)
	local base = Vector3.new(e.X, e.Y, e.Z)
	-- kapı düzleminin dış yüzü (binanın kapı parçasının hemen önü)
	local frame = CFrame.fromMatrix(base + out * 0.06, right, Vector3.yAxis, -out)
	local trim = rgb(48, 48, 52)
	local jl, jr, hd = model.JambL :: BasePart, model.JambR :: BasePart, model.Head :: BasePart
	for _, j in { jl, jr } do
		j.Size = Vector3.new(0.3, h, 0.36)
		j.Color = trim
		j.Material = Enum.Material.SmoothPlastic
	end
	jl.CFrame = frame * CFrame.new(-w / 2 - 0.15, h / 2, -0.12)
	jr.CFrame = frame * CFrame.new(w / 2 + 0.15, h / 2, -0.12)
	hd.Size = Vector3.new(w + 0.6, 0.3, 0.36)
	hd.Color = trim
	hd.CFrame = frame * CFrame.new(0, h + 0.15, -0.12)
	local dark = model.Dark :: BasePart
	dark.Size = Vector3.new(w, h, 0.05)
	dark.Color = rgb(12, 12, 14)
	dark.Material = Enum.Material.SmoothPlastic
	dark.CFrame = frame * CFrame.new(0, h / 2, 0.02)
	dark.Transparency = 1
	local style = LEAF[e.Style] or GLASS
	local leaf = model.Leaf :: BasePart
	leaf.Size = Vector3.new(w - 0.1, h - 0.1, 0.22)
	leaf.Color = style[1]
	leaf.Material = style[2]
	leaf.Transparency = (style == GLASS) and 0.35 or 0
	leaf.Reflectance = (style == GLASS) and 0.15 or 0
	-- menteşe: dışarıdan bakınca sol kenar; kanat dışarı doğru açılır (binanın içine girmez)
	local hinge = frame * CFrame.new(-w / 2 + 0.05, (h - 0.1) / 2 + 0.05, -0.14)
	leaf.CFrame = hinge * CFrame.new((w - 0.1) / 2, 0, 0)
	return hinge, leaf, dark
end

local function release(key)
	local a = active[key]
	if a then
		a.Model.Parent = nil
		table.insert(pool, a.Model)
		active[key] = nil
	end
end

-- 10 Hz: yakındaki kapıları al/bırak. focus nil → hepsini bırak
function DoorRenderer.Update(focus: Vector3?, time: number)
	simTime = time
	if not reg or not folder then
		return
	end
	if not focus then
		for key in active do
			release(key)
		end
		lastFocus = nil
		return
	end
	local now = os.clock()
	if lastFocus and (focus - lastFocus).Magnitude < 8 and now - lastScan < 0.5 then
		return
	end
	lastScan, lastFocus = now, focus
	for e, a in active do
		if (Vector3.new(e.X, 0, e.Z) - Vector3.new(focus.X, 0, focus.Z)).Magnitude > RELEASE then
			release(e)
		end
		local _ = a
	end
	for _, e in Entrances.Near(reg, focus.X, focus.Z, RADIUS) do
		if not active[e] then
			local model = table.remove(pool) or build()
			local hinge, leaf, dark = place(model, e)
			model.Parent = folder
			active[e] = { Model = model, Angle = 0, Hinge = hinge, Leaf = leaf, Dark = dark }
		end
	end
end

-- Her kare: kullanımda olan kapıları aç/kapat
function DoorRenderer.Animate(dt: number)
	for e, a in active do
		local target = ((e.OpenUntil or 0) > simTime) and OPEN_ANGLE or 0
		if a.Angle ~= target then
			local step = SPEED * dt
			if math.abs(target - a.Angle) <= step then
				a.Angle = target
			else
				a.Angle += if target > a.Angle then step else -step
			end
			local w = a.Leaf.Size.X
			-- dışarı açılış: menteşe ekseninde, dış yöne (−Z yerel) dönüş
			a.Leaf.CFrame = a.Hinge * CFrame.Angles(0, -a.Angle, 0) * CFrame.new(w / 2, 0, 0)
			a.Dark.Transparency = if a.Angle > 0.05 then 0 else 1
		end
	end
end

function DoorRenderer.ActiveCount(): number
	local n = 0
	for _ in active do
		n += 1
	end
	return n
end

return DoorRenderer
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX838AEFE7N"><Properties>
<string name="Name">PedRenderer</string>

<ProtectedString name="Source"><![CDATA[-- PedRenderer: NPC yaya görselleri ve HAVUZ (Aşama 6; Yaşayan Şehir: R15 insan modeli). Sadece bu istemcide.
--
-- Model: kodla kurulan R15 iskeleti — HumanoidRootPart (görünmez, sabit kök) + LowerTorso, UpperTorso, Head, kollar
-- (UpperArm/LowerArm/Hand), bacaklar (UpperLeg/LowerLeg/Foot); eklemler standart R15 adlı Motor6D'ler (Root, Waist,
-- Neck, Left/RightShoulder, Elbow, Wrist, Hip, Knee, Ankle). Humanoid ve Animator YOK (80 yayada pahalı):
-- pozlar Shared/Ambient/PedAnim'den gelir (ters kinematik yürüme; basan ayak kaymaz) ve Motor6D.Transform'a yazılır.
-- Dış model/varlık yok: lisans sorunu yok; yüz Roblox'un yerleşik dokusu (rbxasset://textures/face.png).
--
-- Çeşitlilik (her havuzdan alışta yeniden giydirilir): boy (3 ölçek), gövde genişliği, ten rengi, kıyafet tipi
-- (tişört, uzun kol, ceket, takım elbise, elbise/etek, şort), saç (kısa, uzun, topuz, kel) ya da şapka (kep, bere),
-- aksesuar (sırt çantası, omuz çantası, gözlük). Parçalar çarpışmaz, gölge düşürmez, ışın sorgularına girmez.

local Workspace = game:GetService("Workspace")

local PedRenderer = {}

local rgb = Color3.fromRGB
local SKIN = { rgb(255, 224, 196), rgb(240, 200, 164), rgb(214, 164, 124), rgb(176, 124, 88), rgb(128, 86, 58), rgb(92, 60, 42) }
local SHIRT = {
	rgb(236, 236, 232), rgb(44, 48, 56), rgb(176, 46, 56), rgb(58, 104, 172), rgb(232, 196, 76), rgb(86, 146, 92),
	rgb(240, 128, 80), rgb(140, 92, 168), rgb(118, 192, 204), rgb(214, 170, 190), rgb(120, 120, 124),
}
local PANTS = { rgb(42, 54, 86), rgb(30, 30, 34), rgb(112, 102, 90), rgb(72, 72, 78), rgb(196, 186, 166), rgb(92, 64, 44), rgb(64, 84, 112) }
local JACKET = { rgb(36, 38, 44), rgb(96, 70, 52), rgb(54, 70, 52), rgb(120, 40, 44), rgb(140, 140, 146), rgb(40, 60, 96) }
local SUIT = { rgb(34, 36, 42), rgb(52, 58, 72), rgb(88, 88, 92) }
local DRESS = { rgb(176, 46, 66), rgb(58, 104, 172), rgb(232, 196, 76), rgb(40, 40, 44), rgb(214, 150, 180), rgb(90, 150, 120) }
local SHOES = { rgb(28, 28, 30), rgb(240, 240, 236), rgb(96, 64, 44), rgb(60, 60, 66) }
local HAIR = { rgb(26, 20, 18), rgb(70, 44, 28), rgb(120, 82, 46), rgb(212, 178, 110), rgb(150, 66, 40), rgb(160, 160, 160) }
local BAG = { rgb(36, 36, 40), rgb(160, 60, 50), rgb(60, 90, 140), rgb(120, 90, 60) }

local SCALES = { 0.88, 0.94, 1.0 } -- boy: ~5.2 / 5.6 / 6.0 stud
local ROOT_Y = 2.95 -- kökün (alt gövde ortası) yerden yüksekliği (ölçek 1)

local folder: Folder
local pool: { Model } = {}
local rng = Random.new()

type Rig = {
	Scale: number, Width: number, Parts: { [string]: BasePart }, Motors: { [string]: Motor6D }, Extras: { Instance },
	Face: Decal, Fade: number,
}
local rigOf: { [Model]: Rig } = {}

function PedRenderer.Init()
	folder = Instance.new("Folder")
	folder.Name = "SolaraPedestrians"
	folder.Parent = Workspace
end

local function newPart(model: Model, name: string, size: Vector3, cf: CFrame): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- R15 eklemi: dünya (dinlenme pozu) noktasında, dönüşsüz C0/C1 (R15 animasyon kuralı)
local function motor(name: string, p0: BasePart, p1: BasePart, at: Vector3): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0, m.Part1 = p0, p1
	m.C0 = p0.CFrame:Inverse() * CFrame.new(at)
	m.C1 = p1.CFrame:Inverse() * CFrame.new(at)
	m.Parent = p1
	return m
end

-- Dinlenme pozunda (yer y = 0, yüz −Z) R15 iskeletini kur. k: boy ölçeği, w: gövde genişlik çarpanı
local function build(k: number, w: number): (Model, Rig)
	local model = Instance.new("Model")
	model.Name = "NPC_Pedestrian"
	local function at(x, y, z)
		return Vector3.new(x * k, y * k, z * k)
	end
	local function part(name, sx, sy, sz, x, y, z)
		return newPart(model, name, Vector3.new(sx * k, sy * k, sz * k), CFrame.new(at(x, y, z)))
	end
	local tw = 2.0 * w
	local ax = tw / 2 + 0.48
	local P = {}
	P.HumanoidRootPart = part("HumanoidRootPart", 2, 2, 1, 0, ROOT_Y, 0)
	P.HumanoidRootPart.Transparency = 1
	P.HumanoidRootPart.Anchored = true
	P.LowerTorso = part("LowerTorso", 1.9 * w, 0.6, 1.0, 0, 2.95, 0)
	P.UpperTorso = part("UpperTorso", tw, 1.5, 1.0, 0, 4.0, 0)
	P.Head = part("Head", 1.15, 1.2, 1.15, 0, 5.35, 0)
	for _, side in { "Left", "Right" } do
		local sx = (side == "Left") and -1 or 1
		P[side .. "UpperArm"] = part(side .. "UpperArm", 0.95, 1.2, 0.95, sx * ax, 4.15, 0)
		P[side .. "LowerArm"] = part(side .. "LowerArm", 0.9, 1.05, 0.9, sx * ax, 3.0, 0)
		P[side .. "Hand"] = part(side .. "Hand", 0.8, 0.45, 0.8, sx * ax, 2.25, 0)
		P[side .. "UpperLeg"] = part(side .. "UpperLeg", 0.95, 1.2, 0.95, sx * 0.5, 2.1, 0)
		P[side .. "LowerLeg"] = part(side .. "LowerLeg", 0.9, 1.2, 0.9, sx * 0.5, 0.9, 0)
		P[side .. "Foot"] = part(side .. "Foot", 0.9, 0.3, 1.25, sx * 0.5, 0.15, -0.15)
	end
	local head = Instance.new("SpecialMesh")
	head.MeshType = Enum.MeshType.Head
	head.Scale = Vector3.new(1.25, 1.25, 1.25)
	head.Parent = P.Head
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = P.Head

	local M = {}
	M.Root = motor("Root", P.HumanoidRootPart, P.LowerTorso, at(0, 2.95, 0))
	M.Waist = motor("Waist", P.LowerTorso, P.UpperTorso, at(0, 3.25, 0))
	M.Neck = motor("Neck", P.UpperTorso, P.Head, at(0, 4.75, 0))
	for _, side in { "Left", "Right" } do
		local sx = (side == "Left") and -1 or 1
		M[side .. "Shoulder"] = motor(side .. "Shoulder", P.UpperTorso, P[side .. "UpperArm"], at(sx * ax, 4.6, 0))
		M[side .. "Elbow"] = motor(side .. "Elbow", P[side .. "UpperArm"], P[side .. "LowerArm"], at(sx * ax, 3.55, 0))
		M[side .. "Wrist"] = motor(side .. "Wrist", P[side .. "LowerArm"], P[side .. "Hand"], at(sx * ax, 2.475, 0))
		M[side .. "Hip"] = motor(side .. "Hip", P.LowerTorso, P[side .. "UpperLeg"], at(sx * 0.5, 2.7, 0))
		M[side .. "Knee"] = motor(side .. "Knee", P[side .. "UpperLeg"], P[side .. "LowerLeg"], at(sx * 0.5, 1.5, 0))
		M[side .. "Ankle"] = motor(side .. "Ankle", P[side .. "LowerLeg"], P[side .. "Foot"], at(sx * 0.5, 0.3, 0))
	end
	model.PrimaryPart = P.HumanoidRootPart
	P.HumanoidRootPart.CFrame = CFrame.new(0, -500, 0)
	model:SetAttribute("Ped", true)
	local rig: Rig = { Scale = k, Width = w, Parts = P, Motors = M, Extras = {}, Face = face, Fade = 0 }
	return model, rig
end

-- Gövde parçasına (dinlenme pozuna göre ofsetle) kaynaklı ek parça: saç, şapka, etek, çanta...
local function extra(rig: Rig, model: Model, base: string, name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?)
	local k = rig.Scale
	local b = rig.Parts[base]
	local p = newPart(model, name, size * k, b.CFrame * CFrame.new(offset.Position * k) * offset.Rotation)
	p.Color = color
	if shape then
		p.Shape = shape
	end
	local wld = Instance.new("Weld")
	wld.Part0 = b
	wld.Part1 = p
	wld.C0 = CFrame.new(offset.Position * k) * offset.Rotation
	wld.Parent = p
	table.insert(rig.Extras, p)
	return p
end

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- Giydir: renkler + kıyafet tipine göre ek parçalar (havuzdan her alışta yeniden)
local function dress(model: Model, rig: Rig)
	for _, e in rig.Extras do
		e:Destroy()
	end
	rig.Extras = {}
	local P = rig.Parts
	-- ek parçalar dinlenme pozuna göre yerleşsin: eklemleri sıfırla
	for _, m in rig.Motors do
		m.Transform = CFrame.identity
	end
	local skin, shoes = pick(SKIN), pick(SHOES)
	local top, armTop, armLow, low, leg = pick(SHIRT), nil, nil, pick(PANTS), nil
	local outfit = rng:NextNumber()
	local kind
	if outfit < 0.28 then
		kind = "tshirt"
	elseif outfit < 0.46 then
		kind = "longsleeve"
	elseif outfit < 0.62 then
		kind = "jacket"
	elseif outfit < 0.74 then
		kind = "suit"
	elseif outfit < 0.88 then
		kind = "dress"
	else
		kind = "shorts"
	end
	armTop, armLow, leg = top, skin, low
	if kind == "longsleeve" then
		armLow = top
	elseif kind == "jacket" then
		local j = pick(JACKET)
		armTop, armLow = j, j
		extra(rig, model, "UpperTorso", "JacketL", Vector3.new(0.85, 1.5, 1.04), CFrame.new(-0.58, 0, -0.01), j)
		extra(rig, model, "UpperTorso", "JacketR", Vector3.new(0.85, 1.5, 1.04), CFrame.new(0.58, 0, -0.01), j)
	elseif kind == "suit" then
		local s = pick(SUIT)
		top = rgb(240, 240, 236)
		armTop, armLow, low, leg = s, s, s, s
		extra(rig, model, "UpperTorso", "JacketL", Vector3.new(0.8, 1.52, 1.05), CFrame.new(-0.6, 0, -0.01), s)
		extra(rig, model, "UpperTorso", "JacketR", Vector3.new(0.8, 1.52, 1.05), CFrame.new(0.6, 0, -0.01), s)
		extra(rig, model, "UpperTorso", "Tie", Vector3.new(0.22, 0.9, 0.06), CFrame.new(0, 0.15, -0.52), pick({ rgb(150, 30, 40), rgb(30, 50, 110), rgb(40, 40, 44) }))
	elseif kind == "dress" then
		local d = pick(DRESS)
		top, armTop, low = d, d, d
		leg = skin
		extra(rig, model, "LowerTorso", "Skirt", Vector3.new(2.05 * rig.Width, 1.25, 1.2), CFrame.new(0, -0.7, 0), d)
	elseif kind == "shorts" then
		extra(rig, model, "LeftLowerLeg", "SockL", Vector3.new(0.92, 0.3, 0.92), CFrame.new(0, -0.45, 0), rgb(236, 236, 232))
		extra(rig, model, "RightLowerLeg", "SockR", Vector3.new(0.92, 0.3, 0.92), CFrame.new(0, -0.45, 0), rgb(236, 236, 232))
	end
	P.Head.Color = skin
	P.UpperTorso.Color = top
	P.LowerTorso.Color = low
	for _, side in { "Left", "Right" } do
		P[side .. "UpperArm"].Color = armTop
		P[side .. "LowerArm"].Color = armLow
		P[side .. "Hand"].Color = skin
		P[side .. "UpperLeg"].Color = leg
		P[side .. "LowerLeg"].Color = if kind == "shorts" then skin else leg
		P[side .. "Foot"].Color = shoes
	end
	-- saç / şapka
	local hair = pick(HAIR)
	local hr = rng:NextNumber()
	if kind == "suit" and hr < 0.5 then
		hr = 0.1 -- takım elbiseli: çoğunlukla kısa saç
	end
	if hr < 0.34 then
		extra(rig, model, "Head", "Hair", Vector3.new(1.28, 0.42, 1.28), CFrame.new(0, 0.5, 0.04), hair)
		extra(rig, model, "Head", "HairBack", Vector3.new(1.26, 0.7, 0.3), CFrame.new(0, 0.12, 0.52), hair)
	elseif hr < 0.56 then
		extra(rig, model, "Head", "Hair", Vector3.new(1.3, 0.45, 1.3), CFrame.new(0, 0.5, 0.04), hair)
		extra(rig, model, "Head", "HairLong", Vector3.new(1.3, 1.45, 0.34), CFrame.new(0, -0.18, 0.54), hair)
	elseif hr < 0.68 then
		extra(rig, model, "Head", "Hair", Vector3.new(1.28, 0.4, 1.28), CFrame.new(0, 0.5, 0.04), hair)
		extra(rig, model, "Head", "Bun", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 0.55, 0.62), hair, Enum.PartType.Ball)
	elseif hr < 0.8 then
		local cap = pick({ rgb(176, 46, 56), rgb(30, 30, 34), rgb(58, 104, 172), rgb(236, 236, 232) })
		extra(rig, model, "Head", "Cap", Vector3.new(1.32, 0.42, 1.32), CFrame.new(0, 0.55, 0.02), cap)
		extra(rig, model, "Head", "CapBrim", Vector3.new(1.2, 0.08, 0.6), CFrame.new(0, 0.38, -0.85), cap)
	elseif hr < 0.88 then
		extra(rig, model, "Head", "Beanie", Vector3.new(1.32, 0.62, 1.32), CFrame.new(0, 0.5, 0.02), pick(JACKET))
	end -- aksi: kel / çok kısa
	-- aksesuar
	local acc = rng:NextNumber()
	if acc < 0.18 then
		local c = pick(BAG)
		extra(rig, model, "UpperTorso", "Backpack", Vector3.new(1.4, 1.5, 0.6), CFrame.new(0, -0.05, 0.8), c)
	elseif acc < 0.3 then
		local c = pick(BAG)
		extra(rig, model, "UpperTorso", "Strap", Vector3.new(0.16, 1.7, 1.06), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(40)), c)
		extra(rig, model, "LowerTorso", "Bag", Vector3.new(0.5, 0.9, 1.1), CFrame.new(1.25 * rig.Width, -0.2, 0), c)
	end
	if rng:NextNumber() < 0.15 then
		extra(rig, model, "Head", "Glasses", Vector3.new(1.0, 0.16, 0.08), CFrame.new(0, 0.12, -0.6), rgb(20, 20, 22))
	end
	PedRenderer.SetFade(model, 0)
end

function PedRenderer.Acquire(): Model
	local model = table.remove(pool)
	local rig
	if model then
		rig = rigOf[model]
	else
		model, rig = build(SCALES[rng:NextInteger(1, #SCALES)], rng:NextNumber(0.9, 1.08))
		rigOf[model] = rig
	end
	dress(model, rig)
	model.Parent = folder
	return model
end

function PedRenderer.Release(model: Model)
	local root = model.PrimaryPart
	if root then
		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CFrame.new(0, -500, 0)
	end
	if root then
		root.CanCollide = false
	end
	PedRenderer.SetFade(model, 0)
	model.Parent = nil
	table.insert(pool, model)
end

function PedRenderer.Scale(model: Model): number
	local rig = rigOf[model]
	return rig and rig.Scale or 1
end

-- Konum: zemin noktası (ayak tabanı) ve yön (hx, hz)
function PedRenderer.Place(model: Model, position: Vector3, hx: number, hz: number)
	local root = model.PrimaryPart
	local rig = rigOf[model]
	if not root or not rig then
		return
	end
	local pos = position + Vector3.new(0, ROOT_Y * rig.Scale, 0)
	local look = Vector3.new(hx, 0, hz)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	root.CFrame = CFrame.lookAt(pos, pos + look)
end

-- PedAnim pozunu eklemlere yaz (açılar radyan; kök ofseti ölçeksiz stud)
local Angles = CFrame.Angles
function PedRenderer.Pose(model: Model, pose)
	local rig = rigOf[model]
	if not rig then
		return
	end
	local M, k = rig.Motors, rig.Scale
	M.Root.Transform = CFrame.new(pose.RootX * k, pose.RootY * k, 0) * Angles(0, pose.RootYaw, pose.RootRoll)
	M.Waist.Transform = Angles(pose.WaistPitch, pose.WaistYaw, 0)
	M.Neck.Transform = Angles(pose.NeckPitch, pose.NeckYaw, 0)
	M.LeftHip.Transform = Angles(pose.LHip, 0, 0)
	M.LeftKnee.Transform = Angles(-pose.LKnee, 0, 0)
	M.LeftAnkle.Transform = Angles(pose.LAnkle, 0, 0)
	M.RightHip.Transform = Angles(pose.RHip, 0, 0)
	M.RightKnee.Transform = Angles(-pose.RKnee, 0, 0)
	M.RightAnkle.Transform = Angles(pose.RAnkle, 0, 0)
	M.LeftShoulder.Transform = Angles(pose.LShoulder, 0, pose.LShoulderRoll)
	M.RightShoulder.Transform = Angles(pose.RShoulder, 0, pose.RShoulderRoll)
	M.LeftElbow.Transform = Angles(pose.LElbow, 0, 0)
	M.RightElbow.Transform = Angles(pose.RElbow, 0, 0)
end

-- Ayakta, kollar yanda (uzaktaki yaya için tek seferlik)
function PedRenderer.Neutral(model: Model)
	local rig = rigOf[model]
	if rig then
		for _, m in rig.Motors do
			m.Transform = CFrame.identity
		end
	end
end

-- Kapıda kararma: 0 görünür … 1 görünmez (yerel)
function PedRenderer.SetFade(model: Model, fade: number)
	local rig = rigOf[model]
	if not rig or math.abs((rig.Fade or 0) - fade) < 0.02 then
		return
	end
	rig.Fade = fade
	for _, p in rig.Parts do
		if p.Name ~= "HumanoidRootPart" then
			p.LocalTransparencyModifier = fade
		end
	end
	for _, e in rig.Extras do
		if e:IsA("BasePart") then
			e.LocalTransparencyModifier = fade
		end
	end
	rig.Face.Transparency = fade
end

-- Araç çarptı: model düşer (bu istemcide fizik), sonra havuza döner
function PedRenderer.MakePhysical(model: Model, velocity: Vector3)
	local root = model.PrimaryPart
	if not root then
		return
	end
	PedRenderer.Neutral(model)
	root.CanCollide = true -- yere düşsün (zeminin içinden geçmesin)
	root.Anchored = false
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = Vector3.new(math.random() * 4 - 2, 0, math.random() * 4 - 2)
end

function PedRenderer.PoolCount(): number
	return #pool
end

function PedRenderer.Folder(): Folder
	return folder
end

return PedRenderer
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX15E242B9N"><Properties>
<string name="Name">SignalRenderer</string>

<ProtectedString name="Source"><![CDATA[-- SignalRenderer: ışıklı kavşaklarda görünür trafik ışıkları (Aşama 6). Sadece bu istemcide, yakın kavşaklarda.
--
-- Harita verisinde 211 ışıklı kavşak var ama dünyada ışık direği yok; NPC'ler ışığa uyduğu için oyuncunun da
-- ışığı görmesi gerekir. Her yaklaşım kolunun sağ kaldırım köşesine, durma çizgisi hizasına bir direk konur.
-- Işık durumu TrafficGraph.SignalState'ten (sunucu saati) gelir → tüm oyuncularda aynı. Direkler havuzdan.

local Workspace = game:GetService("Workspace")

local SignalRenderer = {}

local RED = Color3.fromRGB(255, 50, 40)
local YELLOW = Color3.fromRGB(255, 190, 40)
local GREEN = Color3.fromRGB(60, 230, 110)
local OFF = Color3.fromRGB(40, 40, 44)
local POLE = Color3.fromRGB(58, 62, 68)

local folder: Folder
local pool: { Model } = {}
local active: { [string]: { Model: Model, Node: any, Phase: number, State: string? } } = {}
local approaches: { any } = {} -- { Key, Node, Phase, Position, Look }
local TG

local function build(): Model
	local model = Instance.new("Model")
	model.Name = "TrafficLight"
	local function p(name: string, size: Vector3, color: Color3, material: Enum.Material?)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = material or Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = name == "Pole"
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = name == "Pole"
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end
	local pole = p("Pole", Vector3.new(0.6, 12, 0.6), POLE)
	model.PrimaryPart = pole
	p("Head", Vector3.new(1.4, 3.6, 1), Color3.fromRGB(24, 26, 30))
	p("Red", Vector3.new(0.9, 0.9, 0.2), OFF, Enum.Material.Neon)
	p("Yellow", Vector3.new(0.9, 0.9, 0.2), OFF, Enum.Material.Neon)
	p("Green", Vector3.new(0.9, 0.9, 0.2), OFF, Enum.Material.Neon)
	return model
end

local function place(model: Model, position: Vector3, look: Vector3)
	-- yer: direk tabanı; ışık başı direğin tepesinde, yaklaşan trafiğe bakar
	local base = CFrame.lookAt(position, position + look)
	local parts = model:GetChildren()
	for _, part in parts do
		if part:IsA("BasePart") then
			if part.Name == "Pole" then
				part.CFrame = base * CFrame.new(0, 6, 0)
			elseif part.Name == "Head" then
				part.CFrame = base * CFrame.new(0, 10.4, -0.2)
			elseif part.Name == "Red" then
				part.CFrame = base * CFrame.new(0, 11.5, -0.75)
			elseif part.Name == "Yellow" then
				part.CFrame = base * CFrame.new(0, 10.4, -0.75)
			elseif part.Name == "Green" then
				part.CFrame = base * CFrame.new(0, 9.3, -0.75)
			end
		end
	end
end

local function setState(model: Model, state: string)
	for _, name in { "Red", "Yellow", "Green" } do
		local part = model:FindFirstChild(name) :: BasePart
		local on = (name == "Red" and state == "R") or (name == "Yellow" and state == "Y") or (name == "Green" and state == "G")
		part.Color = if on then (if name == "Red" then RED elseif name == "Yellow" then YELLOW else GREEN) else OFF
	end
end

-- graph: TrafficGraph sonucu; trafficGraphModule: TrafficGraph (SignalState)
function SignalRenderer.Init(graph, trafficGraphModule)
	TG = trafficGraphModule
	folder = Instance.new("Folder")
	folder.Name = "SolaraTrafficLights"
	folder.Parent = Workspace
	-- yaklaşım kolları: her ışıklı düğümde, düğüme giren şerit grubunun kaldırım tarafı
	for _, node in graph.Nodes do
		if node.Control == "Signal" then
			local seen = {}
			for _, lane in node.InLanes do
				local group = lane.Group
				if not seen[group] then
					seen[group] = true
					local curb = group[#group]
					local s = curb.StopS
					local t = s / math.max(curb.Length, 0.1)
					local x = curb.X0 + (curb.X1 - curb.X0) * t + curb.RX * (curb.LaneWidth / 2 + 2.5)
					local z = curb.Z0 + (curb.Z1 - curb.Z0) * t + curb.RZ * (curb.LaneWidth / 2 + 2.5)
					local y = graph.Meta.BlockTop or 0.8
					if curb.Y1 > 2 then
						y = curb.Y1 -- yükseltilmiş yol (nadiren)
					end
					table.insert(approaches, {
						Key = node.Id .. ":" .. lane.Edge .. ":" .. lane.From,
						Node = node,
						Phase = node.ArmPhase[lane.Edge] or 1,
						Position = Vector3.new(x, y, z),
						Look = Vector3.new(-curb.UX, 0, -curb.UZ),
					})
				end
			end
		end
	end
end

-- Yakındaki direkleri görünür yap, uzaklaşanları havuza ver; ışık durumlarını güncelle
function SignalRenderer.Update(graph, focus: Vector3?, time: number, radius: number)
	if not focus then
		for key, entry in active do
			entry.Model.Parent = nil
			table.insert(pool, entry.Model)
			active[key] = nil
		end
		return
	end
	local r2 = radius * radius
	local keep = {}
	for _, a in approaches do
		local d = a.Position - focus
		if d.X * d.X + d.Z * d.Z < r2 then
			keep[a.Key] = a
		end
	end
	for key, entry in active do
		if not keep[key] then
			entry.Model.Parent = nil
			table.insert(pool, entry.Model)
			active[key] = nil
		end
	end
	for key, a in keep do
		local entry = active[key]
		if not entry then
			local model = table.remove(pool) or build()
			-- direk tabanı: zemine ışınla otur (kaldırım varsa kaldırım, yoksa zemin)
			if not a.Grounded then
				a.Grounded = true
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { folder }
				local hit = Workspace:Raycast(a.Position + Vector3.new(0, 15, 0), Vector3.new(0, -40, 0), params)
				if hit then
					a.Position = Vector3.new(a.Position.X, hit.Position.Y, a.Position.Z)
				end
			end
			place(model, a.Position, a.Look)
			model.Parent = folder
			entry = { Model = model, Node = a.Node, Phase = a.Phase, State = nil }
			active[key] = entry
		end
		local state = TG.SignalState(graph, entry.Node, entry.Phase, time)
		if state ~= entry.State then
			entry.State = state
			setState(entry.Model, state)
		end
	end
end

function SignalRenderer.ActiveCount(): number
	local n = 0
	for _ in active do
		n += 1
	end
	return n
end

return SignalRenderer
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7E5ADC5EN"><Properties>
<string name="Name">TrafficRenderer</string>

<ProtectedString name="Source"><![CDATA[-- TrafficRenderer: NPC araçların görselleri ve HAVUZ (Aşama 6). Sadece bu istemcide (yerel parçalar).
--
-- Model: görünmez sabit (Anchored) kök + kaynaklı ~11 parça (gövde, kabin, tavan, 4 teker, farlar, stoplar).
-- Fizik kısıtı yok; kök CFrame'i her karede yazılır (ara değerli). Gövde/kabin çarpışır (oyuncunun aracı çarpar),
-- hiçbiri ışın sorgularına girmez (CanQuery=false: kamera ve araç zemin ışını etkilenmez).
-- Ölçüler ve renkler VehicleDefinitions'tan gelir (aynı otomobil aileleri).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VehicleDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VehicleDefinitions"))
local CarModelKit = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CarModelKit"))

local TrafficRenderer = {}

local DARK = Color3.fromRGB(28, 30, 34)
local GLASS = Color3.fromRGB(40, 56, 70)
local HEAD_OFF = Color3.fromRGB(220, 220, 210)
local HEAD_ON = Color3.fromRGB(255, 244, 214)
local TAIL_OFF = Color3.fromRGB(110, 18, 22)
local TAIL_ON = Color3.fromRGB(255, 40, 40)

-- Kabin oranı ve konumu (gövde uzunluğuna göre): stil → { uzunluk oranı, merkez kayması }
local CABIN = {
	compact = { 0.55, 0.05 }, sedan = { 0.5, 0.05 }, sports = { 0.4, 0.08 }, suv = { 0.62, 0.08 },
	pickup = { 0.36, -0.12 }, van = { 0.8, 0.06 }, utility = { 0.7, 0.05 },
}

local folder: Folder
local pools: { [string]: { Model } } = {}
local rng = Random.new()

function TrafficRenderer.Init()
	folder = Instance.new("Folder")
	folder.Name = "SolaraTraffic"
	folder.Parent = Workspace
end

local function part(model: Model, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, opts: { [string]: any }?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = root.CFrame * offset
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = false
	p.CanCollide = opts ~= nil and opts.Collide == true
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = not (opts ~= nil and opts.Collide == true) -- gövde/kabin kütleli: kazada gerçekçi savrulma
	p.CastShadow = opts ~= nil and opts.Shadow == true
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	if opts and opts.Transparency then
		p.Transparency = opts.Transparency
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

local function build(defId: string): Model
	local def = VehicleDefinitions.Get(defId)
	local W, L = def.Width, def.Length
	local R = def.WheelRadius
	local clearance = def.Clearance or 1
	local lowerH, cabinH = def.LowerHeight or 2, def.CabinHeight or 2.2
	local model = Instance.new("Model")
	model.Name = "NPC_" .. defId
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(W, 0.2, L)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(0, -500, 0)
	root.Parent = model
	model.PrimaryPart = root

	part(model, root, "Body", Vector3.new(W, lowerH, L), CFrame.new(0, clearance + lowerH / 2, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Collide = true, Shadow = true })
	local cab = CABIN[def.Style] or CABIN.sedan
	local cabL = L * cab[1]
	local cabZ = L * cab[2]
	local cw = W - 0.8
	part(model, root, "Cabin", Vector3.new(cw, cabinH, cabL), CFrame.new(0, clearance + lowerH + cabinH / 2, cabZ), GLASS, Enum.Material.Glass, { Collide = true, Transparency = 0.2 })
	part(model, root, "Roof", Vector3.new(cw + 0.1, 0.3, cabL - 0.4), CFrame.new(0, clearance + lowerH + cabinH + 0.15, cabZ), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			part(model, root, "Wheel", Vector3.new(def.WheelWidth, R * 2, R * 2), CFrame.new(sx * def.Track / 2, R, sz * def.Wheelbase / 2), DARK, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		end
		part(model, root, "Head", Vector3.new(1.2, 0.5, 0.2), CFrame.new(sx * (W / 2 - 1), clearance + lowerH * 0.65, -L / 2 - 0.05), HEAD_OFF, Enum.Material.SmoothPlastic)
		part(model, root, "Tail", Vector3.new(1.2, 0.5, 0.2), CFrame.new(sx * (W / 2 - 1), clearance + lowerH * 0.65, L / 2 + 0.05), TAIL_OFF, Enum.Material.SmoothPlastic)
	end
	model:SetAttribute("DefId", defId)
	model:SetAttribute("Painted", true)
	model:SetAttribute("Brake", false)
	model:SetAttribute("Lights", false)
	return model
end

-- Dış 3D model (CarModelConfig; ör. Quaternius CC0 paketi): ReplicatedStorage.VehicleModels'ta varsa kullanılır.
-- Ölçek: tanımın dingil mesafesi; kök yol yüzeyinde, teker merkezleri yerden teker yarıçapı kadar yukarıda.
local meshData: { [Model]: { Name: string, Parts: { BasePart }, Spin: { any }, Radius: number, Angle: number } } = {}

local function buildMesh(defId: string, name: string): Model?
	local info = CarModelKit.Get(name)
	if not info then
		return nil
	end
	local def = VehicleDefinitions.Get(defId)
	local s = def.Wheelbase / info.Wheelbase
	local radius = info.WheelRadius * s
	local model = Instance.new("Model")
	model.Name = "NPC_" .. name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(info.Width * s, 0.2, info.Length * s)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(0, -500, 0)
	root.Parent = model
	model.PrimaryPart = root
	-- tek kutu çarpışma gövdesi (oyuncunun aracı çarpar; görsel meshler çarpışmaz → ucuz ve kararlı)
	local height = math.max(radius + info.RoofY * s - 0.4, 2)
	local hull = Instance.new("Part")
	hull.Name = "Hull"
	hull.Size = Vector3.new(info.Width * s * 0.95, height, info.Length * s * 0.95)
	hull.CFrame = root.CFrame * CFrame.new(0, 0.4 + height / 2, 0)
	hull.Transparency = 1
	hull.Anchored = false
	hull.CanCollide = true
	hull.CanQuery = false
	hull.CanTouch = false
	hull.Massless = false
	hull.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(def.Mass / (hull.Size.X * hull.Size.Y * hull.Size.Z), 0.05, 10), 0.4, 0.1)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = hull
	weld.Parent = hull
	hull.Parent = model
	local result = CarModelKit.Build(info, {
		Frame = root.CFrame * CFrame.new(0, radius, 0), Scale = s, Parent = model, Body = root, Shadows = true,
	})
	meshData[model] = { Name = name, Parts = result.Parts, Spin = result.Spin, Radius = radius, Angle = 0 }
	model:SetAttribute("DefId", defId)
	model:SetAttribute("Brake", false)
	model:SetAttribute("Lights", false)
	return model
end

local function paint(model: Model)
	local def = VehicleDefinitions.Get(model:GetAttribute("DefId"))
	local color = def.Colors[rng:NextInteger(1, #def.Colors)]
	local mesh = meshData[model]
	if mesh then
		CarModelKit.Repaint(mesh.Parts, mesh.Name, color)
		return
	end
	for _, name in { "Body", "Roof" } do
		local p = model:FindFirstChild(name) :: BasePart?
		if p then
			p.Color = color
		end
	end
end

function TrafficRenderer.SetBrake(model: Model, on: boolean)
	if model:GetAttribute("Brake") == on then
		return
	end
	model:SetAttribute("Brake", on)
	for _, p in model:GetChildren() do
		if (p.Name == "Tail" or p.Name == "TailLight") and p:IsA("BasePart") then
			p.Color = if on then TAIL_ON else (p:GetAttribute("OffColor") or TAIL_OFF)
			p.Material = if on or model:GetAttribute("Lights") then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

function TrafficRenderer.SetLights(model: Model, on: boolean)
	if model:GetAttribute("Lights") == on then
		return
	end
	model:SetAttribute("Lights", on)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			local head = p.Name == "Head" or p.Name == "Headlight"
			local tail = p.Name == "Tail" or p.Name == "TailLight"
			if head then
				p.Color = if on then HEAD_ON else (p:GetAttribute("OffColor") or HEAD_OFF)
			end
			if head or tail then
				p.Material = if on or (tail and model:GetAttribute("Brake")) then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
end

-- Görünür tekerleri döndür (dış modelli araçlar). speed: stud/sn (ileri +)
function TrafficRenderer.Spin(model: Model, speed: number, dt: number)
	local mesh = meshData[model]
	if not mesh or #mesh.Spin == 0 then
		return
	end
	mesh.Angle = (mesh.Angle - speed / mesh.Radius * dt) % (math.pi * 2)
	local t = CFrame.Angles(mesh.Angle, 0, 0)
	for _, s in mesh.Spin do
		s.Motor.Transform = t
	end
end

-- Havuzdan al (yoksa üret), boya, sahneye koy. taxiScale: bölgeye göre taksi olasılığı çarpanı
function TrafficRenderer.Acquire(defId: string, lightsOn: boolean, taxiScale: number?): Model
	local bodyName = CarModelKit.Pick(defId, rng, true, taxiScale)
	local key = defId .. "|" .. (bodyName or "box")
	local pool = pools[key]
	local model = pool and table.remove(pool)
	if not model then
		model = (bodyName and buildMesh(defId, bodyName)) or build(defId)
		model:SetAttribute("PoolKey", key)
	end
	paint(model)
	TrafficRenderer.SetBrake(model, false)
	TrafficRenderer.SetLights(model, lightsOn)
	model.Parent = folder
	return model
end

-- Havuza geri ver (kaza sonrası fizikseldiyse tekrar sabitle)
function TrafficRenderer.Release(model: Model)
	local root = model.PrimaryPart
	if root then
		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CFrame.new(0, -500, 0)
	end
	model.Parent = nil
	local key = model:GetAttribute("PoolKey") or model:GetAttribute("DefId")
	pools[key] = pools[key] or {}
	table.insert(pools[key], model)
end

-- Kaza: model fizik nesnesine döner (bu istemcide simüle edilir), sonra havuza döner
function TrafficRenderer.MakePhysical(model: Model, velocity: Vector3)
	local root = model.PrimaryPart
	if not root then
		return
	end
	root.Anchored = false
	root.AssemblyLinearVelocity = velocity
end

function TrafficRenderer.PoolCount(): number
	local n = 0
	for _, pool in pools do
		n += #pool
	end
	return n
end

function TrafficRenderer.Folder(): Folder
	return folder
end

return TrafficRenderer
]]></ProtectedString>
