<Item class="ModuleScript" referent="RBX00000005"><Properties>
<string name="Name">AnimationConfig</string>

<ProtectedString name="Source"><![CDATA[-- AnimationConfig: ÖZEL eylem animasyonları (yeme, içme, selamlama, araç binme...).
--
-- ÖNEMLİ — avatar kuralı:
--   Yürüme/koşma/zıplama/düşme animasyonlarını OYUNCUNUN KENDİ AVATARI belirler.
--   Roblox'un varsayılan "Animate" scripti, oyuncunun hesabındaki animasyon paketini
--   (ör. Ninja, Robot, Stylish) otomatik kullanır. Bu yüzden o scripti DEĞİŞTİRMİYORUZ.
--
-- Buradaki ID'ler, Animation Editor'de oluşturup Roblox'a yüklediğin animasyonlar olacak.
-- ID boş ("") ise AnimationController o animasyonu sessizce atlar (oyun bozulmaz).
-- R6 ve R15 için AYRI animasyon gerekir; iskeletler farklıdır.

local AnimationConfig = {}

AnimationConfig.Actions = {
	-- Sosyal (Aşama 5)
	Greet = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action },
	TalkIdle = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action },
	Listen = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action },
	-- Tüketim (Aşama 7)
	Eat = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action },
	Drink = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action },
	-- Araçlar (Aşama 3)
	CarEnter = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action2 },
	CarExit = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action2 },
	DriveIdle = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action },
	BikeRide = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action },
	BikeLeanLeft = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action2 },
	BikeLeanRight = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Action2 },
	-- Ekipman (Aşama 6)
	WeaponEquip = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action },
	WeaponIdle = { R15 = "", R6 = "", Looped = true, Priority = Enum.AnimationPriority.Idle },
	Reload = { R15 = "", R6 = "", Looped = false, Priority = Enum.AnimationPriority.Action2 },
}

AnimationConfig.DefaultFadeTime = 0.18

return AnimationConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties>
<string name="Name">AudioConfig</string>

<ProtectedString name="Source"><![CDATA[-- AudioConfig: tüm ses varlıkları tek yerde (Bölüm 23).
--
-- ÖNEMLİ: Spec gereği sadece ÖZGÜN veya LİSANSLI ses kullanılmalı. Bu yüzden ID'ler boş bırakıldı.
-- Roblox Creator Store'da (Studio → Toolbox → Audio) "car engine loop", "car horn", "motorcycle engine"
-- aratıp kullanım iznini kontrol ettiğin sesin ID'sini buraya yaz ("rbxassetid://123..." veya sadece sayı).
-- ID boşsa sistem sessizce çalışır; hiçbir şey bozulmaz.

local AudioConfig = {}

AudioConfig.Vehicle = {
	EngineCar = "",
	EngineMotorcycle = "",
	HornCar = "",
	HornMotorcycle = "",
	EngineBasePitch = 0.7, -- rölanti
	EngineMaxPitch = 1.9, -- en yüksek hızda
	EngineVolume = 0.55,
	HornVolume = 0.8,
	RollOffMin = 10,
	RollOffMax = 140, -- uzaktaki araçlar gereksiz yüksek ses çıkarmasın
}

-- Menü/arayüz sesleri (Aşama 1). Boşsa menü sessiz çalışır.
AudioConfig.Interface = {
	Move = "", -- odak değişimi (kısa "tık")
	Select = "", -- onay
	Back = "", -- geri
	Volume = 0.5,
}

function AudioConfig.Resolve(id: string?): string?
	if id == nil or id == "" then
		return nil
	end
	if string.find(id, "rbxasset", 1, true) then
		return id
	end
	return "rbxassetid://" .. id
end

return AudioConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties>
<string name="Name">CameraConfig</string>

<ProtectedString name="Source"><![CDATA[-- CameraConfig: her kamera modunun profili (Bölüm 19).
-- Ana kamera ThirdPerson: yakın, omuz üstü, aşırı yüksek DEĞİL.
-- ShoulderOffset.Y, avatarın GÖZ yüksekliğine göre eklenir; böylece kısa/uzun avatarlarda tutarlı.

local CameraConfig = {}

CameraConfig.Profiles = {
	ThirdPerson = {
		Distance = 6.5,
		MinDistance = 3,
		MaxDistance = 11,
		ShoulderOffset = Vector3.new(1.6, 0.35, 0),
		FieldOfView = 70,
		MinPitch = -65,
		MaxPitch = 55,
		FollowSharpness = 22,
		RotationSharpness = 30,
		CollisionRadius = 0.35,
		HideCharacter = false,
		SprintFovBoost = 7,
	},
	-- Alternatif üçüncü şahıs: ortalanmış, biraz daha geride ve yüksekte (klasik takip)
	ThirdPersonAlt = {
		Distance = 9.5,
		MinDistance = 4,
		MaxDistance = 16,
		ShoulderOffset = Vector3.new(0, 1.1, 0),
		FieldOfView = 70,
		MinPitch = -70,
		MaxPitch = 60,
		FollowSharpness = 16,
		RotationSharpness = 26,
		CollisionRadius = 0.4,
		HideCharacter = false,
		SprintFovBoost = 6,
	},
	FirstPerson = {
		Distance = 0,
		MinDistance = 0,
		MaxDistance = 0,
		ShoulderOffset = Vector3.new(0, 0.1, 0),
		FieldOfView = 78,
		MinPitch = -80,
		MaxPitch = 80,
		FollowSharpness = 60,
		RotationSharpness = 45,
		CollisionRadius = 0.2,
		HideCharacter = true,
		SprintFovBoost = 5,
	},
	-- ===== Sürüş kameraları (Aşama 3 — sürüş arayüzü) =====
	-- Araç modlarında Distance/ShoulderOffset.Y TABAN değerlerdir; CameraController bunları aracın boyutuna göre
	-- büyütür (framing): yükseklik ≥ tavan + RoofClearance, mesafe ≥ uzunluk × LengthFactor + DistancePad,
	-- en yakın mesafe ≥ uzunluk/2 + 3 (kamera kendi aracının içine giremez).
	--   FollowSharpness      yatay takip (hız ileri beslemeli → hızda geride kalma yok)
	--   VerticalSharpness    dikey takip (düşük = tümsekleri yutar)
	--   AutoFollowSharpness  bakış girişi yokken aracın arkasına dönme hızı (hızla artar)
	--   AutoPitch, PitchFollow  otomatik bakış açısı (derece) ve aracın yokuş eğiminin izlenme oranı
	--   RollFollow           motosiklet yatışının kameraya aktarılan oranı (otomobil 0)
	--   SpeedFovBoost        azami hızda eklenen görüş açısı (derece); SpeedDistanceBoost azami hızda eklenen mesafe
	Vehicle = {
		Distance = 11,
		MinDistance = 7,
		MaxDistance = 22,
		ShoulderOffset = Vector3.new(0, 2.4, 0),
		FieldOfView = 70,
		MinPitch = -50,
		MaxPitch = 35,
		FollowSharpness = 14,
		VerticalSharpness = 6,
		RotationSharpness = 14,
		CollisionRadius = 0.6,
		HideCharacter = false,
		SprintFovBoost = 0,
		RoofClearance = 1.4,
		LengthFactor = 0.7,
		DistancePad = 3,
		AutoFollowSharpness = 2.4,
		AutoPitch = -11,
		PitchFollow = 0.5,
		RollFollow = 0,
		SpeedFovBoost = 9,
		SpeedDistanceBoost = 3,
	},
	Motorcycle = {
		Distance = 8,
		MinDistance = 4.5,
		MaxDistance = 16,
		ShoulderOffset = Vector3.new(0, 2.2, 0),
		FieldOfView = 72,
		MinPitch = -50,
		MaxPitch = 35,
		FollowSharpness = 16,
		VerticalSharpness = 8,
		RotationSharpness = 16,
		CollisionRadius = 0.45,
		HideCharacter = false,
		SprintFovBoost = 0,
		RoofClearance = 0.8,
		LengthFactor = 0.8,
		DistancePad = 2.5,
		AutoFollowSharpness = 3,
		AutoPitch = -10,
		PitchFollow = 0.6,
		RollFollow = 0.3,
		SpeedFovBoost = 10,
		SpeedDistanceBoost = 2.5,
	},
}

CameraConfig.DefaultMode = "ThirdPerson"

-- Hassasiyet (radyan / piksel). SettingsController çarpanı bunlarla çarpılır.
CameraConfig.MouseSensitivity = 0.0035
CameraConfig.TouchSensitivity = 0.006
CameraConfig.GamepadSensitivity = 3.2 -- radyan / sn (tam itişte)
CameraConfig.GamepadDeadzone = 0.15

CameraConfig.ZoomStep = 1.25 -- fare tekerleği adımı (stud)
CameraConfig.PinchZoomFactor = 0.04

-- Kameranın kafaya bu kadar yaklaşması durumunda karakter yarı saydamlaşır
CameraConfig.CharacterFadeDistance = 1.6

-- Kamera hatası güvenlik ağı: art arda bu kadar karede hata olursa varsayılan kameraya dön
CameraConfig.MaxConsecutiveErrors = 3

return CameraConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties>
<string name="Name">InputConfig</string>

<ProtectedString name="Source"><![CDATA[-- InputConfig: eylem → tuş eşlemesi. Tuşlar tek yerden değiştirilebilir (Bölüm 21).
-- Mobil karşılıkları MobileControls (InputController içinde) tarafından özel butonlarla sağlanır.

local InputConfig = {}

InputConfig.Actions = {
	Sprint = {
		Keys = { Enum.KeyCode.LeftShift },
		Gamepad = { Enum.KeyCode.ButtonL3 },
		Hold = true, -- basılı tutulunca aktif (mobilde toggle olarak davranır)
	},
	WalkToggle = {
		Keys = { Enum.KeyCode.LeftControl },
		Gamepad = { Enum.KeyCode.ButtonR3 },
		Hold = false,
	},
	CameraCycle = {
		Keys = { Enum.KeyCode.V },
		Gamepad = { Enum.KeyCode.DPadUp },
		Hold = false,
	},
	FreeCursor = {
		-- PC'de imleci geçici serbest bırakır (kamera kilidi açılır)
		Keys = { Enum.KeyCode.LeftAlt },
		Gamepad = {},
		Hold = true,
	},
	ToggleDebug = {
		Keys = { Enum.KeyCode.F3 },
		Gamepad = {},
		Hold = false,
	},
	-- Trafik/yaya yapay zekâsı hata ayıklama görünümü (Aşama 6; geliştirme aracı)
	AmbientDebug = {
		Keys = { Enum.KeyCode.F7 },
		Gamepad = {},
		Hold = false,
	},
	-- Tam ekran harita (Aşama 4). Araçtayken de çalışır (araç dururken).
	OpenMap = {
		Keys = { Enum.KeyCode.M },
		Gamepad = {},
		Hold = false,
	},
	-- Araç telemetrisi ve test ölçümleri paneli (Aşama 2; geliştirme aracı)
	ToggleTelemetry = {
		Keys = { Enum.KeyCode.F4 },
		Gamepad = {},
		Hold = false,
	},
	-- Oyun içinde ana menüyü aç (Esc Roblox'a ait; gamepad'de Start da Roblox menüsüdür)
	OpenMenu = {
		Keys = { Enum.KeyCode.P },
		Gamepad = { Enum.KeyCode.DPadLeft },
		Hold = false,
	},
	-- ===== Araç bağlamı (sadece araçtayken bağlanır; yürürken WASD'yi engellemez) =====
	-- Gamepad tetikleri (R2/L2) burada YOK: VehicleController onları analog okur (Aşama 2).
	-- Dijital olarak da bağlansalardı yarım basış tam gaz sayılırdı.
	VehGas = { Context = "Vehicle", Keys = { Enum.KeyCode.W, Enum.KeyCode.Up }, Gamepad = {}, Hold = true },
	VehBrake = { Context = "Vehicle", Keys = { Enum.KeyCode.S, Enum.KeyCode.Down }, Gamepad = {}, Hold = true },
	VehLeft = { Context = "Vehicle", Keys = { Enum.KeyCode.A, Enum.KeyCode.Left }, Gamepad = {}, Hold = true },
	VehRight = { Context = "Vehicle", Keys = { Enum.KeyCode.D, Enum.KeyCode.Right }, Gamepad = {}, Hold = true },
	VehHandbrake = { Context = "Vehicle", Keys = { Enum.KeyCode.Space }, Gamepad = { Enum.KeyCode.ButtonX }, Hold = true },
	VehHorn = { Context = "Vehicle", Keys = { Enum.KeyCode.H }, Gamepad = { Enum.KeyCode.ButtonL3 }, Hold = true },
	VehExit = { Context = "Vehicle", Keys = { Enum.KeyCode.F }, Gamepad = { Enum.KeyCode.ButtonY }, Hold = false },
	VehLights = { Context = "Vehicle", Keys = { Enum.KeyCode.L }, Gamepad = { Enum.KeyCode.DPadDown }, Hold = false },
	VehIndLeft = { Context = "Vehicle", Keys = { Enum.KeyCode.Q }, Gamepad = { Enum.KeyCode.DPadLeft }, Hold = false },
	VehIndRight = { Context = "Vehicle", Keys = { Enum.KeyCode.E }, Gamepad = { Enum.KeyCode.DPadRight }, Hold = false },
	VehFlip = { Context = "Vehicle", Keys = { Enum.KeyCode.R }, Gamepad = { Enum.KeyCode.ButtonB }, Hold = false },
	-- ===== Menü bağlamı (ana menü açıkken bağlanır; OnFoot eylemleri o sırada çözülür) =====
	-- Yön eylemleri basılı tutulunca FrontEnd tekrar eder (Hold = true).
	MenuUp = { Context = "Menu", Keys = { Enum.KeyCode.Up, Enum.KeyCode.W }, Gamepad = { Enum.KeyCode.DPadUp }, Hold = true },
	MenuDown = { Context = "Menu", Keys = { Enum.KeyCode.Down, Enum.KeyCode.S }, Gamepad = { Enum.KeyCode.DPadDown }, Hold = true },
	MenuLeft = { Context = "Menu", Keys = { Enum.KeyCode.Left, Enum.KeyCode.A }, Gamepad = { Enum.KeyCode.DPadLeft }, Hold = true },
	MenuRight = { Context = "Menu", Keys = { Enum.KeyCode.Right, Enum.KeyCode.D }, Gamepad = { Enum.KeyCode.DPadRight }, Hold = true },
	MenuAccept = { Context = "Menu", Keys = { Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter }, Gamepad = { Enum.KeyCode.ButtonA }, Hold = false },
	MenuBack = { Context = "Menu", Keys = { Enum.KeyCode.Backspace }, Gamepad = { Enum.KeyCode.ButtonB }, Hold = false },
	MenuTabPrev = { Context = "Menu", Keys = { Enum.KeyCode.Q }, Gamepad = { Enum.KeyCode.ButtonL1 }, Hold = false },
	MenuTabNext = { Context = "Menu", Keys = { Enum.KeyCode.E }, Gamepad = { Enum.KeyCode.ButtonR1 }, Hold = false },
	MenuClose = { Context = "Menu", Keys = { Enum.KeyCode.P, Enum.KeyCode.M }, Gamepad = {}, Hold = false },
	-- İleride: Interact (E), Inventory (Tab), Map (M)...
}

return InputConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties>
<string name="Name">UIConfig</string>

<ProtectedString name="Source"><![CDATA[-- UIConfig: ortak görsel dil. Varsayılan Roblox görünümünden kaçınmak için (Bölüm 18.3 / 21).

local UIConfig = {}

UIConfig.Colors = {
	Background = Color3.fromRGB(14, 16, 22),
	Surface = Color3.fromRGB(26, 29, 38),
	Accent = Color3.fromRGB(255, 122, 69), -- gün batımı turuncusu (oyunun kimlik rengi)
	AccentAlt = Color3.fromRGB(64, 196, 214), -- sahil turkuazı
	Text = Color3.fromRGB(240, 242, 247),
	TextMuted = Color3.fromRGB(150, 156, 170),
	Danger = Color3.fromRGB(235, 87, 87),
}

UIConfig.Fonts = {
	Title = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
	Body = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium),
	Mono = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular),
}

UIConfig.Mobile = {
	-- Butonlar ekran kısa kenarına oranla boyutlanır → farklı ekranlarda aynı his
	ButtonSizeScale = 0.13, -- kısa kenarın oranı
	ButtonMinPx = 56,
	ButtonMaxPx = 96,
	Spacing = 12,
	BackgroundTransparency = 0.35,
	-- Sağ alt köşede Roblox'un zıplama butonu bulunur; bizim butonlar onun ÜSTÜNE ve SOLUNA dizilir.
	-- Sol alt köşe: joystick. (Minimap Aşama 9'da joystick'in ÜSTÜNE yerleşecek.)
}

UIConfig.Tween = {
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Normal = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

return UIConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2B853EB9N"><Properties>
<string name="Name">FrontEndConfig</string>

<ProtectedString name="Source"><![CDATA[-- FrontEndConfig: ana menü / ön yüz ayarları (Aşama 1).
-- Hem sunucu (akış odağı, doğma bekleme süreleri) hem istemci (menü kamerası, zaman aşımları) okur.
-- Sadece veri içerir.

local FrontEndConfig = {}

-- ===== Menü kamerası: şehir merkezinin kulelerine bakan yavaş hava çekimi =====
-- Konumlar MapData'dan seçildi: kuleler (184–324 stud) orijin çevresinde (±220) kümelenir,
-- varsayılan doğma meydanı (80, -80) ve deniz x≈1446'dan itibaren başlar.
FrontEndConfig.MenuShot = {
	Target = Vector3.new(0, 150, 0), -- kameranın baktığı nokta (kule kümesi)
	Pivot = Vector3.new(0, 0, 0), -- yörünge merkezi (yatay)
	Radius = 760,
	Height = 230,
	StartAngle = 200, -- derece (+X ekseninden, XZ düzleminde)
	EndAngle = 250,
	Period = 70, -- sn: bir uçtan diğerine (sonra geri döner)
	FieldOfView = 58,
}

-- Menü yeniden açıldığında (oyun içi): oyuncunun etrafında yavaş dönen çekim
FrontEndConfig.PauseShot = {
	Radius = 24,
	Height = 9,
	LookHeight = 2,
	DegreesPerSecond = 5,
	FieldOfView = 62,
	CollisionRadius = 0.8,
}

-- Oyuncu henüz doğmamışken içerik bu noktanın çevresinde akar (StreamingEnabled).
-- Hem menü çekimine (≈500 stud) hem doğma meydanına (≈400 stud) yakın seçildi.
FrontEndConfig.StreamFocus = Vector3.new(-270, 20, -270)
FrontEndConfig.StreamRequestTimeout = 12 -- sn (istemci RequestStreamAroundAsync)
-- Menü arka planındaki uzak şehir için EK akış odakları (sunucu: Player:AddReplicationFocus).
-- Tek odak (1024 stud) menü kamerasının gördüğü binaların ~%30'unu yüklüyordu (uzak kısım hiç gelmiyordu).
-- Bu iki nokta ile ~%76'sı (ekranda kapladıkları alanın ~%97'si) yüklenir. Sadece menüdeyken etkindir;
-- oyuncu doğarken kaldırılır. Hesap: harita verisi + MenuShot görüş alanı (Hata düzeltme 2 dokümanı).
FrontEndConfig.MenuExtraStreamFoci = {
	Vector3.new(1900, 20, 0),
	Vector3.new(400, 20, 1200),
}

-- Şehir menü arka planında "hazır" sayılmadan önce yedek arka plan gösterilir.
FrontEndConfig.CityProbeInterval = 1 -- sn
FrontEndConfig.BackdropFadeTime = 0.9

-- ===== Doğma =====
FrontEndConfig.ServerWorldWait = 30 -- sn: sunucu, dünya tam hazır olsun diye en fazla bu kadar bekler
FrontEndConfig.ServerGroundWait = 15 -- sn: sonra en az zemin adımının bitmesini bu kadar daha bekler
FrontEndConfig.MinWorldProgress = 0.25 -- WorldBuilder adım 2/8 (doğma noktaları + zemin/bloklar) tamam
FrontEndConfig.ClientSpawnTimeout = 60 -- sn: istemci bu sürede karakter alamazsa hata gösterir
FrontEndConfig.ClientCharacterReadyTimeout = 8 -- sn: karakter geldikten sonra sunucunun konumlamasını bekleme

-- ===== Arayüz =====
FrontEndConfig.DisplayOrder = 50 -- araç HUD'u (6) ve mobil kontrollerin (5) üstünde, DebugHUD'un (100) altında
FrontEndConfig.NavRepeatDelay = 0.35 -- sn: yön tuşu basılı tutulunca tekrar başlama gecikmesi
FrontEndConfig.NavRepeatRate = 0.09 -- sn
FrontEndConfig.StickThreshold = 0.6

return table.freeze(FrontEndConfig)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0CC1E715N"><Properties>
<string name="Name">DrivingLayout</string>

<ProtectedString name="Source"><![CDATA[-- DrivingLayout: sürüş arayüzünün yerleşim hesabı (Aşama 3). SAF fonksiyon; Instance kullanmaz.
-- Dokunmatik sürüş kontrolleri (MobileControlsController) ve sürüş göstergesi (VehicleHUDController)
-- AYNI dikdörtgenleri buradan alır → birbirleriyle ve harita alanıyla çakışmazlar.
--
-- Koordinatlar: güvenli alanın (ScreenInsets = CoreUISafeInsets) sol üst köşesine göre piksel.
-- Dikdörtgen = { X, Y, W, H }.
--
-- Not: bu dosya bilerek "düz Lua" alt kümesiyle yazıldı (tip açıklaması, +=, if-ifadesi yok);
-- tools/test_driving_layout.py onu gerçek bir Lua yorumlayıcısında çalıştırıp çok sayıda ekran
-- boyutunda çakışma testi yapar.

local DrivingLayout = {}

local MIN_TOUCH = 44 -- en küçük dokunma hedefi (piksel); platform rehberleriyle uyumlu
DrivingLayout.MinTouch = MIN_TOUCH

local function clamp(x, lo, hi)
	if x < lo then
		return lo
	end
	if x > hi then
		return hi
	end
	return x
end

local function rect(x, y, w, h)
	return { X = math.floor(x), Y = math.floor(y), W = math.floor(w), H = math.floor(h) }
end

function DrivingLayout.Overlaps(a, b, pad)
	pad = pad or 0
	return a.X < b.X + b.W + pad and b.X < a.X + a.W + pad and a.Y < b.Y + b.H + pad and b.Y < a.Y + a.H + pad
end

-- Dokunmatik buton taban boyutu (piksel): kısa kenarın oranı, sınırlı, oyuncu ölçeğiyle
function DrivingLayout.ButtonSize(width, height, userScale)
	local minAxis = math.min(width, height)
	local base = clamp(math.floor(minAxis * 0.13), 56, 96)
	return math.floor(base * (userScale or 1))
end

-- options: Steering ("Pad" | "Buttons"), Kind ("Car" | "Motorcycle" | "Passenger")
-- Döndürür: rects (isim → dikdörtgen), order (çizim/kontrol sırası)
function DrivingLayout.Touch(width, height, base, options)
	options = options or {}
	local kind = options.Kind or "Car"
	local steering = options.Steering or "Pad"
	local minAxis = math.min(width, height)
	local m = math.max(12, math.floor(base * 0.3)) -- kenar boşluğu
	local gap = math.max(8, math.floor(base * 0.18))
	local small = math.max(MIN_TOUCH, math.floor(base * 0.8)) -- ikincil butonlar da 44 px'den küçük olmaz
	local r = {}

	-- Ayrılmış alanlar: harita (sol üst) ve hız çubuğu (üst orta)
	local map = clamp(math.floor(minAxis * 0.26), 84, 180)
	r.Minimap = rect(m, m, map, map)
	local hudW = clamp(math.floor(width * 0.3), 220, 340)
	local hudH = clamp(math.floor(base * 0.95), 48, 80)
	-- Ortada yer yoksa (dar/dikey ekran) haritanın sağına; o da sığmazsa haritanın altına
	local hudX = (width - hudW) / 2
	local hudY = m
	local mapRight = r.Minimap.X + r.Minimap.W + gap
	if hudX < mapRight then
		hudX = mapRight
		if hudX + hudW > width - m then
			hudW = math.max(width - m - hudX, 0)
			if hudW < 200 then
				hudW = math.min(clamp(math.floor(width * 0.3), 220, 340), width - 2 * m)
				hudX = m
				hudY = r.Minimap.Y + r.Minimap.H + gap
			end
		end
	end
	r.Hud = rect(hudX, hudY, hudW, hudH)

	-- Navigasyon yönlendirme paneli (Aşama 4): haritanın altında; HUD o sütuna inmişse onun da altında
	local guideW = math.min(clamp(math.floor(map * 1.9), 170, 300), width - 2 * m)
	local guideH = clamp(math.floor(base * 0.85), 44, 66)
	local guideY = r.Minimap.Y + r.Minimap.H + gap
	if r.Hud.X < m + guideW + gap and r.Hud.Y + r.Hud.H + gap > guideY then
		guideY = r.Hud.Y + r.Hud.H + gap
	end
	r.Guidance = rect(m, guideY, guideW, guideH)

	-- Üst sağ satır: in, far, çevir (sağdan sola)
	local topRow = { "Exit" }
	if kind ~= "Passenger" then
		table.insert(topRow, "Lights")
		if kind == "Car" then
			table.insert(topRow, "Flip")
		end
	end
	local x = width - m - small
	local rowY = m
	-- Satır HUD'a değecekse HUD'un altına in
	local rowLeft = width - m - (#topRow * small + (#topRow - 1) * gap)
	if rowLeft < r.Hud.X + r.Hud.W + gap and r.Hud.Y < m + small + gap then
		rowY = r.Hud.Y + r.Hud.H + gap
	end
	for _, name in ipairs(topRow) do
		r[name] = rect(x, rowY, small, small)
		x = x - small - gap
	end
	-- Yönlendirme paneli üst sağ satıra değiyorsa daralt; çok daralacaksa satırın altına in
	local rowLeftEdge = x + small + gap
	local g = r.Guidance
	if g.Y < rowY + small + gap and g.Y + g.H + gap > rowY and g.X + g.W + gap > rowLeftEdge then
		local fitW = rowLeftEdge - gap - g.X
		if fitW >= 150 then
			r.Guidance = rect(g.X, g.Y, fitW, g.H)
		else
			r.Guidance = rect(g.X, rowY + small + gap, g.W, g.H)
		end
	end

	if kind == "Passenger" then
		return r
	end

	-- Sağ alt: gaz (en büyük, başparmağın doğal yeri), solunda fren, frenin üstünde el freni, gazın üstünde korna
	local gasW, gasH = math.floor(base * 1.25), math.floor(base * 1.7)
	r.Gas = rect(width - m - gasW, height - m - gasH, gasW, gasH)
	local brakeW, brakeH = math.floor(base * 1.15), math.floor(base * 1.3)
	r.Brake = rect(r.Gas.X - gap - brakeW, height - m - brakeH, brakeW, brakeH)
	if kind == "Car" then
		local hb = math.floor(base * 0.95)
		r.Handbrake = rect(r.Brake.X + (brakeW - hb) / 2, r.Brake.Y - gap - hb, hb, hb)
	end
	r.Horn = rect(r.Gas.X + (gasW - small) / 2, r.Gas.Y - gap - small, small, small)

	-- Sol alt: direksiyon (ped ya da iki buton); üstünde sinyaller
	local available = r.Brake.X - gap * 2 - m
	if steering == "Buttons" then
		-- Fren butonuna değmeyecek kadar küçült (dar ekran), ama dokunma sınırının altına inme
		local b = math.max(math.min(math.floor(base * 1.3), math.floor((available - gap) / 2)), MIN_TOUCH)
		r.SteerL = rect(m, height - m - b, b, b)
		r.SteerR = rect(m + b + gap, height - m - b, b, b)
		r.IndL = rect(r.SteerL.X + (b - small) / 2, r.SteerL.Y - gap - small, small, small)
		r.IndR = rect(r.SteerR.X + (b - small) / 2, r.SteerR.Y - gap - small, small, small)
	else
		local padH = math.floor(base * 1.3)
		local padW = clamp(math.floor(width * 0.34), math.floor(base * 2.4), math.floor(base * 5))
		padW = math.max(math.min(padW, available), math.floor(base * 1.8))
		r.Pad = rect(m, height - m - padH, padW, padH)
		r.IndL = rect(m, r.Pad.Y - gap - small, small, small)
		r.IndR = rect(m + padW - small, r.Pad.Y - gap - small, small, small)
	end
	return r
end

-- Masaüstü/gamepad göstergesi: hız saati sağ alt, harita alanı sol alt
function DrivingLayout.Desktop(width, height)
	local minAxis = math.min(width, height)
	local m = clamp(math.floor(minAxis * 0.03), 16, 40)
	local cluster = clamp(math.floor(minAxis * 0.27), 170, 270)
	local map = clamp(math.floor(minAxis * 0.24), 150, 240)
	local guideW, guideH = math.max(map, 280), 64
	return {
		Cluster = rect(width - m - cluster, height - m - cluster, cluster, cluster),
		Minimap = rect(m, height - m - map, map, map),
		-- Navigasyon paneli haritanın hemen üstünde
		Guidance = rect(m, height - m - map - 12 - guideH, guideW, guideH),
		Margin = m,
	}
end

-- Görünür dikdörtgenlerin birbirine değip değmediğini listeler (geliştirme kontrolü)
function DrivingLayout.FindOverlaps(rects, pad)
	local names = {}
	for name in pairs(rects) do
		table.insert(names, name)
	end
	table.sort(names)
	local problems = {}
	for i = 1, #names do
		for j = i + 1, #names do
			local a, b = rects[names[i]], rects[names[j]]
			if DrivingLayout.Overlaps(a, b, pad or 0) then
				table.insert(problems, names[i] .. "~" .. names[j])
			end
		end
	end
	return problems
end

-- Ekran dışına taşan dikdörtgenler
function DrivingLayout.FindOutOfBounds(rects, width, height)
	local problems = {}
	for name, a in pairs(rects) do
		if a.X < 0 or a.Y < 0 or a.X + a.W > width or a.Y + a.H > height then
			table.insert(problems, name)
		end
	end
	return problems
end

return DrivingLayout
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7E750431N"><Properties>
<string name="Name">CarModelConfig</string>

<ProtectedString name="Source"><![CDATA[-- CarModelConfig: dış 3D otomobil modelleri.
-- Kaynak: "LowPoly Cars" — Quaternius (https://quaternius.com), lisans CC0 1.0 (kamu malı; ticari kullanım serbest,
-- atıf zorunlu değil; jenerikte "Araba modelleri: Quaternius" yazılması önerilir).
--
-- Akış: tools/carpack_convert.py → assets/carpack/<Ad>.glb → Studio "Import 3D" → ReplicatedStorage.VehicleModels.<Ad>
-- (Model; içinde parça başına bir MeshPart: Paint, Paint2, Glass, Dark, Trim, Headlight, TailLight, SirenWhite,
-- SirenBlue, Wheel_FL_Tire, Wheel_FL_Rim, ...). Model yoksa araçlar eski kutu görünümle çalışır.
-- Sadece GÖRÜNÜM değişir: fizik (şasi, yaylar, fizik tekerleri, çarpışma kabuğu) VehicleDefinitions'tan aynen gelir.

return {
	Folder = "VehicleModels", -- ReplicatedStorage altında
	Credit = "Araba modelleri: Quaternius (CC0)",

	-- VehicleDefinitions kimliği → model(ler). Birden fazlaysa araç doğarken rastgele seçilir.
	ByDefinition = {
		compact_pico = { "NormalCar2" },
		sedan_vela = { "NormalCar1" },
		sports_rayo = { "SportsCar", "SportsCar2" },
		suv_terra = { "SUV" },
		-- pickup_mesa, van_porter, utility_brisa: pakette karşılığı yok → kutu görünüm
	},

	-- Sadece trafikte (NPC) görülen özel varyantlar: hangi tanımın sürüş ölçüleriyle, hangi olasılıkla
	TrafficVariants = {
		sedan_vela = { { Model = "Taxi", Chance = 0.15 } },
	},

	-- Boyası değişmeyen modeller (taksi sarısı, polis siyah-beyazı); diğerlerinde Paint = aracın renk listesinden
	FixedPaint = { Taxi = true, Cop = true },

	-- Paint2 (ikinci gövde rengi): "Darker" = boyanın koyusu, yoksa orijinal renk
	Paint2Rule = { SportsCar = "Darker" },

	-- Parça rolü → malzeme ve saydamlık
	Roles = {
		Paint = { Material = Enum.Material.SmoothPlastic, Reflectance = 0.06 },
		Paint2 = { Material = Enum.Material.SmoothPlastic, Reflectance = 0.06 },
		Glass = { Material = Enum.Material.Glass, Transparency = 0.15 },
		Dark = { Material = Enum.Material.SmoothPlastic },
		Trim = { Material = Enum.Material.Metal },
		Headlight = { Material = Enum.Material.SmoothPlastic },
		TailLight = { Material = Enum.Material.SmoothPlastic },
		SirenWhite = { Material = Enum.Material.SmoothPlastic },
		SirenBlue = { Material = Enum.Material.SmoothPlastic },
		Tire = { Material = Enum.Material.SmoothPlastic },
		Rim = { Material = Enum.Material.Metal },
	},

	-- Modellerin orijinal renkleri (tools/carpack_convert.py → assets/carpack/carpack.json, sRGB)
	Colors = {
		Cop = { Dark = Color3.fromRGB(31, 31, 31), Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(216, 216, 216), SirenBlue = Color3.fromRGB(65, 123, 231), SirenWhite = Color3.fromRGB(231, 231, 231), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
		NormalCar1 = { Dark = Color3.fromRGB(31, 31, 31), Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(159, 194, 231), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
		NormalCar2 = { Dark = Color3.fromRGB(31, 31, 31), Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(199, 216, 231), Paint2 = Color3.fromRGB(231, 231, 231), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
		SUV = { Dark = Color3.fromRGB(31, 31, 31), Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(218, 218, 218), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
		SportsCar = { Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 204, 116), Paint = Color3.fromRGB(231, 156, 92), Paint2 = Color3.fromRGB(218, 147, 87), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
		SportsCar2 = { Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(216, 216, 216), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(110, 110, 110), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(110, 110, 110) },
		Taxi = { Dark = Color3.fromRGB(31, 31, 31), Glass = Color3.fromRGB(53, 53, 53), Headlight = Color3.fromRGB(231, 165, 100), Paint = Color3.fromRGB(231, 201, 67), TailLight = Color3.fromRGB(231, 86, 77), Trim = Color3.fromRGB(124, 124, 124), Tire = Color3.fromRGB(31, 31, 31), Rim = Color3.fromRGB(124, 124, 124) },
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXCF048B85N"><Properties>
<string name="Name">AmbientConfig</string>

<ProtectedString name="Source"><![CDATA[-- AmbientConfig: trafik ve yaya yapay zekâsının TÜM ayarları ve sınırları (Aşama 6).
-- Saf Lua tablosu (Roblox türü yok): tools/test_ambient.py aynı dosyayı yükler.
-- Birimler: stud, saniye, stud/sn. 1 stud ≈ 0.28 m; hız değerleri ≈ km/s ile aynı ölçektedir.

return {
	Enabled = true,

	-- Simülasyon her oyuncunun KENDİ cihazında, oyuncunun çevresinde çalışır (ağ trafiği yok).
	-- Trafik ışıkları sunucu saatine bağlıdır: tüm oyuncular aynı ışığı görür.
	SimRate = 10, -- Hz: karar/fizik adımı; görüntü her karede ara değerlenir (interpolate)

	Traffic = {
		Enabled = true,
		-- Aynı anda en fazla araç: cihaz sınıfı × Şehir yoğunluğu ayarı (Ayarlar → Grafik). Tablet = dokunmatik ve
		-- ekranın kısa kenarı ≥ 700 px; Mobile = telefon. Gerçek sayı ayrıca saat/bölge yoğunluğu ve kare süresine
		-- göre (uyarlanır kalite) azalır. Workspace.AmbientMaxVehicles bunların hepsini geçersiz kılar (test).
		MaxVehicles = {
			Desktop = { Low = 36, Normal = 64, High = 90 },
			Tablet = { Low = 22, Normal = 38, High = 50 },
			Mobile = { Low = 14, Normal = 26, High = 34 },
		},
		SpawnMin = 90, -- oyuncuya bundan yakın doğmaz (bu yakınlıkta sadece görünmeyen yerde: kamera arkası/bina arkası)
		SpawnMax = 420, -- bundan uzakta doğmaz
		SpawnVisibleMin = 300, -- kameranın gördüğü yerde bundan yakın doğmaz
		DespawnRadius = 480, -- bundan uzaklaşan araç GÖRÜNMÜYORSA havuza döner
		HardDespawnRadius = 680, -- görünse bile bundan uzaktaysa kaldırılır (ufukta küçük nokta)
		SpawnsPerTick = 2, -- hedefin %60'ının altındaysa 3 katı
		SpawnSpeedFactor = 0.75, -- doğan araç yol hızının bu oranıyla başlar (görünmeyen yerde doğar)
		DensityFloor = 0.2, -- bölge/saat yoğunluğu ne kadar düşerse düşsün en az bu oran
		NightFactor = 0.45, -- gece trafiği (gündüz = 1)
		-- Yol sınıfı ağırlığı: doğma olasılığı (şerit uzunluğu × ağırlık) ve dönüş tercihi. Caddeler yoğun, ara
		-- sokaklar seyrek. TurnClassBias: 0 = dönüşte sınıf önemsiz, 1 = tamamen sınıfa göre.
		ClassWeight = { avenue = 1, freeway = 0.8, highway = 0.8, ramp = 0.35, street = 0.2, country = 0.3 },
		TurnClassBias = 0.9,

		-- Sürücü modeli (Intelligent Driver Model). Yaşayan Şehir: daha çevik şehir sürüşü
		MaxAccel = 13, -- stud/sn²  (~3.6 m/s²)
		ComfortDecel = 14, -- stud/sn² (~3.9 m/s²)
		MaxDecel = 36, -- acil fren
		Jerk = 45, -- stud/sn³: ivme artışı sınırı (sarsıntısız kalkış; fren sınırsız)
		StartThreshold = 1.2, -- duran araç bundan küçük ivme için kıpırdamaz (dur-kalk titremesi yok)
		MinGap = 4.5, -- duruşta öndeki araçla mesafe
		Anticipation = 0.35, -- sn: öndeki kalkınca boşluğun açılacağını öngör (kuyruk hızlı çözülür)
		Headway = 1.0, -- sn: takip süresi
		SpeedFactor = { 0.92, 1.08 }, -- sürücüden sürücüye istenen hız / yol hız sınırı
		TurnLateralAccel = 12, -- virajda güvenli hız: v = √(a·r)
		LookAhead = 90, -- öndeki araç/engel arama mesafesi
		ApproachDistance = 30, -- kavşağa bu kadar kala geçiş izni istenir (ve fren mesafesi)
		StopSignWait = 0.6, -- dur levhasında tam duruş süresi
		YieldLookAhead = 45, -- sol dönüş / rampa: karşıdan gelen önceliklilere bakma mesafesi
		LaneChangeAfter = 1.5, -- sn engel arkasında bekleyince yan şeride geç (çok şeritli yolda)
		LaneChangeTime = 1.4,
		RerouteAfter = 4, -- sn çıkış dolu/engelli diye bekleyen araç kavşakta başka yöne döner
		BlockedDespawnAfter = 40, -- sn hiç ilerleyemeyen araç (oyuncudan uzak ve görünmüyorsa) kaldırılır
		LockedAfter = 25, -- sn kavşak izni olup ilerleyemeyen araç (kilit; uzak ve görünmüyorsa) kaldırılır
		IdleWatchdog = 75, -- sn hiç kıpırdamayan araç (uzak ve görünmüyorsa) kaldırılır: son güvenlik ağı
		ObstacleRadius = { Player = 2.5, Vehicle = 4.5, Pedestrian = 1.4 },

		-- Işık: ana yol (cadde/otoyol) fazı MainGreen, kesişen ara sokak SideGreen; eşit sınıfta Green.
		-- WaveSpeed > 0: ana yol boyunca "yeşil dalga" (bu hızla giden araç art arda yeşile denk gelir); 0 = rastgele.
		-- PedClearFactor: yaya, karşı trafiğe yeşil yanana kadar kalan süre geçiş süresinin bu katından uzunsa başlar.
		Signal = { Green = 14, MainGreen = 20, SideGreen = 11, Yellow = 3, AllRed = 1.5, WaveSpeed = 55, PedClearFactor = 0.7 },

		-- Trafikte kullanılacak otomobil modelleri (VehicleDefinitions kimlikleri) ve sıklıkları
		Kinds = {
			{ Id = "sedan_vela", Weight = 5 },
			{ Id = "compact_pico", Weight = 4 },
			{ Id = "suv_terra", Weight = 3 },
			{ Id = "van_porter", Weight = 2 },
			{ Id = "pickup_mesa", Weight = 2 },
			{ Id = "utility_brisa", Weight = 1 },
			{ Id = "sports_rayo", Weight = 1 },
		},
		-- Bölge türüne göre araç karışımı (ağırlık çarpanı; yazılmayan = 1). Ticari: van_porter, utility_brisa.
		-- Taxi: sedan_vela'nın taksi görünüm olasılığı çarpanı (CarModelConfig.TrafficVariants).
		DistrictMix = {
			downtown = { sedan_vela = 1.4, compact_pico = 1.2, van_porter = 1.2, pickup_mesa = 0.4, utility_brisa = 0.8, Taxi = 2.2 },
			industrial = { van_porter = 2.5, utility_brisa = 2.5, pickup_mesa = 2, sedan_vela = 0.6, sports_rayo = 0.3, Taxi = 0.3 },
			residential = { suv_terra = 1.4, compact_pico = 1.3, van_porter = 0.6, utility_brisa = 0.5, Taxi = 0.5 },
			town = { pickup_mesa = 1.4, suv_terra = 1.2, Taxi = 0.5 },
			rural = { pickup_mesa = 3, suv_terra = 1.5, utility_brisa = 1.2, compact_pico = 0.6, sports_rayo = 0.4, Taxi = 0.1 },
			coastal = { sports_rayo = 2.2, suv_terra = 1.2, Taxi = 0.8 },
			resort = { sports_rayo = 2.5, suv_terra = 1.2, van_porter = 0.8, Taxi = 1.5 },
			airport = { van_porter = 1.6, Taxi = 3 },
		},
	},

	Pedestrians = {
		Enabled = true,
		-- cihaz sınıfı × Şehir yoğunluğu (Traffic.MaxVehicles ile aynı kurallar)
		MaxPedestrians = {
			Desktop = { Low = 45, Normal = 80, High = 110 },
			Tablet = { Low = 25, Normal = 45, High = 60 },
			Mobile = { Low = 18, Normal = 30, High = 40 },
		},
		SpawnMin = 45, -- bu yakınlıkta sadece görünmeyen yerde doğar
		SpawnMax = 190,
		SpawnVisibleMin = 140,
		DespawnRadius = 230, -- bundan uzaklaşan yaya GÖRÜNMÜYORSA kaldırılır
		HardDespawnRadius = 320, -- görünse bile bundan uzaktaysa kaldırılır
		FullUpdateRadius = 140, -- bundan uzaktaki (kaldırımdaki) yayada komşu/engel taraması yok (maliyet LOD)
		SpawnsPerTick = 2, -- hedefin %60'ının altındaysa 3 katı
		DensityFloor = 0.1,
		WalkSpeed = { 4.2, 5.8 }, -- stud/sn (~1.2–1.6 m/s)
		WalkAccel = 6, -- stud/sn²: kalkış (≈0.8 sn'de tam hız)
		WalkDecel = 8, -- stud/sn²: yavaşlama (geçit başında / hedefte yumuşak duruş)
		TurnRate = 6, -- rad/sn (~340°/sn): köşede ani dönme yerine kısa bir dönüş
		GoalMinDistance = 70, -- rastgele hedef en az bu kadar uzakta (olduğu yerde dönüp durma)
		CrossPenalty = 30, -- rota: gereksiz karşıya geçme cezası (stud eşdeğeri)
		CrossSpeedFactor = 1.15, -- karşıya geçerken biraz hızlanır
		SidewalkSpread = 2.6, -- kaldırım ortasından en fazla yanal kayma
		PersonalSpace = 2.2, -- yayalar arası en az mesafe
		PlayerAvoidRadius = 4,
		VehicleFleeRadius = 9, -- kaldırıma yaklaşan hızlı araçtan kaçma
		CrossGapRadius = 45, -- ışıksız geçitte bu mesafede araç varken geçme
		CrossWaitGiveUp = 25, -- sn: ışıksız geçitte bekleyip vazgeçme
		GoalRadius = 220, -- hedef seçimi yarıçapı
		-- Bina giriş/çıkış (Shared/Ambient/Entrances: kapı noktaları arsa verisinden; harita değişmez)
		Doors = {
			Enabled = true,
			PauseTime = { 0.5, 1.1 }, -- sn: kapıya dönüp bekleme (DoorApproach), kapı açılır
			EnterTime = 1.5, -- sn: eşikten geçip içeride kaybolma (EnterBuilding)
			ExitTime = 1.5, -- sn: içeriden belirip dışarı çıkma (ExitBuilding)
			Depth = 1.8, -- stud: kapı düzleminin içinde kaybolma/belirme noktası
			GoalMinDistance = 30, -- kapı hedefi en az bu kadar uzakta
			SpawnMinDistance = 15, -- oyuncunun dibindeki kapıdan doğma yok
			-- saat → Goal: yeni hedefin kapı olma olasılığı, Spawn: kapıdan çıkarak doğma olasılığı,
			-- Enter/Exit: kullanım ağırlıkları (Home ev, Work ofis/kule, Shop dükkân/AVM, Hotel otel)
			Schedule = {
				{ From = 0, To = 6, Goal = 0.6, Spawn = 0.2, Enter = { Home = 1, Hotel = 0.6, Shop = 0.05, Work = 0.1 }, Exit = { Home = 0.3, Work = 0.4, Shop = 0.1, Hotel = 0.3 } },
				{ From = 6, To = 9, Goal = 0.45, Spawn = 0.55, Enter = { Work = 1, Shop = 0.4, Home = 0.2, Hotel = 0.2 }, Exit = { Home = 1, Hotel = 0.5, Shop = 0.1, Work = 0.1 } }, -- işe gidiş
				{ From = 9, To = 17, Goal = 0.35, Spawn = 0.45, Enter = { Shop = 1, Work = 0.6, Home = 0.3, Hotel = 0.3 }, Exit = { Shop = 1, Work = 0.6, Home = 0.4, Hotel = 0.3 } },
				{ From = 17, To = 21, Goal = 0.45, Spawn = 0.45, Enter = { Home = 1, Shop = 0.6, Hotel = 0.5, Work = 0.1 }, Exit = { Work = 1, Shop = 0.6, Home = 0.3, Hotel = 0.3 } }, -- eve dönüş
				{ From = 21, To = 24, Goal = 0.6, Spawn = 0.25, Enter = { Home = 1, Hotel = 0.6, Shop = 0.2, Work = 0.05 }, Exit = { Shop = 0.4, Work = 0.3, Home = 0.2, Hotel = 0.3 } },
			},
		},
		AnimateRadius = 90, -- bu mesafeden uzakta uzuv animasyonu yok (ayakta duruş pozu)
		FullAnimateRadius = 45, -- bu mesafe içinde her kare animasyon; 45–90 arası iki karede bir
		-- Gün içi davranış: saat → { yoğunluk, mola olasılığı, mola süresi aralığı }
		Schedule = {
			{ From = 0, To = 5, Density = 0.08, Idle = 0.05, IdleTime = { 3, 6 } },
			{ From = 5, To = 7, Density = 0.3, Idle = 0.1, IdleTime = { 3, 8 } },
			{ From = 7, To = 9, Density = 0.85, Idle = 0.15, IdleTime = { 3, 8 } }, -- sabah işe gidiş
			{ From = 9, To = 12, Density = 0.7, Idle = 0.45, IdleTime = { 8, 20 } }, -- işler, alışveriş
			{ From = 12, To = 14, Density = 1, Idle = 0.6, IdleTime = { 10, 25 } }, -- öğle
			{ From = 14, To = 17, Density = 0.75, Idle = 0.45, IdleTime = { 8, 20 } },
			{ From = 17, To = 20, Density = 0.95, Idle = 0.35, IdleTime = { 6, 18 } }, -- akşam
			{ From = 20, To = 23, Density = 0.45, Idle = 0.25, IdleTime = { 5, 12 } },
			{ From = 23, To = 24, Density = 0.15, Idle = 0.1, IdleTime = { 3, 6 } },
		},
	},

	Debug = {
		DrawRadius = 220, -- hata ayıklama çizimi bu yarıçapta
		RefreshInterval = 0.5,
	},
}
]]></ProtectedString>
