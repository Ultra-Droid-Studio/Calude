	bike_standard_ruta = {
		Type = "Motorcycle", Category = "Standard", DisplayName = "Ruta", Style = "standard",
		Width = 1.7, Length = 6.9, WheelRadius = 1.25, WheelWidth = 0.75, Wheelbase = 5.2, Clearance = 0.6, Travel = 1,
		Mass = 25, MaxSpeed = 120, ReverseSpeed = 8, Accel = 44, Brake = 84, MaxSteer = 26, MinSteer = 5, Grip = 1.45,
		MaxLean = 33, Drive = "RWD",
		Seats = { { X = 0, Z = 0.4, Driver = true }, { X = 0, Z = 2 } },
		Colors = { rgb(60, 70, 60), rgb(140, 110, 80), rgb(40, 44, 52), rgb(150, 30, 40) },
	},
}

function VehicleDefinitions.Get(id: string)
	return VehicleDefinitions.Catalog[id]
end

function VehicleDefinitions.IsMotorcycle(def): boolean
	return def ~= nil and def.Type == "Motorcycle"
end

-- Aşama 2 otomobil fizik modelini kullanan araç mı? (Physics tablosu olan otomobiller)
function VehicleDefinitions.UsesCarPhysics(def): boolean
	return def ~= nil and def.Type == "Car" and def.Physics ~= nil
end

-- Hıza bağlı direksiyon açısı (derece): düşük hızda tam açı, yüksek hızda dar açı
function VehicleDefinitions.SteerAngleAt(def, speed: number): number
	local t = math.clamp(math.abs(speed) / def.MaxSpeed, 0, 1)
	return def.MaxSteer + (def.MinSteer - def.MaxSteer) * t
end

-- Stud/sn → gösterge km/s (1 stud ≈ 0.28 m varsayımı)
function VehicleDefinitions.ToKmh(studsPerSecond: number): number
	return studsPerSecond * VehicleDefinitions.MetersPerStud * 3.6
end

return VehicleDefinitions
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXD3D9CBEEN"><Properties>
<string name="Name">VehiclePhysics</string>

<ProtectedString name="Source"><![CDATA[-- VehiclePhysics: otomobil fizik modelinin formülleri (Aşama 2). Saf hesap; Instance yaratmaz.
-- Sunucu (VehicleFactory: yay, balast, kaldırma kuvvetleri) ve istemci (CarPhysics: motor, fren, lastik)
-- AYNI formülleri buradan kullanır. tools/car_model.py bu dosyanın çevrimdışı aynasıdır.

local VehicleDefinitions = require(script.Parent.VehicleDefinitions)

local VehiclePhysics = {}

local C = VehicleDefinitions.CarPhysics
local MPS = VehicleDefinitions.MetersPerStud

VehiclePhysics.Constants = C

-- Bir otomobil tanımından türetilen sabitler (önbelleğe alınır; her araç için bir kez)
local cache: { [any]: any } = {}

function VehiclePhysics.Derive(def)
	local cached = cache[def]
	if cached then
		return cached
	end
	local p = def.Physics
	local g = C.EffectiveGravity
	local hz = def.Wheelbase / 2
	local wf = p.WeightFront
	local d = {}

	-- Süspansiyon (kütleye ORANSAL değerler; gerçek sertlik = oran × yaylı kütle)
	local omegaF = 2 * math.pi * p.SpringHzFront
	local omegaR = 2 * math.pi * p.SpringHzRear
	d.CornerFracFront = wf / 2
	d.CornerFracRear = (1 - wf) / 2
	d.SagFront = g / (omegaF * omegaF) -- statik çökme (stud)
	d.SagRear = g / (omegaR * omegaR)
	d.StiffnessPerMassFront = d.CornerFracFront * omegaF * omegaF
	d.StiffnessPerMassRear = d.CornerFracRear * omegaR * omegaR
	-- c = 2ζ√(k·m) = 2ζ·m_köşe·ω
	d.DampingPerMassFront = 2 * p.Damping * d.CornerFracFront * omegaF
	d.DampingPerMassRear = 2 * p.Damping * d.CornerFracRear * omegaR
	d.BumpRoom = C.BumpFraction * def.Travel -- sürüş yüksekliğinin üstündeki kurs
	d.DroopRoom = def.Travel - d.BumpRoom

	-- Ağırlık dağılımı: kütle merkezinin Z konumu (ön = -Z) ve balastın yeri
	local comZ = hz * (1 - 2 * wf)
	d.BallastZ = math.clamp(comZ / C.BallastFraction, -hz * 0.95, hz * 0.95)

	-- Motor: özgül güç (stud²/sn³), hız tavanı, sürtünme
	d.SpecificPower = p.PowerKW * 1000 / p.MassKg / (MPS * MPS)
	d.TopSpeed = def.MaxSpeed * 1.03
	d.RollingAccel = C.RollingResistance * g
	d.DragPerSpeed2 = math.max((d.SpecificPower / d.TopSpeed - d.RollingAccel) / (d.TopSpeed * d.TopSpeed), 0)
	d.LaunchAccel = p.LaunchG * g
	d.BrakeAccel = p.BrakeG * g
	d.HandbrakeAccel = p.HandbrakeG * g
	d.EngineBrakeAccel = C.EngineBrakeG * g
	d.ReverseAccel = C.ReverseG * g
	d.ReverseSpeed = def.ReverseSpeed * C.ReverseSpeed
	d.DownforcePerSpeed2 = p.DownforceAt100 * g / (100 * 100)
	d.GearTops = table.create(p.Gears)
	for i = 1, p.Gears do
		d.GearTops[i] = d.TopSpeed * (i / p.Gears) ^ C.GearSpread
	end

	-- Yanal sınır (direksiyon sınırı ve denge yardımı hedefi)
	d.LateralLimit = p.TireGrip * g * p.LatLimitScale

	cache[def] = d
	return d
end

-- Vites içindeki devir oranına (0..1) göre güç çarpanı: düşük devirde ~0.78, kırmızı çizgide 1.0
function VehiclePhysics.PowerFactor(rpmNorm: number): number
	local r = math.clamp(rpmNorm, 0.25, 1)
	return 0.55 + 0.9 * r - 0.45 * r * r
end

-- Tam gazda tekerlere ulaşan çekiş ivmesi (stud/sn²): kalkışta LaunchAccel, sonra güçle sınırlı
function VehiclePhysics.DriveAccel(d, speed: number, gear: number): number
	local top = d.GearTops[gear]
	local powerLimited = d.SpecificPower * VehiclePhysics.PowerFactor(speed / top) / math.max(speed, 1)
	return math.min(d.LaunchAccel, powerLimited)
end

-- Hıza bağlı azami direksiyon açısı (derece): yanal tutuş sınırını aşmayacak geometri + kayma payı
function VehiclePhysics.SteerLimit(def, d, speed: number): number
	local v = math.max(speed, 1)
	local geometric = math.deg(math.atan(def.Wheelbase * d.LateralLimit / (v * v)))
	return math.min(def.MaxSteer, geometric + def.Physics.SlipAllowanceDeg)
end

-- Zemin malzemesi → tutuş ve yuvarlanma direnci çarpanı
local SURFACE = {
	[Enum.Material.Asphalt] = { 1.0, 1.0 },
	[Enum.Material.Concrete] = { 0.97, 1.0 },
	[Enum.Material.Pavement] = { 0.95, 1.1 },
	[Enum.Material.Brick] = { 0.9, 1.2 },
	[Enum.Material.Cobblestone] = { 0.85, 1.5 },
	[Enum.Material.SmoothPlastic] = { 0.92, 1.0 },
	[Enum.Material.Plastic] = { 0.92, 1.0 },
	[Enum.Material.Metal] = { 0.8, 1.0 },
	[Enum.Material.DiamondPlate] = { 0.85, 1.1 },
	[Enum.Material.WoodPlanks] = { 0.85, 1.3 },
	[Enum.Material.Wood] = { 0.85, 1.3 },
	[Enum.Material.Marble] = { 0.8, 1.0 },
	[Enum.Material.Granite] = { 0.88, 1.1 },
	[Enum.Material.Slate] = { 0.86, 1.2 },
	[Enum.Material.Rock] = { 0.82, 1.6 },
	[Enum.Material.Basalt] = { 0.84, 1.5 },
	[Enum.Material.Grass] = { 0.62, 3.0 },
	[Enum.Material.LeafyGrass] = { 0.6, 3.2 },
	[Enum.Material.Ground] = { 0.6, 3.0 },
	[Enum.Material.Mud] = { 0.42, 5.0 },
	[Enum.Material.Sand] = { 0.5, 6.0 },
	[Enum.Material.Snow] = { 0.35, 4.0 },
	[Enum.Material.Ice] = { 0.15, 1.0 },
	[Enum.Material.Glacier] = { 0.2, 1.0 },
}
local DEFAULT_SURFACE = { 0.9, 1.2 }

function VehiclePhysics.Surface(material: Enum.Material?): ({ number })
	return material and SURFACE[material] or DEFAULT_SURFACE
end

-- Otomobilin yere oturduğunda şasi merkezinin zeminden yüksekliği (doğurma için)
function VehiclePhysics.CarRideHeight(def): number
	return 1 / 2 + def.Clearance
end

return VehiclePhysics
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXC8F620B0N"><Properties>
<string name="Name">SettingsSchema</string>

<ProtectedString name="Source"><![CDATA[-- SettingsSchema: oyuncu ayarlarının TEK tanımı (Aşama 1).
-- İstemci (SettingsController + ayarlar ekranı) bugün kullanır; kalıcı kayıt aşamasında sunucudaki
-- veri servisi AYNI şemayla doğrulayacak. Yeni ayar = buraya bir satır + Strings'te etiket.
--
-- Tipler:
--   boolean                          Default
--   number   Min, Max, Step          Default (Step'e yuvarlanır, aralığa sıkıştırılır)
--   enum     Options = { değerler }   Default (sadece listedeki değerler)

local Constants = require(script.Parent.Constants)

local SettingsSchema = {}

SettingsSchema.Version = 1

-- Ayarlar ekranındaki sekme sırası
SettingsSchema.Categories = { "Graphics", "Camera", "Audio", "Controls" }

SettingsSchema.Definitions = {
	-- ===== Grafik (yerel; Roblox'un kendi grafik kalitesi Esc menüsünden ayarlanır) =====
	{ Key = "VisualEffects", Category = "Graphics", Type = "boolean", Default = true },
	{ Key = "Shadows", Category = "Graphics", Type = "boolean", Default = true },
	{ Key = "ReduceMotion", Category = "Graphics", Type = "boolean", Default = false },
	-- Yaşayan Şehir: NPC araç/yaya bütçesi (AmbientController; cihaz sınıfına göre AmbientConfig'teki sayılar)
	{ Key = "CityDensity", Category = "Graphics", Type = "enum", Options = { "Low", "Normal", "High" }, Default = "Normal" },

	-- ===== Kamera (CameraController her karede okur) =====
	{ Key = "CameraMode", Category = "Camera", Type = "enum", Options = Constants.PlayerSelectableCameraModes, Default = "ThirdPerson" },
	{ Key = "CameraSensitivity", Category = "Camera", Type = "number", Min = 0.2, Max = 3, Step = 0.1, Default = 1 },
	{ Key = "InvertY", Category = "Camera", Type = "boolean", Default = false },
	{ Key = "FieldOfViewOffset", Category = "Camera", Type = "number", Min = -10, Max = 15, Step = 1, Default = 0 },
	{ Key = "ShoulderSide", Category = "Camera", Type = "enum", Options = { 1, -1 }, Default = 1 },
	{ Key = "CameraSmoothing", Category = "Camera", Type = "boolean", Default = true },

	-- ===== Ses (SoundGroup hacimleri; AudioController uygular) =====
	{ Key = "MasterVolume", Category = "Audio", Type = "number", Min = 0, Max = 1, Step = 0.05, Default = 1 },
	{ Key = "VehicleVolume", Category = "Audio", Type = "number", Min = 0, Max = 1, Step = 0.05, Default = 1 },
	{ Key = "WorldVolume", Category = "Audio", Type = "number", Min = 0, Max = 1, Step = 0.05, Default = 1 },
	{ Key = "InterfaceVolume", Category = "Audio", Type = "number", Min = 0, Max = 1, Step = 0.05, Default = 0.8 },

	-- ===== Kontroller =====
	{ Key = "MobileButtonScale", Category = "Controls", Type = "enum", Options = { 0.85, 1, 1.2 }, Default = 1 },
	{ Key = "MobileSteering", Category = "Controls", Type = "enum", Options = { "Pad", "Buttons" }, Default = "Pad" },
}

local byKey = {}
for index, def in SettingsSchema.Definitions do
	def.Order = index
	byKey[def.Key] = def
end

function SettingsSchema.Get(key: string)
	return byKey[key]
end

function SettingsSchema.GetByCategory(category: string)
	local list = {}
	for _, def in SettingsSchema.Definitions do
		if def.Category == category then
			table.insert(list, def)
		end
	end
	return list
end

function SettingsSchema.Defaults(): { [string]: any }
	local values = {}
	for _, def in SettingsSchema.Definitions do
		values[def.Key] = def.Default
	end
	return values
end

-- Değeri şemaya uydurur. Geçersizse nil döner (çağıran reddeder).
function SettingsSchema.Normalize(key: string, value: any): any
	local def = byKey[key]
	if not def then
		return nil
	end
	if def.Type == "boolean" then
		return if type(value) == "boolean" then value else nil
	elseif def.Type == "number" then
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return nil
		end
		local clamped = math.clamp(value, def.Min, def.Max)
		if def.Step then
			clamped = def.Min + math.floor((clamped - def.Min) / def.Step + 0.5) * def.Step
			clamped = math.clamp(clamped, def.Min, def.Max)
			-- kayan nokta gürültüsünü temizle (0.30000000004 → 0.3)
			clamped = math.floor(clamped * 1000 + 0.5) / 1000
		end
		return clamped
	elseif def.Type == "enum" then
		return if table.find(def.Options, value) then value else nil
	end
	return nil
end

function SettingsSchema.IsValid(key: string, value: any): boolean
	local normalized = SettingsSchema.Normalize(key, value)
	return normalized ~= nil and normalized == value
end

-- Dışarıdan gelen (ör. kayıttan okunan) tabloyu temizler: bilinmeyen/geçersiz alanlar atılır.
function SettingsSchema.Sanitize(data: any): { [string]: any }
	local clean = {}
	if type(data) ~= "table" then
		return clean
	end
	for key, value in data do
		if type(key) == "string" then
			local normalized = SettingsSchema.Normalize(key, value)
			if normalized ~= nil then
				clean[key] = normalized
			end
		end
	end
	return clean
end

return SettingsSchema
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXABA7B410N"><Properties>
<string name="Name">Navigation</string>

<ProtectedString name="Source"><![CDATA[-- Navigation: yol ağı üzerinde rota hesabı ve rota takibi (GPS). SAF modül; Instance kullanmaz.
--
-- TEK koordinat kaynağı: MapDefinitions (MapData'nın düğüm ve yolları). Burada yeni bir koordinat sistemi
-- yoktur; noktalar dünya stud'udur (X, Y, Z alanları olan her şey: Vector3 ya da { X=, Y=, Z= }).
--
--   nav = Navigation.new(MapDefinitions.GetData())
--   route, reason = nav:FindRoute(fromPos, toPos)      -- reason: "NoRoadNearStart" | "Unreachable"
--   progress = Navigation.Progress(route, position, hintIndex)
--
-- Kurallar:
--   * Rotalar sadece yollardan geçer; tek yönlü yollarda (rampa) yön kurallarına uyulur (LanesForward/Backward).
--   * Başlangıç/hedef en yakın yol parçasına "oturtulur" (yükseklik farkı cezalı: otoyolun altındaki sokak seçilir).
--   * Hedef yoldan uzaksa rota en yakın yol noktasına gider ve "Offroad" işaretlenir (son kısım düz çizgi).
--   * Ulaşılamayan hedefte nil + sebep döner; çağıran oyuncuya bildirir, çökmez.
--
-- Bu dosya bilerek "düz Lua" alt kümesiyle yazıldı; tools/test_navigation.py onu gerçek MapData ile
-- bir Lua yorumlayıcısında test eder.

local Navigation = {}
Navigation.__index = Navigation

local CELL = 256 -- uzamsal ızgara hücresi (stud)
local VERTICAL_PENALTY = 1.5 -- yükseklik farkının yatay mesafeye çarpanı (köprü/otoyol ayrımı)
local ABOVE_PENALTY = 6 -- oyuncunun çok ÜSTÜNDEKİ yol (otoyol tabliyesi) oradan erişilemez: ağır ceza
local ABOVE_MARGIN = 6 -- stud: bu kadardan fazla yukarıdaki yol "üstte" sayılır
local MAX_SNAP_RINGS = 10 -- en fazla ~2.5 km uzaktaki yola oturtulur
Navigation.OffroadDistance = 120 -- hedef yola bundan uzaksa "Offroad"

-- Luau: math.atan2(y, x). Lua 5.3+: math.atan(y, x). İkisinde de çalışsın (test yorumlayıcısı).
local atan2 = math.atan2 or math.atan

local function sqrt(x)
	return math.sqrt(x)
end

local function cellKey(cx, cz)
	return cx * 100000 + cz
end

-- ===== Kurulum =====
function Navigation.new(data)
	local self = setmetatable({}, Navigation)
	self.Nodes = {}
	self.Edges = {}
	self.Grid = {}
	self.Stamp = 0
	self.MaxSpeed = 1
	for id, n in pairs(data.Nodes) do
		local p = n.Position
		self.Nodes[id] = { Id = id, X = p.X, Y = p.Y, Z = p.Z, Out = {} }
	end
	for _, e in ipairs(data.EdgeList) do
		local a, b = self.Nodes[e.A], self.Nodes[e.B]
		if a and b then
			local dx, dy, dz = b.X - a.X, b.Y - a.Y, b.Z - a.Z
			local length = sqrt(dx * dx + dy * dy + dz * dz)
			local speed = math.max(e.Speed or 50, 20)
			if speed > self.MaxSpeed then
				self.MaxSpeed = speed
			end
			local rec = {
				Id = e.Id, A = a, B = b, Length = length, Speed = speed, Name = e.Name or "",
				Forward = (e.LanesForward or 1) > 0, Backward = (e.LanesBackward or 1) > 0,
				Width = e.Width or 20, Kind = e.Kind, Stamp = 0,
			}
			table.insert(self.Edges, rec)
			-- maliyet = süre (uzunluk / hız): ana yollar tercih edilir
			if rec.Forward then
				table.insert(a.Out, { To = b, Edge = rec, Cost = length / speed })
			end
			if rec.Backward then
				table.insert(b.Out, { To = a, Edge = rec, Cost = length / speed })
			end
			-- ızgaraya ekle (kenarın kapsadığı tüm hücreler)
			local pad = rec.Width / 2
			local x0 = math.floor((math.min(a.X, b.X) - pad) / CELL)
			local x1 = math.floor((math.max(a.X, b.X) + pad) / CELL)
			local z0 = math.floor((math.min(a.Z, b.Z) - pad) / CELL)
			local z1 = math.floor((math.max(a.Z, b.Z) + pad) / CELL)
			for cx = x0, x1 do
				for cz = z0, z1 do
					local key = cellKey(cx, cz)
					local list = self.Grid[key]
					if not list then
						list = {}
						self.Grid[key] = list
					end
					table.insert(list, rec)
				end
			end
		end
	end
	return self
end

-- ===== En yakın yol noktası =====
local function projectOnEdge(e, x, y, z)
	local ax, az = e.A.X, e.A.Z
	local dx, dz = e.B.X - ax, e.B.Z - az
	local len2 = dx * dx + dz * dz
	local t = 0
	if len2 > 1e-6 then
		t = ((x - ax) * dx + (z - az) * dz) / len2
		if t < 0 then
			t = 0
		elseif t > 1 then
			t = 1
		end
	end
	local px, pz = ax + dx * t, az + dz * t
	local py = e.A.Y + (e.B.Y - e.A.Y) * t
	local hx, hz = x - px, z - pz
	local horizontal = sqrt(hx * hx + hz * hz)
	local rise = py - y
	local penalty = VERTICAL_PENALTY
	if rise > ABOVE_MARGIN then
		penalty = ABOVE_PENALTY
	end
	return t, px, py, pz, horizontal + math.abs(rise) * penalty, horizontal
end

-- Döndürür: { Edge, T, X, Y, Z, Distance (cezalı), Horizontal } ya da nil
function Navigation:Snap(position)
	local x, y, z = position.X, position.Y, position.Z
	local cx, cz = math.floor(x / CELL), math.floor(z / CELL)
	self.Stamp = self.Stamp + 1
	local stamp = self.Stamp
	local best = nil
	for ring = 0, MAX_SNAP_RINGS do
		for ix = cx - ring, cx + ring do
			for iz = cz - ring, cz + ring do
				if math.abs(ix - cx) == ring or math.abs(iz - cz) == ring then
					local list = self.Grid[cellKey(ix, iz)]
					if list then
						for _, e in ipairs(list) do
							if e.Stamp ~= stamp then
								e.Stamp = stamp
								local t, px, py, pz, d, h = projectOnEdge(e, x, y, z)
								if not best or d < best.Distance then
									best = { Edge = e, T = t, X = px, Y = py, Z = pz, Distance = d, Horizontal = h }
								end
							end
						end
					end
				end
			end
		end
		-- Bu halkadaki en kötü durumdaki nokta bile daha uzaksa aramayı bitir
		if best and best.Distance < ring * CELL then
			break
		end
	end
	return best
end

-- ===== İkili yığın (A* açık liste) =====
local function heapPush(heap, item, priority)
	local n = #heap + 1
	heap[n] = { Item = item, P = priority }
	while n > 1 do
		local parent = math.floor(n / 2)
		if heap[parent].P <= heap[n].P then
			break
		end
		heap[parent], heap[n] = heap[n], heap[parent]
		n = parent
	end
end

local function heapPop(heap)
	local count = #heap
	if count == 0 then
		return nil
	end
	local top = heap[1]
	heap[1] = heap[count]
	heap[count] = nil
	count = count - 1
	local n = 1
	while true do
		local l, r = n * 2, n * 2 + 1
		local smallest = n
		if l <= count and heap[l].P < heap[smallest].P then
			smallest = l
		end
		if r <= count and heap[r].P < heap[smallest].P then
			smallest = r
		end
		if smallest == n then
			break
		end
		heap[smallest], heap[n] = heap[n], heap[smallest]
		n = smallest
	end
	return top.Item, top.P
end

-- ===== Rota =====
local function point(x, y, z)
	return { X = x, Y = y, Z = z }
end

-- Başlangıç noktasından kenar uçlarına çıkış seçenekleri (tek yön kuralına uyarak)
local function exitsFrom(snap)
	local e, list = snap.Edge, {}
	if e.Forward then
		table.insert(list, { Node = e.B, Cost = (1 - snap.T) * e.Length / e.Speed })
	end
	if e.Backward then
		table.insert(list, { Node = e.A, Cost = snap.T * e.Length / e.Speed })
	end
	return list
end

-- Hedef kenara hangi uçtan girilebilir: düğüm → (kalan maliyet)
local function entriesTo(snap)
	local e, map = snap.Edge, {}
	if e.Forward then
		map[e.A] = snap.T * e.Length / e.Speed -- A'dan B yönüne gidip hedefte dur
	end
	if e.Backward then
		map[e.B] = (1 - snap.T) * e.Length / e.Speed
	end
	return map
end

function Navigation:FindRoute(from, to)
	local s = self:Snap(from)
	if not s then
		return nil, "NoRoadNearStart"
	end
	local g = self:Snap(to)
	if not g then
		return nil, "Unreachable"
	end
	local offroad = g.Horizontal > Navigation.OffroadDistance

	-- Aynı yol parçası ve izin verilen yönde → doğrudan
	if s.Edge == g.Edge then
		local e = s.Edge
		if (g.T >= s.T and e.Forward) or (g.T <= s.T and e.Backward) then
			return self:_build({ point(s.X, s.Y, s.Z), point(g.X, g.Y, g.Z) }, { e.Name }, to, offroad)
		end
	end

	local targets = entriesTo(g)
	local maxSpeed = self.MaxSpeed
	local function h(node)
		local dx, dz = g.X - node.X, g.Z - node.Z
		return sqrt(dx * dx + dz * dz) / maxSpeed
	end
	local cost, came, closed = {}, {}, {}
	local heap = {}
	for _, exit in ipairs(exitsFrom(s)) do
		if not cost[exit.Node] or exit.Cost < cost[exit.Node] then
			cost[exit.Node] = exit.Cost
			came[exit.Node] = { Edge = s.Edge }
			heapPush(heap, exit.Node, exit.Cost + h(exit.Node))
		end
	end
	local bestGoal, bestTotal = nil, math.huge
	while true do
		local node = heapPop(heap)
		if not node then
			break
		end
		if not closed[node] then
			closed[node] = true
			local base = cost[node]
			if base + h(node) >= bestTotal then
				break -- daha iyi bir çözüm kalmadı
			end
			local finish = targets[node]
			if finish and base + finish < bestTotal then
				bestTotal = base + finish
				bestGoal = node
			end
			for _, arc in ipairs(node.Out) do
				local next = arc.To
				local c = base + arc.Cost
				if not closed[next] and (not cost[next] or c < cost[next]) then
					cost[next] = c
					came[next] = { From = node, Edge = arc.Edge }
					heapPush(heap, next, c + h(next))
				end
			end
		end
	end
	if not bestGoal then
		return nil, "Unreachable"
	end

	-- Geri izle
	local nodes, names = {}, {}
	local n = bestGoal
	while n do
		table.insert(nodes, 1, n)
		local c = came[n]
		table.insert(names, 1, c and c.Edge.Name or "")
		n = c and c.From or nil
	end
	local points = { point(s.X, s.Y, s.Z) }
	local segmentNames = {}
	for i, node in ipairs(nodes) do
		table.insert(points, point(node.X, node.Y, node.Z))
		table.insert(segmentNames, names[i])
	end
	table.insert(points, point(g.X, g.Y, g.Z))
	table.insert(segmentNames, g.Edge.Name)
	return self:_build(points, segmentNames, to, offroad)
end

-- Lua 5.1 uyumlu üçlü seçim (Luau if-ifadesi düz Lua'da yok)
local function choose(condition, a, b)
	if condition then
		return a
	end
	return b
end

-- ===== Rota nesnesi + yönlendirme =====
-- segmentNames[i]: points[i] → points[i+1] parçasının sokak adı
function Navigation:_build(points, segmentNames, destination, offroad)
	-- art arda çok yakın noktaları birleştir (titrek yönlendirme olmasın)
	local clean, cleanNames = { points[1] }, {}
	for i = 2, #points do
		local p, q = clean[#clean], points[i]
		local dx, dz = q.X - p.X, q.Z - p.Z
		if dx * dx + dz * dz > 1 or i == #points then
			table.insert(clean, q)
			table.insert(cleanNames, segmentNames[i - 1] or "")
		end
	end
	if #clean < 2 then
		table.insert(clean, points[#points])
		table.insert(cleanNames, segmentNames[#segmentNames] or "")
	end
	local cum = { 0 }
	for i = 2, #clean do
		local p, q = clean[i - 1], clean[i]
		local dx, dy, dz = q.X - p.X, q.Y - p.Y, q.Z - p.Z
		cum[i] = cum[i - 1] + sqrt(dx * dx + dy * dy + dz * dz)
	end
	local route = {
		Points = clean,
		Names = cleanNames,
		Cum = cum,
		Length = cum[#cum],
		Offroad = offroad == true,
		Destination = point(destination.X, destination.Y, destination.Z),
		Maneuvers = {},
	}
	-- Dönüşler: (y ekseni ekranda aşağı) çapraz çarpım > 0 → saat yönü → SAĞ
	for i = 2, #clean - 1 do
		local a, b, c = clean[i - 1], clean[i], clean[i + 1]
		local ux, uz = b.X - a.X, b.Z - a.Z
		local vx, vz = c.X - b.X, c.Z - b.Z
		local lu, lv = sqrt(ux * ux + uz * uz), sqrt(vx * vx + vz * vz)
		if lu > 0.5 and lv > 0.5 then
			local cross = (ux * vz - uz * vx) / (lu * lv)
			local dot = (ux * vx + uz * vz) / (lu * lv)
			local angle = math.deg(atan2(cross, dot)) -- + sağ, - sol
			local abs = math.abs(angle)
			local kind = nil
			if abs >= 150 then
				kind = "UTurn"
			elseif abs >= 60 then
				kind = choose(angle > 0, "Right", "Left")
			elseif abs >= 25 then
				kind = choose(angle > 0, "SlightRight", "SlightLeft")
			elseif cleanNames[i] ~= cleanNames[i - 1] and cleanNames[i] ~= "" then
				kind = "Continue" -- yön aynı, yol adı değişiyor
			end
			if kind then
				table.insert(route.Maneuvers, { Index = i, Type = kind, Angle = angle, Street = cleanNames[i] or "", Distance = cum[i] })
			end
		end
	end
	table.insert(route.Maneuvers, { Index = #clean, Type = "Arrive", Angle = 0, Street = "", Distance = route.Length })
	return route
end

-- ===== Takip =====
-- Döndürür: { Segment, Along (rota başından mesafe), Remaining, Deviation (rotadan sapma), Next (sonraki
-- manevra), NextDistance, NextIndex }. hint: önceki Segment (aramayı yakın çevreyle sınırlar)
function Navigation.Progress(route, position, hint)
	local points, cum = route.Points, route.Cum
	local x, y, z = position.X, position.Y, position.Z
	local first, last = 1, #points - 1
	if hint then
		first = math.max(1, hint - 2)
		last = math.min(#points - 1, hint + 12)
	end
	local bestSeg, bestD, bestAlong = nil, math.huge, 0
	for i = first, last do
		local a, b = points[i], points[i + 1]
		local dx, dz = b.X - a.X, b.Z - a.Z
		local len2 = dx * dx + dz * dz
		local t = 0
		if len2 > 1e-6 then
			t = ((x - a.X) * dx + (z - a.Z) * dz) / len2
			if t < 0 then
				t = 0
			elseif t > 1 then
				t = 1
			end
		end
		local px, pz = a.X + dx * t, a.Z + dz * t
		local py = a.Y + (b.Y - a.Y) * t
		local hx, hz = x - px, z - pz
		local d = sqrt(hx * hx + hz * hz) + math.abs(y - py) * VERTICAL_PENALTY * 0.5
		if d < bestD then
			bestD = d
			bestSeg = i
			bestAlong = cum[i] + (cum[i + 1] - cum[i]) * t
		end
	end
	if hint and bestD > 60 then
		-- yakın pencerede bulunamadı (ışınlanma vb.): tüm rotada ara
		return Navigation.Progress(route, position, nil)
	end
	local nextManeuver = nil
	for _, m in ipairs(route.Maneuvers) do
		if m.Distance > bestAlong + 1 then
			nextManeuver = m
			break
		end
	end
	if not nextManeuver then
		nextManeuver = route.Maneuvers[#route.Maneuvers]
	end
	return {
		Segment = bestSeg or 1,
		Along = bestAlong,
		Remaining = math.max(route.Length - bestAlong, 0),
		Deviation = bestD,
		Next = nextManeuver,
		NextDistance = math.max(nextManeuver.Distance - bestAlong, 0),
	}
end

return Navigation
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5FFEACDAN"><Properties>
<string name="Name">MapView</string>

<ProtectedString name="Source"><![CDATA[-- MapView: minimap, tam harita ve GPS'in ortak görünüm hesapları (saf matematik, Instance yok).
-- tools/test_map_view.py bu dosyayı doğrudan çalıştırır; bu yüzden tip açıklaması kullanılmaz.
--
-- Kural: harita tuvalinin konumu, tuvale UYGULANAN ölçekle hesaplanır. Eskiden ölçek (UIScale) sadece %1 değişince
-- güncellenip konum her seferinde yeni ölçekle hesaplanıyordu; araçta (hıza bağlı yakınlık) harita merkezi oyuncudan
-- 100 stud'a kadar kayıyor, eşik aşılınca geri zıplıyordu.

local MapView = {}

local function round(x)
	return math.floor(x + 0.5)
end

-- Tuval kökünün görüntü alanındaki konumu (tam birime yuvarlanır: harita bütün olarak kayar, parçalar birbirine göre
-- oynamaz). Dünya noktası (cx, cz), görüntü alanının merkezine düşer (en fazla 0.5 birim hata).
function MapView.RootOffset(cx, cz, scale, viewportX, viewportY, half)
	return round(viewportX / 2 - (cx + half) * scale), round(viewportY / 2 - (cz + half) * scale)
end

-- Uygulanan yakınlık: hedeften `step` (oran) kadar uzaklaşınca hedefe geçer. Böylece binlerce harita parçasının
-- yeniden yerleşimi her karede değil, birkaç yüzde birlik adımlarda olur. Konum hatası oluşturmaz (konum her zaman
-- uygulanan ölçekle hesaplanır).
function MapView.ZoomStep(applied, target, step)
	if applied == nil or applied <= 0 or math.abs(target - applied) > applied * step then
		return target
	end
	return applied
end

-- Kuzey = 0°, doğu (+X) = 90°. Bakış vektörünün yatay bileşeni çok küçükse (araç dikleşmiş/devrilmiş) yön
-- tanımsızdır: son geçerli yön korunur (eskiden ok rastgele yönlere dönüyordu).
MapView.MinHorizontal = 0.3
function MapView.Heading(lookX, lookZ, last)
	if math.sqrt(lookX * lookX + lookZ * lookZ) < MapView.MinHorizontal then
		return last or 0
	end
	return math.deg(math.atan2(lookX, -lookZ))
end

-- İki açı arasındaki en kısa fark (derece, -180..180)
function MapView.AngleDelta(a, b)
	return (a - b + 180) % 360 - 180
end

return MapView
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX59126120N"><Properties>
<string name="Name">CarModelKit</string>

<ProtectedString name="Source"><![CDATA[-- CarModelKit: içe aktarılan 3D otomobil modellerini (CarModelConfig) araçlara giydirir.
-- Sunucu (oyuncu araçları, VehicleFactory) ve istemci (NPC trafiği, TrafficRenderer) aynı modülü kullanır.
--
-- Kalibrasyon (model başına bir kez): Studio'nun içe aktarıcısı yönü/birimi nasıl yorumlarsa yorumlasın, modelin
-- KENDİ tekerlekleri ölçülür:
--   ön = ön teker ortası − arka teker ortası,  sağ = sağ tekerler − sol tekerler,  yukarı = sağ × ön,
--   orijin = dört teker merkezinin ortası (teker merkezi yüksekliğinde).
-- Her parça bu çerçeveye göre saklanır; giydirirken hedef çerçeveye ölçekle yerleştirilir.
-- Görsel parçalar kütlesiz, çarpışmasız ve ışın sorgusuna kapalıdır (fizik ve kamera etkilenmez).
-- Tekerlek görselleri Motor6D ile bağlanır: dönüş (spin) Motor6D.Transform ile istemcide oynatılır.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarModelConfig"))

local CarModelKit = {}

local WHEELS = { "FL", "FR", "RL", "RR" }
local cache: { [string]: any } = {}
local warned: { [string]: boolean } = {}

local function warnOnce(key: string, ...)
	if not warned[key] then
		warned[key] = true
		warn("[CarModelKit]", ...)
	end
end

-- Parça adı → rol ve (tekerlekse) hangi teker. İçe aktarıcının eklediği önek/sonekleri tolere eder.
local function roleOf(name: string, modelName: string): (string?, string?)
	local n = name
	if string.sub(n, 1, #modelName + 1) == modelName .. "_" then
		n = string.sub(n, #modelName + 2)
	end
	local wheel, kind = string.match(n, "^Wheel_(%u%u)_(%a+)")
	if wheel then
		return kind, wheel
	end
	local role = string.match(n, "^(%a+%d?)")
	if role and Config.Roles[role] then
		return role, nil
	end
	return nil, nil
end

-- Model hazır mı? (ReplicatedStorage.<Folder>.<name> var ve kalibre edilebiliyor)
function CarModelKit.Get(name: string)
	local cached = cache[name]
	if cached ~= nil then
		return cached or nil
	end
	local folder = ReplicatedStorage:FindFirstChild(Config.Folder)
	local model = folder and folder:FindFirstChild(name)
	if not model then
		return nil
	end
	local entries = {}
	local wheelParts = { FL = {}, FR = {}, RL = {}, RR = {} }
	local tires = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local role, wheel = roleOf(d.Name, name)
			if role then
				table.insert(entries, { Template = d, Role = role, Wheel = wheel })
				if wheel then
					table.insert(wheelParts[wheel], d)
					if role == "Tire" then
						tires[wheel] = d
					end
				end
			end
		end
	end
	for _, w in WHEELS do
		if #wheelParts[w] == 0 then
			warnOnce(name, name, "modelinde Wheel_" .. w .. "_* parçası yok; kutu görünüm kullanılacak.")
			cache[name] = false
			return nil
		end
	end
	local centers = {}
	for _, w in WHEELS do
		local sum = Vector3.zero
		for _, p in wheelParts[w] do
			sum += p.Position
		end
		centers[w] = sum / #wheelParts[w]
	end
	local front = ((centers.FL + centers.FR) - (centers.RL + centers.RR)) / 2
	local right = ((centers.FR - centers.FL) + (centers.RR - centers.RL)) / 2
	if front.Magnitude < 1e-3 or right.Magnitude < 1e-3 then
		warnOnce(name, name, "modelinin tekerlek konumları okunamadı.")
		cache[name] = false
		return nil
	end
	local f = front.Unit
	local r = (right - f * right:Dot(f)).Unit
	local up = r:Cross(f).Unit
	local origin = (centers.FL + centers.FR + centers.RL + centers.RR) / 4
	local frame = CFrame.fromMatrix(origin, r, up) -- LookVector = ön
	local tire = tires.FL or wheelParts.FL[1]
	local radius = math.max(tire.Size.X, tire.Size.Y, tire.Size.Z) / 2
	local roof, minZ, maxZ, maxX = -math.huge, math.huge, -math.huge, 0
	for _, e in entries do
		e.Offset = frame:ToObjectSpace(e.Template.CFrame)
		if e.Wheel then
			e.Center = frame:PointToObjectSpace(centers[e.Wheel])
		end
		local half = e.Template.Size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local c = e.Offset * Vector3.new(sx * half.X, sy * half.Y, sz * half.Z)
					if not e.Wheel then
						roof = math.max(roof, c.Y)
					end
					minZ, maxZ = math.min(minZ, c.Z), math.max(maxZ, c.Z)
					maxX = math.max(maxX, math.abs(c.X))
				end
			end
		end
	end
	local info = {
		Name = name,
		Entries = entries,
		Wheelbase = front.Magnitude,
		Track = right.Magnitude,
		WheelRadius = radius,
		RoofY = roof, -- teker merkezinden tavana
		Length = maxZ - minZ,
		Width = maxX * 2,
	}
	cache[name] = info
	return info
end

-- defId için kullanılacak model (yoksa nil). traffic = true → NPC'ye özel varyantlar (taksi) da olabilir.
-- variantScale: varyant olasılığı çarpanı (Yaşayan Şehir: merkezde/havalimanında daha çok taksi); yoksa 1.
function CarModelKit.Pick(defId: string, rng: Random, traffic: boolean?, variantScale: number?): string?
	if traffic then
		for _, v in Config.TrafficVariants[defId] or {} do
			if rng:NextNumber() < v.Chance * (variantScale or 1) and CarModelKit.Get(v.Model) then
				return v.Model
			end
		end
	end
	local available = {}
	for _, name in Config.ByDefinition[defId] or {} do
		if CarModelKit.Get(name) then
			table.insert(available, name)
		end
	end
	if #available == 0 then
		return nil
	end
	return available[rng:NextInteger(1, #available)]
end

function CarModelKit.PaintColors(name: string, paint: Color3?): (Color3, Color3)
	local colors = Config.Colors[name] or {}
	local base = if Config.FixedPaint[name] or not paint then (colors.Paint or Color3.new(0.8, 0.8, 0.8)) else paint
	local second
	if Config.Paint2Rule[name] == "Darker" then
		second = base:Lerp(Color3.new(0, 0, 0), 0.12)
	else
		second = colors.Paint2 or base
	end
	return base, second
end

-- Boyayı değiştir (havuzdan yeniden kullanılan NPC araçları için)
function CarModelKit.Repaint(parts: { BasePart }, name: string, paint: Color3?)
	local base, second = CarModelKit.PaintColors(name, paint)
	for _, p in parts do
		local role = p:GetAttribute("CarRole")
		if role == "Paint" then
			p.Color = base
		elseif role == "Paint2" then
			p.Color = second
		end
	end
end

-- Giydir. opts:
--   Frame: CFrame       hedef çerçeve: teker merkezlerinin ortası, teker merkezi yüksekliğinde; LookVector = ön
--   Scale: number       modelden hedefe ölçek
--   Parent: Instance
--   Body: BasePart      gövde parçalarının kaynaklanacağı parça (şasi / NPC kökü)
--   Wheels: { [string]: BasePart }?   teker görsellerinin bağlanacağı parçalar (FL/FR/RL/RR); yoksa Body
--   Paint: Color3?      gövde rengi (sabit boyalı modellerde yok sayılır)
--   Shadows: boolean?
-- Döndürür: { Parts = { BasePart }, Spin = { { Motor: Motor6D, Wheel: string } }, Lights = { Headlight = {}, TailLight = {} } }
function CarModelKit.Build(info, opts)
	local colors = Config.Colors[info.Name] or {}
	local base, second = CarModelKit.PaintColors(info.Name, opts.Paint)
	local s = opts.Scale
	local result = { Parts = {}, Spin = {}, Lights = { Headlight = {}, TailLight = {} } }
	for _, e in info.Entries do
		local p = e.Template:Clone()
		for _, child in p:GetChildren() do
			child:Destroy() -- içe aktarıcının eklediği görünüş/kaynak nesneleri: renk ve bağlantılar bizden
		end
		p.Size = e.Template.Size * s
		p.Anchored = false
		p.Massless = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		local style = Config.Roles[e.Role] or {}
		p.Material = style.Material or Enum.Material.SmoothPlastic
		p.Transparency = style.Transparency or 0
		p.Reflectance = style.Reflectance or 0
		p.CastShadow = opts.Shadows ~= false and (e.Role == "Paint" or e.Role == "Paint2" or e.Role == "Dark" or e.Role == "Tire")
		p.Color = if e.Role == "Paint" then base elseif e.Role == "Paint2" then second else (colors[e.Role] or Color3.fromRGB(110, 110, 110))
		p:SetAttribute("CarRole", e.Role)
		p:SetAttribute("OffColor", p.Color)
		if e.Role == "Headlight" or e.Role == "TailLight" then
			p.Name = e.Role -- araç ışık sistemi (VehicleService) bu adlarla bulur
			table.insert(result.Lights[e.Role], p)
		elseif e.Wheel then
			p.Name = "CarWheel_" .. e.Wheel .. "_" .. e.Role
		else
			p.Name = "Car_" .. e.Role
		end
		local offset = e.Offset
		p.CFrame = opts.Frame * CFrame.new(offset.Position * s) * offset.Rotation
		if e.Wheel then
			local anchor = (opts.Wheels and opts.Wheels[e.Wheel]) or opts.Body
			local center = opts.Frame * CFrame.new(e.Center * s) -- teker merkezi, aracın eksenleriyle
			local motor = Instance.new("Motor6D")
			motor.Name = "SpinMotor"
			motor.Part0 = anchor
			motor.Part1 = p
			motor.C0 = anchor.CFrame:ToObjectSpace(center)
			motor.C1 = p.CFrame:ToObjectSpace(center)
			motor:SetAttribute("Wheel", e.Wheel)
			motor.Parent = p
			table.insert(result.Spin, { Motor = motor, Wheel = e.Wheel })
		else
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = opts.Body
			weld.Part1 = p
			weld.Parent = p
		end
		p.Parent = opts.Parent
		table.insert(result.Parts, p)
	end
	return result
end

return CarModelKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX7EC0D00EN"><Properties>
<string name="Name">Ambient</string>
</Properties>
<Item class="ModuleScript" referent="RBX5B2320D9N"><Properties>
<string name="Name">Entrances</string>

<ProtectedString name="Source"><![CDATA[-- Entrances: bina giriş/çıkış kayıt sistemi (Yaşayan Şehir). SAF Lua; Roblox API'si yok (tools/test_ambient.py
-- çalıştırır). Harita DEĞİŞMEZ: kapı noktaları arsa verisinden (MapData "L" satırları) ve BuildingBuilder'ın her stil
-- için kullandığı cephe geometrisinden hesaplanır.
--
-- Her giriş (BuildingEntrance = BuildingExit, aynı kapı):
--   { Id, LotId, Style, Use ("Home" | "Shop" | "Work" | "Hotel"), X, Y, Z (kapı düzleminin ortası, zemin),
--     NX, NZ (dışa bakan normal), Width, Height, OutX, OutZ (kapının 1.2 stud önü: yaya burada kapıya döner),
--     Node (PedGraph kapı düğümü = NPCDestination), Walk (kaldırım düğümü = PedestrianWaypoint), HasDoorPart }
-- Kapı yalnızca cephesi doğrulanmış stillerde üretilir (yanlış yerde, duvarın içinde kapı olmasın). Kapı ile kaldırım
-- arasında, cepheye dik, yoldan ve başka arsalardan geçmeyen düz bir yürüme bağlantısı kurulur; kurulamazsa kapı
-- kaydedilmez. Kaldırım bağlantısı kapı noktasında bölünür (yeni kaldırım düğümü), kapı düğümü çıkmaz uçtur: A* onu
-- kısa yol olarak kullanamaz, sadece hedef/çıkış noktasıdır.

local Entrances = {}

local sqrt, abs, max, min, floor, cos, sin, rad = math.sqrt, math.abs, math.max, math.min, math.floor, math.cos, math.sin, math.rad
local GRID = 96
local clampN = function(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

-- Stil → kapılar (yerel koordinat: genişlik X, bina önü −Z; z = kapı düzlemi). BuildingBuilder ile birebir aynı
-- formüller (orada değişirse burası da değişmeli; test her kapının cephede olduğunu denetler).
-- Dönüş: { { x, z, floorY, width, height, doorPart }, ... }, kullanım
local STYLES = {}

STYLES.house_b = function(w, d)
	local hw = max(min(w - 8, 32), 10)
	return { { hw * 0.3, -d / 2 + 9, 0, 4, 7, false } }, "Home"
end

STYLES.house_a = function(w, d)
	local hw, hd = min(w - 8, 34), min(d - 16, 28)
	if hw < 12 or hd < 10 then
		return STYLES.house_b(w, d) -- BuildingBuilder da house_b'ye düşer
	end
	-- ahşap kapı parçası: genişlik 4, x = −hw·0.15, cephe z = −d/2 + 10 (ön bahçe 10 stud)
	return { { -hw * 0.15, -d / 2 + 10 - 0.4, 0, 4, 7, true } }, "Home"
end

STYLES.townhouse = function(w, d)
	local n = clampN(floor(w / 16), 2, 4)
	local uw = w / n
	local list = {}
	for i = 1, n do
		-- kapı 1.5 stud yüksekte (önünde 1.5 yüksek basamak): kapı düzlemi −d·0.3 − 0.4
		list[#list + 1] = { -w / 2 + (i - 0.5) * uw, -d * 0.3 - 0.4, 1.5, 3.5, 7, true }
	end
	return list, "Home"
end

local function storefront(_w, d)
	local depth = d * 0.85
	local front = (d / 2 - depth / 2) - depth / 2
	return { { 0, front - 0.7, 0, 5, 7.5, true } }, "Shop" -- metal kapı parçası
end
STYLES.storefront = storefront
STYLES.storefront_plain = storefront

STYLES.apartment_brick = function(_w, d)
	return { { 0, -d / 2 - 1, 0, 6, 8, true } }, "Home" -- ahşap giriş parçası
end

STYLES.apartment_modern = function(_w, d)
	return { { 0, -d / 2 - 0.45, 0, 6, 8, false } }, "Home" -- cam lobi cephesi
end

STYLES.office = function(_w, d)
	return { { 0, -d / 2, 0, 6, 8, false } }, "Work"
end

STYLES.glass_tower = function(_w, d)
	return { { 0, -d / 2, 0, 8, 9, false } }, "Work" -- giriş saçağının altı
end

STYLES.setback_tower = function(_w, d)
	return { { 0, -d * 0.48, 0, 8, 9, false } }, "Work"
end

STYLES.hotel = function(_w, d)
	return { { 0, -d * 0.3 - 2, 0, 8, 9, false } }, "Hotel" -- cam giriş kolonunun önü
end

STYLES.deco_lowrise = function(w, d)
	if w < 28 then
		return {}, "Home" -- dar cephe: pencere bandına denk gelmeyen kapı yeri yok
	end
	return { { w * 0.43, -d / 2, 0, 4, 7, false } }, "Home"
end

STYLES.mall = function(_w, d)
	return { { 0, -d / 2 - 5, 0, 10, 9, false } }, "Shop" -- cam giriş kutusunun önü
end

Entrances.Styles = STYLES

-- Yerel (x, z) → dünya (Roblox CFrame.Angles(0, θ, 0) ile aynı dönüş)
local function toWorld(lot, x, z)
	local th = rad(lot.Rotation or 0)
	local c, s = cos(th), sin(th)
	return lot.Center.X + x * c + z * s, lot.Center.Z - x * s + z * c
end
Entrances.ToWorld = toWorld

-- (px, pz) bir arsanın dikdörtgeninin içinde mi? (pay kadar küçültülmüş)
local function inLot(lot, px, pz, pad)
	local th = rad(lot.Rotation or 0)
	local c, s = cos(th), sin(th)
	local dx, dz = px - lot.Center.X, pz - lot.Center.Z
	-- dünyadan yerele: tersi dönüş
	local lx = dx * c - dz * s
	local lz = dx * s + dz * c
	return abs(lx) < lot.Width / 2 - pad and abs(lz) < lot.Depth / 2 - pad
end
Entrances.InLot = inLot

local function segIntersect(ax, az, bx, bz, cx, cz, dx, dz)
	local rx, rz = bx - ax, bz - az
	local sx, sz = dx - cx, dz - cz
	local den = rx * sz - rz * sx
	if abs(den) < 1e-9 then
		return nil
	end
	local t = ((cx - ax) * sz - (cz - az) * sx) / den
	local u = ((cx - ax) * rz - (cz - az) * rx) / den
	if t >= 0 and t <= 1 and u >= 0 and u <= 1 then
		return t, u
	end
	return nil
end

-- data: MapDefinitions verisi; pg: PedGraph (değiştirilir: kaldırım bölünür, kapı düğümleri eklenir)
-- PG: PedGraph modülü (OnRoad, RebuildGrid); tg: TrafficGraph (OnRoad için)
function Entrances.Build(data, pg, PG, tg, opts)
	opts = opts or {}
	local reach = opts.Reach or 32 -- kapıdan kaldırıma en fazla bu kadar
	local reg = { List = {}, Grid = {}, Rejected = { NoSidewalk = 0, Road = 0, OtherLot = 0, Narrow = 0 } }
	if #pg.Links == 0 then
		return reg
	end
	local top = pg.Top

	-- yol ızgarası (PedGraph.OnRoad ile aynı kural, ama sadece yakındaki yollar: kurulum hızlı)
	local edgeGrid = {}
	for _, e in ipairs(data.EdgeList) do
		local pa, pb = data.Nodes[e.A].Position, data.Nodes[e.B].Position
		local L = sqrt((pb.X - pa.X) ^ 2 + (pb.Z - pa.Z) ^ 2)
		local steps = max(1, floor(L / (GRID / 2)))
		local seen = {}
		for i = 0, steps do
			local f = i / steps
			local x, z = pa.X + (pb.X - pa.X) * f, pa.Z + (pb.Z - pa.Z) * f
			local k = floor(x / GRID) .. ":" .. floor(z / GRID)
			if not seen[k] then
				seen[k] = true
				edgeGrid[k] = edgeGrid[k] or {}
				table.insert(edgeGrid[k], e)
			end
		end
	end
	local padList = {}
	for _, pad in pairs(tg and tg.Pads or {}) do
		if pad.Kind == "Box" then
			padList[#padList + 1] = pad
		end
	end
	local function onRoad(x, z, y)
		local cx, cz = floor(x / GRID), floor(z / GRID)
		for i = cx - 1, cx + 1 do
			for j = cz - 1, cz + 1 do
				for _, e in ipairs(edgeGrid[i .. ":" .. j] or {}) do
					local pa, pb = data.Nodes[e.A].Position, data.Nodes[e.B].Position
					local dx, dz = pb.X - pa.X, pb.Z - pa.Z
					local L2 = dx * dx + dz * dz
					if L2 > 1 then
						local t = ((x - pa.X) * dx + (z - pa.Z) * dz) / L2
						local ry = pa.Y + (pb.Y - pa.Y) * t
						if t > 0 and t < 1 and abs(ry - y) < 4 then
							local px, pz = pa.X + dx * t, pa.Z + dz * t
							if (x - px) ^ 2 + (z - pz) ^ 2 < (e.Width / 2 - 0.2) ^ 2 then
								return true
							end
						end
					end
				end
			end
		end
		for _, pad in ipairs(padList) do
			if abs(x - pad.X) < pad.SX / 2 - 0.2 and abs(z - pad.Z) < pad.SZ / 2 - 0.2 and abs(pad.Y - y) < 4 then
				return true
			end
		end
		return false
	end
	Entrances._onRoad = onRoad

	-- arsa ızgarası (başka arsadan geçme denetimi)
	local lotGrid = {}
	for _, lot in ipairs(data.Lots or {}) do
		local k = floor(lot.Center.X / GRID) .. ":" .. floor(lot.Center.Z / GRID)
		lotGrid[k] = lotGrid[k] or {}
		table.insert(lotGrid[k], lot)
	end
	local function lotsNear(x, z)
		local out = {}
		local cx, cz = floor(x / GRID), floor(z / GRID)
		for i = cx - 1, cx + 1 do
			for j = cz - 1, cz + 1 do
				for _, l in ipairs(lotGrid[i .. ":" .. j] or {}) do
					out[#out + 1] = l
				end
			end
		end
		return out
	end

	local function newNode(x, z, y, comp)
		local n = { Id = #pg.Nodes + 1, X = x, Y = y or top, Z = z, Links = {}, Comp = comp }
		pg.Nodes[n.Id] = n
		return n
	end
	local function newLink(a, b, info)
		local dx, dz = b.X - a.X, b.Z - a.Z
		local l = { Id = #pg.Links + 1, A = a, B = b, Length = sqrt(dx * dx + dz * dz), Crossing = false }
		for k, v in pairs(info or {}) do
			l[k] = v
		end
		pg.Links[l.Id] = l
		a.Links[#a.Links + 1] = l
		b.Links[#b.Links + 1] = l
		return l
	end
	-- l'yi (A, B) → (A, S) + (S, B) olarak böl. Bağlantı dizisi boşluksuz kalır (eski kayıt yeniden kullanılır).
	local function split(l, x, z)
		local a, b = l.A, l.B
		local s = newNode(x, z, top, a.Comp)
		local nl = newLink(s, b, { Edge = l.Edge })
		-- b'nin listesinde l → nl
		for i, bl in ipairs(b.Links) do
			if bl == l then
				table.remove(b.Links, i)
				break
			end
		end
		l.B = s
		local dx, dz = s.X - a.X, s.Z - a.Z
		l.Length = sqrt(dx * dx + dz * dz)
		s.Links[#s.Links + 1] = l
		return s, nl
	end

	local linksNear = function(x, z, r)
		local out, seen = {}, {}
		for i = floor((x - r) / GRID), floor((x + r) / GRID) do
			for j = floor((z - r) / GRID), floor((z + r) / GRID) do
				for _, l in ipairs(pg.Grid[i .. ":" .. j] or {}) do
					if not seen[l] then
						seen[l] = true
						out[#out + 1] = l
					end
				end
			end
		end
		return out
	end
	local pending = {} -- bölünen bağlantılar ızgarada henüz yok: aynı kenarda ikinci kapı için ek liste

	for lotIndex, lot in ipairs(data.Lots or {}) do
		local fn = STYLES[lot.Style]
		if opts.Yield and lotIndex % 60 == 0 then
			opts.Yield() -- kurulumu karelere yay
		end
		if fn then
			local doors, use = fn(lot.Width, lot.Depth)
			for di, door in ipairs(doors) do
				local lx, lz, floorY, width, height, hasPart = door[1], door[2], door[3], door[4], door[5], door[6]
				local th = rad(lot.Rotation or 0)
				local nx, nz = -sin(th), -cos(th) -- yerel −Z (cephe dışı)
				local x, z = toWorld(lot, lx, lz)
				local ox, oz = x + nx * 1.2, z + nz * 1.2
				-- cepheye dik ışın: en yakın kaldırım bağlantısı (geçit değil)
				local best, bestT = nil, math.huge
				local ex, ez = ox + nx * reach, oz + nz * reach
				local cands = linksNear(ox, oz, reach + 10)
				for _, l in ipairs(pending) do
					cands[#cands + 1] = l
				end
				for _, l in ipairs(cands) do
					if not l.Crossing and not l.Door then
						local t = segIntersect(ox, oz, ex, ez, l.A.X, l.A.Z, l.B.X, l.B.Z)
						if t and t < bestT then
							best, bestT = l, t
						end
					end
				end
				if not best then
					reg.Rejected.NoSidewalk = reg.Rejected.NoSidewalk + 1
				else
					local sx, sz = ox + (ex - ox) * bestT, oz + (ez - oz) * bestT
					-- yürüme çizgisi yoldan ve başka arsalardan geçmesin
					local ok = true
					local len = bestT * reach
					local steps = max(2, floor(len / 1.5))
					for i = 0, steps do
						local f = i / steps
						local px, pz = ox + (sx - ox) * f, oz + (sz - oz) * f
						if onRoad(px, pz, top) then
							ok = false
							reg.Rejected.Road = reg.Rejected.Road + 1
							break
						end
						for _, other in ipairs(lotsNear(px, pz)) do
							if other ~= lot and inLot(other, px, pz, 0.5) then
								ok = false
								break
							end
						end
						if not ok then
							reg.Rejected.OtherLot = reg.Rejected.OtherLot + 1
							break
						end
					end
					-- bölünen parça çok kısa olmasın (köşe düğümüne yapışık kapı → mevcut düğümü kullan)
					local walk
					if ok then
						local la, lb = best.A, best.B
						local da = (la.X - sx) ^ 2 + (la.Z - sz) ^ 2
						local db = (lb.X - sx) ^ 2 + (lb.Z - sz) ^ 2
						if da < 2.25 then
							walk = la
						elseif db < 2.25 then
							walk = lb
						else
							local nl
							walk, nl = split(best, sx, sz)
							pending[#pending + 1] = nl
						end
						local dn = newNode(ox, oz, (lot.BaseY or top) + floorY, walk.Comp)
						local e = {
							Id = #reg.List + 1, LotId = lot.Id, Style = lot.Style, Use = use, Index = di,
							X = x, Y = (lot.BaseY or top) + floorY, Z = z, NX = nx, NZ = nz, Width = width, Height = height,
							OutX = ox, OutZ = oz, Walk = walk, Node = dn, HasDoorPart = hasPart, Poi = lot.PoiId,
							ActiveUntil = 0,
						}
						dn.Door = e
						newLink(walk, dn, { DoorLink = e, Door = true })
						reg.List[#reg.List + 1] = e
						local k = floor(x / GRID) .. ":" .. floor(z / GRID)
						reg.Grid[k] = reg.Grid[k] or {}
						table.insert(reg.Grid[k], e)
					end
				end
			end
		end
	end
	if PG.RebuildGrid then
		PG.RebuildGrid(pg)
	end
	return reg
end

function Entrances.Near(reg, x, z, radius)
	local out = {}
	local r2 = radius * radius
	for i = floor((x - radius) / GRID), floor((x + radius) / GRID) do
		for j = floor((z - radius) / GRID), floor((z + radius) / GRID) do
			for _, e in ipairs(reg.Grid[i .. ":" .. j] or {}) do
				if (e.X - x) ^ 2 + (e.Z - z) ^ 2 < r2 then
					out[#out + 1] = e
				end
			end
		end
	end
	return out
end

return Entrances
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX1989E307N"><Properties>
<string name="Name">PedAnim</string>

<ProtectedString name="Source"><![CDATA[-- PedAnim: NPC yaya animasyonu (Yaşayan Şehir). SAF Lua; Roblox API'si yok (tools/test_ambient.py denetler).
--
-- R15 iskeleti için eklem açıları üretir (PedRenderer bunları Motor6D.Transform'a yazar). Hazır Roblox yürüme
-- animasyonu kullanılmaz: o animasyon Roblox'un hızlı karakter adımına göre çizilmiştir; 4–6 stud/sn yürüyen bir
-- yayada ya ayak kayar ya da ağır çekim görünür. Burada adım, ters kinematikle GERÇEK yürüme hızından üretilir:
--   * Basan ayak yere sabittir (ayak kayması yok): adım boyu = hız / adım sıklığı; basan bacağın açısı, kalçanın
--     ilerleyişine göre her karede yeniden çözülür (iki eklemli IK). Kalça yüksekliği basan bacaktan hesaplanır
--     (doğal inip kalkma).
--   * Salınan ayak yerden kalkar (0.3 stud), öne gelir; ayak bileği tabanı yere paralel tutar.
--   * Kollar karşı bacakla salınır, dirsek hafif bükük; gövde hafif karşı döner.
--   * Hız 0'a inerken adım kısalır ve sıklık düşer → doğal duruş (Stop); hız artarken tersi (StartWalking).
--   * Dönüş: dönüş yönüne hafif eğilme ve başın dönüş yönüne bakması (Turn); yerinde dönüşte kısa ayak adımları.
--   * Duruş (Idle): nefes, ağırlık aktarma, ara sıra etrafa bakma.
--   * Kapı (DoorApproach/EnterBuilding/ExitBuilding): sağ kol kapıyı iter (Reach).
--
-- Ölçüler (PedRenderer ile aynı, stud): kalça eklemi yerden HIP_Y; uyluk L1, baldır L2; ayak bileği yerden ANKLE_Y.

local PedAnim = {}

local sin, cos, sqrt, abs, max, min, pi = math.sin, math.cos, math.sqrt, math.abs, math.max, math.min, math.pi
local atan2 = math.atan2 or math.atan
local acos = math.acos

PedAnim.HIP_Y = 2.7
PedAnim.L1 = 1.2
PedAnim.L2 = 1.2
PedAnim.ANKLE_Y = 0.3
PedAnim.LIFT = 0.32 -- salınan ayağın en yüksek kalkışı

local function clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

local function newRng(seed)
	local state = math.floor((seed or 1) * 1000003) % 2147483646 + 1
	return function()
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

-- Adım sıklığı (adım/sn) yürüme hızına göre (insan: 1.4 m/s ≈ 5 stud/sn'de ~2 adım/sn)
function PedAnim.Cadence(v)
	if v <= 0.05 then
		return 0
	end
	local c = 1.5 + 0.14 * v
	if v < 1 then
		c = c * sqrt(v) -- çok yavaşken adımlar seyrekleşir (duruş/kalkış)
	end
	return c
end

-- İki eklemli bacak IK: kalçaya göre hedef ayak bileği (d: ileri +, h: aşağı +) → kalça açısı θ (ileri +), diz κ (≥0)
function PedAnim.LegIK(d, h)
	local L1, L2 = PedAnim.L1, PedAnim.L2
	local r = sqrt(d * d + h * h)
	r = clamp(r, 0.2, (L1 + L2) * 0.9999)
	local c = (r * r - L1 * L1 - L2 * L2) / (2 * L1 * L2)
	local kappa = acos(clamp(c, -1, 1)) -- diz bükülmesi: 0 = düz bacak (r = L1 + L2)
	-- hedef yönü (dikey aşağıdan ileri açı) + uyluğun önde olma payı
	local phiT = atan2(d, h)
	local beta = atan2(L2 * sin(kappa), L1 + L2 * cos(kappa))
	return phiT + beta, kappa
end

-- İleri kinematik (test ve hata ayıklama): kalçaya göre diz ve ayak bileği (d ileri, y yukarı)
function PedAnim.LegFK(theta, kappa)
	local L1, L2 = PedAnim.L1, PedAnim.L2
	local kx, ky = L1 * sin(theta), -L1 * cos(theta)
	local ax, ay = kx + L2 * sin(theta - kappa), ky - L2 * cos(theta - kappa)
	return kx, ky, ax, ay
end

function PedAnim.new(seed)
	local rng = newRng(seed)
	return {
		Rng = rng, Phase = rng() * 2 * pi, Time = rng() * 10, Gait = 0, Look = 0, LookTarget = 0,
		LookTimer = 1 + rng() * 4, Seed = rng(), Reach = 0, Lean = 0, Shuffle = 0, Dist = 0,
		Legs = { { InStance = true, Plant = 0, LiftD = 0 }, { InStance = false, Plant = 0, LiftD = 0 } },
	}
end

-- Bir bacağın ayak konumu (kalçaya göre ileri d) ve kalkışı. ph = bu bacağın evresi (0..π basış, π..2π salınım).
-- Basışta ayağın DÜNYADAKİ yeri saklanır (Plant): d = Plant − kat edilen yol → hız değişse de ayak kaymaz.
local function footOf(leg, ph, s, dist)
	ph = ph % (2 * pi)
	if ph < pi then
		if not leg.InStance then
			leg.InStance = true
			leg.Plant = dist + s / 2 -- salınımın bittiği yer (öne atılan ayak)
		end
		return clamp(leg.Plant - dist, -1.7, 1.7), 0, true
	end
	if leg.InStance then
		leg.InStance = false
		leg.LiftD = clamp(leg.Plant - dist, -1.7, 1.7)
	end
	local u = (ph - pi) / pi
	local us = u * u * (3 - 2 * u)
	local d = leg.LiftD + (s / 2 - leg.LiftD) * us -- salınım: ayak öne gelir
	return d, PedAnim.LIFT * sin(pi * u) * min(1, s / 1.2), false
end

-- st: PedAnim.new; input: { Speed (stud/sn, gerçek), Turn (rad/sn, + sola), Reach (0..1), Dt }
-- Dönüş: pose (açılar radyan; Root ofseti stud)
function PedAnim.Step(st, dt, speed, turn, reach)
	st.Time = st.Time + dt
	local v = max(speed or 0, 0)
	turn = turn or 0
	-- yerinde dönüş: kısa ayak adımları (Turn)
	local shuffleTarget = (v < 0.4 and abs(turn) > 1.2) and 1 or 0
	st.Shuffle = st.Shuffle + (shuffleTarget - st.Shuffle) * min(1, dt * 6)
	local gaitV = max(v, st.Shuffle * 1.2)
	local c = PedAnim.Cadence(gaitV)
	st.Phase = (st.Phase + dt * c * pi) % (2 * pi) -- bir adım = π
	local s = (c > 0) and min(gaitV / c, 2.6) or 0
	if st.Shuffle > 0.5 and v < 0.4 then
		s = min(s, 0.5)
	end
	-- yürüyüş ağırlığı (0 duruş … 1 yürüyüş): duruşa yumuşak geçiş. İlk karede doğrudan hedef (yürürken doğan /
	-- havuzdan alınan yaya ilk adımda ayak kaydırmasın)
	local gaitTarget = clamp(gaitV / 0.8, 0, 1)
	if not st.Started then
		st.Started = true
		st.Gait = gaitTarget
	end
	st.Gait = st.Gait + (gaitTarget - st.Gait) * min(1, dt * 8)
	local g = st.Gait

	local H0 = PedAnim.HIP_Y
	local a = PedAnim.ANKLE_Y
	local reachL = (PedAnim.L1 + PedAnim.L2) * 0.995
	st.Dist = st.Dist + v * dt
	local phL, phR = st.Phase, st.Phase + pi
	local dL, liftL, stL = footOf(st.Legs[1], phL, s, st.Dist)
	local dR, liftR, stR = footOf(st.Legs[2], phR, s, st.Dist)
	-- duruşa geçerken ayaklar gövdenin altına toplanır
	dL, dR = dL * g, dR * g
	liftL, liftR = liftL * g, liftR * g
	-- basan bacağa göre kalça yüksekliği (ayak yere değsin; doğal inip kalkma)
	local dSt = stL and dL or (stR and dR or 0)
	local hipH = min(H0, a + sqrt(max(reachL * reachL - dSt * dSt, 0.01)))
	hipH = H0 + (hipH - H0) * g

	local pose = {}
	local tL, kL = PedAnim.LegIK(dL, hipH - a - liftL)
	local tR, kR = PedAnim.LegIK(dR, hipH - a - liftR)
	pose.LHip, pose.LKnee = tL, kL
	pose.RHip, pose.RKnee = tR, kR
	-- ayak tabanı yere paralel (salınımda uç hafif yukarı)
	pose.LAnkle = -(tL - kL) + (stL and 0 or 0.12 * g)
	pose.RAnkle = -(tR - kR) + (stR and 0 or 0.12 * g)
	pose.LFootD, pose.RFootD, pose.LLift, pose.RLift = dL, dR, liftL, liftR
	pose.LStance, pose.RStance = stL, stR
	pose.HipH = hipH
	pose.StepLength = s * g

	-- kollar: karşı bacakla salınım
	local armAmp = clamp(s * g / 2.2, 0, 1)
	local swingL = sin(phR) * 0.33 * armAmp -- sol kol sağ bacakla (~±19°)
	local swingR = sin(phL) * 0.33 * armAmp
	local t = st.Time
	local breathe = sin(t * 2 * pi * 0.25 + st.Seed * 6)
	pose.LShoulder = swingL + 0.03 * breathe * (1 - g)
	pose.RShoulder = swingR + 0.03 * breathe * (1 - g)
	pose.LShoulderRoll = -0.06 -- kollar gövdeye yapışmasın
	pose.RShoulderRoll = 0.06
	pose.LElbow = 0.12 + 0.25 * max(0, swingL) + 0.08 * g
	pose.RElbow = 0.12 + 0.25 * max(0, swingR) + 0.08 * g

	-- kapıyı itme (sağ kol öne)
	st.Reach = st.Reach + ((reach or 0) - st.Reach) * min(1, dt * 6)
	local r = st.Reach
	pose.RShoulder = pose.RShoulder * (1 - r) + 1.15 * r
	pose.RElbow = pose.RElbow * (1 - r) + 0.35 * r

	-- gövde: karşı dönüş, nefes, ağırlık aktarma (duruşta), dönüşe eğilme
	local leanTarget = clamp(turn * max(v, 1) * 0.018, -0.12, 0.12) -- dönüşün içine eğil (+ sol)
	st.Lean = st.Lean + (leanTarget - st.Lean) * min(1, dt * 5)
	pose.WaistYaw = sin(phL) * 0.07 * g
	pose.WaistPitch = 0.04 * g + 0.012 * breathe * (1 - g)
	pose.RootYaw = -sin(phL) * 0.035 * g
	pose.RootRoll = st.Lean
	pose.RootX = (1 - g) * 0.05 * sin(t * 2 * pi * 0.11 + st.Seed * 9) + g * 0.04 * cos(phL)
	pose.RootY = hipH - H0

	-- baş: duruşta ara sıra etrafa bakar; dönüşte dönüş yönüne
	st.LookTimer = st.LookTimer - dt
	if st.LookTimer <= 0 then
		st.LookTimer = 2.5 + st.Rng() * 5
		st.LookTarget = (st.Rng() < 0.6) and (st.Rng() * 1.1 - 0.55) * (1 - g * 0.7) or 0
	end
	local lookGoal = st.LookTarget + clamp(turn * 0.25, -0.5, 0.5)
	st.Look = st.Look + (lookGoal - st.Look) * min(1, dt * 3)
	pose.NeckYaw = st.Look
	pose.NeckPitch = -pose.WaistPitch * 0.7 - (pose.RootY) * 0.15
	return pose
end

return PedAnim
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXD193C7CEN"><Properties>
<string name="Name">PedGraph</string>

<ProtectedString name="Source"><![CDATA[-- PedGraph: kaldırım yürüyüş grafiği (Aşama 6). SAF Lua; Roblox API'si yok (tools/test_ambient.py çalıştırır).
--
-- RoadBuilder'ın kaldırım geometrisini izler:
--   * Kaldırımlı yolun (Edge.Sidewalk) iki yanında, yol kenarından sw/2 içeride bir yürüyüş çizgisi
--     (yol kırpma + kaldırım kırpma mesafeleriyle aynı uçlar).
--   * Kaldırımlı dik kavşaklarda dört köşe karesi; kapalı kenarlarda kaldırım dolgusu (yürünür bağlantı).
--   * KARŞIYA GEÇİŞ yalnızca kavşak platformlarının açık kenarlarında, yaya geçidi çizgilerinin olduğu yerde
--     (kol başından sw/2 dışarıda). Bunun dışında yaya yola inmez.
-- Kaldırım bayrağı olmayan haritada grafik boş kalır → yaya doğmaz (geçersiz yolda NPC üretilmez).
--
-- graph.Nodes[id]  { Id, X, Y, Z, Links = {link}, Spot = {Kind, FaceX, FaceZ}? , Comp }
-- graph.Links[id]  { Id, A, B (düğüm), Length, Crossing, Node (kavşak), ArmEdge, ArmPhase, Door (bina kapısı) }
-- graph.Nodes[id].Door: Entrances kaydı (kapı düğümü; çıkmaz uç)

local PedGraph = {}

local sqrt, floor, max, abs = math.sqrt, math.floor, math.max, math.abs
local GRID = 96

local function keyOf(x, z)
	return floor(x * 2 + 0.5) .. ":" .. floor(z * 2 + 0.5)
end

-- data: MapDefinitions verisi; tg: TrafficGraph.Build sonucu (pad + kırpma bilgisi ve kol fazları)
function PedGraph.Build(data, tg)
	local meta = data.Meta
	local sw = meta.Sidewalk or 8
	local top = meta.BlockTop or 0.8
	local graph = { Nodes = {}, Links = {}, Grid = {}, Top = top, RoadTop = meta.RoadTop or 0.3, Spots = {} }
	local byKey = {}

	local function node(x, z)
		local k = keyOf(x, z)
		local n = byKey[k]
		if not n then
			n = { Id = #graph.Nodes + 1, X = x, Y = top, Z = z, Links = {} }
			graph.Nodes[n.Id] = n
			byKey[k] = n
		end
		return n
	end
	local function link(a, b, crossing, info)
		if a == b then
			return nil
		end
		for _, l in ipairs(a.Links) do
			if (l.A == a and l.B == b) or (l.A == b and l.B == a) then
				return l
			end
		end
		local dx, dz = b.X - a.X, b.Z - a.Z
		local l = { Id = #graph.Links + 1, A = a, B = b, Length = sqrt(dx * dx + dz * dz), Crossing = crossing }
		if info then
			for k, v in pairs(info) do
				l[k] = v
			end
		end
		graph.Links[l.Id] = l
		a.Links[#a.Links + 1] = l
		b.Links[#b.Links + 1] = l
		return l
	end

	local endpoints = {} -- [nodeId] = { pedNode... }
	local walkTrim = tg.WalkTrim
	for _, e in ipairs(data.EdgeList) do
		if e.Sidewalk then
			local pa, pb = data.Nodes[e.A].Position, data.Nodes[e.B].Position
			local dx, dz = pb.X - pa.X, pb.Z - pa.Z
			local L = sqrt(dx * dx + dz * dz)
			if L > 2 then
				local ux, uz = dx / L, dz / L
				local rx, rz = -uz, ux
				local trims = walkTrim[e.Id]
				local ta = trims and trims[e.A] or 0
				local tb = trims and trims[e.B] or 0
				ta, tb = math.min(ta, L * 0.49), math.min(tb, L * 0.49)
				local off = e.Width / 2 + sw / 2
				for _, side in ipairs({ 1, -1 }) do
					local ax = pa.X + ux * ta + rx * off * side
					local az = pa.Z + uz * ta + rz * off * side
					local bx = pb.X - ux * tb + rx * off * side
					local bz = pb.Z - uz * tb + rz * off * side
					local na, nb = node(ax, az), node(bx, bz)
					link(na, nb, false, { Edge = e.Id })
					endpoints[e.A] = endpoints[e.A] or {}
					endpoints[e.B] = endpoints[e.B] or {}
					table.insert(endpoints[e.A], na)
					table.insert(endpoints[e.B], nb)
				end
			end
		end
	end

	-- Kavşak köşeleri, kenar dolguları ve geçitler
	local SIDES = {
		N = { { -1, -1 }, { 1, -1 } },
		S = { { -1, 1 }, { 1, 1 } },
		W = { { -1, -1 }, { -1, 1 } },
		E = { { 1, -1 }, { 1, 1 } },
	}
	for nodeId, pad in pairs(tg.Pads) do
		if pad.Kind == "Box" and pad.Walk then
			local tnode = tg.Nodes[nodeId]
			local hx, hz = pad.SX / 2, pad.SZ / 2
			local corners = {}
			for _, sx in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					corners[sx .. ":" .. sz] = node(pad.X + sx * (hx + sw / 2), pad.Z + sz * (hz + sw / 2))
				end
			end
			-- kaldırım uçlarını en yakın köşeye bağla
			for _, en in ipairs(endpoints[nodeId] or {}) do
				local best, bestD = nil, math.huge
				for _, c in pairs(corners) do
					local d = (c.X - en.X) ^ 2 + (c.Z - en.Z) ^ 2
					if d < bestD then
						best, bestD = c, d
					end
				end
				if best and bestD < (sw * 3) ^ 2 then
					link(en, best, false)
				end
			end
			for side, pair in pairs(SIDES) do
				local a = corners[pair[1][1] .. ":" .. pair[1][2]]
				local b = corners[pair[2][1] .. ":" .. pair[2][2]]
				if pad.Open[side] then
					local armEdge = tnode and tnode.ArmEdge[side]
					link(a, b, true, {
						Node = nodeId, ArmEdge = armEdge, ArmPhase = (tnode and armEdge and tnode.ArmPhase[armEdge]) or 1,
						Signal = tnode and tnode.Control == "Signal",
					})
				else
					link(a, b, false) -- kapalı kenar: kaldırım dolgusu
				end
			end
		end
	end

	-- Bileşenler (çok küçük adacıklarda doğma yok)
	local comp = 0
	local sizes = {}
	for _, n in ipairs(graph.Nodes) do
		if not n.Comp then
			comp = comp + 1
			local stack, size = { n }, 0
			n.Comp = comp
			while #stack > 0 do
				local cur = table.remove(stack)
				size = size + 1
				for _, l in ipairs(cur.Links) do
					local o = (l.A == cur) and l.B or l.A
					if not o.Comp then
						o.Comp = comp
						stack[#stack + 1] = o
					end
				end
			end
			sizes[comp] = size
		end
	end
	graph.ComponentSizes = sizes

	PedGraph.RebuildGrid(graph)

	-- Mola noktaları: dükkân girişleri, banklar, otobüs durakları → en yakın kaldırım düğümü
	local nodeGrid = {}
	for _, n in ipairs(graph.Nodes) do
		local k = floor(n.X / GRID) .. ":" .. floor(n.Z / GRID)
		nodeGrid[k] = nodeGrid[k] or {}
		table.insert(nodeGrid[k], n)
	end
	local function nearestNode(x, z, radius)
		local best, bestD = nil, radius * radius
		local cx, cz = floor(x / GRID), floor(z / GRID)
		for i = cx - 1, cx + 1 do
			for j = cz - 1, cz + 1 do
				for _, n in ipairs(nodeGrid[i .. ":" .. j] or {}) do
					local d = (n.X - x) ^ 2 + (n.Z - z) ^ 2
					if d < bestD then
						best, bestD = n, d
					end
				end
			end
		end
		return best
	end
	local function addSpot(kind, x, z)
		-- düğüm yerine en yakın bağlantı üzerindeki noktaya da bakılabilir; basit: en yakın düğüm (40 stud içinde)
		local n = nearestNode(x, z, 40)
		if n and not n.Spot then
			local fx, fz = x - n.X, z - n.Z
			local fl = sqrt(fx * fx + fz * fz)
			n.Spot = { Kind = kind, FaceX = fl > 0.1 and fx / fl or 0, FaceZ = fl > 0.1 and fz / fl or 1 }
			graph.Spots[#graph.Spots + 1] = n
		end
	end
	for _, p in ipairs(data.POIs or {}) do
		addSpot("Shop", p.Entrance.X, p.Entrance.Z)
	end
	for _, prop in ipairs(data.Props or {}) do
		if prop.Kind == "bench" or prop.Kind == "busstop" then
			addSpot(prop.Kind == "bench" and "Bench" or "Bus", prop.X, prop.Z)
		end
	end
	return graph
end

-- Doğma/hedef ızgarası: kaldırım bağlantıları (geçit ve bina kapısı bağlantıları hariç). Entrances kaldırımı
-- böldükten sonra yeniden kurulur.
function PedGraph.RebuildGrid(graph)
	graph.Grid = {}
	local sizes = graph.ComponentSizes
	for _, l in ipairs(graph.Links) do
		if not l.Crossing and not l.Door and (sizes[l.A.Comp] or 0) >= 6 then
			local steps = max(1, floor(l.Length / 40))
			local seen = {}
			for i = 0, steps do
				local t = i / steps
				local x, z = l.A.X + (l.B.X - l.A.X) * t, l.A.Z + (l.B.Z - l.A.Z) * t
				local k = floor(x / GRID) .. ":" .. floor(z / GRID)
				if not seen[k] then
					seen[k] = true
					local cell = graph.Grid[k]
					if not cell then
						cell = {}
						graph.Grid[k] = cell
					end
					cell[#cell + 1] = l
				end
			end
		end
	end
end

function PedGraph.LinksNear(graph, x, z, radius)
	local out, seen = {}, {}
	for i = floor((x - radius) / GRID), floor((x + radius) / GRID) do
		for j = floor((z - radius) / GRID), floor((z + radius) / GRID) do
			for _, l in ipairs(graph.Grid[i .. ":" .. j] or {}) do
				if not seen[l] then
					seen[l] = true
					out[#out + 1] = l
				end
			end
		end
	end
	return out
end

-- Basit A* (sınırlı): from → to düğüm listesi (from hariç). Bulamazsa nil.
function PedGraph.Path(graph, from, to, maxNodes)
	if from == to then
		return {}
	end
	maxNodes = maxNodes or 600
	local open, came, g = { from }, {}, { [from] = 0 }
	local f = { [from] = sqrt((from.X - to.X) ^ 2 + (from.Z - to.Z) ^ 2) }
	local closed = {}
	local expanded = 0
	while #open > 0 do
		local bi, best = 1, open[1]
		for i = 2, #open do
			if f[open[i]] < f[best] then
				bi, best = i, open[i]
			end
		end
		table.remove(open, bi)
		if best == to then
			local path = {}
			local cur = to
			while cur ~= from do
				table.insert(path, 1, { Node = cur, Link = came[cur].Link })
				cur = came[cur].Node
			end
			return path
		end
		closed[best] = true
		expanded = expanded + 1
		if expanded > maxNodes then
			return nil
		end
		for _, l in ipairs(best.Links) do
			local o = (l.A == best) and l.B or l.A
			if not closed[o] then
				local cost = g[best] + l.Length + (l.Crossing and (graph.CrossPenalty or 12) or 0) -- gereksiz karşıya geçmeyi az tercih et
				if not g[o] or cost < g[o] then
					if not g[o] then
						open[#open + 1] = o
					end
					g[o] = cost
					f[o] = cost + sqrt((o.X - to.X) ^ 2 + (o.Z - to.Z) ^ 2)
					came[o] = { Node = best, Link = l }
				end
			end
		end
	end
	return nil
end

-- Bir noktanın bir yol yüzeyinin üstünde olup olmadığı (test ve hata ayıklama için)
-- y verilirse (yaya yüksekliği) üstten geçen köprü/otoyol yüzeyleri sayılmaz.
function PedGraph.OnRoad(data, tg, x, z, y)
	for _, e in ipairs(data.EdgeList) do
		local pa, pb = data.Nodes[e.A].Position, data.Nodes[e.B].Position
		local dx, dz = pb.X - pa.X, pb.Z - pa.Z
		local L2 = dx * dx + dz * dz
		if L2 > 1 then
			local t = ((x - pa.X) * dx + (z - pa.Z) * dz) / L2
			local ry = pa.Y + (pb.Y - pa.Y) * t
			if t > 0 and t < 1 and (not y or abs(ry - y) < 4) then
				local px, pz = pa.X + dx * t, pa.Z + dz * t
				if (x - px) ^ 2 + (z - pz) ^ 2 < (e.Width / 2 - 0.2) ^ 2 then
					return true, e.Id
				end
			end
		end
	end
	for _, pad in pairs(tg.Pads) do
		if pad.Kind == "Box" and abs(x - pad.X) < pad.SX / 2 - 0.2 and abs(z - pad.Z) < pad.SZ / 2 - 0.2
			and (not y or abs(pad.Y - y) < 4) then
			return true, "pad"
		end
	end
	return false
end

return PedGraph
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX51CD43C7N"><Properties>
<string name="Name">PedSim</string>

<ProtectedString name="Source"><![CDATA[-- PedSim: yaya simülasyonu (Aşama 6). SAF Lua; Roblox API'si yok (tools/test_ambient.py çalıştırır).
--
-- Yaya yalnızca PedGraph üzerinde yürür (kaldırım + kavşaktaki geçitler). Davranış:
--   * Hedef: saate göre (Schedule) bir mola noktası (dükkân, bank, durak) ya da rastgele bir kaldırım düğümü;
--     A* ile yol bulur. Hedefe varınca saate bağlı olasılıkla mola verir (durur, noktaya döner).
--   * Karşıya geçiş: ışıklı kavşakta YAYA YEŞİLİ (kolun trafiği kırmızı, diğer faz yeşil ve süre yetiyor);
--     ışıksızda kolda yaklaşan araç yokken. Uzun beklerse başka yöne döner.
--   * Çarpışmadan kaçınma: aynı kaldırımda karşılaşınca sağa kayma, önündekine yetişince yavaşlama, oyuncuya yol
--     verme; kaldırım kenarına hızla yaklaşan araçtan uzaklaşma.
--
-- ctx (Step): Time, Hour (0..24), Focus, Obstacles { {X,Z,R,Kind,Speed} } (oyuncu/araç), MaxPeds, Density,
--             CanSpawn(x,y,z,dist), DensityAt(x,z), IsVisible(x,y,z,dist)
--
-- Bina kapıları (graph.Entrances, Entrances modülü): saate göre bazı yayaların hedefi bir kapıdır (ev/iş/dükkân/otel).
-- Kapıya varınca: Kapı (kapıya dön, kısa bekle, kapı açılır) → Gir (eşikten geçer, içeride kaybolur, kaldırılır).
-- Bazı yayalar kapıdan çıkarak doğar: Çık (kapı açılır, içeriden belirir, dışarı yürür) → normal yürüyüş.
--
-- Yaşayan Şehir: yön değişimi dönüş hızıyla sınırlı (köşede ani dönme yok), yürüme hızı ivmeli (kalkış/duruş
-- yumuşak; gerçek hız animasyona gider → ayak kayması yok), görünen yaya kaldırılmaz, uzaktakiler sade güncellenir,
-- hedefler daha uzak ve anlamlı (gereksiz karşıya geçmeye ceza), yaya ışığında geç kalan da güvenle geçebilir.

local PedSim = {}
PedSim.__index = PedSim

local sqrt, abs, max, min, floor = math.sqrt, math.abs, math.max, math.min, math.floor
local atan2 = math.atan2 or math.atan -- Luau: atan2; Lua 5.4 (çevrimdışı test): atan(y, x)

local function newRng(seed)
	local state = floor(seed) % 2147483646 + 1
	return function()
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

-- graph: PedGraph; tg: TrafficGraph; traffic: TrafficSim (ArmBusy, araç konumları); cfg: AmbientConfig.Pedestrians
function PedSim.new(graph, tg, traffic, cfg, PG, TG, seed)
	local self = setmetatable({}, PedSim)
	self.Graph, self.TGraph, self.Traffic, self.Cfg, self.PG, self.TG = graph, tg, traffic, cfg, PG, TG
	self.Rng = newRng(seed or 777)
	self.Peds = {}
	self.NextId = 1
	self.Spawned, self.Despawned = {}, {}
	self.Stats = {
		Spawns = 0, Despawns = 0, Rejected = 0, Crossings = 0, CrossOnRed = 0, GaveUp = 0, PathFail = 0,
		Entered = 0, Exited = 0, DoorGoals = 0,
	}
	self.Doors = graph.Entrances -- Entrances.Build sonucu (yoksa kapı davranışı yok)
	self.Time = 0
	graph.CrossPenalty = cfg.CrossPenalty or graph.CrossPenalty -- A*: gereksiz karşıya geçme cezası
	return self
end

function PedSim:_schedule(hour)
	for _, s in ipairs(self.Cfg.Schedule) do
		if hour >= s.From and hour < s.To then
			return s
		end
	end
	return self.Cfg.Schedule[1]
end

local function nearestFocus(foci, x, z)
	local best = math.huge
	for _, f in ipairs(foci) do
		local d = (f.X - x) ^ 2 + (f.Z - z) ^ 2
		if d < best then
			best = d
		end
	end
	return sqrt(best)
end

-- ===== Bina kapıları =====
function PedSim:_doorSchedule(hour)
	local dc = self.Cfg.Doors
	if not dc or not dc.Enabled or not self.Doors then
		return nil
	end
	for _, s in ipairs(dc.Schedule) do
		if hour >= s.From and hour < s.To then
			return s
		end
	end
	return dc.Schedule[1]
end

-- yarıçap içindeki kapılardan kullanım ağırlığına göre rastgele biri (filter: ek koşul)
function PedSim:_pickDoor(x, z, radius, weights, filter)
	local reg = self.Doors
	local cands, total = {}, 0
	local r2 = radius * radius
	for i = floor((x - radius) / 96), floor((x + radius) / 96) do
		for j = floor((z - radius) / 96), floor((z + radius) / 96) do
			for _, e in ipairs(reg.Grid[i .. ":" .. j] or {}) do
				local d2 = (e.X - x) ^ 2 + (e.Z - z) ^ 2
				local w = weights[e.Use] or 0
				if d2 < r2 and w > 0 and (not filter or filter(e, d2)) then
					total = total + w
					cands[#cands + 1] = { e, total }
				end
			end
		end
	end
	if total <= 0 then
		return nil
	end
	local r = self.Rng() * total
	for _, c in ipairs(cands) do
		if r <= c[2] then
			return c[1]
		end
	end
	return cands[#cands][1]
end

-- Kapı kullanımda mı (biri giriyor/çıkıyor)? → kapı açık kalır, sıradaki bekler
function PedSim:_doorBusy(e)
	return (e.BusyUntil or 0) > self.Time
end

-- Kapıdan çıkarak doğ (görünür yerde de olabilir: insan binadan çıkıyor)
function PedSim:_trySpawnDoor(ctx, sched)
	local cfg = self.Cfg
	local foci = ctx.Focus or {}
	if #foci == 0 then
		return false
	end
	local focus = foci[1 + floor(self.Rng() * #foci) % #foci]
	local minD2 = (cfg.Doors.SpawnMinDistance or 15) ^ 2
	local e = self:_pickDoor(focus.X, focus.Z, cfg.SpawnMax, sched.Exit, function(door, d2)
		return d2 > minD2 and not self:_doorBusy(door) and (self.Graph.ComponentSizes[door.Walk.Comp] or 0) >= 6
	end)
	if not e then
		return false
	end
	if ctx.DensityAt and self.Rng() > max(ctx.DensityAt(e.X, e.Z), cfg.DensityFloor) then
		return false
	end
	for _, q in ipairs(self.Peds) do
		if (q.X - e.OutX) ^ 2 + (q.Z - e.OutZ) ^ 2 < 9 then
			return false
		end
	end
	local depth = cfg.Doors.Depth or 1.8
	local p = {
		Id = self.NextId, Node = e.Node, X = e.X - e.NX * depth, Y = e.Y, Z = e.Z - e.NZ * depth, HX = e.NX, HZ = e.NZ,
		WX = e.NX, WZ = e.NZ, Speed = cfg.WalkSpeed[1] + self.Rng() * (cfg.WalkSpeed[2] - cfg.WalkSpeed[1]),
		Lateral = (self.Rng() * 2 - 1) * cfg.SidewalkSpread * 0.7, LatCur = 0, State = "Çık", Timer = 0, Moving = 0,
		Seed = self.Rng(), CurSpeed = 0, Door = e, Fade = 1, DX = e.NX, DZ = e.NZ,
	}
	self.NextId = self.NextId + 1
	e.BusyUntil = self.Time + (cfg.Doors.ExitTime or 1.1) + 0.4
	self.Peds[#self.Peds + 1] = p
	self.Spawned[#self.Spawned + 1] = p
	self.Stats.Spawns = self.Stats.Spawns + 1
	self.Stats.Exited = self.Stats.Exited + 1
	return true
end

-- Yeni hedef seç ve yol bul
function PedSim:_newGoal(p, ctx)
	local graph = self.Graph
	local sched = self:_schedule(ctx.Hour or 12)
	local goal
	local ds = self:_doorSchedule(ctx.Hour or 12)
	if ds and self.Rng() < ds.Goal then
		-- bir binaya git (eve dön, işe/dükkâna gir): aynı kaldırım ağında, birkaç adım ötede
		local minD2 = (self.Cfg.Doors.GoalMinDistance or 30) ^ 2
		local comp = p.Node.Comp
		local e = self:_pickDoor(p.X, p.Z, self.Cfg.GoalRadius, ds.Enter, function(door, d2)
			return d2 > minD2 and door.Node.Comp == comp
		end)
		if e then
			goal = e.Node
			self.Stats.DoorGoals = self.Stats.DoorGoals + 1
		end
	end
	if not goal and #graph.Spots > 0 and self.Rng() < sched.Idle + 0.2 then
		-- yakın bir mola noktası
		for _ = 1, 6 do
			local s = graph.Spots[1 + floor(self.Rng() * #graph.Spots) % #graph.Spots]
			if s.Comp == p.Node.Comp and (s.X - p.X) ^ 2 + (s.Z - p.Z) ^ 2 < self.Cfg.GoalRadius ^ 2 and s ~= p.Node then
				goal = s
				break
			end
		end
	end
	if not goal then
		-- rastgele ama anlamlı uzaklıkta bir kaldırım noktası (çok yakın hedef = olduğu yerde dönüp durma)
		local links = self.PG.LinksNear(graph, p.X, p.Z, self.Cfg.GoalRadius)
		local minD2 = (self.Cfg.GoalMinDistance or 0) ^ 2
		local fallback
		for _ = 1, 8 do
			local l = links[1 + floor(self.Rng() * max(#links, 1)) % max(#links, 1)]
			if l then
				local n = (self.Rng() < 0.5) and l.A or l.B
				if n.Comp == p.Node.Comp and n ~= p.Node then
					if (n.X - p.X) ^ 2 + (n.Z - p.Z) ^ 2 >= minD2 then
						goal = n
						break
					end
					fallback = fallback or n
				end
			end
		end
		goal = goal or fallback
	end
	if not goal then
		return false
	end
	local path = self.PG.Path(graph, p.Node, goal, 700)
	if not path or #path == 0 then
		self.Stats.PathFail = self.Stats.PathFail + 1
		return false
	end
	p.Path, p.PathIndex, p.Goal = path, 1, goal
	return true
end

function PedSim:_startLink(p, link, toNode)
	p.Link = link
	p.From = p.Node
	p.To = toNode
	p.T = 0
	local dx, dz = toNode.X - p.From.X, toNode.Z - p.From.Z
	local l = max(sqrt(dx * dx + dz * dz), 0.01)
	p.DX, p.DZ = dx / l, dz / l
end

function PedSim:_trySpawn(ctx)
	local cfg = self.Cfg
	local foci = ctx.Focus or {}
	if #foci == 0 then
		return false
	end
	local focus = foci[1 + floor(self.Rng() * #foci) % #foci]
	local links = self.PG.LinksNear(self.Graph, focus.X, focus.Z, cfg.SpawnMax)
	if #links == 0 then
		return false
	end
	local link = links[1 + floor(self.Rng() * #links) % #links]
	local t = self.Rng()
	local x = link.A.X + (link.B.X - link.A.X) * t
	local z = link.A.Z + (link.B.Z - link.A.Z) * t
	local d = nearestFocus(foci, x, z)
	if d < cfg.SpawnMin or d > cfg.SpawnMax then
		return false
	end
	if ctx.CanSpawn and not ctx.CanSpawn(x, self.Graph.Top, z, d) then
		return false
	end
	if ctx.DensityAt and self.Rng() > max(ctx.DensityAt(x, z), cfg.DensityFloor) then
		return false
	end
	for _, q in ipairs(self.Peds) do
		if (q.X - x) ^ 2 + (q.Z - z) ^ 2 < 9 then
			return false
		end
	end
	local dirForward = self.Rng() < 0.5
	local from, to = link.A, link.B
	if not dirForward then
		from, to = link.B, link.A
	end
	local p = {
		Id = self.NextId, Node = from, X = x, Y = self.Graph.Top, Z = z, HX = 0, HZ = 1,
		Speed = cfg.WalkSpeed[1] + self.Rng() * (cfg.WalkSpeed[2] - cfg.WalkSpeed[1]),
		Lateral = (self.Rng() * 2 - 1) * cfg.SidewalkSpread * 0.7, LatCur = 0, State = "Yürü", Timer = 0, Moving = 0,
		Seed = self.Rng(), CurSpeed = 0,
	}
	p.LatCur = p.Lateral
	self.NextId = self.NextId + 1
	self:_startLink(p, link, to)
	p.T = link.Length * (dirForward and t or (1 - t))
	p.HX, p.HZ = p.DX, p.DZ
	p.CurSpeed = p.Speed -- görünmeyen yerde, yürürken doğar
	self.Peds[#self.Peds + 1] = p
	self.Spawned[#self.Spawned + 1] = p
	self.Stats.Spawns = self.Stats.Spawns + 1
	return true
end

function PedSim:Remove(p, reason)
	if p.Removed then
		return
	end
	p.Removed = true
	p.RemoveReason = reason
	for i = #self.Peds, 1, -1 do
		if self.Peds[i] == p then
			table.remove(self.Peds, i)
			break
		end
	end
	self.Despawned[#self.Despawned + 1] = p
	self.Stats.Despawns = self.Stats.Despawns + 1
end

-- Düğüme varınca: yol varsa sıradakine, yoksa yeni hedef; geçitse izin bekle
function PedSim:_arrive(p, ctx)
	p.Node = p.To
	p.Link = nil
	if p.Node.Door and p.Goal == p.Node then
		-- DoorApproach: kapıya dön, kısa bekle (kapı açılır), sonra gir
		local e = p.Node.Door
		local dc = self.Cfg.Doors
		p.Goal, p.Path = nil, nil
		p.Door = e
		p.State = "Kapı"
		p.Timer = dc.PauseTime[1] + self.Rng() * (dc.PauseTime[2] - dc.PauseTime[1])
		p.WX, p.WZ = -e.NX, -e.NZ
		return
	end
	if p.Goal and p.Node == p.Goal then
		p.Goal, p.Path = nil, nil
		local sched = self:_schedule(ctx.Hour or 12)
		if p.Node.Spot and self.Rng() < sched.Idle + 0.25 or self.Rng() < sched.Idle * 0.4 then
			p.State = "Mola"
			p.Timer = sched.IdleTime[1] + self.Rng() * (sched.IdleTime[2] - sched.IdleTime[1])
			if p.Node.Spot then
				p.WX, p.WZ = p.Node.Spot.FaceX, p.Node.Spot.FaceZ -- noktaya doğru (dönüş hızıyla) dön
			end
			return
		end
	end
	if not p.Path or p.PathIndex > #p.Path then
		if not self:_newGoal(p, ctx) then
			-- hedef yok: rastgele komşu bağlantı (geri dönüş son çare)
			local links = {}
			for _, l in ipairs(p.Node.Links) do
				if not l.Door or p.Node.Door then
					links[#links + 1] = l -- kapı bağlantısına rastgele sapma yok (kapıdaysa çıkış yolu o)
				end
			end
			if #links == 0 then
				self:Remove(p, "Çıkmaz")
				return
			end
			local l = links[1 + floor(self.Rng() * #links) % #links]
			p.Path, p.PathIndex = { { Node = (l.A == p.Node) and l.B or l.A, Link = l } }, 1
		end
	end
	local step = p.Path[p.PathIndex]
	p.PathIndex = p.PathIndex + 1
	if step.Link.Crossing then
		p.State = "Bekle"
		p.Timer = 0
		p.PendingLink, p.PendingNode = step.Link, step.Node
	else
		self:_startLink(p, step.Link, step.Node)
		p.State = "Yürü"
	end
end

-- Nokta (x, z) bir aracın (pay kadar genişletilmiş) gövde kutusunda mı?
local function inVehicleBox(v, x, z, pad)
	local dx, dz = x - v.X, z - v.Z
	local along = dx * v.HX + dz * v.HZ
	local side = -dx * v.HZ + dz * v.HX
	return abs(along) < v.Len / 2 + pad and abs(side) < v.Width / 2 + pad
end

-- Geçit şeridinin üstünde/yanında araç var mı (dönen ya da geçide taşmış araç)
function PedSim:_crossingOccupied(link)
	local ax, az, bx, bz = link.A.X, link.A.Z, link.B.X, link.B.Z
	local dx, dz = bx - ax, bz - az
	local L2 = max(dx * dx + dz * dz, 0.01)
	local vehicles = self.Traffic and self.Traffic.Vehicles or {}
	for _, v in ipairs(vehicles) do
		local t = clamp(((v.X - ax) * dx + (v.Z - az) * dz) / L2, 0, 1)
		local px, pz = ax + dx * t, az + dz * t
		local reach = v.Len / 2 + 3 + (v.V > 1 and v.V * 0.8 or 0)
		if (v.X - px) ^ 2 + (v.Z - pz) ^ 2 < reach * reach and abs(v.Y - self.Graph.RoadTop) < 4 then
			return true
		end
	end
	return false
end

function PedSim:_mayCross(p, link, time)
	local tnode = self.TGraph.Nodes[link.Node]
	if not tnode then
		return true
	end
	if self:_crossingOccupied(link) then
		return false
	end
	local crossSeconds = link.Length / (p.Speed * self.Cfg.CrossSpeedFactor) + 1.5
	if link.Signal then
		return (self.TG.WalkAllowed(self.TGraph, tnode, link.ArmPhase, time, crossSeconds))
	end
	if link.ArmEdge and self.Traffic and self.Traffic:ArmBusy(tnode, link.ArmEdge, self.Cfg.CrossGapRadius) then
		return false
	end
	return true
end

function PedSim:Step(dt, ctx)
	local cfg = self.Cfg
	local graph = self.Graph
	local time = ctx.Time or 0
	self.Time = self.Time + dt
	local foci = ctx.Focus or {}
	local fullR2 = (cfg.FullUpdateRadius or math.huge) ^ 2
	self.Spawned, self.Despawned = {}, {}
	local obstacles = ctx.Obstacles or {}
	local vehicles = self.Traffic and self.Traffic.Vehicles or {}

	-- komşuluk ızgarası (yaya ↔ yaya)
	local cell = {}
	local CS = 6
	for _, p in ipairs(self.Peds) do
		local k = floor(p.X / CS) .. ":" .. floor(p.Z / CS)
		cell[k] = cell[k] or {}
		table.insert(cell[k], p)
	end

	local dc = cfg.Doors
	for i = #self.Peds, 1, -1 do
		local p = self.Peds[i]
		if p.State == "Kapı" then
			-- kapının önünde, kapıya dönük; sıradaki biri giriyor/çıkıyorsa bekler
			local e = p.Door
			p.Moving, p.CurSpeed = 0, 0
			p.X, p.Z, p.Y = e.OutX, e.OutZ, e.Y
			p.Timer = p.Timer - dt
			if p.Timer < 0.35 then
				e.OpenUntil = self.Time + 0.8 -- kapı açılmaya başlar
			end
			if p.Timer <= 0 and not self:_doorBusy(e) then
				p.State, p.Timer = "Gir", 0
				e.BusyUntil = self.Time + dc.EnterTime + 0.2
			end
		elseif p.State == "Gir" or p.State == "Çık" then
			-- EnterBuilding / ExitBuilding: kapı boşluğundan geçiş (duvar içinden değil), eşikte kararma
			local e = p.Door
			p.Timer = p.Timer + dt
			local dur = (p.State == "Gir") and dc.EnterTime or dc.ExitTime
			local k = clamp(p.Timer / dur, 0, 1)
			local depth = dc.Depth or 1.8
			local inX, inZ = e.X - e.NX * depth, e.Z - e.NZ * depth
			local ax, az, bx, bz = e.OutX, e.OutZ, inX, inZ
			if p.State == "Çık" then
				ax, az, bx, bz = inX, inZ, e.OutX, e.OutZ
			end
			-- yumuşak başla/bitir (smoothstep): kapıda dururken hız 0'dan artar, içeride/kapı önünde 0'a iner
			local ks = k * k * (3 - 2 * k)
			p.X, p.Z, p.Y = ax + (bx - ax) * ks, az + (bz - az) * ks, e.Y
			local dx, dz = bx - ax, bz - az
			local l = max(sqrt(dx * dx + dz * dz), 0.01)
			p.WX, p.WZ = dx / l, dz / l
			p.CurSpeed = l * 6 * k * (1 - k) / dur
			p.Moving = p.CurSpeed / max(p.Speed, 0.1)
			e.OpenUntil = self.Time + 0.8
			if p.State == "Gir" then
				p.Fade = clamp((k - 0.35) / 0.55, 0, 1) -- eşikten geçerken kararır
				if k >= 1 then
					self.Stats.Entered = self.Stats.Entered + 1
					self:Remove(p, "Bina")
				end
			else
				p.Fade = 1 - clamp(k / 0.5, 0, 1)
				if k >= 1 then
					p.Fade = 0
					p.State = "Yürü"
					p.Node = e.Node
					p.To = e.Node
					p.Door = nil
					self:_arrive(p, ctx) -- yeni hedef ve yol (kapı bağlantısından kaldırıma)
				end
			end
		elseif p.State == "Mola" then
			p.Timer = p.Timer - dt
			p.Moving = 0
			if p.Timer <= 0 then
				p.State = "Yürü"
				self:_arrive(p, ctx)
			end
		elseif p.State == "Bekle" then
			p.Moving = 0
			p.Timer = p.Timer + dt
			local link = p.PendingLink
			if self:_mayCross(p, link, time) then
				if link.Signal and self.TGraph.Nodes[link.Node] then
					local ok = self.TG.WalkAllowed(self.TGraph, self.TGraph.Nodes[link.Node], link.ArmPhase, time, 0)
					if not ok then
						self.Stats.CrossOnRed = self.Stats.CrossOnRed + 1
					end
				end
				self:_startLink(p, link, p.PendingNode)
				p.State = "Geç"
				p.PendingLink, p.PendingNode = nil, nil
				self.Stats.Crossings = self.Stats.Crossings + 1
			elseif not link.Signal and p.Timer > cfg.CrossWaitGiveUp then
				-- vazgeç: başka hedef
				p.PendingLink, p.PendingNode, p.Path, p.Goal = nil, nil, nil, nil
				self.Stats.GaveUp = self.Stats.GaveUp + 1
				local links = {}
				for _, l in ipairs(p.Node.Links) do
					if not l.Crossing then
						links[#links + 1] = l
					end
				end
				if #links > 0 then
					local l = links[1 + floor(self.Rng() * #links) % #links]
					self:_startLink(p, l, (l.A == p.Node) and l.B or l.A)
					p.State = "Yürü"
				else
					p.Timer = 0
				end
			end
		end

		if (p.State == "Yürü" or p.State == "Geç") and p.Link then
			local speed = p.Speed * ((p.State == "Geç") and cfg.CrossSpeedFactor or 1)
			local wantLat = p.Lateral
			local slow = 1
			-- uzak (görüş detayı yok) ve kaldırımdaki yaya: komşu/engel taraması yapılmaz (maliyet LOD)
			local near = true
			if #foci > 0 and p.State ~= "Geç" and not p.Link.Crossing then
				local f = foci[1]
				local best = (f.X - p.X) ^ 2 + (f.Z - p.Z) ^ 2
				for k = 2, #foci do
					local d2 = (foci[k].X - p.X) ^ 2 + (foci[k].Z - p.Z) ^ 2
					if d2 < best then
						best = d2
					end
				end
				near = best < fullR2
			end
			-- diğer yayalar
			local cx, cz = floor(p.X / CS), floor(p.Z / CS)
			for a = cx - 1, (near and cx + 1 or cx - 2) do
				for b = cz - 1, cz + 1 do
					for _, q in ipairs(cell[a .. ":" .. b] or {}) do
						if q ~= p then
							local dx, dz = q.X - p.X, q.Z - p.Z
							local d2 = dx * dx + dz * dz
							if d2 < 36 then
								local ahead = dx * p.DX + dz * p.DZ
								local side = dx * (-p.DZ) + dz * p.DX -- + sağ
								if ahead > 0 and abs(side) < cfg.PersonalSpace then
									if q.Link == p.Link and q.DX * p.DX + q.DZ * p.DZ < -0.5 then
										wantLat = cfg.SidewalkSpread * 0.8 -- karşıdan gelen: sağa kay
									elseif ahead < 2.5 then
										slow = min(slow, (q.Moving or 0) > 0 and 0.6 or 0.25)
										wantLat = clamp(p.LatCur - (side > 0 and 1.5 or -1.5), -cfg.SidewalkSpread, cfg.SidewalkSpread)
									end
								end
							end
						end
					end
				end
			end
			-- oyuncular ve araçlar
			for _, o in ipairs(near and obstacles or {}) do
				local dx, dz = o.X - p.X, o.Z - p.Z
				local d2 = dx * dx + dz * dz
				local r = (o.Kind == "Vehicle") and cfg.VehicleFleeRadius or cfg.PlayerAvoidRadius
				if d2 < r * r then
					local ahead = dx * p.DX + dz * p.DZ
					local side = dx * (-p.DZ) + dz * p.DX
					if o.Kind == "Vehicle" and (o.Speed or 0) > 6 then
						wantLat = (side > 0) and -cfg.SidewalkSpread or cfg.SidewalkSpread -- uzaklaş
						if p.State ~= "Geç" then
							slow = min(slow, 0.3)
						end
					elseif ahead > -0.5 then
						wantLat = (side > 0) and -cfg.SidewalkSpread or cfg.SidewalkSpread
						if ahead < 2.2 then
							slow = min(slow, 0.15)
						end
					end
				end
			end
			-- önündeki araç (duran ya da geçen): gövde kutusuna yürüme (araç zaten yayaya yol verir; çift güvenlik)
			if p.State == "Geç" or p.Link.Crossing then
				local fx, fz = p.X + p.DX * 1.6, p.Z + p.DZ * 1.6
				-- Duran araç kendisini bekliyorsa ikisi birbirini beklemesin: 2.5 sn'den uzun bekleyen yaya duran aracın
				-- köşesinden daha yakın (0.5 pay) geçer. Hareketli araç için pay her zaman büyük.
				if (p.BoxWait or 0) > 2.5 then
					p.SqueezeLink = p.Link -- bu geçit boyunca yakın geçebilir
				end
				local stillPad = (p.SqueezeLink == p.Link) and 0.5 or 0.9
				local blocker = nil
				for _, v in ipairs(vehicles) do
					local dx, dz = v.X - p.X, v.Z - p.Z
					if dx * dx + dz * dz < 400 then
						if v.V > 1 then
							if inVehicleBox(v, fx, fz, 2.5) then
								slow = 0
							end
						elseif inVehicleBox(v, fx, fz, stillPad) then
							slow = 0
							blocker = v
						end
					end
				end
				p.BoxWait = blocker and ((p.BoxWait or 0) + dt) or 0
				-- Etrafından dolaş: duran aracın burnu geçide taşmışsa (yaya onu, o yayayı bekliyor) aracın gövdesinin
				-- yanından 1 stud açıkta geçecek yanal konuma kay (geçidin dışına en fazla 4 stud).
				if blocker and p.BoxWait > 2.5 then
					local lx, lz = -p.DZ, p.DX
					local f = p.From
					local lmin, lmax = math.huge, -math.huge
					local sx, sz = -blocker.HZ, blocker.HX
					for _, a in ipairs({ -1, 1 }) do
						for _, c in ipairs({ -1, 1 }) do
							local cx = blocker.X + blocker.HX * blocker.Len / 2 * a + sx * blocker.Width / 2 * c
							local cz = blocker.Z + blocker.HZ * blocker.Len / 2 * a + sz * blocker.Width / 2 * c
							local lat = (cx - f.X) * lx + (cz - f.Z) * lz
							lmin, lmax = min(lmin, lat), max(lmax, lat)
						end
					end
					local left, right = lmin - 1, lmax + 1
					local target = (abs(left - p.LatCur) <= abs(right - p.LatCur)) and left or right
					if abs(target) > 4 then
						target = (target == left) and right or left -- diğer taraf
					end
					if abs(target) <= 4 then
						p.Detour, p.DetourLink = target, p.Link
					end
				end
			end
			-- yanal konum (geçitte ortada yürü; araç etrafından dolaşırken o yanal konumda)
			if p.State == "Geç" then
				wantLat = clamp(p.Lateral, -1.5, 1.5)
			end
			if p.Detour and p.DetourLink == p.Link then
				wantLat = p.Detour
			end
			if p.Link.Door then
				wantLat = 0 -- kapıya giden yolda kapının ortasına yürü
			end
			local latStep = 1.8 * dt
			p.LatCur = p.LatCur + clamp(wantLat - p.LatCur, -latStep, latStep)
			-- hız rampası: kalkış ve yavaşlama ivmeli; engel/araç kutusu yüzünden "dur" (slow = 0) anında
			local target = speed * slow
			-- karşıya geçmeden önce (geçit başında bekleyecek) ve hedefte yavaşlayarak dur
			local nextStep = p.Path and p.Path[p.PathIndex]
			if (nextStep and nextStep.Link.Crossing) or (p.Goal and p.To == p.Goal) then
				local rest = max(p.Link.Length - p.T, 0)
				target = min(target, max(sqrt(2 * (cfg.WalkDecel or 8) * rest), 1.2))
			end
			local cur = p.CurSpeed or target
			if slow == 0 then
				cur = 0
			elseif target > cur then
				cur = min(target, cur + (cfg.WalkAccel or 6) * dt)
			else
				cur = max(target, cur - (cfg.WalkDecel or 8) * dt)
			end
			p.CurSpeed = cur
			local step = cur * dt
			p.Moving = cur / max(p.Speed, 0.1) -- animasyon adım hızı gerçek hıza bağlı (ayak kayması yok)
			p.T = p.T + step
			if p.T >= p.Link.Length then
				p.T = p.Link.Length
				if p.State == "Geç" then
					p.State = "Yürü"
				end
				self:_arrive(p, ctx)
			end
		end

		-- konum
		local doorState = p.State == "Kapı" or p.State == "Gir" or p.State == "Çık" -- konum yukarıda ayarlandı
		if not doorState and not p.Removed and p.Link then
			local f, t = p.From, p.To
			local L = max(p.Link.Length, 0.01)
			local u = clamp(p.T / L, 0, 1)
			local x = f.X + (t.X - f.X) * u
			local z = f.Z + (t.Z - f.Z) * u
			local lat = p.LatCur
			p.X = x + (-p.DZ) * lat
			p.Z = z + p.DX * lat
			p.WX, p.WZ = p.DX, p.DZ
			if p.Link.Crossing then
				-- uçlarda kaldırım (köşe karesi), ortada yol yüzeyi; kaldırım kenarında yumuşak basamak
				local edgeDist = min(p.T, L - p.T)
				local k = clamp((edgeDist - 3) / 1.2, 0, 1)
				p.Y = graph.Top + (graph.RoadTop - graph.Top) * k
			elseif p.Link.Door then
				p.Y = f.Y + (t.Y - f.Y) * clamp((u - 0.7) / 0.3, 0, 1) -- basamaklı kapıda son kısımda yüksel
			else
				p.Y = graph.Top
			end
		elseif not doorState and not p.Removed and p.Node then
			-- düğümde bekliyor / mola: yanal konumu koru (sıçrama olmasın)
			local lat = p.LatCur or 0
			p.X, p.Z, p.Y = p.Node.X + (-(p.DZ or 0)) * lat, p.Node.Z + (p.DX or 0) * lat, graph.Top
			p.CurSpeed, p.Moving = 0, 0
			if p.State == "Bekle" and p.PendingNode then
				-- geçidin karşısına dön (ışığı bekliyor)
				local dx, dz = p.PendingNode.X - p.Node.X, p.PendingNode.Z - p.Node.Z
				local l = sqrt(dx * dx + dz * dz)
				if l > 0.01 then
					p.WX, p.WZ = dx / l, dz / l
				end
			elseif p.State == "Mola" and p.Node.Spot then
				p.WX, p.WZ = p.Node.Spot.FaceX, p.Node.Spot.FaceZ
			end
		end
		-- yön: istenen yöne dönüş hızıyla dön (köşede ani dönme yok)
		if not p.Removed and p.WX then
			local hx, hz = p.HX or p.WX, p.HZ or p.WZ
			local cross = hx * p.WZ - hz * p.WX
			local dot = hx * p.WX + hz * p.WZ
			local ang = atan2(cross, dot)
			local maxTurn = (cfg.TurnRate or 6) * dt
			if abs(ang) <= maxTurn then
				hx, hz = p.WX, p.WZ
			else
				local a = (ang > 0) and maxTurn or -maxTurn
				local c, s2 = math.cos(a), math.sin(a)
				hx, hz = hx * c - hz * s2, hx * s2 + hz * c
			end
			p.HX, p.HZ = hx, hz
		end
	end

	-- kaldırma ve doğurma. Görünen yaya kaldırılmaz (HardDespawnRadius'a kadar).
	local isVisible = ctx.IsVisible
	local selfTime = self.Time
	local function hidden(p, d)
		if not isVisible then
			return true
		end
		if (p.VisUntil or 0) > selfTime then
			return false
		end
		if isVisible(p.X, p.Y, p.Z, d) then
			p.VisUntil = selfTime + 0.5
			return false
		end
		return true
	end
	local hard = cfg.HardDespawnRadius or math.huge
	for i = #self.Peds, 1, -1 do
		local p = self.Peds[i]
		if #foci > 0 then
			local d = nearestFocus(foci, p.X, p.Z)
			if d > hard or (d > cfg.DespawnRadius and hidden(p, d)) then
				self:Remove(p, "Uzak")
			end
		end
	end
	local target = floor((ctx.MaxPeds or 0) * clamp(ctx.Density or 1, 0, 1) + 0.5)
	local tries, spawned = 0, 0
	local perTick = cfg.SpawnsPerTick
	if #self.Peds < target * 0.6 then
		perTick = perTick * 3
	end
	local ds = self:_doorSchedule(ctx.Hour or 12)
	while #self.Peds < target and spawned < perTick and tries < perTick * 4 do
		tries = tries + 1
		local ok
		if ds and self.Rng() < ds.Spawn then
			ok = self:_trySpawnDoor(ctx, ds)
		else
			ok = self:_trySpawn(ctx)
		end
		if ok then
			spawned = spawned + 1
		else
			self.Stats.Rejected = self.Stats.Rejected + 1
		end
	end
	local excess = #self.Peds - (target + 2)
	if excess > 0 then
		local order = {}
		for _, p in ipairs(self.Peds) do
			order[#order + 1] = { p, nearestFocus(foci, p.X, p.Z) }
		end
		table.sort(order, function(a, b)
			return a[2] > b[2]
		end)
		local removed, checked = 0, 0
		for _, item in ipairs(order) do
			if removed >= min(excess, 4) or checked >= 12 then
				break
			end
			checked = checked + 1
			if hidden(item[1], item[2]) then
				self:Remove(item[1], "Sınır")
				removed = removed + 1
			end
		end
	end
end

-- Saate göre yaya yoğunluk çarpanı
function PedSim:HourDensity(hour)
	return self:_schedule(hour).Density
end

return PedSim
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX04FE7F03N"><Properties>
<string name="Name">TrafficGraph</string>

<ProtectedString name="Source"><![CDATA[-- TrafficGraph: MapDefinitions yol grafiğinden ŞERİT + KAVŞAK grafiği (trafik ve yaya yapay zekâsı).
--
-- SAF Lua: Roblox API'si kullanmaz. tools/test_ambient.py bu dosyayı gerçek harita verisiyle (lupa) çalıştırır.
-- Konumlar .X/.Y/.Z alanlarından okunur (Vector3 veya düz tablo); üretilen tüm koordinatlar düz sayıdır.
--
-- Geometri RoadBuilder ile AYNI kurallardan türetilir:
--   * Kavşak platformu (pad) boyutu ve yol kırpma mesafeleri  → RoadBuilder.planNodes
--   * Şerit merkezleri                                         → RoadBuilder şerit çizgileri (sarı orta çizgi,
--                                                                beyaz şerit çizgisi, otoyol refüjü)
--   * Sağdan trafik. Şerit 1 = en içteki (orta çizgiye en yakın), şerit N = kaldırım tarafı.
--
-- Çıktı:
--   graph.Lanes[i]        { Id, Edge, Kind, From, To, Index, Count, Offset, LaneWidth, X0,Y0,Z0, X1,Y1,Z1,
--                           Length, UX, UZ, Speed, StopS, Out = {conn}, In = {conn}, Group = {lane...}, Vehicles = {} }
--   graph.Connectors[i]   { Id, From = lane, To = lane, Node, Turn ("S"|"L"|"R"|"U"), PX/PY/PZ (dizi), Cum, Length,
--                           MaxSpeed, Phase, Vehicles = {} }
--   graph.Nodes[id]       { Id, X,Y,Z, Degree, Control ("Free"|"Signal"|"Stop"|"Yield"), Pad, ArmPhase, ArmEdge,
--                           Connectors = {}, Reserved = {}, Waiting = {} }

local TrafficGraph = {}

local sqrt, abs, floor, max, min = math.sqrt, math.abs, math.floor, math.max, math.min
local atan2 = math.atan2 or math.atan

local INNER = { street = 0.25, country = 0.25, avenue = 0.8, highway = 0.8, freeway = 1.2 } -- orta çizgi/refüj payı
local OUTER = { highway = 1.0, freeway = 1.2 } -- kenar çizgisi/bariyer payı
local CURVE_SAMPLES = 8
local GRID = 200

local function clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

local function axisOf(dx, dz)
	if dx > 0.99 then
		return "E"
	elseif dx < -0.99 then
		return "W"
	elseif dz > 0.99 then
		return "S"
	elseif dz < -0.99 then
		return "N"
	end
	return nil
end
TrafficGraph.AxisOf = axisOf

local function flatDir(ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l = sqrt(dx * dx + dz * dz)
	if l < 1e-6 then
		return 1, 0
	end
	return dx / l, dz / l
end

-- ===== RoadBuilder.planNodes ile aynı kırpma/platform kuralları =====
local function planNodes(data)
	local roadTrim, walkTrim, pads = {}, {}, {}
	local sidewalkW = data.Meta.Sidewalk or 8
	local function setTrim(edgeId, nodeId, road, walk)
		roadTrim[edgeId] = roadTrim[edgeId] or {}
		walkTrim[edgeId] = walkTrim[edgeId] or {}
		roadTrim[edgeId][nodeId] = road
		walkTrim[edgeId][nodeId] = walk
	end
	for _, node in ipairs(data.NodeList) do
		local p = node.Position
		local adj = {}
		for _, edgeId in ipairs(node.Edges) do
			local e = data.Edges[edgeId]
			local otherId = (e.A == node.Id) and e.B or e.A
			local o = data.Nodes[otherId].Position
			local dx, dz = flatDir(p.X, p.Z, o.X, o.Z)
			adj[#adj + 1] = { Edge = e, DX = dx, DZ = dz, Width = e.Width, Sidewalk = e.Sidewalk, Ramp = e.Kind == "ramp" }
		end
		local elevated = p.Y > 2
		if #adj > 1 then
			local allAxis = true
			for _, a in ipairs(adj) do
				if not axisOf(a.DX, a.DZ) then
					allAxis = false
					break
				end
			end
			if allAxis then
				local w = { E = 0, W = 0, N = 0, S = 0 }
				local anyWalk = false
				for _, a in ipairs(adj) do
					local ax = axisOf(a.DX, a.DZ)
					w[ax] = max(w[ax], a.Width)
					anyWalk = anyWalk or a.Sidewalk
				end
				local collinear = #adj == 2 and ((w.E > 0 and w.W > 0) or (w.N > 0 and w.S > 0))
				if not collinear then
					local wNS, wEW = max(w.N, w.S), max(w.E, w.W)
					local sx = (wNS > 0) and wNS or wEW
					local sz = (wEW > 0) and wEW or wNS
					for _, a in ipairs(adj) do
						local ax = axisOf(a.DX, a.DZ)
						local half = (ax == "E" or ax == "W") and sx / 2 or sz / 2
						setTrim(a.Edge.Id, node.Id, half, half + (anyWalk and sidewalkW or 0))
					end
					pads[node.Id] = {
						Kind = "Box", X = p.X, Y = p.Y, Z = p.Z, SX = sx, SZ = sz, Walk = anyWalk,
						Open = { E = w.E > 0, W = w.W > 0, N = w.N > 0, S = w.S > 0 },
					}
				end
			else
				local mains, ramps = {}, {}
				for _, a in ipairs(adj) do
					if a.Ramp then
						ramps[#ramps + 1] = a
					else
						mains[#mains + 1] = a
					end
				end
				local maxW = 0
				for _, a in ipairs(mains) do
					maxW = max(maxW, a.Width)
				end
				if #mains == 2 and (mains[1].DX * mains[2].DX + mains[1].DZ * mains[2].DZ) < -0.98 then
					for _, r in ipairs(ramps) do
						local t = elevated and (maxW / 2 - 4) or (maxW / 2)
						setTrim(r.Edge.Id, node.Id, t, t)
					end
				elseif #mains == 2 and #ramps == 0 then
					pads[node.Id] = { Kind = "Disc", X = p.X, Y = p.Y, Z = p.Z, SX = maxW, SZ = maxW }
				else
					local size = max(maxW, 16)
					for _, a in ipairs(adj) do
						setTrim(a.Edge.Id, node.Id, size / 2, size / 2)
					end
					pads[node.Id] = { Kind = "Dir", X = p.X, Y = p.Y, Z = p.Z, SX = size, SZ = size }
				end
			end
		end
	end
	return roadTrim, walkTrim, pads
end

local function laneOffsets(kind, width, n, otherN)
	local offs = {}
	local outer = OUTER[kind] or 0
	local lw
	if otherN > 0 then
		local inner = INNER[kind] or 0.3
		lw = (width / 2 - inner - outer) / n
		for k = 1, n do
			offs[k] = inner + lw * (k - 0.5)
		end
	else
		lw = (width - 2 * outer) / n
		for k = 1, n do
			offs[k] = -width / 2 + outer + lw * (k - 0.5)
		end
	end
	return offs, lw
end

-- ===== Kavşak bağlantı eğrisi (ikinci derece Bezier) =====
local function makeCurve(conn, l, o)
	local x0, y0, z0 = l.X1, l.Y1, l.Z1
	local x2, y2, z2 = o.X0, o.Y0, o.Z0
	local ix, iz, ox, oz = l.UX, l.UZ, o.UX, o.UZ
	local dx, dz = x2 - x0, z2 - z0
	local chord = sqrt(dx * dx + dz * dz)
	local cx, cz = (x0 + x2) / 2, (z0 + z2) / 2
	if conn.Turn == "U" then
		local w = max(chord, 4)
		cx, cz = (x0 + x2) / 2 + ix * w, (z0 + z2) / 2 + iz * w
	else
		local det = ix * oz - ox * iz
		if abs(det) > 0.05 then
			local t = (dx * oz - ox * dz) / det
			local u = (ix * dz - dx * iz) / det
			if t > 0 and u > 0 and t < 4 * chord + 10 then
				cx, cz = x0 + ix * t, z0 + iz * t
			end
		end
	end
	local PX, PY, PZ, Cum = {}, {}, {}, {}
	local total = 0
	for s = 0, CURVE_SAMPLES do
		local t = s / CURVE_SAMPLES
		local a, b, c = (1 - t) * (1 - t), 2 * (1 - t) * t, t * t
		local x = a * x0 + b * cx + c * x2
		local z = a * z0 + b * cz + c * z2
		local y = y0 + (y2 - y0) * t
		local n = s + 1
		if n > 1 then
			local ddx, ddy, ddz = x - PX[n - 1], y - PY[n - 1], z - PZ[n - 1]
			total = total + sqrt(ddx * ddx + ddy * ddy + ddz * ddz)
		end
		PX[n], PY[n], PZ[n], Cum[n] = x, y, z, total
	end
	conn.PX, conn.PY, conn.PZ, conn.Cum = PX, PY, PZ, Cum
	conn.Length = max(total, 0.5)
	-- Dönüş yarıçapı → güvenli hız (yanal ivme sınırı)
	local cross = ix * oz - iz * ox
	local dot = ix * ox + iz * oz
	local theta = abs(atan2(cross, dot))
	if theta < 0.2 then
		conn.Radius = 1e6
	else
		conn.Radius = max(chord / (2 * math.sin(theta / 2)), 3)
	end
end

local function classify(l, o)
	local cross = l.UX * o.UZ - l.UZ * o.UX
	local dot = l.UX * o.UX + l.UZ * o.UZ
	local angle = math.deg(atan2(cross, dot)) -- + sağ, - sol (ekranda z aşağı)
	if abs(angle) > 150 then
		return "U", angle
	elseif abs(angle) <= 35 then
		return "S", angle
	elseif angle > 0 then
		return "R", angle
	end
	return "L", angle
end

-- in-şerit l → out-şerit o geçerli mi (şerit kuralları)
local function laneRule(turn, l, o, free)
	if free or turn == "S" then
		-- kaldırım tarafına hizalı eşleme: 2→2 aynı şerit, rampa(1)→otoyol(2) kaldırım şeridi, otoyol→rampa sadece dış şerit
		return o.Index == o.Count - (l.Count - l.Index)
	elseif turn == "R" then
		return l.Index == l.Count and o.Index == o.Count
	end
	return l.Index == 1 and o.Index == 1 -- L ve U
end

-- data: MapDefinitions.GetData() biçiminde (Nodes, NodeList, Edges, EdgeList, Meta)
-- cfg:  AmbientConfig.Traffic. opts.Yield: (fonksiyon) uzun kurulumda ara sıra çağrılır.
function TrafficGraph.Build(data, cfg, opts)
	opts = opts or {}
	local yieldFn = opts.Yield
	local roadTrim, walkTrim, pads = planNodes(data)
	local graph = {
		Lanes = {}, Connectors = {}, Nodes = {}, Grid = {}, Pads = pads, RoadTrim = roadTrim, WalkTrim = walkTrim,
		Meta = data.Meta, Cfg = cfg, EdgeKind = {},
	}
	for _, e in ipairs(data.EdgeList) do
		graph.EdgeKind[e.Id] = e.Kind
	end
	local signal = cfg.Signal

	-- Düğümler
	for _, n in ipairs(data.NodeList) do
		local p = n.Position
		graph.Nodes[n.Id] = {
			Id = n.Id, X = p.X, Y = p.Y, Z = p.Z, Degree = #n.Edges, Pad = pads[n.Id],
			Signal = n.Signal, Stop = n.Stop, Crosswalk = n.Crosswalk,
			Connectors = {}, InLanes = {}, OutLanes = {}, ArmPhase = {}, ArmEdge = {}, ArmEdges = {},
			Reserved = {}, Waiting = {}, Offset = 0, Greens = { signal.Green, signal.Green },
			Cycle = 2 * (signal.Green + signal.Yellow + signal.AllRed),
		}
	end

	-- Şeritler
	local function trimOf(edgeId, nodeId)
		local t = roadTrim[edgeId]
		return t and t[nodeId] or 0
	end
	local count = 0
	for _, e in ipairs(data.EdgeList) do
		local nA, nB = data.Nodes[e.A], data.Nodes[e.B]
		if nA and nB then
			for pass = 1, 2 do
				local from, to, n, other
				if pass == 1 then
					from, to, n, other = nA, nB, e.LanesForward, e.LanesBackward
				else
					from, to, n, other = nB, nA, e.LanesBackward, e.LanesForward
				end
				if n and n > 0 then
					local P, Q = from.Position, to.Position
					local dx, dz = Q.X - P.X, Q.Z - P.Z
					local L = sqrt(dx * dx + dz * dz)
					if L > 1 then
						local ux, uz = dx / L, dz / L
						local rx, rz = -uz, ux -- sağ
						local tP = min(trimOf(e.Id, from.Id), L * 0.45)
						local tQ = min(trimOf(e.Id, to.Id), L * 0.45)
						local offs, lw = laneOffsets(e.Kind, e.Width, n, other or 0)
						local group = {}
						for k = 1, n do
							local off = offs[k]
							local lane = {
								Id = #graph.Lanes + 1, Edge = e.Id, Kind = e.Kind, From = from.Id, To = to.Id,
								Index = k, Count = n, Offset = off, LaneWidth = lw,
								X0 = P.X + ux * tP + rx * off, Y0 = P.Y + (Q.Y - P.Y) * tP / L, Z0 = P.Z + uz * tP + rz * off,
								X1 = Q.X - ux * tQ + rx * off, Y1 = Q.Y + (P.Y - Q.Y) * tQ / L, Z1 = Q.Z - uz * tQ + rz * off,
								UX = ux, UZ = uz, RX = rx, RZ = rz, Speed = e.Speed, Out = {}, In = {}, Group = group, Vehicles = {},
							}
							local lx, ly, lz = lane.X1 - lane.X0, lane.Y1 - lane.Y0, lane.Z1 - lane.Z0
							lane.Length = sqrt(lx * lx + ly * ly + lz * lz)
							group[k] = lane
							graph.Lanes[#graph.Lanes + 1] = lane
							local gTo, gFrom = graph.Nodes[to.Id], graph.Nodes[from.Id]
							gTo.InLanes[#gTo.InLanes + 1] = lane
							gFrom.OutLanes[#gFrom.OutLanes + 1] = lane
						end
					end
				end
			end
		end
		count = count + 1
		if yieldFn and count % 60 == 0 then
			yieldFn()
		end
	end

	-- Kavşak kontrolü, kol fazları, durma çizgileri
	for _, node in pairs(graph.Nodes) do
		local refX, refZ = nil, nil
		local arms = {}
		for _, lane in ipairs(node.InLanes) do
			arms[lane.Edge] = { -lane.UX, -lane.UZ } -- düğümden dışarı
		end
		for _, lane in ipairs(node.OutLanes) do
			arms[lane.Edge] = { lane.UX, lane.UZ }
		end
		local edgeIds = {}
		for edgeId in pairs(arms) do
			edgeIds[#edgeIds + 1] = edgeId
		end
		table.sort(edgeIds)
		for _, edgeId in ipairs(edgeIds) do
			local d = arms[edgeId]
			if not refX then
				refX, refZ = d[1], d[2]
			end
			local phase = (abs(d[1] * refX + d[2] * refZ) > 0.7) and 1 or 2
			node.ArmPhase[edgeId] = phase
			local axis = axisOf(d[1], d[2])
			if axis then
				node.ArmEdge[axis] = edgeId
			end
			node.ArmEdges[#node.ArmEdges + 1] = edgeId
		end
		if node.Degree <= 2 then
			node.Control = "Free"
		elseif node.Signal then
			node.Control = "Signal"
			TrafficGraph._planSignal(graph, node, arms)
		elseif node.Stop then
			node.Control = "Stop"
		else
			node.Control = "Yield"
		end
		local back = 1.5
		if node.Control ~= "Free" and node.Crosswalk and node.Pad and node.Pad.Kind == "Box" then
			back = 9 -- yaya geçidinin önünde dur (çizgiler kol başından 1..7 stud içeride)
		end
		for _, lane in ipairs(node.InLanes) do
			lane.StopS = max(lane.Length - back, lane.Length * 0.5)
		end
	end

	-- Bağlantılar
	count = 0
	for _, node in pairs(graph.Nodes) do
		local free = node.Degree <= 2
		for _, l in ipairs(node.InLanes) do
			for _, o in ipairs(node.OutLanes) do
				if o.Edge ~= l.Edge or node.Degree == 1 then
					local turn = classify(l, o)
					if laneRule(turn, l, o, free) then
						TrafficGraph._connect(graph, node, l, o, turn)
					end
				end
			end
		end
		-- Hiç çıkışı olmayan şerit kalmasın: her hedef kola en uygun şeritten bağla
		for _, l in ipairs(node.InLanes) do
			if #l.Out == 0 then
				local byEdge = {}
				for _, o in ipairs(node.OutLanes) do
					if o.Edge ~= l.Edge or node.Degree == 1 then
						local best = byEdge[o.Edge]
						local score = abs((o.Count - o.Index) - (l.Count - l.Index))
						if not best or score < best.Score then
							byEdge[o.Edge] = { Lane = o, Score = score }
						end
					end
				end
				for _, b in pairs(byEdge) do
					TrafficGraph._connect(graph, node, l, b.Lane, (classify(l, b.Lane)))
				end
			end
		end
		count = count + 1
		if yieldFn and count % 40 == 0 then
			yieldFn()
		end
	end

	-- Yumurtlama ızgarası: şerit üzerindeki örnek noktalar
	for _, lane in ipairs(graph.Lanes) do
		local steps = max(1, floor(lane.Length / 80))
		local seen = {}
		for i = 0, steps do
			local t = i / steps
			local x = lane.X0 + (lane.X1 - lane.X0) * t
			local z = lane.Z0 + (lane.Z1 - lane.Z0) * t
			local key = floor(x / GRID) .. ":" .. floor(z / GRID)
			if not seen[key] then
				seen[key] = true
				local cell = graph.Grid[key]
				if not cell then
					cell = {}
					graph.Grid[key] = cell
				end
				cell[#cell + 1] = lane
			end
		end
	end
	return graph
end

function TrafficGraph._connect(graph, node, l, o, turn)
	local conn = {
		Id = #graph.Connectors + 1, From = l, To = o, Node = node.Id, Turn = turn,
		Phase = node.ArmPhase[l.Edge] or 1, Vehicles = {},
	}
	makeCurve(conn, l, o)
	local cfg = graph.Cfg
	local speedLimit = min(l.Speed, o.Speed)
	if conn.Radius < 1e5 then
		speedLimit = min(speedLimit, sqrt(cfg.TurnLateralAccel * conn.Radius))
	end
	conn.MaxSpeed = max(speedLimit, 6)
	graph.Connectors[conn.Id] = conn
	l.Out[#l.Out + 1] = conn
	o.In[#o.In + 1] = conn
	node.Connectors[#node.Connectors + 1] = conn
	return conn
end

-- ===== Sorgular =====
function TrafficGraph.LanesNear(graph, x, z, radius)
	local out, seen = {}, {}
	local c0x, c1x = floor((x - radius) / GRID), floor((x + radius) / GRID)
	local c0z, c1z = floor((z - radius) / GRID), floor((z + radius) / GRID)
	for cx = c0x, c1x do
		for cz = c0z, c1z do
			local cell = graph.Grid[cx .. ":" .. cz]
			if cell then
				for _, lane in ipairs(cell) do
					if not seen[lane] then
						seen[lane] = true
						out[#out + 1] = lane
					end
				end
			end
		end
	end
	return out
end

function TrafficGraph.LanePoint(lane, s)
	local t = (lane.Length > 0) and clamp(s / lane.Length, 0, 1) or 0
	return lane.X0 + (lane.X1 - lane.X0) * t, lane.Y0 + (lane.Y1 - lane.Y0) * t, lane.Z0 + (lane.Z1 - lane.Z0) * t, lane.UX, lane.UZ
end

-- Yön: eğri parçasının yönü; parça sıfır uzunluktaysa (düz birleşimde şerit ucu = sonraki şerit başı)
-- giriş şeridinin yönü kullanılır — yön asla (0, 0) olmaz.
local function headingOf(conn, hx, hz)
	local hl = sqrt(hx * hx + hz * hz)
	if hl < 1e-4 then
		return conn.From.UX, conn.From.UZ
	end
	return hx / hl, hz / hl
end

function TrafficGraph.ConnPoint(conn, s)
	local cum = conn.Cum
	local n = #cum
	if s <= 0 then
		local hx, hz = headingOf(conn, conn.PX[2] - conn.PX[1], conn.PZ[2] - conn.PZ[1])
		return conn.PX[1], conn.PY[1], conn.PZ[1], hx, hz
	end
	for i = 2, n do
		if cum[i] >= s or i == n then
			local seg = max(cum[i] - cum[i - 1], 1e-6)
			local t = clamp((s - cum[i - 1]) / seg, 0, 1)
			local dx, dz = conn.PX[i] - conn.PX[i - 1], conn.PZ[i] - conn.PZ[i - 1]
			local hx, hz = headingOf(conn, dx, dz)
			return conn.PX[i - 1] + dx * t, conn.PY[i - 1] + (conn.PY[i] - conn.PY[i - 1]) * t, conn.PZ[i - 1] + dz * t, hx, hz
		end
	end
	local hx, hz = headingOf(conn, 0, 0)
	return conn.PX[n], conn.PY[n], conn.PZ[n], hx, hz
end

-- Işık durumu: "G" | "Y" | "R" ve bu durumun kalan süresi. time: sunucu zamanı (tüm oyuncularda aynı)
-- Işık planı (Yaşayan Şehir): yüksek sınıflı yolun (cadde/otoyol) fazına uzun yeşil, yan yola kısa; eşitse eşit.
-- Ofset "yeşil dalga": ana yol yönündeki koordinat / dalga hızı → o yönde dalga hızıyla giden araçlar art arda
-- yeşile denk gelir. Tamamen haritadan hesaplanır: tüm istemcilerde aynı plan, aynı sunucu saati → aynı ışık.
local CLASS_RANK = { freeway = 3, highway = 3, avenue = 3, street = 1, country = 1, ramp = 1 }

function TrafficGraph._planSignal(graph, node, arms)
	local s = graph.Cfg.Signal
	local rank = { 0, 0 }
	local axisX = { false, false }
	for edgeId, d in pairs(arms) do
		local phase = node.ArmPhase[edgeId] or 1
		local e = graph.EdgeKind[edgeId]
		local r = CLASS_RANK[e] or 1
		if r > rank[phase] then
			rank[phase] = r
		end
		axisX[phase] = abs(d[1]) > 0.7
	end
	local g1, g2 = s.Green, s.Green
	local main = 1
	if rank[1] > rank[2] then
		g1, g2, main = s.MainGreen or s.Green, s.SideGreen or s.Green, 1
	elseif rank[2] > rank[1] then
		g1, g2, main = s.SideGreen or s.Green, s.MainGreen or s.Green, 2
	end
	node.Greens = { g1, g2 }
	node.Cycle = g1 + g2 + 2 * (s.Yellow + s.AllRed)
	local coord = axisX[main] and node.X or node.Z
	local wave = s.WaveSpeed or 0
	local startMain = (main == 1) and 0 or (g1 + s.Yellow + s.AllRed)
	if wave > 0 then
		node.Offset = (startMain - coord / wave) % node.Cycle -- ana yolun yeşili ana yol boyunca kayar
	else
		node.Offset = (node.Id * 7.31) % node.Cycle
	end
end

function TrafficGraph.SignalState(graph, node, phase, time)
	local s = graph.Cfg.Signal
	local g1, g2 = node.Greens[1], node.Greens[2]
	local cycle = node.Cycle
	local t = (time + node.Offset) % cycle
	local start = (phase == 1) and 0 or (g1 + s.Yellow + s.AllRed)
	local green = (phase == 1) and g1 or g2
	local tp = (t - start) % cycle
	if tp < green then
		return "G", green - tp
	elseif tp < green + s.Yellow then
		return "Y", green + s.Yellow - tp
	end
	return "R", cycle - tp
end

-- Yaya: kolu (o kolun trafiği kırmızıyken) geçebilir mi? Diğer faz yeşil ve kalan süre yetiyorsa.
-- Yaya yeşili: kolun trafiği kırmızı (diğer faz yeşil) ve karşı trafiğe yeşil yanana kadar kalan süre (kalan yeşil +
-- sarı + tümü kırmızı) geçiş süresinin PedClearFactor katından uzun. (Yaşayan Şehir: ana yolda yan faz kısa olduğu için
-- "kalan yeşil > geçiş süresi" geniş caddede neredeyse hiç sağlanmıyordu; geç kalan yayayı araçlar zaten bekler.)
function TrafficGraph.WalkAllowed(graph, node, armPhase, time, crossSeconds)
	local other = (armPhase == 1) and 2 or 1
	local state, remaining = TrafficGraph.SignalState(graph, node, other, time)
	local s = graph.Cfg.Signal
	local window = remaining + s.Yellow + s.AllRed
	return state == "G" and (crossSeconds <= 0 or window > crossSeconds * (s.PedClearFactor or 1)), state, remaining
end

-- ===== Çatışma haritası (tembel; düğüm başına bir kez) =====
local function segCross(ax, az, bx, bz, cx, cz, dx, dz)
	local d1x, d1z, d2x, d2z = bx - ax, bz - az, dx - cx, dz - cz
	local den = d1x * d2z - d1z * d2x
	if abs(den) < 1e-9 then
		return false
	end
	local t = ((cx - ax) * d2z - (cz - az) * d2x) / den
	local u = ((cx - ax) * d1z - (cz - az) * d1x) / den
	return t > 0.02 and t < 0.98 and u > 0.02 and u < 0.98
end

local CLEARANCE = 7.5 -- iki eğri bu kadar yaklaşıyorsa (araç gövdeleri sürtünür) çakışma say

-- a, b: { PX = {...}, PZ = {...} } çoklu çizgiler
local function pathsCross(a, b)
	for i = 1, #a.PX - 1 do
		for j = 1, #b.PX - 1 do
			if segCross(a.PX[i], a.PZ[i], a.PX[i + 1], a.PZ[i + 1], b.PX[j], b.PZ[j], b.PX[j + 1], b.PZ[j + 1]) then
				return true
			end
		end
	end
	-- kesişmese de gövdeler sürtünecek kadar yakın geçiyorsa (karşılıklı sola dönüşler gibi)
	local c2 = CLEARANCE * CLEARANCE
	for i = 2, #a.PX - 1 do
		for j = 2, #b.PX - 1 do
			local dx, dz = a.PX[i] - b.PX[j], a.PZ[i] - b.PZ[j]
			if dx * dx + dz * dz < c2 then
				return true
			end
		end
	end
	return false
end

-- Platformsuz düğümlerde (otoyol/rampa birleşimi) bağlantı eğrisi kısa ya da sıfır olabilir ve bir rampa döngüsü
-- şeridin düğümden önceki kısmının üstünden geçebilir: çakışma için bağlantıya şeridin son ve hedef şeridin ilk
-- EXT studu da eklenir (Yaşayan Şehir: otoyol düğümünde rampadan gelenle çarpışma bulundu).
local EXT = 15
local function extendedPath(conn)
	local PX, PZ = {}, {}
	local from, to = conn.From, conn.To
	local e1 = math.min(EXT, from.Length)
	for k = 0, 2 do
		local s = from.Length - e1 + e1 * k / 3
		local t = (from.Length > 0) and s / from.Length or 0
		PX[#PX + 1] = from.X0 + (from.X1 - from.X0) * t
		PZ[#PZ + 1] = from.Z0 + (from.Z1 - from.Z0) * t
	end
	for i = 1, #conn.PX do
		PX[#PX + 1], PZ[#PZ + 1] = conn.PX[i], conn.PZ[i]
	end
	local e2 = math.min(EXT, to.Length)
	for k = 1, 3 do
		local t = (to.Length > 0) and (e2 * k / 3) / to.Length or 0
		PX[#PX + 1] = to.X0 + (to.X1 - to.X0) * t
		PZ[#PZ + 1] = to.Z0 + (to.Z1 - to.Z0) * t
	end
	return { PX = PX, PZ = PZ }
end

function TrafficGraph.Conflicts(_graph, node)
	if node.ConflictMap then
		return node.ConflictMap
	end
	local map = {}
	local list = node.Connectors
	local boxed = node.Pad and node.Pad.Kind == "Box"
	local ext = {}
	for i = 1, #list do
		map[list[i]] = map[list[i]] or {}
		if not boxed then
			ext[list[i]] = extendedPath(list[i])
		end
	end
	for i = 1, #list do
		local a = list[i]
		for j = i + 1, #list do
			local b = list[j]
			local conflict = false
			if a.To == b.To then
				conflict = a.From ~= b.From -- aynı şeride birleşme
			elseif a.From.Group ~= b.From.Group then
				conflict = pathsCross(a, b) or (not boxed and pathsCross(ext[a], ext[b]))
			end
			if conflict then
				map[a][b] = true
				map[b][a] = true
			end
		end
	end
	node.ConflictMap = map
	return map
end

return TrafficGraph
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9C513E18N"><Properties>
<string name="Name">TrafficSim</string>

<ProtectedString name="Source"><![CDATA[-- TrafficSim: NPC araç simülasyonu (Aşama 6). SAF Lua; Roblox API'si yok (tools/test_ambient.py çalıştırır).
--
-- Her araç bir şeritte (lane) ya da kavşak bağlantısında (connector) "S" mesafesindedir. Her adımda:
--   1. Sürüş modeli (IDM): öndeki araç, durma çizgisi, engeller (oyuncu, oyuncu aracı, yaya) ve viraj hızı
--      kısıtlarından en sıkısı ivmeyi belirler → yumuşak hızlanma, güvenli duruş.
--   2. Kavşak izni: ışık (sunucu saatine bağlı), dur levhası (tam duruş + geliş sırası), yol ver (rampa).
--      İzin alan araç bağlantısını REZERVE eder; çakışan bağlantılar (kesişen ya da aynı şeride birleşen) boşalana
--      kadar kimse giremez. Çıkış şeridinde yer yoksa kavşağa girilmez ("kavşağı tıkama").
--   3. Engel arkasında kalırsa çok şeritli yolda yan şeride geçer; çok uzun süre tıkalı kalırsa (oyuncudan uzakta)
--      kaldırılır.
--   4. Oyuncunun çevresinde yoğunluğa göre GEÇERLİ bir şeritte doğar, uzaklaşınca kaldırılır (havuz istemcide).
--
-- ctx (Step): Time (sunucu zamanı), Focus = { {X,Z}... }, Obstacles = { {X,Y,Z,R,Kind,VX?,VZ?}... }, MaxVehicles,
--             Density (0..1), CanSpawn(x,y,z,dist) -> bool (görünürlük), DensityAt(x,z) -> 0..1,
--             IsVisible(x,y,z,dist) -> bool (Yaşayan Şehir: görünen araç kaldırılmaz), MixAt(x,z) -> { kindId = çarpan }
--
-- Yaşayan Şehir eklentileri: yol sınıfına göre doğma ağırlığı (cadde yoğun, ara sokak seyrek), sınıfa göre dönüş
-- tercihi, sarsıntısız kalkış (ivme artışı sınırlı, fren anında), dur-kalk titremesine karşı duruş eşiği,
-- tıkalı çıkışta alternatif yön, rezervasyon kilidi bekçisi, bölgeye göre araç karışımı.

local TrafficSim = {}
TrafficSim.__index = TrafficSim

local sqrt, abs, max, min, floor = math.sqrt, math.abs, math.max, math.min, math.floor

local function newRng(seed)
	local state = floor(seed) % 2147483646 + 1
	return function()
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

-- graph: TrafficGraph.Build sonucu; cfg: AmbientConfig.Traffic; kinds: { {Id, Length, Width, MaxSpeed, Weight} }
-- TG: TrafficGraph modülü (bağımlılık enjeksiyonu; saf Lua testinde require yok)
function TrafficSim.new(graph, cfg, kinds, TG, seed)
	local self = setmetatable({}, TrafficSim)
	self.Graph, self.Cfg, self.Kinds, self.TG = graph, cfg, kinds, TG
	self.Rng = newRng(seed or 12345)
	self.Vehicles = {}
	self.NextId = 1
	self.Time = 0
	self.ReservedNodes = {}
	self.Spawned, self.Despawned = {}, {}
	self.Stats = {
		Spawns = 0, Despawns = 0, Rejected = 0, LaneChanges = 0, Entries = 0, RedEntries = 0, Removed = 0,
		Reroutes = 0, Locked = 0, Leaks = 0, Watchdog = 0, WatchdogObstacle = 0,
	}
	self.LaneCache = {}
	self.NextAudit = 5
	local total = 0
	for _, k in ipairs(kinds) do
		total = total + (k.Weight or 1)
	end
	self.KindWeight = total
	return self
end

-- ===== Yardımcılar =====
local function segList(v)
	return v.Seg.Vehicles
end

local function insertSorted(list, v)
	local i = #list
	while i >= 1 and list[i].S > v.S do
		list[i + 1] = list[i]
		i = i - 1
	end
	list[i + 1] = v
end

local function removeFrom(list, v)
	for i = 1, #list do
		if list[i] == v then
			table.remove(list, i)
			return
		end
	end
end

-- mix: { kindId = çarpan } (bölge karışımı; yoksa yapılandırmadaki ağırlıklar)
function TrafficSim:_pickKind(mix)
	local total = self.KindWeight
	if mix then
		total = 0
		for _, k in ipairs(self.Kinds) do
			total = total + (k.Weight or 1) * (mix[k.Id] or 1)
		end
	end
	local r = self.Rng() * total
	for _, k in ipairs(self.Kinds) do
		r = r - (k.Weight or 1) * (mix and mix[k.Id] or 1)
		if r <= 0 then
			return k
		end
	end
	return self.Kinds[1]
end

local TURN_WEIGHT = { S = 0.5, R = 0.26, L = 0.22, U = 0.02 }
-- Dönüş tercihi: üst sınıf yola (cadde/otoyol) çıkan bağlantılar daha olası → trafik ana yollarda toplanır,
-- ara sokaklar seyrek kalır (TurnClassBias = 0 → eski davranış)
function TrafficSim:_turnWeight(c)
	local w = TURN_WEIGHT[c.Turn] or 0.1
	local bias = self.Cfg.TurnClassBias
	local cw = self.Cfg.ClassWeight
	if bias and cw then
		w = w * (1 - bias + bias * (cw[c.To.Kind] or 0.5))
	end
	return w
end

function TrafficSim:_pickNext(lane, exclude)
	local outs = lane.Out
	if #outs == 0 then
		return nil
	end
	local total = 0
	for _, c in ipairs(outs) do
		if c ~= exclude then
			total = total + self:_turnWeight(c)
		end
	end
	if total <= 0 then
		return outs[1]
	end
	local r = self.Rng() * total
	local last = outs[#outs]
	for _, c in ipairs(outs) do
		if c ~= exclude then
			r = r - self:_turnWeight(c)
			last = c
			if r <= 0 then
				return c
			end
		end
	end
	return last
end

-- d stud ilerideki yol noktası (x, z)
function TrafficSim:_pointAhead(v, d)
	local TG = self.TG
	local seg, s = v.Seg, v.S + d
	if v.OnConn then
		if s <= seg.Length then
			local x, _, z = TG.ConnPoint(seg, s)
			return x, z
		end
		local x, _, z = TG.LanePoint(seg.To, s - seg.Length)
		return x, z
	end
	if s <= seg.Length or not v.Next then
		local x, _, z = TG.LanePoint(seg, s)
		if v.Lat ~= 0 then
			-- şerit değiştirirken: yanal kayma ileri gittikçe kapanır (yanal hız ileri hıza bağlı, bkz. Step)
			local close = abs(v.Lat) * max(v.V, 1.5) / max(v.LatRate or 1, 0.1)
			local k = max(0, 1 - d / max(close, 1))
			x, z = x + seg.RX * v.Lat * k, z + seg.RZ * v.Lat * k
		end
		return x, z
	end
	s = s - seg.Length
	if s <= v.Next.Length then
		local x, _, z = TG.ConnPoint(v.Next, s)
		return x, z
	end
	local x, _, z = TG.LanePoint(v.Next.To, s - v.Next.Length)
	return x, z
end

-- IDM ivmesi. gap: önündeki engele net boşluk; vLead: onun hızı. gap nil → serbest yol
-- Öngörü (Anticipation, sn): öndeki benden hızlıysa (ör. ışıkta kalktı) boşluğun birazdan açılacağını hesaba katar →
-- kuyruk daha çabuk çözülür. Öndeki yavaşlarsa terim sıfırdır (güvenlik aynı).
local function idm(cfg, v, v0, gap, vLead)
	local a, b = cfg.MaxAccel, cfg.ComfortDecel
	local free = 1 - (v / max(v0, 0.5)) ^ 4
	if not gap then
		return a * free
	end
	if vLead > v and cfg.Anticipation then
		gap = gap + (vLead - v) * cfg.Anticipation
	end
	local sStar = cfg.MinGap + max(0, v * cfg.Headway + v * (v - vLead) / (2 * sqrt(a * b)))
	local g = max(gap, 0.05)
	return a * (free - (sStar / g) ^ 2)
end

-- ===== Kavşak izni =====
function TrafficSim:_targetHasRoom(v, conn)
	local to = conn.To
	local first = to.Vehicles[1]
	local room = first and (first.S - first.Len / 2) or to.Length
	local entering = 0
	for _, c in ipairs(to.In) do
		for _, w in ipairs(c.Vehicles) do
			room = room - (w.Len + self.Cfg.MinGap)
			entering = entering + 1
		end
	end
	if not first and entering == 0 then
		return true -- boş şerit: aracın boyundan kısa olsa bile girilebilir (kısa ara şeritler)
	end
	-- +1.5 pay: kuyruğun arkasında duran aracın arka tamponu kavşağın dışında kalsın ("kavşağı tıkama")
	return room >= min(v.Len + self.Cfg.MinGap + 1.5, to.Length * 0.8)
end

-- Çıkış kapalı mı? (oyuncu/oyuncu aracı kavşak içinde ya da çıkış şeridinin başında duruyor). Kapalıysa kavşağa
-- girilmez: araç kavşağın ortasında kalıp diğer yönleri tıkamaz; bir süre sonra başka yöne döner (_reroute).
-- Karşıdan karşıya geçen yaya burada sayılmaz (onu bekleme kuralları zaten çözer).
function TrafficSim:_exitBlocked(v, node, conn)
	local obstacles = self.Obstacles
	if not obstacles or #obstacles == 0 then
		return false
	end
	local lane = conn.To
	local need = v.Len + self.Cfg.MinGap + 2
	-- yanal eşik, sürüşteki engel freniyle aynı (araç: gövde yarı genişliği; insan: şerit yarı genişliği)
	local halfBody = v.Width / 2 + 0.5
	local halfLane = max(conn.From.LaneWidth / 2, halfBody)
	for _, o in ipairs(obstacles) do
		if o.Kind ~= "Pedestrian" then
			local r = o.R or 2
			local lim = ((o.Kind == "Vehicle") and halfBody or halfLane) + r
			local nx, nz = o.X - node.X, o.Z - node.Z
			if nx * nx + nz * nz < 3600 then
				local ox, oz = o.X - lane.X0, o.Z - lane.Z0
				local along = ox * lane.UX + oz * lane.UZ
				local side = abs(ox * lane.RX + oz * lane.RZ)
				if along > -2 and along < need + r and side < max(lane.LaneWidth / 2 + r, lim) then
					return true
				end
				local steps = max(2, floor(conn.Length / 3))
				for i = 0, steps do
					local px, _, pz = self.TG.ConnPoint(conn, conn.Length * i / steps)
					local ex, ez = o.X - px, o.Z - pz
					if ex * ex + ez * ez < lim * lim then
						return true
					end
				end
			end
		end
	end
	return false
end

-- Çıkıştaki yaya geçidinde (hedef şeridin ilk metreleri) karşıya geçen yaya var mı ya da şeridime yaklaşıyor mu?
-- Varsa kavşağa girmeden çizgide beklenir (kavşağın ortasında yaya bekleyip yolu tıkamak yerine).
function TrafficSim:_exitCrosswalkBusy(v, conn)
	local obstacles = self.Obstacles
	if not obstacles or #obstacles == 0 then
		return false
	end
	local lane = conn.To
	local need = v.Len + self.Cfg.MinGap + 2
	for _, o in ipairs(obstacles) do
		if o.Kind == "Pedestrian" then
			local r = o.R or 1.4
			local ox, oz = o.X - lane.X0, o.Z - lane.Z0
			local along = ox * lane.UX + oz * lane.UZ
			if along > -2 and along < need then
				local side = abs(ox * lane.RX + oz * lane.RZ)
				if side < lane.LaneWidth / 2 + r + 8 then
					return true
				end
			end
		end
	end
	return false
end

function TrafficSim:_conflictReserved(node, conn)
	local conflicts = self.TG.Conflicts(self.Graph, node)[conn]
	if not conflicts then
		return false
	end
	for other in pairs(conflicts) do
		if (node.Reserved[other] or 0) > 0 then
			return true
		end
	end
	return false
end

-- Önceliği olan (çakışan) bir araç kavşağa yaklaşıyor mu? (sol dönüş / rampa yol verir)
function TrafficSim:_priorityApproaching(node, conn, onlyStraight)
	local conflicts = self.TG.Conflicts(self.Graph, node)[conn]
	if not conflicts then
		return false
	end
	local look = self.Cfg.YieldLookAhead
	for other in pairs(conflicts) do
		if other.From.Group ~= conn.From.Group and (not onlyStraight or other.Turn ~= "L") then
			for _, w in ipairs(other.From.Vehicles) do
				if w.Next == other and (other.From.Length - w.S) < look and w.V > 1.5 then
					return true
				end
			end
		end
	end
	return false
end

-- Sarıda: karşıdan gelip artık DURAMAYACAK (kavşağa girmek zorunda) öncelikli araç var mı?
function TrafficSim:_priorityCommitted(node, conn)
	local conflicts = self.TG.Conflicts(self.Graph, node)[conn]
	if not conflicts then
		return false
	end
	local b = self.Cfg.ComfortDecel
	for other in pairs(conflicts) do
		if other.From.Group ~= conn.From.Group then
			for _, w in ipairs(other.From.Vehicles) do
				if w.Next == other and w.V > 1.5 and (other.From.StopS - w.S - w.Len / 2) < w.V * w.V / (2 * b) + 3 then
					return true
				end
			end
		end
	end
	return false
end

function TrafficSim:_canEnter(v, node, conn, distToStop, time)
	local control = node.Control
	if control == "Free" and #conn.To.In <= 1 then
		return true
	end
	if not self:_targetHasRoom(v, conn) then
		return false, "Dolu"
	end
	if self:_exitBlocked(v, node, conn) then
		return false, "Kapalı"
	end
	if self:_exitCrosswalkBusy(v, conn) then
		return false, "Geçit"
	end
	if self:_conflictReserved(node, conn) or self:_tailBlocks(node, conn, v) then
		return false, "Çakışma"
	end
	if control == "Free" then
		return true -- şerit birleşmesi (şerit sayısı azalıyor): sadece rezervasyon + yer kontrolü
	end
	if control == "Signal" then
		local state, left = self.TG.SignalState(self.Graph, node, conn.Phase, time)
		if state == "R" then
			return false, "Kırmızı"
		elseif state == "Y" then
			-- yeşil boyunca karşı akış yüzünden dönemeyen (çizgide bekleyen) sola dönen araç sarıda döner:
			-- karşıdan gelenler durur; sadece artık duramayacak olana yol verir. Kırmızı + tümü kırmızı içinde çıkar.
			local turnL = conn.Turn == "L" or conn.Turn == "U"
			if turnL and (v.LeftWait or 0) > 2 and v.V < 2 and left > 1.2 then
				if self:_priorityCommitted(node, conn) then
					return false, "SolDönüş"
				end
				return true
			end
			if distToStop > (v.V * v.V) / (2 * self.Cfg.ComfortDecel) then
				return false, "Sarı"
			end
		end
		if (conn.Turn == "L" or conn.Turn == "U") and self:_priorityApproaching(node, conn, true) then
			return false, "SolDönüş"
		end
		return true
	elseif control == "Stop" then
		if (v.StopTimer or 0) < self.Cfg.StopSignWait then
			return false, "Dur"
		end
		-- geliş sırası: benden önce durmuş ve çakışan yöne gidecek biri varsa bekle
		local conflicts = self.TG.Conflicts(self.Graph, node)[conn] or {}
		for w, arrived in pairs(node.Waiting) do
			if w ~= v and w.Next and conflicts[w.Next] and arrived < (node.Waiting[v] or math.huge) then
				return false, "Sıra"
			end
		end
		return true
	end
	-- Yield: rampadan gelen ana yola yol verir
	if conn.From.Kind == "ramp" and self:_priorityApproaching(node, conn, false) then
		return false, "YolVer"
	end
	return true
end

function TrafficSim:_reserve(v, node, conn)
	node.Reserved[conn] = (node.Reserved[conn] or 0) + 1
	self.ReservedNodes[node] = true
	v.Reserve = conn
	v.ReserveNode = node
end

function TrafficSim:_release(v)
	local conn, node = v.Reserve, v.ReserveNode
	if conn and node then
		node.Reserved[conn] = max((node.Reserved[conn] or 1) - 1, 0)
	end
	v.Reserve, v.ReserveNode = nil, nil
end

-- Kuyruk: araç bağlantıdan çıkış şeridine geçtiğinde arkası hâlâ kavşağın içinde olabilir (ör. çıkıştaki yaya
-- geçidinde durdu). Rezervasyon bırakılır (bütün çakışan yönleri kapatmak şebekede kilitlenme yaratır), ama araç
-- arka tamponu kavşaktan çıkana kadar düğümün "kuyruk" listesinde kalır: gövdesi bir bağlantının yolunu GERÇEKTEN
-- kesiyorsa o bağlantıya giriş izni verilmez (_tailBlocks) ve kavşaktaki araç onun önünde durur.
function TrafficSim:_moveToTail(v)
	self:_releaseTail(v)
	local conn, node = v.Reserve, v.ReserveNode
	self:_release(v)
	if node then
		v.TailConn, v.TailNode = conn, node
		node.Tails = node.Tails or {}
		node.Tails[v] = true
	end
end

function TrafficSim:_releaseTail(v)
	local node = v.TailNode
	if node and node.Tails then
		node.Tails[v] = nil
	end
	v.TailConn, v.TailNode = nil, nil
end

-- Noktanın (px,pz) aracın gövde ekseni (arka tampon → ön tampon) doğru parçasına uzaklığının karesi
local function distToBody2(w, px, pz)
	local hl = w.Len / 2
	local ax, az = w.X - w.HX * hl, w.Z - w.HZ * hl
	local ex, ez = w.HX * w.Len, w.HZ * w.Len
	local t = ((px - ax) * ex + (pz - az) * ez) / max(w.Len * w.Len, 0.01)
	t = clamp(t, 0, 1)
	local dx, dz = px - (ax + ex * t), pz - (az + ez * t)
	return dx * dx + dz * dz
end

-- Benim yolum (önümdeki maxAlong stud) w'nin gövdesine değiyor mu? Değiyorsa değdiği yol mesafesi.
function TrafficSim:_pathHitsBody(v, w, maxAlong)
	local lim = (v.Width + w.Width) / 2 + 0.6
	local lim2 = lim * lim
	local along = 0
	while along <= maxAlong do
		local px, pz = self:_pointAhead(v, along)
		if distToBody2(w, px, pz) < lim2 then
			return along
		end
		along = along + 2
	end
	return nil
end

-- Kavşaktan çıkmış ama arkası hâlâ kavşakta duran (kuyruğu tutulan) bir araç bu bağlantının yolunu kesiyor mu?
-- (Kavşak küçük, araç uzun: çıkıştaki yaya geçidinde durunca arkası yandaki yönün şeridine taşabilir.)
function TrafficSim:_tailBlocks(node, conn, v)
	local tails = node.Tails
	if not tails then
		return false
	end
	for w in pairs(tails) do
		if w ~= v and w.TailConn ~= conn then
			local lim = (v.Width + w.Width) / 2 + 0.6
			local lim2 = lim * lim
			for i = 1, #conn.PX do
				if distToBody2(w, conn.PX[i], conn.PZ[i]) < lim2 then
					return true
				end
			end
		end
	end
	return false
end

-- ===== Doğurma / kaldırma =====
local function nearestFocus(foci, x, z)
	local best = math.huge
	for _, f in ipairs(foci) do
		local dx, dz = f.X - x, f.Z - z
		local d = dx * dx + dz * dz
		if d < best then
			best = d
		end
	end
	return sqrt(best)
end

-- Doğma adayları: odağın çevresindeki şeritler, ağırlık = uzunluk × yol sınıfı ağırlığı (birikimli liste).
-- Önbellek: odak 40 studdan az kıpırdadıysa ve 3 sn geçmediyse yeniden hesaplanmaz (her denemede ızgara taraması yok).
function TrafficSim:_spawnLanes(index, focus)
	local c = self.LaneCache[index]
	if c and (c.X - focus.X) ^ 2 + (c.Z - focus.Z) ^ 2 < 1600 and self.Time - c.T < 3 then
		return c
	end
	local lanes = self.TG.LanesNear(self.Graph, focus.X, focus.Z, self.Cfg.SpawnMax)
	local cw = self.Cfg.ClassWeight or {}
	local cum, total = {}, 0
	for i, l in ipairs(lanes) do
		if l.Length >= 40 and #l.Out > 0 then
			total = total + (cw[l.Kind] or 0.5) * l.Length
		end
		cum[i] = total
	end
	c = { X = focus.X, Z = focus.Z, T = self.Time, Lanes = lanes, Cum = cum, Total = total }
	self.LaneCache[index] = c
	return c
end

function TrafficSim:_trySpawn(ctx)
	local cfg = self.Cfg
	local foci = ctx.Focus
	if #foci == 0 then
		return false
	end
	local fi = 1 + floor(self.Rng() * #foci) % #foci
	local cache = self:_spawnLanes(fi, foci[fi])
	if cache.Total <= 0 then
		return false
	end
	local r = self.Rng() * cache.Total
	local lo, hi = 1, #cache.Lanes
	while lo < hi do
		local mid = floor((lo + hi) / 2)
		if cache.Cum[mid] < r then
			lo = mid + 1
		else
			hi = mid
		end
	end
	local lane = cache.Lanes[lo]
	if lane.Length < 40 or #lane.Out == 0 then
		return false
	end
	local s = 12 + self.Rng() * (lane.Length - 24)
	local x, y, z = self.TG.LanePoint(lane, s)
	local d = nearestFocus(foci, x, z)
	if d < cfg.SpawnMin or d > cfg.SpawnMax then
		return false
	end
	if ctx.CanSpawn and not ctx.CanSpawn(x, y, z, d) then
		return false
	end
	if ctx.DensityAt and self.Rng() > max(ctx.DensityAt(x, z), cfg.DensityFloor) then
		return false
	end
	local kind = self:_pickKind(ctx.MixAt and ctx.MixAt(x, z))
	local b = cfg.ComfortDecel
	local spawnSpeed = min(lane.Speed, kind.MaxSpeed) * (cfg.SpawnSpeedFactor or 0.6)
	-- durma çizgisine kadar konforlu durabilecek hız (ışık kırmızı olabilir: doğduğu an çizgide çakılmasın)
	spawnSpeed = min(spawnSpeed, sqrt(2 * b * max(lane.StopS - s - kind.Length / 2 - 4, 0)))
	local function clear(ws, wv, wlen)
		local need = (wlen + kind.Length) / 2 + 14
		if ws < s then
			need = need + wv * wv / (2 * b) -- arkadan gelen durabilmeli
		else
			need = need + spawnSpeed * spawnSpeed / (2 * b)
		end
		return abs(ws - s) >= need
	end
	for _, w in ipairs(lane.Vehicles) do
		if not clear(w.S, w.V, w.Len) then
			return false
		end
	end
	-- önde: şeridin çıkış bağlantılarındaki ve onların hedef şeritlerinin başındaki araçlar (kavşakta duran araç)
	for _, c in ipairs(lane.Out) do
		for _, w in ipairs(c.Vehicles) do
			if not clear(lane.Length + w.S, w.V, w.Len) then
				return false
			end
		end
		local first = c.To.Vehicles[1]
		if first and not clear(lane.Length + c.Length + first.S, first.V, first.Len) then
			return false
		end
	end
	for _, c in ipairs(lane.In) do
		for _, w in ipairs(c.Vehicles) do
			if not clear(-(c.Length - w.S), w.V, w.Len) then
				return false
			end
		end
		for _, w in ipairs(c.From.Vehicles) do
			if w.Next == c and not clear(-(c.Length + c.From.Length - w.S), w.V, w.Len) then
				return false
			end
		end
	end
	if s > lane.StopS - kind.Length then
		return false -- durma çizgisinin içinde doğma
	end
	local stopAhead = spawnSpeed * spawnSpeed / (2 * b) + 30
	for _, o in ipairs(ctx.Obstacles or {}) do
		local dx, dz = o.X - x, o.Z - z
		-- her engelin dibinde doğma yok; insan (yolda yürüyen oyuncu/yaya) için doğma hızıyla durma mesafesi + pay
		local r = (o.Kind == "Vehicle") and 20 or stopAhead
		if dx * dx + dz * dz < r * r then
			return false
		end
		-- aynı şeritte önde (park etmiş oyuncu aracı vb.): durma mesafesi + 30 stud içinde doğma yok
		local ox, oz = o.X - lane.X0, o.Z - lane.Z0
		local along = ox * lane.UX + oz * lane.UZ
		local side = abs(ox * lane.RX + oz * lane.RZ)
		if side < lane.LaneWidth / 2 + (o.R or 2) + 1 and along > s - 15 and along < s + stopAhead then
			return false
		end
	end
	local v = {
		Id = self.NextId, Kind = kind, Len = kind.Length, Width = kind.Width,
		Seg = lane, OnConn = false, S = s, V = 0, Factor = cfg.SpeedFactor[1] + self.Rng() * (cfg.SpeedFactor[2] - cfg.SpeedFactor[1]),
		Lat = 0, LatRate = 0, Blocked = 0, StopTimer = 0, State = "Sür", Brake = false, Accel = 0, Stuck = 0, Held = 0,
		X = x, Y = y, Z = z, HX = lane.UX, HZ = lane.UZ,
	}
	v.V = spawnSpeed
	self.NextId = self.NextId + 1
	v.Next = self:_pickNext(lane)
	insertSorted(lane.Vehicles, v)
	self.Vehicles[#self.Vehicles + 1] = v
	self.Spawned[#self.Spawned + 1] = v
	self.Stats.Spawns = self.Stats.Spawns + 1
	return true
end

function TrafficSim:Remove(v, reason)
	if v.Removed then
		return
	end
	v.Removed = true
	v.RemoveReason = reason
	removeFrom(segList(v), v)
	self:_release(v)
	self:_releaseTail(v)
	if v.WaitNode then
		v.WaitNode.Waiting[v] = nil
		v.WaitNode = nil
	end
	for i = #self.Vehicles, 1, -1 do
		if self.Vehicles[i] == v then
			table.remove(self.Vehicles, i)
			break
		end
	end
	self.Despawned[#self.Despawned + 1] = v
	self.Stats.Despawns = self.Stats.Despawns + 1
end

-- ===== Şerit değiştirme =====
function TrafficSim:_tryLaneChange(v, obstacles)
	if v.OnConn or v.Reserve then
		return false
	end
	local lane = v.Seg
	for _, delta in ipairs({ 1, -1 }) do
		local target = lane.Group[lane.Index + delta]
		if target then
			local ok = true
			for _, w in ipairs(target.Vehicles) do
				local need = (w.Len + v.Len) / 2 + 8
				if w.S < v.S then
					need = need + w.V * w.V / (2 * self.Cfg.ComfortDecel) -- arkadan gelen durabilmeli
				end
				if abs(w.S - v.S) < need then
					ok = false
					break
				end
			end
			-- hedef şeritte (benim yanımda ya da biraz önümde) engel var mı?
			if ok then
				for _, o in ipairs(obstacles or {}) do
					local ox, oz = o.X - target.X0, o.Z - target.Z0
					local along = ox * target.UX + oz * target.UZ
					local side = abs(ox * target.RX + oz * target.RZ)
					if side < v.Width / 2 + (o.R or 2) + 0.5 and along > v.S - v.Len and along < v.S + v.Len + (o.R or 2) + 25 then
						ok = false
						break
					end
				end
			end
			if ok and v.S < target.StopS - v.Len then
				self:_releaseTail(v)
				removeFrom(lane.Vehicles, v)
				v.Seg = target
				insertSorted(target.Vehicles, v)
				v.Lat = v.Lat + (lane.Offset - target.Offset)
				v.LatRate = abs(v.Lat) / self.Cfg.LaneChangeTime
				v.Next = self:_pickNext(target)
				v.Blocked = 0
				if v.WaitNode then
					v.WaitNode.Waiting[v] = nil
					v.WaitNode = nil
				end
				self.Stats.LaneChanges = self.Stats.LaneChanges + 1
				return true
			end
		end
	end
	return false
end

-- ===== Alternatif yön (kapalı/dolu çıkış) =====
-- Çıkış şeridi dolu ya da önü engelli olduğu için uzun süre bekleyen araç, kavşakta başka bir yöne döner
-- (gerçek sürücü gibi: "bu yol kapalı, sağdan dolaşayım"). Sadece durma çizgisinden önce ve izin almadan.
function TrafficSim:_obstacleNear(lane, obstacles, from, to)
	for _, o in ipairs(obstacles) do
		local ox, oz = o.X - lane.X0, o.Z - lane.Z0
		local along = ox * lane.UX + oz * lane.UZ
		local side = abs(ox * lane.RX + oz * lane.RZ)
		if along > from and along < to and side < lane.LaneWidth / 2 + (o.R or 2) then
			return true
		end
	end
	return false
end

function TrafficSim:_reroute(v, obstacles)
	if v.OnConn or v.Reserve or not v.Next then
		return false
	end
	local lane = v.Seg
	local options = {}
	for _, c in ipairs(lane.Out) do
		if c ~= v.Next and c.Turn ~= "U" and self:_targetHasRoom(v, c) and not self:_obstacleNear(c.To, obstacles, -4, 40) then
			options[#options + 1] = c
		end
	end
	if #options == 0 then
		return false
	end
	v.Next = options[1 + floor(self.Rng() * #options) % #options]
	v.Stuck = 0
	if v.WaitNode then
		v.WaitNode.Waiting[v] = nil
		v.WaitNode = nil
	end
	self.Stats.Reroutes = self.Stats.Reroutes + 1
	return true
end

-- ===== Ana adım =====
function TrafficSim:Step(dt, ctx)
	local cfg, TG, graph = self.Cfg, self.TG, self.Graph
	self.Time = self.Time + dt
	local time = ctx.Time or self.Time
	self.Spawned, self.Despawned = {}, {}
	local obstacles = ctx.Obstacles or {}
	self.Obstacles = obstacles
	local look = cfg.LookAhead

	-- 1. Kararlar (mevcut durumdan; sıra bağımsız)
	for _, v in ipairs(self.Vehicles) do
		local seg = v.Seg
		local list = seg.Vehicles
		local myIndex = 0
		for i = 1, #list do
			if list[i] == v then
				myIndex = i
				break
			end
		end
		-- istenen hız
		local v0
		local remaining = seg.Length - v.S
		if v.OnConn then
			v0 = seg.MaxSpeed
		else
			v0 = min(seg.Speed * v.Factor, v.Kind.MaxSpeed * 0.92)
			if v.Next then
				local vt = v.Next.MaxSpeed
				v0 = min(v0, sqrt(vt * vt + 2 * cfg.ComfortDecel * max(remaining - 4, 0)))
			end
		end
		local accel = idm(cfg, v.V, v0, nil, 0)
		-- Viraj/kavşak yaklaşması: bağlantının güvenli hızına (vt) şerit sonunda inmek için gereken sabit fren.
		-- IDM'in serbest yol terimi v > v0 iken zayıf frenler, sonra bağlantıya girince sert frene geçerdi (arkadaki
		-- araç yetişemezdi). Gereken fren 0.6·konfor frenini aşınca tam o kadar fren: düzgün, öngörülebilir yavaşlama.
		if not v.OnConn and v.Next and v.V > v.Next.MaxSpeed then
			local vt = v.Next.MaxSpeed
			local need = (v.V * v.V - vt * vt) / (2 * max(remaining - 1, 0.5))
			if need > cfg.ComfortDecel * 0.6 then
				accel = min(accel, -need)
			end
		end
		local limitBy = nil

		-- öndeki araç
		local gap, vLead
		local leader = list[myIndex + 1]
		if leader then
			gap = leader.S - leader.Len / 2 - v.S - v.Len / 2
			vLead = leader.V
			limitBy = leader
		else
			local ahead = remaining
			local nextSeg = v.OnConn and seg.To or v.Next
			local hops = 0
			while nextSeg and ahead < look and hops < 2 do
				local first = nextSeg.Vehicles[1]
				if first then
					gap = ahead + first.S - first.Len / 2 - v.Len / 2
					vLead = first.V
					limitBy = first
					break
				end
				ahead = ahead + nextSeg.Length
				hops = hops + 1
				if nextSeg.To and not nextSeg.Edge then
					nextSeg = nextSeg.To -- connector → lane
				else
					nextSeg = nil
				end
			end
		end
		if gap and gap < look then
			accel = min(accel, idm(cfg, v.V, v0, gap, vLead))
		end
		-- Kavşak içinde (bağlantı üstünde) ya da kavşağa girerken: aynı düğümdeki diğer bağlantılarda önümde
		-- duran/yavaşlayan araç (aynı şeritten ayrılan ya da aynı şeride birleşen eğriler başta/sonda üst üste biner)
		local nodeId = v.OnConn and seg.Node or (v.Next and remaining < look and v.Next.Node)
		if nodeId then
			local node = graph.Nodes[nodeId]
			local myGroup = v.OnConn and seg.From.Group or seg.Group
			local pathLen = min(look, (v.OnConn and (seg.Length - v.S) or (remaining + v.Next.Length)) + 4)
			for _, c in ipairs(node.Connectors) do
				if c ~= seg and #c.Vehicles > 0 then
					for _, w in ipairs(c.Vehicles) do
						if w ~= v then
							local dx, dz = w.X - v.X, w.Z - v.Z
							local ahead = dx * v.HX + dz * v.HZ
							local side = abs(-dx * v.HZ + dz * v.HX)
							local sameFlow = (w.HX * v.HX + w.HZ * v.HZ) > 0.3 -- karşıdan/çaprazdan geleni rezervasyon çözer
							if sameFlow and ahead > 0 and side < (v.Width + w.Width) / 2 + 0.6 then
								local g2 = ahead - (v.Len + w.Len) / 2
								local a2 = idm(cfg, v.V, v0, g2, w.V * max(w.HX * v.HX + w.HZ * v.HZ, 0))
								if a2 < accel then
									accel = a2
									limitBy = w
								end
							elseif c.From.Group == myGroup and ahead > 0 then
								-- aynı şeritten ayrılan (dönüşe giren) araç: rezervasyon bunu korumaz; dönüşte durduysa
								-- arkası hâlâ benim yolumda olabilir → gövdesi yolumu kesiyorsa önünde dur
								local hitAt = self:_pathHitsBody(v, w, pathLen)
								if hitAt then
									local a2 = idm(cfg, v.V, v0, hitAt - v.Len / 2, 0)
									if a2 < accel then
										accel = a2
										limitBy = w
									end
								end
							end
						end
					end
				end
			end
			-- Kavşakta (ya da izinle girerken): arkası kavşağa taşan duran araç yolumdaysa önünde dur (güvenlik ağı)
			if (v.OnConn or v.Reserve) and node.Tails then
				for w in pairs(node.Tails) do
					if w ~= v and w ~= limitBy and w.Seg ~= (v.OnConn and seg.To or (v.Next and v.Next.To)) then
						local hitAt = self:_pathHitsBody(v, w, pathLen)
						if hitAt then
							local a2 = idm(cfg, v.V, v0, hitAt - v.Len / 2, 0)
							if a2 < accel then
								accel = a2
								limitBy = w
							end
						end
					end
				end
			end
		end

		-- durma çizgisi / kavşak izni
		v.State = "Sür"
		if not v.OnConn then
			if not v.Next then
				local g = remaining - v.Len / 2 - 1
				accel = min(accel, idm(cfg, v.V, v0, g + cfg.MinGap, 0))
				v.State = "Yol sonu"
			elseif not v.Reserve then
				local node = graph.Nodes[seg.To]
				local distToStop = seg.StopS - v.S - v.Len / 2
				local approach = max(cfg.ApproachDistance, v.V * v.V / (2 * cfg.ComfortDecel) + 8)
				local isFirst = myIndex == #list
				-- serbest düğüm; ama iki şeridin tek şeride birleştiği yerde sıra/rezervasyon gerekir
				local free = node.Control == "Free" and #v.Next.To.In <= 1
				if free then
					if isFirst and distToStop < approach and not self:_tailBlocks(node, v.Next, v) then
						self:_reserve(v, node, v.Next)
					end
				elseif distToStop < approach then
					-- dur levhası: tam duruş sayacı ve geliş sırası
					if node.Control == "Stop" and isFirst and distToStop < 3 and v.V < 0.6 then
						v.StopTimer = (v.StopTimer or 0) + dt
						if not node.Waiting[v] then
							node.Waiting[v] = time
							v.WaitNode = node
						end
					end
					local ok, why = false, "Sırada"
					if isFirst then
						ok, why = self:_canEnter(v, node, v.Next, distToStop, time)
						if not ok and (why == "SolDönüş" or why == "Çakışma") and (v.Next.Turn == "L" or v.Next.Turn == "U") then
							v.LeftWait = (v.LeftWait or 0) + dt -- sarıda dönme hakkı için bekleme süresi
						end
					end
					if ok then
						if node.Control == "Signal" and TG.SignalState(graph, node, v.Next.Phase, time) == "R" then
							self.Stats.RedEntries = self.Stats.RedEntries + 1
						end
						self:_reserve(v, node, v.Next)
						if v.WaitNode then
							v.WaitNode.Waiting[v] = nil
							v.WaitNode = nil
						end
						v.StopTimer = 0
						v.LeftWait = 0
						self.Stats.Entries = self.Stats.Entries + 1
					else
						local g = distToStop + cfg.MinGap - 1
						accel = min(accel, idm(cfg, v.V, v0, g, 0))
						v.State = why or "Bekle"
						if not limitBy or g < (gap or math.huge) then
							limitBy = "stop"
						end
					end
				end
			end
		end

		-- engeller (oyuncular, oyuncu araçları, yayalar)
		local hx, hz = v.HX, v.HZ
		-- yanal eşik: araçlar için gövde yarı genişliği (yol kenarına park etmiş araç şeridi kapatmaz);
		-- insanlar için şerit yarı genişliği (şeride yaklaşan yayayı önceden fark et, öngörülü fren)
		local halfBody = v.Width / 2 + 0.5
		local halfLane = max((v.OnConn and seg.From.LaneWidth or seg.LaneWidth) / 2, halfBody)
		for _, o in ipairs(obstacles) do
			local dx, dz = o.X - v.X, o.Z - v.Z
			local d2 = dx * dx + dz * dz
			if d2 < look * look and abs((o.Y or v.Y) - v.Y) < 7 and dx * hx + dz * hz > -v.Len / 2 then
				local straight = sqrt(d2)
				local best, bestAlong = math.huge, 0
				local step = 3
				local along = 0
				-- insan (oyuncu/yaya) hareket ediyorsa 2 sn sonraki yeri de denenir: yola doğru yürüyen önceden görülür
				local qx, qz
				if o.Kind ~= "Vehicle" and o.VX and (o.VX * o.VX + o.VZ * o.VZ) > 0.25 then
					qx, qz = o.X + o.VX * 2, o.Z + o.VZ * 2
				end
				while along <= straight + 6 do
					local px, pz = self:_pointAhead(v, along)
					local ex, ez = o.X - px, o.Z - pz
					local e2 = ex * ex + ez * ez
					if qx then
						local fx, fz = qx - px, qz - pz
						e2 = min(e2, fx * fx + fz * fz)
					end
					if e2 < best then
						best, bestAlong = e2, along
					end
					along = along + step
				end
				local lateralLimit = ((o.Kind == "Vehicle") and halfBody or halfLane) + (o.R or 2)
				-- Yaya, yolumun ön tamponun GERİSİNDEKİ bir noktasına en yakınsa gövdenin yanındadır: gövdeden 0.8 stud
				-- açıktaysa ileri giderken ona çarpılmaz (onu beklemek karşılıklı beklemeye yol açar: yaya da gövdeyi
				-- bekler). Yol yayaya doğru dönüyorsa en yakın nokta öndedir → normal kural.
				if o.Kind == "Pedestrian" and bestAlong < v.Len / 2 - 0.5 and sqrt(best) > halfBody + 0.8 then
					lateralLimit = 0
				end
				if sqrt(best) < lateralLimit then
					local og = bestAlong - v.Len / 2 - (o.R or 2)
					local a2 = idm(cfg, v.V, v0, og, 0)
					if a2 < accel then
						accel = a2
						-- karşıya geçen yaya birazdan geçer: onun için şerit değiştirilmez / tıkanma sayılmaz
						limitBy = (o.Kind == "Pedestrian") and "pedestrian" or "obstacle"
					end
					v.State = "Engel"
				end
			end
		end

		-- İzin aldı ama engel (oyuncu/araç) yüzünden kavşağa giremiyor: izni 2 sn sonra bırak (bütün çakışan yönleri
		-- boşuna kapatmasın); sonra "çıkış kapalı" kuralıyla bekler ya da başka yöne döner. Sadece ön tampon durma
		-- çizgisini geçmemişse (kavşağa taşmış araç iznini korur).
		if v.Reserve and not v.OnConn and v.V < 0.3 and limitBy == "obstacle" and v.S + v.Len / 2 <= seg.StopS + 0.5 then
			v.ResHold = (v.ResHold or 0) + dt
			if v.ResHold > 2 then
				self:_release(v)
				v.ResHold = 0
			end
		else
			v.ResHold = 0
		end
		accel = clamp(accel, -cfg.MaxDecel, cfg.MaxAccel)
		-- Dur-kalk titremesi: duran araç küçük bir boşluk açıldı diye santim santim sürünmez (eşik altı → bekle)
		if v.V < 0.25 and accel > 0 and accel < (cfg.StartThreshold or 0) then
			accel = 0
		end
		-- Sarsıntısız kalkış: ivme ARTIŞI saniyede Jerk ile sınırlı (fren her zaman anında uygulanır → güvenlik
		-- etkilenmez). Duran araç negatif ivme hafızasını taşımaz: yeşilde gecikmeden kalkar.
		local prev = v.Accel or 0
		if v.V < 0.05 and prev < 0 then
			prev = 0
		end
		local jerk = cfg.Jerk
		if jerk and accel > prev + jerk * dt then
			accel = prev + jerk * dt
		end
		v.Accel = accel
		v.LimitBy = limitBy
	end

	-- 2. Entegrasyon ve geçişler
	for i = #self.Vehicles, 1, -1 do
		local v = self.Vehicles[i]
		if v then
			local oldV = v.V
			local newV = max(0, v.V + v.Accel * dt)
			local ds = (oldV + newV) / 2 * dt
			v.V = newV
			v.Brake = v.Accel < -2 or (newV < 0.5 and v.State ~= "Sür")
			if not v.OnConn and v.Next and not v.Reserve then
				-- izinsiz durma çizgisini geçme
				ds = min(ds, max(v.Seg.StopS - v.Len / 2 - v.S, 0) + 0.01)
			end
			v.S = v.S + ds
			-- tıkanma takibi (ışık/sırada beklemek tıkanma sayılmaz)
			if newV < 0.3 and (v.LimitBy == "obstacle" or (type(v.LimitBy) == "table" and (v.LimitBy.Blocked or 0) > 2)) then
				v.Blocked = v.Blocked + dt
			elseif newV > 1 then
				v.Blocked = 0
			end
			-- dolu/engelli çıkış yüzünden bekleme (alternatif yön için) ve izinli ama hiç ilerleyemeyen araç (kilit)
			if newV < 0.3 and not v.OnConn and not v.Reserve and (v.State == "Dolu" or v.State == "Kapalı" or v.State == "Engel") then
				v.Stuck = v.Stuck + dt
			else
				v.Stuck = 0
			end
			if newV < 0.3 and (v.Reserve or v.OnConn) and v.State ~= "Engel" then
				v.Held = v.Held + dt
			else
				v.Held = 0
			end
			-- bekçi: hiç kıpırdamadan geçen süre (kırmızı ışıkta bekleme dahil; eşik bir ışık döngüsünden çok uzun)
			if newV < 0.1 then
				v.Idle = (v.Idle or 0) + dt
			else
				v.Idle = 0
			end
			-- şerit sonu → bağlantı → yeni şerit
			if not v.OnConn and v.S >= v.Seg.Length then
				if v.Next and v.Reserve then
					local over = v.S - v.Seg.Length
					removeFrom(v.Seg.Vehicles, v)
					v.Seg, v.OnConn, v.S = v.Next, true, over
					insertSorted(v.Seg.Vehicles, v)
				else
					v.S = v.Seg.Length - 0.01
					v.V = 0
				end
			end
			if v.OnConn and v.S >= v.Seg.Length then
				local over = v.S - v.Seg.Length
				local lane = v.Seg.To
				removeFrom(v.Seg.Vehicles, v)
				self:_moveToTail(v)
				v.Seg, v.OnConn, v.S = lane, false, over
				insertSorted(lane.Vehicles, v)
				v.Next = self:_pickNext(lane)
			end
			-- arka tampon kavşaktan çıktı (ya da araç yeni bir bağlantıya girdi): kuyruk rezervasyonunu bırak
			if v.TailConn and (v.OnConn or v.S >= v.Len / 2 + 0.5) then
				self:_releaseTail(v)
			end
			-- yanal şerit değiştirme geçişi
			if v.Lat ~= 0 then
				-- araba dururken yana kaymaz: yanal hareket ileri harekete bağlı (1.5 stud/sn ve üstünde tam hız;
				-- yavaşken kısa mesafede şerit değiştirir). _pointAhead aynı kuralla yolu tahmin eder.
				local stepLat = v.LatRate * dt * min(newV / 1.5, 1)
				if abs(v.Lat) <= stepLat then
					v.Lat = 0
				else
					v.Lat = v.Lat - stepLat * (v.Lat > 0 and 1 or -1)
				end
			end
		end
	end

	-- 3. Tıkanma: yan şerit, alternatif yön, sonra kaldırma
	for i = #self.Vehicles, 1, -1 do
		local v = self.Vehicles[i]
		if v.Blocked > cfg.LaneChangeAfter and not v.OnConn then
			self:_tryLaneChange(v, obstacles)
		end
		if cfg.RerouteAfter and v.Stuck > cfg.RerouteAfter then
			if not self:_reroute(v, obstacles) then
				v.Stuck = cfg.RerouteAfter * 0.5 -- yarım süre sonra tekrar dene
			end
		end
	end
	-- rezervasyon denetimi (sızıntı olursa düzelt; ucuz, 5 sn'de bir)
	if self.Time >= self.NextAudit then
		self.NextAudit = self.Time + 5
		self.Stats.Leaks = self.Stats.Leaks + self:CheckReservations()
	end

	-- 4. Konum ve yön
	for _, v in ipairs(self.Vehicles) do
		local x, y, z, hx, hz
		if v.OnConn then
			x, y, z, hx, hz = TG.ConnPoint(v.Seg, v.S)
		else
			x, y, z, hx, hz = TG.LanePoint(v.Seg, v.S)
			if v.Lat ~= 0 then
				x, z = x + v.Seg.RX * v.Lat, z + v.Seg.RZ * v.Lat
			end
		end
		v.X, v.Y, v.Z, v.HX, v.HZ = x, y, z, hx, hz
		-- eğim (rampa/köprü): görüntüde aracın burnu yolla birlikte kalksın
		local seg = v.Seg
		if v.OnConn then
			v.Slope = (seg.PY[#seg.PY] - seg.PY[1]) / max(seg.Length, 0.5)
		else
			v.Slope = (seg.Y1 - seg.Y0) / max(seg.Length, 0.5)
		end
	end

	-- 5. Kaldırma (uzak / uzun süre tıkalı / kilitli) ve doğurma.
	-- Görünen araç kaldırılmaz (gözün önünde kaybolma yok): uzak ama görünürse HardDespawnRadius'a kadar yaşar.
	local foci = ctx.Focus or {}
	local isVisible = ctx.IsVisible
	local function hidden(v, d)
		if not isVisible then
			return true
		end
		if (v.VisUntil or 0) > self.Time then
			return false -- yakın zamanda görünür bulundu: her adımda ışın atma
		end
		if isVisible(v.X, v.Y, v.Z, d) then
			v.VisUntil = self.Time + 0.5
			return false
		end
		return true
	end
	local hard = cfg.HardDespawnRadius or math.huge
	for i = #self.Vehicles, 1, -1 do
		local v = self.Vehicles[i]
		local d = nearestFocus(foci, v.X, v.Z)
		if #foci > 0 and (d > hard or (d > cfg.DespawnRadius and hidden(v, d))) then
			self:Remove(v, "Uzak")
		elseif v.Blocked > cfg.BlockedDespawnAfter and d > 60 and hidden(v, d) then
			self:Remove(v, "Tıkalı")
		elseif cfg.LockedAfter and v.Held > cfg.LockedAfter and d > 60 and hidden(v, d) then
			self.Stats.Locked = self.Stats.Locked + 1
			self:Remove(v, "Kilit")
		elseif cfg.IdleWatchdog and (v.Idle or 0) > cfg.IdleWatchdog and d > 60 and hidden(v, d) then
			-- son güvenlik ağı: beklenmedik bir kilitlenme şehri kalıcı tıkamasın. Kuyruğun başı bir engeli (yolda
			-- duran oyuncu/araç) bekliyorsa bu bir kilit değildir; ayrı sayılır (test sadece gerçek kilidi hata sayar).
			local w, hops = v, 0
			while type(w.LimitBy) == "table" and hops < 40 do
				w, hops = w.LimitBy, hops + 1
			end
			if w.LimitBy == "obstacle" then
				self.Stats.WatchdogObstacle = self.Stats.WatchdogObstacle + 1
			else
				self.Stats.Watchdog = self.Stats.Watchdog + 1
			end
			self:Remove(v, "Bekçi")
		end
	end
	local target = floor((ctx.MaxVehicles or 0) * clamp(ctx.Density or 1, 0, 1) + 0.5)
	local tries = 0
	local spawned = 0
	local perTick = cfg.SpawnsPerTick
	if #self.Vehicles < target * 0.6 then
		perTick = perTick * 3 -- hedefin çok altında (ilk giriş, yoğunluk artırıldı): daha hızlı doldur
	end
	while #self.Vehicles < target and spawned < perTick and tries < perTick * 4 do
		tries = tries + 1
		if self:_trySpawn(ctx) then
			spawned = spawned + 1
		else
			self.Stats.Rejected = self.Stats.Rejected + 1
		end
	end
	-- fazlalık (ör. sınır düşürüldü): GÖRÜNMEYENLERİN en uzağını kaldır (görünen kalır, sonra uzaklaşınca gider)
	local excess = #self.Vehicles - (target + 2)
	if excess > 0 then
		local order = {}
		for _, v in ipairs(self.Vehicles) do
			order[#order + 1] = { v, nearestFocus(foci, v.X, v.Z) }
		end
		table.sort(order, function(p, q)
			return p[2] > q[2]
		end)
		local removed, checked = 0, 0
		for _, item in ipairs(order) do
			if removed >= min(excess, 4) or checked >= 12 then
				break -- adım başına sınırlı iş (ışın sayısı)
			end
			checked = checked + 1
			if hidden(item[1], item[2]) then
				self:Remove(item[1], "Sınır")
				removed = removed + 1
			end
		end
	end
end

-- ===== Yaya sistemi için sorgular =====
-- Kolda (edgeId) düğüme yakın araç var mı? (ışıksız geçitte karşıya geçme kararı)
function TrafficSim:ArmBusy(node, edgeId, radius)
	for _, v in ipairs(self.Vehicles) do
		local seg = v.Seg
		if v.OnConn then
			if seg.Node == node.Id and (seg.From.Edge == edgeId or seg.To.Edge == edgeId) then
				return true
			end
		elseif seg.Edge == edgeId then
			if seg.To == node.Id and (seg.Length - v.S) < radius and v.V > 0.5 then
				return true
			elseif seg.To == node.Id and (seg.Length - v.S) < 12 then
				return true -- çizgide bekleyen de geçidin önünde
			elseif seg.From == node.Id and v.S < 10 then
				return true
			end
		end
	end
	return false
end

-- Hata ayıklama: düğüm rezervasyonlarını araçlardan yeniden kur (sızıntı denetimi)
function TrafficSim:CheckReservations()
	local actual = {}
	for _, v in ipairs(self.Vehicles) do
		if v.Reserve then
			actual[v.Reserve] = (actual[v.Reserve] or 0) + 1
		end
	end
	local leaks = 0
	for node in pairs(self.ReservedNodes) do
		for conn, n in pairs(node.Reserved) do
			if (actual[conn] or 0) ~= n then
				leaks = leaks + 1
				node.Reserved[conn] = actual[conn] or 0
			end
		end
	end
	return leaks
end

return TrafficSim
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000018"><Properties>
<string name="Name">ServerScriptService</string>

</Properties>
<Item class="Script" referent="RBX00000019"><Properties>
<string name="Name">ServerBootstrap</string>

<ProtectedString name="Source"><![CDATA[-- ServerBootstrap: sunucudaki TEK giriş noktası.
-- Her servis bir ModuleScript'tir ve şu sözleşmeye uyar:
--   Service.Name: string
--   Service.Priority: number (küçük olan önce başlar)
--   Service:Init(services)  -- sadece hazırlık, başka servisi ÇAĞIRMAZ
--   Service:Start()         -- diğer servislerle etkileşim burada başlar
-- Bir servis hata verirse diğerleri yine başlar ve hata Output'ta açıkça görünür.

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log).new("Bootstrap")
local RemoteRegistry = require(Shared.RemoteRegistry)

-- 1) Remote'lar her şeyden önce oluşur (istemciler bunları bekliyor)
RemoteRegistry.Build()

-- 2) Servisleri topla
local servicesFolder = ServerScriptService:WaitForChild("Services")
local services = {}
local ordered = {}

for _, moduleScript in servicesFolder:GetChildren() do
	if moduleScript:IsA("ModuleScript") then
		local ok, result = pcall(require, moduleScript)
		if ok and type(result) == "table" then
			local name = result.Name or moduleScript.Name
			services[name] = result
			table.insert(ordered, result)
		else
			Log.Error("Servis yüklenemedi:", moduleScript.Name, result)
		end
	end
end

table.sort(ordered, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

-- 3) Init
for _, service in ordered do
	if type(service.Init) == "function" then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			Log.Error("Init hatası:", service.Name, err)
			service._failed = true
		end
	end
end

-- 4) Start
for _, service in ordered do
	if not service._failed and type(service.Start) == "function" then
		local ok, err = pcall(service.Start, service)
		if not ok then
			Log.Error("Start hatası:", service.Name, err)
		else
			Log.Info("Başladı:", service.Name)
		end
	end
end

Log.Info("Sunucu hazır. Servis sayısı:", #ordered)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX0000001A"><Properties>
<string name="Name">Services</string>

</Properties>
<Item class="ModuleScript" referent="RBX0000001B"><Properties>
<string name="Name">CharacterService</string>

<ProtectedString name="Source"><![CDATA[-- CharacterService: OYUNCUNUN KENDİ ROBLOX AVATARI ile doğma.
--
-- Avatar kuralları (kullanıcının zorunlu şartı):
--   * Özel karakter modeli YOK. StarterPlayer.StarterCharacter bulunursa uyarılır.
--   * Karakter player:LoadCharacter() ile yüklenir → Roblox, hesabın HumanoidDescription'ını yükler
--     (kıyafet, aksesuar, vücut oranları, animasyon paketi korunur).
--
-- Doğma akışı (Aşama 1 — ana menü):
--   * Players.CharacterAutoLoads = false. Oyuncu ana menüdeyken karakteri YOKTUR.
--   * İstemci "OYNA" deyince PlayerRemotes.RequestSpawn gelir → sunucu doğrular, dünyanın zemini
--     hazır olana kadar bekler ve TEK karakter yükler (kilit + "zaten canlı mı" kontrolü).
--   * Menüdeyken akış odağı (ReplicationFocus) menü kamerasının baktığı bölgeye çevrilir ve uzak şehir
--     için ek odaklar (AddReplicationFocus) eklenir; doğarken hepsi kalkar, akış karaktere geri verilir.
--   * Ölünce (veya karakter kaybolursa) RespawnDelay sonra sunucu yeniden doğurur.
--   * Görünümü değiştiren hiçbir ApplyDescription çağrısı yapılmaz.
--   * R6 ve R15 ikisi de desteklenir; rig tipi ve göz yüksekliği attribute olarak yazılır,
--     böylece kamera/araç/animasyon sistemleri farklı boylardaki avatarlara uyum sağlar.

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Signal = require(Shared.Utilities.Signal)
local Maid = require(Shared.Utilities.Maid)
local RateLimiter = require(Shared.Utilities.RateLimiter)
local RemoteRegistry = require(Shared.RemoteRegistry)
local FrontEndConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FrontEndConfig"))
local Log = require(Shared.Utilities.Log).new("CharacterService")

local CharacterService = {
	Name = "CharacterService",
	Priority = 20,
	CharacterReady = Signal.new(), -- (player, character, info)
}

local services
local playerMaids: { [Player]: any } = {}
local random = Random.new()

local APPEARANCE_TIMEOUT = 8

-- Doğma durumu (oyuncu başına)
type SpawnState = { InGame: boolean, Spawning: boolean }
local spawnStates: { [Player]: SpawnState } = {}
local spawnLimiter = RateLimiter.new(3, 0.5)
local spawnStatusRemote: RemoteEvent? = nil
local menuFocus: BasePart? = nil
local menuExtraFoci: { BasePart } = {} -- uzak şehir için ek odaklar (sadece menüde)
local extraFociPlayers: { [Player]: { BasePart } } = {} -- oyuncuya eklenmiş ek odaklar
local extraFociWarned = false

-- Menüdeki oyuncunun akış odakları: ana odak + ek odaklar. Ek odak API'si (AddReplicationFocus)
-- bu sunucuda yoksa veya hata verirse sadece ana odakla devam edilir (eski davranış).
local function setMenuStreaming(player: Player, inMenu: boolean)
	if inMenu then
		if menuFocus then
			player.ReplicationFocus = menuFocus
		end
		if extraFociPlayers[player] then
			return
		end
		local added = {}
		for _, part in menuExtraFoci do
			local ok, err = pcall(function()
				(player :: any):AddReplicationFocus(part)
			end)
			if ok then
				table.insert(added, part)
			elseif not extraFociWarned then
				extraFociWarned = true
				Log.Warn("Ek akış odağı eklenemedi, menü tek odakla devam ediyor:", err)
			end
		end
		extraFociPlayers[player] = added
	else
		player.ReplicationFocus = nil -- akış tekrar karakteri takip eder
		local added = extraFociPlayers[player]
		extraFociPlayers[player] = nil
		for _, part in added or {} do
			pcall(function()
				(player :: any):RemoveReplicationFocus(part)
			end)
		end
	end
end

local function checkAvatarPolicy()
	if StarterPlayer:FindFirstChild("StarterCharacter") then
		Log.Warn("StarterPlayer.StarterCharacter bulundu! Bu, oyuncu avatarlarını EZER. Kaldırılmalı.")
	end
	if not StarterPlayer.LoadCharacterAppearance then
		Log.Warn("StarterPlayer.LoadCharacterAppearance kapalıydı; avatar görünümü için açılıyor.")
		pcall(function()
			StarterPlayer.LoadCharacterAppearance = true
		end)
	end
	-- Ana menü: karakteri sunucu, oyuncu "OYNA" dediğinde yükler.
	-- (Place dosyasında da false olmalı; aksi halde ilk oyuncu bu satırdan önce otomatik doğabilir.)
	if Players.CharacterAutoLoads then
		Log.Warn("Players.CharacterAutoLoads açıktı; ana menü akışı için kapatılıyor.")
		Players.CharacterAutoLoads = false
	end
	Players.RespawnTime = Config.Spawn.RespawnDelay
end

local function getRigType(humanoid: Humanoid): string
	return if humanoid.RigType == Enum.HumanoidRigType.R15 then "R15" else "R6"
end

-- Kökten (HumanoidRootPart merkezi) yere olan mesafe. Avatar ölçeğine göre değişir.
local function getRootHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	-- R6: bacaklar 2 stud, HipHeight genelde 0
	return 2 + root.Size.Y / 2 + humanoid.HipHeight
end

-- Kökten göz hizasına olan yükseklik. Kamera bunu pivot olarak kullanır.
local function measureEyeHeight(character: Model, root: BasePart): number
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		-- Kafanın merkezinden biraz yukarısı ≈ göz hizası
		return (head.Position.Y - root.Position.Y) + head.Size.Y * 0.1
	end
	return 1.5
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

-- Doğma noktasının altındaki gerçek zemini bul (plaza, kaldırım, blok yüksekliği farklı olabilir)
local function groundYAt(position: Vector3): number
	local characters = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(characters, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = characters
	local hit = workspace:Raycast(Vector3.new(position.X, position.Y + 60, position.Z), Vector3.new(0, -160, 0), groundParams)
	return if hit then hit.Position.Y else position.Y
end

local function pickSpawnCFrame(): CFrame
	local points = services.WorldService and services.WorldService:GetSpawnPoints() or {}
	if #points == 0 then
		return CFrame.new(Config.Spawn.FallbackPosition)
	end
	local point = points[random:NextInteger(1, #points)]
	local position = point.Position
	local y = groundYAt(position)
	-- Doğma noktasının kendi yönünü kullan (harita verisinde tanımlı)
	return CFrame.new(position.X, y, position.Z) * point.CFrame.Rotation
end

local function onCharacterAdded(player: Player, character: Model)
	local maid = playerMaids[player]
	if not maid then
		return
	end
	maid:Set("Character", nil)
	local charMaid = Maid.new()
	maid:Set("Character", charMaid)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		Log.Warn("Karakter parçaları eksik:", player.Name)
		return
	end
	if character.Parent == nil or player.Character ~= character then
		return -- bu arada tekrar doğmuş
	end

	-- Konumlandırma: avatarın gerçek boyuna göre ayaklar yere değecek şekilde
	local spawnCFrame = pickSpawnCFrame()
	local rootHeight = getRootHeight(humanoid, root)
	task.wait() -- Roblox kendi doğma konumunu uyguladıktan sonra
	if player.Character ~= character then
		return
	end
	character:PivotTo(spawnCFrame + Vector3.new(0, rootHeight + 0.1, 0))
	character:SetAttribute(Constants.Attributes.SpawnedAt, workspace:GetServerTimeNow())

	-- Hareket değerleri (görünüme dokunmaz)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Movement.JumpPower
	humanoid.WalkSpeed = Config.Movement.RunSpeed

	local rigType = getRigType(humanoid)
	character:SetAttribute(Constants.Attributes.RigType, rigType)

	-- Görünüm (aksesuar/ölçek) yüklenene kadar bekle, sonra göz yüksekliğini ölç
	if not player:HasAppearanceLoaded() then
		local loaded = false
		local conn = player.CharacterAppearanceLoaded:Connect(function()
			loaded = true
		end)
		local start = os.clock()
		while not loaded and os.clock() - start < APPEARANCE_TIMEOUT and player.Character == character do
			task.wait(0.1)
		end
		conn:Disconnect()
	end
	if player.Character ~= character then
		return
	end

	local function updateEyeHeight()
		character:SetAttribute(Constants.Attributes.EyeHeight, measureEyeHeight(character, root))
	end
	updateEyeHeight()
	-- Avatar ölçek değerleri değişirse (ör. ileride ayar menüsü) tekrar ölç
	for _, scaleName in { "BodyHeightScale", "HeadScale" } do
		local value = humanoid:FindFirstChild(scaleName)
		if value and value:IsA("NumberValue") then
			charMaid:Give(value.Changed:Connect(function()
				task.wait()
				updateEyeHeight()
			end))
		end
	end

	charMaid:Give(humanoid.Died:Connect(function()
		Log.Info("Öldü:", player.Name, "(", Config.Spawn.RespawnDelay, "sn sonra yeniden doğar )")
		CharacterService:_scheduleRespawnCheck(player)
	end))

	local info = {
		RigType = rigType,
		EyeHeight = character:GetAttribute(Constants.Attributes.EyeHeight),
		RootHeight = rootHeight,
	}
	Log.Info("Avatar hazır:", player.Name, rigType, string.format("göz=%.2f", info.EyeHeight))
	CharacterService.CharacterReady:Fire(player, character, info)
end

local function onPlayerAdded(player: Player)
	if playerMaids[player] then
		return
	end
	local maid = Maid.new()
	playerMaids[player] = maid
	spawnStates[player] = { InGame = false, Spawning = false }
	player:SetAttribute(Constants.Attributes.InGame, false)
	maid:Give(player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end))
	-- Karakter ölmeden kaybolursa (ör. başka bir sistem sildi) oyundaki oyuncu yine geri gelir
	maid:Give(player.CharacterRemoving:Connect(function()
		CharacterService:_scheduleRespawnCheck(player)
	end))
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	elseif menuFocus then
		-- Menüdeyken içerik menü kamerasının çevresinde aksın
		setMenuStreaming(player, true)
	end
end

local function onPlayerRemoving(player: Player)
	spawnStates[player] = nil
	extraFociPlayers[player] = nil
	spawnLimiter:Forget(player)
	local maid = playerMaids[player]
	if maid then
		playerMaids[player] = nil
		maid:Clean()
	end
end

-- ===== Doğma (ana menü → dünya) =====
local function isAlive(player: Player): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and character.Parent ~= nil
end

local function worldReady(): boolean
	local world = services.WorldService
	return world ~= nil and world:IsReady()
end

local function groundReady(): boolean
	if worldReady() then
		return true
	end
	local folder = workspace:FindFirstChild("World")
	local progress = folder and folder:GetAttribute("BuildProgress")
	return type(progress) == "number" and progress >= FrontEndConfig.MinWorldProgress
end

-- Önce dünyanın tamamını, olmazsa en az zemini bekler. Sonsuza kadar beklemez.
local function waitForWorld(player: Player)
	local function waitUntil(check: () -> boolean, seconds: number)
		local deadline = os.clock() + seconds
		while not check() and os.clock() < deadline and player.Parent == Players do
			task.wait(0.25)
		end
	end
	if not worldReady() and spawnStatusRemote then
		spawnStatusRemote:FireClient(player, "Queued", "World")
	end
	waitUntil(worldReady, FrontEndConfig.ServerWorldWait)
	if not worldReady() then
		waitUntil(groundReady, FrontEndConfig.ServerGroundWait)
		Log.Warn("Dünya tam hazır olmadan doğuruluyor:", player.Name, "zemin hazır:", groundReady())
	end
end

local function markInGame(player: Player, state: SpawnState)
	state.InGame = true
	player:SetAttribute(Constants.Attributes.InGame, true)
	setMenuStreaming(player, false) -- akış tekrar karakteri takip eder, menü ek odakları kalkar
end

-- Oyuncuyu dünyaya sokar. Karakter zaten canlıysa yenisini YARATMAZ (sadece etkinleştirir).
-- Aynı anda tek doğma işlemi yürür (Spawning kilidi). true → oyuncunun canlı karakteri var.
function CharacterService:SpawnPlayer(player: Player, reason: string?): boolean
	local state = spawnStates[player]
	if not state or player.Parent ~= Players then
		return false
	end
	if isAlive(player) then
		markInGame(player, state)
		return true
	end
	if state.Spawning then
		return false -- zaten sürüyor; ikinci karakter yaratma
	end
	state.Spawning = true
	waitForWorld(player)
	if player.Parent ~= Players or spawnStates[player] ~= state then
		state.Spawning = false
		return false
	end
	if isAlive(player) then
		state.Spawning = false
		markInGame(player, state)
		return true
	end
	-- Akış odağını doğmadan ÖNCE karaktere bırak (yeni karakterin çevresi hemen yüklensin)
	setMenuStreaming(player, false)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	state.Spawning = false
	if not ok then
		Log.Error("LoadCharacter başarısız:", player.Name, err)
		setMenuStreaming(player, true) -- oyuncu menüde kalıyor; menü şehri akmaya devam etsin
		return false
	end
	markInGame(player, state)
	Log.Info("Doğdu:", player.Name, "sebep:", reason or "?")
	return true
end

function CharacterService:IsInGame(player: Player): boolean
	local state = spawnStates[player]
	return state ~= nil and state.InGame
end

-- Ölüm/kaybolma sonrası: gecikmeden sonra oyuncu hâlâ oyundaysa ve canlı karakteri yoksa yeniden doğur.
-- Aynı karakter için birden çok çağrı güvenlidir (SpawnPlayer kilidi + canlılık kontrolü).
function CharacterService:_scheduleRespawnCheck(player: Player)
	task.delay(Config.Spawn.RespawnDelay, function()
		local state = spawnStates[player]
		if state and state.InGame and not state.Spawning and not isAlive(player) then
			CharacterService:SpawnPlayer(player, "Respawn")
		end
	end)
end

local function onSpawnRequest(player: Player)
	if not spawnLimiter:Check(player) then
		return
	end
	local session = services.PlayerService and services.PlayerService:GetSession(player)
	if not session or not spawnStates[player] then
		if spawnStatusRemote then
			spawnStatusRemote:FireClient(player, "Rejected", "NoSession")
		end
		return
	end
	if spawnStates[player].Spawning then
		return -- istemci tekrar bastı; süren işlem sonucu bildirecek
	end
	local ok = CharacterService:SpawnPlayer(player, "Menu")
	if spawnStatusRemote and player.Parent == Players then
		spawnStatusRemote:FireClient(player, if ok then "Spawned" else "Rejected", if ok then nil else "Error")
	end
end

function CharacterService:Init(allServices)
	services = allServices
	checkAvatarPolicy()
end

function CharacterService:Start()
	-- Menüdeki oyuncuların akış odağı (görünmez, çarpışmasız sabit parça)
	local focus = Instance.new("Part")
	focus.Name = "SolaraMenuFocus"
	focus.Anchored = true
	focus.CanCollide = false
	focus.CanQuery = false
	focus.CanTouch = false
	focus.Transparency = 1
	focus.Size = Vector3.new(1, 1, 1)
	focus.Position = FrontEndConfig.StreamFocus
	focus.Parent = workspace
	menuFocus = focus
	for index, position in FrontEndConfig.MenuExtraStreamFoci or {} do
		local extra = focus:Clone()
		extra.Name = "SolaraMenuFocus" .. (index + 1)
		extra.Position = position
		extra.Parent = workspace
		table.insert(menuExtraFoci, extra)
	end

	spawnStatusRemote = RemoteRegistry.Get("PlayerRemotes", "SpawnStatus") :: RemoteEvent
	local requestSpawn = RemoteRegistry.Get("PlayerRemotes", "RequestSpawn") :: RemoteEvent
	requestSpawn.OnServerEvent:Connect(function(player: Player)
		task.spawn(onSpawnRequest, player)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return CharacterService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties>
<string name="Name">MovementValidationService</string>

<ProtectedString name="Source"><![CDATA[-- MovementValidationService: sunucu tarafı temel hız doğrulaması (Bölüm 26).
-- Karakter fiziği istemcide çalıştığı için hız hilesi mümkündür; burada yakalanır.
-- Aşama 1 politikası: SADECE KAYIT (log). Ceza/geri çekme Aşama 12'de, gerçek testlerden
-- sonra eşikler kalibre edilince açılacak (meşru oyuncuları yanlışlıkla cezalandırmamak için).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log).new("MovementValidation")

local MovementValidationService = {
	Name = "MovementValidationService",
	Priority = 40,
	Policy = "LogOnly", -- "LogOnly" | "Rubberband" (ileride)
}

local SAMPLE_INTERVAL = 0.5
local FLAG_WINDOW = 10 -- sn
local FLAG_THRESHOLD = 4 -- bu pencerede bu kadar ihlal → uyarı

type Sample = {
	Character: Model?,
	Position: Vector3?,
	Time: number,
	Flags: { number },
}

local samples: { [Player]: Sample } = {}

local function maxAllowedSpeed(): number
	local m = Config.Movement
	return m.SprintSpeed * m.ValidationSpeedMultiplier + m.ValidationTolerance
end

local function shouldSkip(character: Model, humanoid: Humanoid): boolean
	if humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
		return true -- araçtaki hız araç sistemi tarafından ayrıca doğrulanacak (Aşama 3)
	end
	local spawnedAt = character:GetAttribute(Constants.Attributes.SpawnedAt)
	if type(spawnedAt) ~= "number" then
		return true
	end
	if workspace:GetServerTimeNow() - spawnedAt < Config.Spawn.TeleportGraceSeconds then
		return true
	end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Physics then
		return true
	end
	-- Sunucu kendisi ışınladıysa bu attribute set edilir (ileride: GPS hızlı seyahat vb.)
	if character:GetAttribute("ServerTeleportAt") then
		local t = character:GetAttribute("ServerTeleportAt")
		if type(t) == "number" and workspace:GetServerTimeNow() - t < Config.Spawn.TeleportGraceSeconds then
			return true
		end
	end
	return false
end

local function check(player: Player, sample: Sample, now: number)
	local character = player.Character
	if not character then
		sample.Character = nil
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	local position = root.Position
	if sample.Character ~= character or sample.Position == nil or shouldSkip(character, humanoid) then
		sample.Character = character
		sample.Position = position
		sample.Time = now
		return
	end

	local elapsed = now - sample.Time
	if elapsed <= 0 then
		return
	end
	local delta = position - sample.Position
	local horizontalSpeed = Vector3.new(delta.X, 0, delta.Z).Magnitude / elapsed
	sample.Position = position
	sample.Time = now

	if horizontalSpeed > maxAllowedSpeed() then
		table.insert(sample.Flags, now)
		-- Pencere dışındaki eski kayıtları at
		while #sample.Flags > 0 and now - sample.Flags[1] > FLAG_WINDOW do
			table.remove(sample.Flags, 1)
		end
		if #sample.Flags >= FLAG_THRESHOLD then
			Log.Warn(string.format("Şüpheli hız: %s %.1f stud/sn (izin %.1f), %d ihlal/%ds",
				player.Name, horizontalSpeed, maxAllowedSpeed(), #sample.Flags, FLAG_WINDOW))
			table.clear(sample.Flags)
		end
	end
end

function MovementValidationService:Init() end

function MovementValidationService:Start()
	Players.PlayerAdded:Connect(function(player)
		samples[player] = { Time = 0, Flags = {} }
	end)
	Players.PlayerRemoving:Connect(function(player)
		samples[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		samples[player] = { Time = 0, Flags = {} }
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SAMPLE_INTERVAL then
			return
		end
		accumulator = 0
		local now = os.clock()
		for player, sample in samples do
			check(player, sample, now)
		end
	end)
end

return MovementValidationService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001D"><Properties>
<string name="Name">PlayerService</string>

<ProtectedString name="Source"><![CDATA[-- PlayerService: oyuncu oturumlarının yaşam döngüsü ve oyun modu ayrımı.
-- Veri kalıcılığı (DataStore) Aşama 7'de DataService ile buraya bağlanacak.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local RemoteRegistry = require(Shared.RemoteRegistry)
local Signal = require(Shared.Utilities.Signal)
local RateLimiter = require(Shared.Utilities.RateLimiter)
local Log = require(Shared.Utilities.Log).new("PlayerService")

local PlayerService = {
	Name = "PlayerService",
	Priority = 5,
	SessionStarted = Signal.new(), -- (player, session)
	SessionEnded = Signal.new(), -- (player)
}

type Session = {
	Player: Player,
	JoinedAt: number,
	ClientReady: boolean,
	DeviceHint: string?,
}

local sessions: { [Player]: Session } = {}
local readyLimiter = RateLimiter.new(3, 0.2)
local serverGameMode = Config.Modes.Normal

local function resolveGameMode(): string
	if table.find(Config.SandboxPlaceIds, game.PlaceId) then
		return Config.Modes.Sandbox
	end
	-- Sadece Studio'da: Workspace'e "ForceGameMode" = "Sandbox" attribute'u ekleyerek test edebilirsin
	if RunService:IsStudio() then
		local forced = workspace:GetAttribute(Constants.Attributes.ForceGameMode)
		if forced == Config.Modes.Sandbox or forced == Config.Modes.Normal then
			return forced
		end
	end
	return Config.Modes.Normal
end

function PlayerService:GetGameMode(): string
	return serverGameMode
end

function PlayerService:GetSession(player: Player): Session?
	return sessions[player]
end

local function onPlayerAdded(player: Player)
	if sessions[player] then
		return
	end
	-- Avatar kuralı: oyuncunun gerçek görünümü yüklenmeli
	player.CanLoadCharacterAppearance = true

	local session: Session = {
		Player = player,
		JoinedAt = workspace:GetServerTimeNow(),
		ClientReady = false,
		DeviceHint = nil,
	}
	sessions[player] = session
	player:SetAttribute(Constants.Attributes.GameMode, serverGameMode)
	player:SetAttribute(Constants.Attributes.SessionReady, false)
	Log.Info("Katıldı:", player.Name, "mod:", serverGameMode)
	PlayerService.SessionStarted:Fire(player, session)
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	readyLimiter:Forget(player)
	Log.Info("Ayrıldı:", player.Name)
	PlayerService.SessionEnded:Fire(player)
end

function PlayerService:Init()
	serverGameMode = resolveGameMode()
	workspace:SetAttribute(Constants.Attributes.GameMode, serverGameMode)
end

function PlayerService:Start()
	local clientReady = RemoteRegistry.Get("PlayerRemotes", "ClientReady") :: RemoteEvent
	local sessionInfo = RemoteRegistry.Get("PlayerRemotes", "SessionInfo") :: RemoteEvent

	clientReady.OnServerEvent:Connect(function(player: Player, deviceHint: any)
		if not readyLimiter:Check(player) then
			return
		end
		local session = sessions[player]
		if not session then
			return
		end
		-- Gelen veri sadece bilgi amaçlı; yine de tipini ve uzunluğunu doğrula
		if type(deviceHint) == "string" and #deviceHint <= 24 then
			session.DeviceHint = deviceHint
		end
		if not session.ClientReady then
			session.ClientReady = true
			player:SetAttribute(Constants.Attributes.SessionReady, true)
		end
		sessionInfo:FireClient(player, {
			GameMode = serverGameMode,
			Version = Config.Version,
			ServerTime = workspace:GetServerTimeNow(),
		})
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	-- Bootstrap'tan önce girmiş oyuncular (Studio'da sık olur)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return PlayerService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties>
<string name="Name">VehicleService</string>

<ProtectedString name="Source"><![CDATA[-- VehicleService: araçların sunucu tarafı (Bölüm 8.3, 9, 15.2, 26, 27.2).
--   * Harita verisindeki noktalara park halindeki araçları doğurur.
--   * Binme: ProximityPrompt → sunucu doğrular (mesafe, koltuk boş mu, oyuncu canlı mı) → Sit.
--   * Sürücü koltuğu tek kişilik; sürücü olunca araç fiziğinin sahibi o oyuncu olur (gecikmesiz sürüş).
--   * İnme: istemci ister → sunucu güvenli iniş noktası bulur.
--   * Far/stop/sinyal/korna: sürücüden gelen durum doğrulanır ve herkes için uygulanır.
--   * Oyuncuya uzak park araçları sabitlenir (fizik maliyeti yok); terk edilmiş araçlar yerine döner.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RemoteRegistry = require(Shared.RemoteRegistry)
local MapDefinitions = require(Shared.MapDefinitions)
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local RateLimiter = require(Shared.Utilities.RateLimiter)
local Signal = require(Shared.Utilities.Signal)
local Log = require(Shared.Utilities.Log).new("VehicleService")

local VehicleService = {
	Name = "VehicleService",
	Priority = 50,
	VehicleEntered = Signal.new(), -- (player, model, isDriver)
	VehicleExited = Signal.new(), -- (player, model)
}

local VehicleFactory -- Init'te yüklenir
local services
local folder: Folder
local records: { [Model]: any } = {}
local seatRecords: { [Seat]: any } = {}
local masslessBackup: { [Model]: { BasePart } } = {}

local enterLimiter = RateLimiter.new(3, 1)
local exitLimiter = RateLimiter.new(3, 1)
local stateLimiter = RateLimiter.new(20, 15)
local flipLimiter = RateLimiter.new(1, 0.33)

local ACTIVATE_RADIUS = 220 -- bu mesafede oyuncu varsa park aracı fiziğe açılır
local FREEZE_RADIUS = 320 -- herkes bu mesafeden uzaksa sabitlenir
local RESPAWN_IDLE = 300 -- sn
local MAX_ENTER_DISTANCE = 14

local HEAD_ON = Color3.fromRGB(255, 246, 225)
local HEAD_OFF = Color3.fromRGB(220, 220, 210)
local TAIL_OFF = Color3.fromRGB(120, 20, 24)
local TAIL_DIM = Color3.fromRGB(170, 24, 28)
local TAIL_BRAKE = Color3.fromRGB(255, 40, 40)
local AMBER_ON = Color3.fromRGB(255, 170, 40)
local AMBER_OFF = Color3.fromRGB(255, 150, 30)

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

local isHungUp: (any) -> boolean

-- ===== Yardımcılar =====
local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function excludeList(extra: { Instance }?)
	local list = { folder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	if extra then
		for _, e in extra do
			table.insert(list, e)
		end
	end
	return list
end

local function groundY(x: number, z: number, fromY: number?): number?
	groundParams.FilterDescendantsInstances = excludeList()
	local hit = workspace:Raycast(Vector3.new(x, fromY or 400, z), Vector3.new(0, -800, 0), groundParams)
	return if hit then hit.Position.Y else nil
end

local function collectLights(model: Model)
	local lights = { Head = {}, Tail = {}, Reverse = {}, IndL = {}, IndR = {}, LightBar = {} }
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "Headlight" then
				table.insert(lights.Head, d)
			elseif d.Name == "TailLight" then
				table.insert(lights.Tail, d)
			elseif d.Name == "ReverseLight" then
				table.insert(lights.Reverse, d)
			elseif d.Name == "IndicatorL" then
				table.insert(lights.IndL, d)
			elseif d.Name == "IndicatorR" then
				table.insert(lights.IndR, d)
			end
		end
	end
	return lights
end

local function applyLights(record)
	local model = record.Model
	local on = model:GetAttribute("Lights") == true
	local braking = model:GetAttribute("Braking") == true
	local reversing = model:GetAttribute("Reversing") == true
	for _, p in record.Lights.Head do
		p.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.Color = if on then HEAD_ON else HEAD_OFF
		local beam = p:FindFirstChild("Beam")
		if beam and beam:IsA("Light") then
			beam.Enabled = on
		end
	end
	for _, p in record.Lights.Tail do
		p.Material = if (on or braking) then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.Color = if braking then TAIL_BRAKE elseif on then TAIL_DIM else TAIL_OFF
	end
	for _, p in record.Lights.Reverse do
		p.Material = if reversing then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.Color = if reversing then HEAD_ON else HEAD_OFF
	end
end

local function setIndicatorPhase(record, phaseOn: boolean)
	local mode = record.Model:GetAttribute("Indicator")
	local left = phaseOn and (mode == "L" or mode == "H")
	local right = phaseOn and (mode == "R" or mode == "H")
	for _, p in record.Lights.IndL do
		p.Material = if left then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.Color = if left then AMBER_ON else AMBER_OFF
	end
	for _, p in record.Lights.IndR do
		p.Material = if right then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.Color = if right then AMBER_ON else AMBER_OFF
	end
end

-- Park freni: tüm motorlar sıfır hız + fren torku; direksiyon düz
local function applyParkingBrake(record)
	local brake = record.Model:GetAttribute("BrakeTorque") or 1e5
	for _, d in record.Model:GetDescendants() do
		if d:IsA("HingeConstraint") then
			d.AngularVelocity = 0
			d.MotorMaxTorque = brake
		elseif d:IsA("CylindricalConstraint") then
			d.TargetAngle = 0
		elseif d:IsA("AlignOrientation") and d.Name == "Upright" then
			d.PrimaryAxis = Vector3.new(0, 1, 0)
			d.Enabled = VehicleDefinitions.IsMotorcycle(record.Def)
		end
	end
end

local function setAnchored(record, anchored: boolean)
	if record.Anchored == anchored then
		return
	end
	record.Anchored = anchored
	VehicleFactory.SetAnchored(record.Model, anchored)
end

local function nearestPlayerDistance(position: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local root = getRoot(p)
		if root then
			best = math.min(best, (root.Position - position).Magnitude)
		end
	end
	return best
end

-- ===== Karakter ↔ araç =====
local function setCharacterMassless(character: Model, value: boolean)
	if value then
		local changed = {}
		for _, d in character:GetDescendants() do
			if d:IsA("BasePart") and not d.Massless then
				d.Massless = true
				table.insert(changed, d)
			end
		end
		masslessBackup[character] = changed
	else
		local changed = masslessBackup[character]
		masslessBackup[character] = nil
		if changed then
			for _, d in changed do
				if d.Parent then
					d.Massless = false
				end
			end
		end
	end
end

-- R15 avatarda elleri direksiyona / gidona yerleştir (avatar kol boyuna IK uyum sağlar)
local function addHandIK(model: Model, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end
	for _, side in { "Left", "Right" } do
		local target = model:FindFirstChild("Hand" .. string.sub(side, 1, 1), true)
		local root = character:FindFirstChild(side .. "UpperArm")
		local hand = character:FindFirstChild(side .. "Hand")
		if target and target:IsA("Attachment") and root and hand then
			local ik = Instance.new("IKControl")
			ik.Name = "VehicleIK_" .. side
			ik.Type = Enum.IKControlType.Position
			ik.ChainRoot = root
			ik.EndEffector = hand
			ik.Target = target
			ik.Weight = 0.9
			ik.SmoothTime = 0.08
			ik.Parent = humanoid
		end
	end
end

local function removeHandIK(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		for _, child in humanoid:GetChildren() do
			if child:IsA("IKControl") and string.sub(child.Name, 1, 10) == "VehicleIK_" then
				child:Destroy()
			end
		end
	end
end

local function onSeated(record, seat: Seat, humanoid: Humanoid)
	local character = humanoid.Parent :: Model
	local player = Players:GetPlayerFromCharacter(character)
	local isDriver = seat:GetAttribute("DriverSeat") == true
	record.Occupants[seat] = { Player = player, Character = character }
	record.LastActive = os.clock()
	setAnchored(record, false)
	setCharacterMassless(character, true)
	local prompt = seat:FindFirstChild("EnterPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = false
	end
	if isDriver then
		addHandIK(record.Model, character)
		record.Driver = player
		record.Model:SetAttribute("DriverUserId", if player then player.UserId else 0)
		if player then
			VehicleFactory.SetNetworkOwner(record.Model, player)
		end
		-- gece ise farlar otomatik açık
		record.Model:SetAttribute("Lights", workspace:GetAttribute("IsNight") == true)
		applyLights(record)
		local engine = record.Chassis:FindFirstChild("Engine")
		if engine and engine:IsA("Sound") then
			engine:Play()
		end
	end
	if player then
		VehicleService.VehicleEntered:Fire(player, record.Model, isDriver)
	end
end

local function onUnseated(record, seat: Seat)
	local info = record.Occupants[seat]
	record.Occupants[seat] = nil
	record.LastActive = os.clock()
	local prompt = seat:FindFirstChild("EnterPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = true
	end
	if info and info.Character then
		setCharacterMassless(info.Character, false)
		removeHandIK(info.Character)
		-- araçtan inişteki ani konum değişimi hız hilesi sanılmasın
		info.Character:SetAttribute("ServerTeleportAt", workspace:GetServerTimeNow())
	end
	if seat:GetAttribute("DriverSeat") then
		record.Driver = nil
		local model = record.Model
		model:SetAttribute("DriverUserId", nil)
		model:SetAttribute("Braking", false)
		model:SetAttribute("Reversing", false)
		model:SetAttribute("Indicator", "")
		model:SetAttribute("Lights", false)
		applyLights(record)
		setIndicatorPhase(record, false)
		for _, name in { "Engine", "Horn" } do
			local s = record.Chassis:FindFirstChild(name)
			if s and s:IsA("Sound") then
				s:Stop()
			end
		end
		-- Sahipliği sunucuya geri al ve aracı frenle (istemci son karede gaz bırakmış olabilir)
		task.delay(0.3, function()
			if record.Driver == nil and model.Parent then
				VehicleFactory.SetNetworkOwner(model, nil)
				applyParkingBrake(record)
			end
		end)
	end
	if info and info.Player then
		VehicleService.VehicleExited:Fire(info.Player, record.Model)
	end
end

local function register(model: Model, defId: string, spot: CFrame?)
	local def = VehicleDefinitions.Get(defId)
	local record = {
		Model = model,
		DefId = defId,
		Def = def,
		Chassis = model.PrimaryPart,
		Spot = spot,
		Driver = nil,
		Occupants = {},
		LastActive = os.clock(),
		Anchored = false,
		Lights = collectLights(model),
		BlinkOn = false,
	}
	records[model] = record
	for _, d in model:GetDescendants() do
		if d:IsA("Seat") and d:GetAttribute("VehicleSeat") then
			seatRecords[d] = record
			d:GetPropertyChangedSignal("Occupant"):Connect(function()
				local hum = d.Occupant
				if hum then
					onSeated(record, d, hum)
				else
					onUnseated(record, d)
				end
			end)
			local prompt = d:FindFirstChild("EnterPrompt")
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Triggered:Connect(function(player)
					VehicleService:_tryEnter(player, d)
				end)
			end
		end
	end
	model.Destroying:Connect(function()
		records[model] = nil
		for seat, r in seatRecords do
			if r == record then
				seatRecords[seat] = nil
			end
		end
	end)
	return record
end

-- Otomobil takıldı mı? (kaldırım/engel üstünde asılı: en az iki tekerlek yere değmiyor)
-- Sadece oyuncu isteğinde (oran sınırlı) çağrılır: 4 kısa ışın.
local hangParams = RaycastParams.new()
hangParams.FilterType = Enum.RaycastFilterType.Exclude
hangParams.RespectCanCollide = true
isHungUp = function(record): boolean
	local model = record.Model
	hangParams.FilterDescendantsInstances = excludeList({ model })
	local grounded = 0
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part:GetAttribute("Wheel") then
			local reach = part.Size.Y / 2 + 0.6
			if workspace:Raycast(part.Position, Vector3.new(0, -reach, 0), hangParams) then
				grounded += 1
			end
		end
	end
	return grounded <= 2
end

-- ===== Genel API =====
function VehicleService:SpawnVehicle(defId: string, cframe: CFrame, options: any?)
	local model = VehicleFactory.Build(defId, cframe, options)
	if not model then
		return nil
	end
	local record = register(model, defId, if options and options.Spot then options.Spot else nil)
	if options and options.Anchored then
		setAnchored(record, true)
	end
	model.Parent = folder
	return record
end

-- Zemin yüksekliğini bulup aracı yere oturtarak doğurur
function VehicleService:SpawnAtGround(defId: string, x: number, z: number, yaw: number, options: any?)
	local def = VehicleDefinitions.Get(defId)
	if not def then
		return nil
	end
	local y = groundY(x, z) or 0
	-- Sürüş yüksekliği fabrikanın formülünden (tek kaynak; motosiklette eski değer aynen korunur)
	local ride = VehicleFactory.ComputeRideHeight(def)
	local cf = CFrame.new(x, y + ride + 0.15, z) * CFrame.Angles(0, math.rad(yaw), 0)
	local opts = options or {}
	opts.Spot = cf
	return self:SpawnVehicle(defId, cf, opts)
end

function VehicleService:GetRecordForPlayer(player: Player)
	for _, record in records do
		for _, info in record.Occupants do
			if info.Player == player then
				return record
			end
		end
	end
	return nil
end

function VehicleService:ResetToSpot(record)
	if not record.Spot or next(record.Occupants) then
		return
	end
	setAnchored(record, true)
	record.Model:PivotTo(record.Spot)
	applyParkingBrake(record)
	record.LastActive = os.clock()
end

function VehicleService:_tryEnter(player: Player, seat: Seat)
	if not enterLimiter:Check(player) then
		return
	end
	local record = seatRecords[seat]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = getRoot(player)
	if not record or not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if seat.Occupant ~= nil or humanoid.SeatPart ~= nil then
		return
	end
	if (root.Position - seat.Position).Magnitude > MAX_ENTER_DISTANCE then
		return -- mesafe doğrulaması (Bölüm 26)
	end
	setAnchored(record, false)
	seat:Sit(humanoid)
end

-- Güvenli iniş noktası: önce koltuk tarafı, sonra diğer taraf, arka, en son üst
local function findExitCFrame(record, seat: Seat, character: Model): CFrame
	local chassisCF = record.Chassis.CFrame
	local def = record.Def
	local halfW = (if def.Type == "Motorcycle" then 1.2 else def.Width / 2)
	local localSeat = chassisCF:PointToObjectSpace(seat.Position)
	local side = if localSeat.X > 0.1 then 1 else -1
	local candidates = {
		Vector3.new(side * (halfW + 2.5), 0, localSeat.Z),
		Vector3.new(-side * (halfW + 2.5), 0, localSeat.Z),
		Vector3.new(0, 0, def.Length / 2 + 3),
		Vector3.new(0, 0, -(def.Length / 2 + 3)),
	}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { record.Model, character }
	params.RespectCanCollide = true
	local from = seat.Position + Vector3.new(0, 1, 0)
	for _, offset in candidates do
		local target = chassisCF:PointToWorldSpace(offset)
		target = Vector3.new(target.X, from.Y, target.Z)
		local blocked = workspace:Raycast(from, target - from, params)
		if not blocked then
			local down = workspace:Raycast(target + Vector3.new(0, 4, 0), Vector3.new(0, -30, 0), params)
			if down then
				local look = chassisCF.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				local pos = down.Position + Vector3.new(0, 3.2, 0)
				return CFrame.lookAt(pos, pos + (if flatLook.Magnitude > 0.01 then flatLook else Vector3.new(0, 0, -1)))
			end
		end
	end
	-- her yer kapalıysa: aracın üstü
	return CFrame.new(record.Chassis.Position + Vector3.new(0, def.Length * 0.25 + 6, 0))
end

function VehicleService:ExitVehicle(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local seat = humanoid.SeatPart
	if not seat or not seat:IsA("Seat") or not seatRecords[seat] then
		return
	end
	local record = seatRecords[seat]
	local exitCF = findExitCFrame(record, seat, character :: Model)
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
	task.defer(function()
		if character and character.Parent then
			(character :: Model):PivotTo(exitCF)
		end
	end)
end

-- ===== Yaşam döngüsü =====
function VehicleService:Init(allServices)
	services = allServices
	VehicleFactory = require(ServerScriptService:WaitForChild("Vehicles"):WaitForChild("VehicleFactory"))
	local body, wheels = VehicleFactory.BodyGroup, VehicleFactory.WheelGroup
	for _, group in { body, wheels } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(group)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable(body, wheels, false)
	folder = workspace:FindFirstChild("Vehicles") or Instance.new("Folder")
	folder.Name = "Vehicles"
	folder.Parent = workspace
end

function VehicleService:Start()
	local exitRemote = RemoteRegistry.Get("VehicleRemotes", "RequestExit") :: RemoteEvent
	local stateRemote = RemoteRegistry.Get("VehicleRemotes", "DriveState") :: RemoteEvent
	local flipRemote = RemoteRegistry.Get("VehicleRemotes", "RequestFlip") :: RemoteEvent

	exitRemote.OnServerEvent:Connect(function(player)
		if exitLimiter:Check(player) then
			VehicleService:ExitVehicle(player)
		end
	end)

	stateRemote.OnServerEvent:Connect(function(player, state)
		if not stateLimiter:Check(player) or type(state) ~= "table" then
			return
		end
		local record = VehicleService:GetRecordForPlayer(player)
		if not record or record.Driver ~= player then
			return -- sadece sürücü
		end
		local model = record.Model
		if type(state.Lights) == "boolean" then
			model:SetAttribute("Lights", state.Lights)
		end
		if type(state.Braking) == "boolean" then
			model:SetAttribute("Braking", state.Braking)
		end
		if type(state.Reversing) == "boolean" then
			model:SetAttribute("Reversing", state.Reversing)
		end
		if state.Indicator == "" or state.Indicator == "L" or state.Indicator == "R" or state.Indicator == "H" then
			model:SetAttribute("Indicator", state.Indicator)
			if state.Indicator == "" then
				setIndicatorPhase(record, false)
			end
		end
		if type(state.Horn) == "boolean" then
			local horn = record.Chassis:FindFirstChild("Horn")
			if horn and horn:IsA("Sound") then
				if state.Horn and not horn.IsPlaying then
					horn:Play()
				elseif not state.Horn and horn.IsPlaying then
					horn:Stop()
				end
			end
			model:SetAttribute("Horn", state.Horn)
		end
		applyLights(record)
	end)

	flipRemote.OnServerEvent:Connect(function(player)
		if not flipLimiter:Check(player) then
			return
		end
		local record = VehicleService:GetRecordForPlayer(player)
		if not record then
			-- yakındaki (inmiş) araç da düzeltilebilir
			local root = getRoot(player)
			if root then
				for _, r in records do
					if (r.Chassis.Position - root.Position).Magnitude < 16 and not next(r.Occupants) then
						record = r
						break
					end
				end
			end
		end
		if not record then
			return
		end
		local chassis = record.Chassis
		if chassis.AssemblyLinearVelocity.Magnitude > 8 then
			return -- sadece durmuş araçlar
		end
		-- Ters/yan dönmüş araç VEYA (otomobil) tekerlekleri yere değmeyen, takılı kalmış araç
		local tipped = chassis.CFrame.UpVector.Y <= 0.6
		if not tipped and not (VehicleDefinitions.UsesCarPhysics(record.Def) and isHungUp(record)) then
			return
		end
		local look = chassis.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then
			flat = Vector3.new(0, 0, -1)
		end
		local pos = chassis.Position + Vector3.new(0, 4, 0)
		record.Model:PivotTo(CFrame.lookAt(pos, pos + flat.Unit))
		for _, d in record.Model:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Physical") then
				d.AssemblyLinearVelocity = Vector3.zero
				d.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)

	-- Park araçlarını dünya hazır olunca doğur
	task.spawn(function()
		local world = services.WorldService
		if world and not world:IsReady() then
			world.WorldReady:Wait()
		end
		local count = 0
		for index, spot in MapDefinitions.GetVehicleSpots() do
			local ok, err = pcall(function()
				local record = self:SpawnAtGround(spot.DefId, spot.Position.X, spot.Position.Z, spot.Yaw, { Seed = index * 7919, Anchored = true })
				if record then
					count += 1
				end
			end)
			if not ok then
				Log.Warn("Araç doğurulamadı:", spot.DefId, err)
			end
			if index % 8 == 0 then
				task.wait()
			end
		end
		Log.Info("Park halindeki araçlar:", count)
	end)

	-- Yönetim döngüsü: sabitleme, terk edilmiş araç, hız doğrulama
	local accumulator = 0
	local lastSpeedWarn = {}
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 then
			return
		end
		accumulator = 0
		local now = os.clock()
		for model, record in records do
			local chassis = record.Chassis
			if not chassis or not chassis.Parent then
				continue
			end
			local occupied = next(record.Occupants) ~= nil
			local distance = nearestPlayerDistance(chassis.Position)
			if occupied then
				record.LastActive = now
				if record.Driver then
					local speed = chassis.AssemblyLinearVelocity.Magnitude
					local limit = record.Def.MaxSpeed * 1.45 + 25
					if speed > limit and (now - (lastSpeedWarn[model] or 0)) > 10 then
						lastSpeedWarn[model] = now
						Log.Warn(string.format("Şüpheli araç hızı: %s %.0f (limit %.0f)", record.Driver.Name, speed, limit))
					end
				end
			else
				if chassis.Position.Y < -60 then
					VehicleService:ResetToSpot(record)
				elseif record.Anchored and distance < ACTIVATE_RADIUS then
					setAnchored(record, false)
				elseif not record.Anchored and distance > FREEZE_RADIUS and chassis.AssemblyLinearVelocity.Magnitude < 1 then
					setAnchored(record, true)
				end
				if record.Spot and now - record.LastActive > RESPAWN_IDLE and distance > 260
					and (chassis.Position - record.Spot.Position).Magnitude > 25 then
					VehicleService:ResetToSpot(record)
				end
			end
		end
	end)

	-- Sinyal yanıp sönme (sadece sinyali açık araçlar)
	task.spawn(function()
		local phase = false
		while true do
			task.wait(0.4)
			phase = not phase
			for _, record in records do
				local mode = record.Model:GetAttribute("Indicator")
				if mode and mode ~= "" then
					setIndicatorPhase(record, phase)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		enterLimiter:Forget(player)
		exitLimiter:Forget(player)
		stateLimiter:Forget(player)
		flipLimiter:Forget(player)
	end)
end

return VehicleService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties>
<string name="Name">WeatherService</string>

<ProtectedString name="Source"><![CDATA[-- WeatherService: gün-gece döngüsü, temel atmosfer ve sokak lambaları (Bölüm 22).
-- Aşama 2 kapsamı: zaman akışı + aydınlatma + lambalar. Hava durumu (bulut/yağmur) Aşama 10-11'de
-- Sandbox ayarlarıyla birlikte eklenecek; API şimdiden hazır.
--
-- Zaman sunucuda tutulur ve Lighting.ClockTime ile tüm istemcilere çoğalır.
-- Workspace attribute'ları: "IsNight" (bool) — NPC programları (Aşama 4) bunu dinleyecek.

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Utilities.Signal)
local Log = require(Shared.Utilities.Log).new("WeatherService")

local WeatherService = {
	Name = "WeatherService",
	Priority = 30,
	NightChanged = Signal.new(), -- (isNight)
}

local paused = false
local clockTime = Config.Environment.StartClockTime
local lampsOn: boolean? = nil
local lampJob = 0

local LAMP_ON_COLOR = Color3.fromRGB(255, 220, 160)
local LAMP_OFF_COLOR = Color3.fromRGB(170, 170, 160)

local function ensure(className: string, name: string, parent: Instance): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local obj = Instance.new(className)
	obj.Name = name
	obj.Parent = parent
	return obj
end

local function setupLighting()
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(64, 64, 74)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 140)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 26 -- subtropik kıyı ışığı

	local atmosphere = ensure("Atmosphere", "SolaraAtmosphere", Lighting) :: Atmosphere
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(199, 212, 226)
	atmosphere.Decay = Color3.fromRGB(110, 116, 132)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.3

	local color = ensure("ColorCorrectionEffect", "SolaraColor", Lighting) :: ColorCorrectionEffect
	color.Saturation = 0.08
	color.Contrast = 0.05
	color.Brightness = 0.01

	local bloom = ensure("BloomEffect", "SolaraBloom", Lighting) :: BloomEffect
	bloom.Intensity = 0.5
	bloom.Size = 22
	bloom.Threshold = 1.8

	local rays = ensure("SunRaysEffect", "SolaraSunRays", Lighting) :: SunRaysEffect
	rays.Intensity = 0.05
	rays.Spread = 0.6
end

local function isNightAt(t: number): boolean
	local env = Config.Environment
	return t >= env.LampsOnAt or t < env.LampsOffAt
end

-- Lambaları parça parça değiştir (binlerce lamba tek karede değişmesin)
local function applyLamps(on: boolean)
	lampJob += 1
	local job = lampJob
	task.spawn(function()
		local lamps = CollectionService:GetTagged("StreetLamp")
		for index, lamp in lamps do
			if job ~= lampJob then
				return -- daha yeni bir istek geldi
			end
			if lamp:IsA("BasePart") then
				lamp.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				lamp.Color = if on then LAMP_ON_COLOR else LAMP_OFF_COLOR
				local light = lamp:FindFirstChildWhichIsA("Light")
				if light then
					light.Enabled = on
				end
			end
			if index % 250 == 0 then
				task.wait()
			end
		end
	end)
end

local function refreshNightState(force: boolean?)
	local night = isNightAt(clockTime)
	if force or night ~= lampsOn then
		lampsOn = night
		workspace:SetAttribute("IsNight", night)
		applyLamps(night)
		WeatherService.NightChanged:Fire(night)
	end
end

-- ===== Genel API (Sandbox / yönetici araçları kullanacak) =====
function WeatherService:GetClockTime(): number
	return clockTime
end

function WeatherService:SetClockTime(t: number)
	if type(t) ~= "number" or t ~= t then
		return
	end
	clockTime = t % 24
	Lighting.ClockTime = clockTime
	refreshNightState()
end

function WeatherService:SetPaused(value: boolean)
	paused = value == true
end

function WeatherService:IsNight(): boolean
	return lampsOn == true
end

function WeatherService:Init()
	setupLighting()
	Lighting.ClockTime = clockTime
end

function WeatherService:Start()
	refreshNightState(true)
	-- Yeni yüklenen lambalar da doğru durumda olsun (dünya arka planda inşa edilirken)
	CollectionService:GetInstanceAddedSignal("StreetLamp"):Connect(function(lamp)
		if lampsOn and lamp:IsA("BasePart") then
			lamp.Material = Enum.Material.Neon
			lamp.Color = LAMP_ON_COLOR
			local light = lamp:FindFirstChildWhichIsA("Light")
			if light then
				light.Enabled = true
			end
		end
	end)

	local hoursPerSecond = 24 / (Config.Environment.DayLengthMinutes * 60)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		if paused then
			return
		end
		clockTime = (clockTime + dt * hoursPerSecond) % 24
		accumulator += dt
		-- Saniyede bir çoğalt (her kare ağ trafiği yaratmasın)
		if accumulator >= 1 then
			accumulator = 0
			Lighting.ClockTime = clockTime
			refreshNightState()
		end
	end)
	Log.Info(string.format("Gün-gece döngüsü: %d dk/gün, başlangıç %.1f", Config.Environment.DayLengthMinutes, clockTime))
end

return WeatherService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties>
<string name="Name">WorldService</string>

<ProtectedString name="Source"><![CDATA[-- WorldService: Workspace.World yaşam döngüsü (Aşama 2).
--   * Dünya "pişirilmişse" (World.Baked = true) olduğu gibi kullanılır.
--   * Değilse sunucu açılışında WorldGen ile kademeli inşa edilir; doğma noktaları ve zemin
--     ilk karede hazır olur, gerisi arka planda tamamlanır.
--   * Aşama 1'in geçici test alanı (Temporary attribute'lu) kaldırılır.
-- Bölüm 30 kuralı: World altında elle eklenen hiçbir şeye dokunulmaz.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Signal = require(Shared.Utilities.Signal)
local Log = require(Shared.Utilities.Log).new("WorldService")

local WorldService = {
	Name = "WorldService",
	Priority = 1,
	WorldReady = Signal.new(),
}

local worldFolder: Folder
local ready = false

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function removePhase1TestZone()
	local districts = worldFolder:FindFirstChild("Districts")
	if districts then
		for _, child in districts:GetChildren() do
			if child:GetAttribute("Temporary") then
				child:Destroy()
				Log.Info("Aşama 1 test alanı kaldırıldı.")
			end
		end
	end
end

local function markReady()
	if ready then
		return
	end
	ready = true
	workspace:SetAttribute("WorldReady", true)
	WorldService.WorldReady:Fire()
end

function WorldService:IsReady(): boolean
	return ready
end

function WorldService:GetWorldFolder(): Folder
	return worldFolder
end

-- Belirli gruptaki doğma noktaları; grup boşsa tüm noktalar
function WorldService:GetSpawnPoints(group: string?): { BasePart }
	local wanted = group or Config.World.DefaultSpawnGroup
	local all, matching = {}, {}
	local folder = worldFolder:FindFirstChild("SpawnPoints")
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") and not child:IsA("SpawnLocation") then
				table.insert(all, child)
				if child:GetAttribute("SpawnGroup") == wanted then
					table.insert(matching, child)
				end
			end
		end
	end
	return if #matching > 0 then matching else all
end

function WorldService:Init()
	worldFolder = ensureFolder(workspace, "World")
	for _, name in Constants.WorldFolders do
		ensureFolder(worldFolder, name)
	end
	removePhase1TestZone()
	workspace:SetAttribute("WorldReady", false)
end

function WorldService:Start()
	if worldFolder:GetAttribute("Baked") then
		Log.Info("Pişirilmiş dünya bulundu, inşa atlandı.")
		markReady()
		return
	end
	local WorldBuilder = require(ServerScriptService:WaitForChild("WorldGen"):WaitForChild("WorldBuilder"))
	task.spawn(function()
		local ok, result = pcall(WorldBuilder.Build, { Yield = true })
		if not ok then
			Log.Error("Dünya inşası başarısız:", result)
		elseif #result.Errors > 0 then
			Log.Warn("Dünya inşa edildi ama hatalar var:", table.concat(result.Errors, " | "))
		end
		markReady()
	end)
end

return WorldService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35F8B53DN"><Properties>
<string name="Name">VehicleTestService</string>

<ProtectedString name="Source"><![CDATA[-- VehicleTestService: otomobil fiziği test pistini kurar (Aşama 2). SADECE Studio'da ve isteğe bağlı.
--
-- Açmak: Studio'da Play'den ÖNCE Workspace'i seç → Attributes → "+" → SolaraTestCourse (boolean) = true.
-- Açıkken: test pisti kurulur, her otomobil modelinden bir tane başlangıç çizgisine dizilir ve oyuncu
-- her doğduğunda (OYNA / yeniden doğma) pistin başına ışınlanır. Canlı sunucuda hiçbir şey yapmaz.

local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local Log = require(Shared.Utilities.Log).new("VehicleTest")

local VehicleTestService = {
	Name = "VehicleTestService",
	Priority = 60, -- VehicleService (50) ve CharacterService (20) başladıktan sonra
}

local ATTRIBUTE = "SolaraTestCourse"

local services

local function carIds(): { string }
	local list = {}
	for id, def in VehicleDefinitions.Catalog do
		if VehicleDefinitions.UsesCarPhysics(def) then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

function VehicleTestService:Init(allServices)
	services = allServices
end

function VehicleTestService:Start()
	if not RunService:IsStudio() or workspace:GetAttribute(ATTRIBUTE) ~= true then
		if RunService:IsStudio() then
			Log.Info("Test pisti kapalı (Workspace attribute SolaraTestCourse = true ile açılır)")
		end
		return
	end
	local Course = require(ServerScriptService:WaitForChild("Testing"):WaitForChild("VehicleTestCourse"))
	local _, carSpots, playerStart = Course.Build()

	local VehicleFactory = require(ServerScriptService:WaitForChild("Vehicles"):WaitForChild("VehicleFactory"))
	for index, id in carIds() do
		local spot = carSpots[index]
		if spot then
			local def = VehicleDefinitions.Get(id)
			local cf = spot + Vector3.new(0, VehicleFactory.ComputeRideHeight(def) + 0.15, 0)
			local ok, err = pcall(function()
				services.VehicleService:SpawnVehicle(id, cf, { Seed = index, Spot = cf })
			end)
			if not ok then
				Log.Warn("Test aracı doğurulamadı:", id, err)
			end
		end
	end

	services.CharacterService.CharacterReady:Connect(function(player, character, info)
		task.wait(0.2)
		if player.Character ~= character or not character.Parent then
			return
		end
		-- sunucu ışınlaması: hareket doğrulaması bunu hile sanmasın
		character:SetAttribute("ServerTeleportAt", workspace:GetServerTimeNow())
		character:PivotTo(playerStart + Vector3.new(0, (info and info.RootHeight) or 3, 0))
	end)
	workspace:SetAttribute("SolaraTestCourseReady", true)
	Log.Info("Test pisti hazır:", #carIds(), "otomobil başlangıçta")
end

return VehicleTestService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000021"><Properties>
<string name="Name">Vehicles</string>

</Properties>
<Item class="ModuleScript" referent="RBX00000022"><Properties>
<string name="Name">VehicleFactory</string>

<ProtectedString name="Source"><![CDATA[-- VehicleFactory: VehicleDefinitions'tan fiziksel olarak sürülebilir araç modeli üretir (Bölüm 8 / 9).
--
-- Fizik yapısı (her tekerlek için):
--   Chassis ──CylindricalConstraint (dikey kayma = süspansiyon, dikey eksende dönme = direksiyon servo)──► Knuckle
--   Chassis ──SpringConstraint (yay + amortisör)──► Knuckle
--   Knuckle ──HingeConstraint (Motor: tork/fren)──► Wheel
-- Görsel gövde parçaları şasiye kaynaklı ve kütlesizdir → ağırlık merkezi alçak şasidedir.
-- Motosiklette ek olarak AlignOrientation (PrimaryAxisParallel) dik durmayı ve virajda yatışı sağlar.
--
-- Model attribute'ları istemci sürüş kontrolcüsüne gereken her şeyi taşır (tork, fren, yarıçap...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")

local VehicleDefinitions = require(ReplicatedStorage.Shared.VehicleDefinitions)
local VehiclePhysics = require(ReplicatedStorage.Shared.VehiclePhysics)
local CarModelKit = require(ReplicatedStorage.Shared.CarModelKit)
local AudioConfig = require(ReplicatedStorage.Modules.AudioConfig)

local VehicleFactory = {}

VehicleFactory.BodyGroup = "VehicleBody"
VehicleFactory.WheelGroup = "VehicleWheels"

local M = Enum.Material

-- Teker titremesi düzeltmesi (Hata düzeltme 3):
--   * Mafsal (şasi ↔ teker arasındaki ara parça) eskiden 0.6³ varsayılan yoğunlukta, kütlesi 0.15 idi: teker
--     20–80, şasi 120–520 kat ağırdı. Bu kütle farkı kısıt çözücüsünü titretiyor, tekerler kendi kendine
--     sağa sola oynuyordu. Mafsal artık tekerin bu oranında (göbek + fren grubu gibi).
--   * Direksiyon servosu eskiden "toplam ağırlık × 40" tork kullanıyordu; artık tekeri köşe yükü altında
--     durağanken çevirmeye yetecek tork × pay.
local KNUCKLE_MASS_RATIO = 0.4
local STEER_SERVO_MARGIN = 4

local function steerServoTorque(totalMass: number, gravity: number, wheelCount: number, mu: number, radius: number): number
	return totalMass * gravity / math.max(wheelCount, 1) * mu * radius * STEER_SERVO_MARGIN
end
local rgb = Color3.fromRGB
local DARK = rgb(34, 36, 40)
local GLASS = rgb(40, 56, 70)
local CHROME = rgb(196, 198, 202)
local LIGHT_OFF = rgb(220, 220, 210)
local TAIL_OFF = rgb(120, 20, 24)
local AMBER = rgb(255, 150, 30)

type Ctx = {
	Model: Model, Chassis: Part, Def: any, Color: Color3, Rng: Random,
	yW: number, yTop: number, Physical: { BasePart },
	Derived: any?, -- Aşama 2 otomobil fizik modeli (motosiklette nil → eski geometri)
	SeatDrop: number?, -- dış 3D modelde koltuk/direksiyon ne kadar alçaltıldı (başın tavandan çıkmaması için)
}

local function attachment(parent: Instance, name: string, position: Vector3, axis: Vector3?, secondary: Vector3?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = position
	if axis then
		a.Axis = axis
	end
	if secondary then
		a.SecondaryAxis = secondary
	end
	a.Parent = parent
	return a
end

-- Kütlesiz görsel parça; `weldTo` (varsayılan şasi) parçasına kaynaklanır
local function vis(ctx: Ctx, name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material?, opts: { [string]: any }?): BasePart
	local o = opts or {}
	local part: BasePart
	if o.Shape == "Wedge" then
		part = Instance.new("WedgePart")
	else
		part = Instance.new("Part")
		if o.Shape == "Cylinder" then
			(part :: Part).Shape = Enum.PartType.Cylinder
		elseif o.Shape == "Ball" then
			(part :: Part).Shape = Enum.PartType.Ball
		end
	end
	part.Name = name
	part.Size = size
	local base = (o.WeldTo or ctx.Chassis) :: BasePart
	part.CFrame = base.CFrame * localCF
	part.Color = color
	part.Material = material or M.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Massless = true
	part.Anchored = false
	part.CanCollide = o.Collide == true
	part.CanTouch = false
	part.CastShadow = o.Shadow ~= false
	part.Transparency = o.Transparency or 0
	part.Reflectance = o.Reflectance or 0
	part.CollisionGroup = VehicleFactory.BodyGroup
	part.Parent = ctx.Model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function cylCF(x: number, y: number, z: number, axis: string): CFrame
	-- Silindirin ekseni varsayılan X; "Z" veya "Y" yönüne çevir
	if axis == "Z" then
		return CFrame.new(x, y, z) * CFrame.Angles(0, math.pi / 2, 0)
	elseif axis == "Y" then
		return CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2)
	end
	return CFrame.new(x, y, z)
end

local function addLight(ctx: Ctx, part: BasePart, range: number, angle: number)
	local light = Instance.new("SpotLight")
	light.Name = "Beam"
	light.Face = Enum.NormalId.Front
	light.Range = range
	light.Angle = angle
	light.Brightness = 3
	light.Color = rgb(255, 244, 220)
	light.Shadows = false
	light.Enabled = false
	light.Parent = part
	local _ = ctx
end

-- ===================== ARABA GÖVDELERİ =====================
local function carCommon(ctx: Ctx, cabZ: number, cabL: number, cabW: number?)
	local d = ctx.Def
	local W, L = d.Width, d.Length
	local yB = ctx.yW - 0.1
	local yT = yB + d.LowerHeight
	ctx.yTop = yT
	-- alt gövde (oyuncuların üstüne çıkabileceği, çarpışan kabuk)
	vis(ctx, "Body", Vector3.new(W, d.LowerHeight, L), CFrame.new(0, yB + d.LowerHeight / 2, 0), ctx.Color, M.SmoothPlastic, { Collide = true, Reflectance = 0.05 })
	-- kabin (camlı çekirdek + tavan + ön/arka cam kamaları)
	local cw = cabW or (W - 0.8)
	local ch = d.CabinHeight
	vis(ctx, "Cabin", Vector3.new(cw, ch, cabL), CFrame.new(0, yT + ch / 2, cabZ), GLASS, M.Glass, { Collide = true, Transparency = 0.25 })
	vis(ctx, "Roof", Vector3.new(cw + 0.2, 0.3, cabL - 0.6), CFrame.new(0, yT + ch + 0.15, cabZ), ctx.Color, M.SmoothPlastic)
	vis(ctx, "Windshield", Vector3.new(cw, ch, 2), CFrame.new(0, yT + ch / 2, cabZ - cabL / 2 - 1), GLASS, M.Glass, { Shape = "Wedge", Transparency = 0.25, Shadow = false })
	vis(ctx, "RearWindow", Vector3.new(cw, ch, 1.6), CFrame.new(0, yT + ch / 2, cabZ + cabL / 2 + 0.8) * CFrame.Angles(0, math.pi, 0), GLASS, M.Glass, { Shape = "Wedge", Transparency = 0.25, Shadow = false })
	-- tamponlar, ızgara
	vis(ctx, "BumperF", Vector3.new(W + 0.1, 0.7, 0.5), CFrame.new(0, yB + 0.35, -L / 2 - 0.2), DARK, M.SmoothPlastic, { Shadow = false })
	vis(ctx, "BumperR", Vector3.new(W + 0.1, 0.7, 0.5), CFrame.new(0, yB + 0.35, L / 2 + 0.2), DARK, M.SmoothPlastic, { Shadow = false })
	vis(ctx, "Grille", Vector3.new(W * 0.45, 0.6, 0.2), CFrame.new(0, yB + 1.1, -L / 2 - 0.05), DARK, M.Metal, { Shadow = false })
	-- farlar, stoplar, sinyaller
	for _, sx in { -1, 1 } do
		local hl = vis(ctx, "Headlight", Vector3.new(1.3, 0.5, 0.2), CFrame.new(sx * (W / 2 - 1), yB + 1.3, -L / 2 - 0.05), LIGHT_OFF, M.SmoothPlastic, { Shadow = false })
		addLight(ctx, hl, 70, 60)
		vis(ctx, "TailLight", Vector3.new(1.3, 0.5, 0.2), CFrame.new(sx * (W / 2 - 1), yB + 1.3, L / 2 + 0.05), TAIL_OFF, M.SmoothPlastic, { Shadow = false })
		vis(ctx, "ReverseLight", Vector3.new(0.5, 0.35, 0.2), CFrame.new(sx * (W / 2 - 2.1), yB + 1.3, L / 2 + 0.05), LIGHT_OFF, M.SmoothPlastic, { Shadow = false })
		local name = if sx < 0 then "IndicatorL" else "IndicatorR"
		vis(ctx, name, Vector3.new(0.5, 0.35, 0.2), CFrame.new(sx * (W / 2 - 0.2), yB + 1.3, -L / 2 - 0.06), AMBER, M.SmoothPlastic, { Shadow = false })
		vis(ctx, name, Vector3.new(0.5, 0.35, 0.2), CFrame.new(sx * (W / 2 - 0.2), yB + 1.3, L / 2 + 0.06), AMBER, M.SmoothPlastic, { Shadow = false })
		vis(ctx, "Mirror", Vector3.new(0.6, 0.4, 0.3), CFrame.new(sx * (cw / 2 + 0.35), yT + 0.4, cabZ - cabL / 2), ctx.Color, M.SmoothPlastic, { Shadow = false })
	end
	-- plaka
	local plate = vis(ctx, "Plate", Vector3.new(1.8, 0.6, 0.1), CFrame.new(0, yB + 0.9, L / 2 + 0.46), rgb(245, 245, 240), M.SmoothPlastic, { Shadow = false })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(180, 60)
	gui.MaxDistance = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	label.TextColor3 = rgb(30, 60, 120)
	label.Text = string.format("SC %03d", ctx.Rng:NextInteger(100, 999))
	label.Parent = gui
	gui.Parent = plate
	return yT
end

local CarStyles = {}

function CarStyles.compact(ctx: Ctx)
	carCommon(ctx, 0.6, 5.4)
end

function CarStyles.sedan(ctx: Ctx)
	carCommon(ctx, 1.0, 6.4)
	-- bagaj kapağı çizgisi
	vis(ctx, "TrunkLine", Vector3.new(ctx.Def.Width + 0.02, 0.1, 0.1), CFrame.new(0, ctx.yTop - 0.05, ctx.Def.Length / 2 - 2.6), DARK, M.SmoothPlastic, { Shadow = false })
end

function CarStyles.sports(ctx: Ctx)
	local d = ctx.Def
	carCommon(ctx, 1.2, 5.0, d.Width - 1.2)
	-- kaput hava girişi ve rüzgarlık
	vis(ctx, "HoodScoop", Vector3.new(1.6, 0.3, 2), CFrame.new(0, ctx.yTop + 0.15, -d.Length / 2 + 3), DARK, M.SmoothPlastic, { Shadow = false })
	if d.Spoiler then
		vis(ctx, "SpoilerWing", Vector3.new(d.Width - 0.4, 0.2, 1.4), CFrame.new(0, ctx.yTop + 1.1, d.Length / 2 - 0.8), DARK, M.SmoothPlastic)
		for _, sx in { -1, 1 } do
			vis(ctx, "SpoilerPost", Vector3.new(0.2, 1, 0.4), CFrame.new(sx * (d.Width / 2 - 1.2), ctx.yTop + 0.5, d.Length / 2 - 0.8), DARK, M.SmoothPlastic, { Shadow = false })
		end
	end
	-- yan şerit
	vis(ctx, "Stripe", Vector3.new(0.8, 0.05, d.Length * 0.9), CFrame.new(0, ctx.yTop + 0.03, 0), rgb(250, 250, 250), M.SmoothPlastic, { Shadow = false })
end

function CarStyles.suv(ctx: Ctx)
	local d = ctx.Def
	carCommon(ctx, 1.4, 8.4)
	if d.RoofRack then
		local top = ctx.yTop + d.CabinHeight + 0.3
		for _, sx in { -1, 1 } do
			vis(ctx, "RackRail", Vector3.new(0.2, 0.3, 7), CFrame.new(sx * (d.Width / 2 - 1), top + 0.15, 1.4), DARK, M.Metal, { Shadow = false })
		end
	end
	vis(ctx, "SpareWheel", Vector3.new(0.8, 2.6, 2.6), cylCF(0, ctx.yTop - 0.6, d.Length / 2 + 0.6, "Z"), DARK, M.SmoothPlastic)
end

function CarStyles.pickup(ctx: Ctx)
	local d = ctx.Def
	carCommon(ctx, -2.0, 5.2)
	-- kasa: yan duvarlar + arka kapak
	local bedL = d.Length / 2 - 0.5
	local bedZ = d.Length / 2 - bedL / 2 - 0.2
	for _, sx in { -1, 1 } do
		vis(ctx, "BedSide", Vector3.new(0.3, 1.4, bedL), CFrame.new(sx * (d.Width / 2 - 0.15), ctx.yTop + 0.7, bedZ), ctx.Color, M.SmoothPlastic, { Collide = true })
	end
	vis(ctx, "Tailgate", Vector3.new(d.Width, 1.4, 0.3), CFrame.new(0, ctx.yTop + 0.7, d.Length / 2 - 0.15), ctx.Color, M.SmoothPlastic, { Collide = true })
	vis(ctx, "BedFloor", Vector3.new(d.Width - 0.6, 0.1, bedL), CFrame.new(0, ctx.yTop + 0.05, bedZ), DARK, M.DiamondPlate, { Shadow = false })
end

function CarStyles.van(ctx: Ctx)
	local d = ctx.Def
	-- uzun yük bölümü: kabin neredeyse tüm boy
	carCommon(ctx, 0.6, d.Length - 4.6, d.Width - 0.2)
	local yT = ctx.yTop
	-- yük bölümünü opak yap (sadece ön kısım cam)
	vis(ctx, "CargoBox", Vector3.new(d.Width - 0.1, d.CabinHeight, d.Length - 8), CFrame.new(0, yT + d.CabinHeight / 2, 2.4), ctx.Color, M.SmoothPlastic, { Collide = true })
	vis(ctx, "SideStripe", Vector3.new(d.Width, 0.4, d.Length - 8), CFrame.new(0, yT + d.CabinHeight * 0.4, 2.4), rgb(255, 122, 69), M.SmoothPlastic, { Shadow = false })
end

function CarStyles.utility(ctx: Ctx)
	local d = ctx.Def
	carCommon(ctx, -2.4, 5.0)
	local bedL = d.Length / 2 - 0.2
	local bedZ = d.Length / 2 - bedL / 2
	vis(ctx, "Flatbed", Vector3.new(d.Width, 0.4, bedL), CFrame.new(0, ctx.yTop + 0.2, bedZ), DARK, M.DiamondPlate, { Collide = true })
	vis(ctx, "Toolbox", Vector3.new(d.Width - 0.6, 1.4, 1.6), CFrame.new(0, ctx.yTop + 1.1, bedZ - bedL / 2 + 1), rgb(200, 200, 196), M.DiamondPlate, { Collide = true })
	if d.LightBar then
		vis(ctx, "LightBar", Vector3.new(d.Width - 1.6, 0.35, 0.6), CFrame.new(0, ctx.yTop + d.CabinHeight + 0.5, -2.4), AMBER, M.Neon, { Shadow = false })
	end
end

-- ===================== MOTOSİKLET GÖVDELERİ =====================
local function bikeCommon(ctx: Ctx, frontKnuckle: BasePart)
	local d = ctx.Def
	local yW = ctx.yW
	local half = d.Wheelbase / 2
	vis(ctx, "Frame", Vector3.new(0.7, 1, d.Wheelbase * 0.6), CFrame.new(0, yW + 0.6, 0), DARK, M.Metal, { Collide = true })
	vis(ctx, "Engine", Vector3.new(1.2, 1.2, 1.6), CFrame.new(0, yW + 0.25, 0.2), rgb(70, 72, 78), M.Metal)
	vis(ctx, "Exhaust", Vector3.new(2.6, 0.4, 0.4), cylCF(0.55, yW + 0.1, 1.6, "Z"), CHROME, M.Metal, { Shape = "Cylinder", Shadow = false })
	vis(ctx, "RearFender", Vector3.new(0.9, 0.3, 1.8), CFrame.new(0, yW + d.WheelRadius + 0.25, half - 0.3), ctx.Color, M.SmoothPlastic, { Shadow = false })
	local tail = vis(ctx, "TailLight", Vector3.new(0.7, 0.3, 0.15), CFrame.new(0, yW + d.WheelRadius + 0.4, half + 0.6), TAIL_OFF, M.SmoothPlastic, { Shadow = false })
	local _ = tail
	for _, sx in { -1, 1 } do
		vis(ctx, if sx < 0 then "IndicatorL" else "IndicatorR", Vector3.new(0.3, 0.2, 0.2), CFrame.new(sx * 0.5, yW + d.WheelRadius + 0.4, half + 0.55), AMBER, M.SmoothPlastic, { Shadow = false })
	end
	-- Ön çatal + gidon + far: ön aks mafsalına kaynaklı → direksiyonla birlikte döner
	local fk = frontKnuckle
	for _, sx in { -1, 1 } do
		vis(ctx, "Fork", Vector3.new(0.2, 2.4, 0.2), CFrame.new(sx * 0.45, 1.2, 0.35) * CFrame.Angles(math.rad(-12), 0, 0), CHROME, M.Metal, { WeldTo = fk, Shadow = false })
	end
	local bar = vis(ctx, "Handlebar", Vector3.new(2.6, 0.2, 0.2), CFrame.new(0, 2.25, 0.9), DARK, M.Metal, { WeldTo = fk, Shadow = false })
	attachment(bar, "HandL", Vector3.new(-1.1, 0, 0))
	attachment(bar, "HandR", Vector3.new(1.1, 0, 0))
	local head = vis(ctx, "Headlight", Vector3.new(0.6, 0.5, 0.2), CFrame.new(0, 1.8, 0.2), LIGHT_OFF, M.SmoothPlastic, { WeldTo = fk, Shadow = false })
	addLight(ctx, head, 60, 55)
	for _, sx in { -1, 1 } do
		vis(ctx, if sx < 0 then "IndicatorL" else "IndicatorR", Vector3.new(0.25, 0.2, 0.2), CFrame.new(sx * 0.6, 1.8, 0.25), AMBER, M.SmoothPlastic, { WeldTo = fk, Shadow = false })
	end
	vis(ctx, "FrontFender", Vector3.new(0.8, 0.25, 1.6), CFrame.new(0, d.WheelRadius + 0.2, 0), ctx.Color, M.SmoothPlastic, { WeldTo = fk, Shadow = false })
end

local BikeStyles = {}

function BikeStyles.sport(ctx: Ctx, fk: BasePart)
	bikeCommon(ctx, fk)
	local yW = ctx.yW
	vis(ctx, "Tank", Vector3.new(1.4, 0.9, 2), CFrame.new(0, yW + 1.45, -0.9), ctx.Color, M.SmoothPlastic)
	vis(ctx, "Fairing", Vector3.new(1.6, 1.4, 1.6), CFrame.new(0, yW + 1.4, -2.2), ctx.Color, M.SmoothPlastic, { Shape = "Wedge" })
	vis(ctx, "Windscreen", Vector3.new(1.2, 0.8, 0.8), CFrame.new(0, yW + 2.4, -2.1), GLASS, M.Glass, { Shape = "Wedge", Transparency = 0.3, Shadow = false })
	vis(ctx, "TailCowl", Vector3.new(1, 0.6, 1.6), CFrame.new(0, yW + 1.5, 1.6) * CFrame.Angles(0, math.pi, 0), ctx.Color, M.SmoothPlastic, { Shape = "Wedge" })
end

function BikeStyles.street(ctx: Ctx, fk: BasePart)
	bikeCommon(ctx, fk)
	local yW = ctx.yW
	vis(ctx, "Tank", Vector3.new(1.3, 0.9, 2), CFrame.new(0, yW + 1.4, -0.8), ctx.Color, M.SmoothPlastic)
	vis(ctx, "SideCover", Vector3.new(1.1, 0.6, 1.2), CFrame.new(0, yW + 1.1, 0.8), ctx.Color, M.SmoothPlastic, { Shadow = false })
end

function BikeStyles.cruiser(ctx: Ctx, fk: BasePart)
	bikeCommon(ctx, fk)
	local yW = ctx.yW
	vis(ctx, "Tank", Vector3.new(1.5, 1, 2.4), CFrame.new(0, yW + 1.3, -1), ctx.Color, M.SmoothPlastic, { Reflectance = 0.1 })
	vis(ctx, "Backrest", Vector3.new(0.9, 1.4, 0.3), CFrame.new(0, yW + 2.1, 3), DARK, M.Leather, { Shadow = false })
	for _, sx in { -1, 1 } do
		vis(ctx, "Saddlebag", Vector3.new(0.6, 1, 1.6), CFrame.new(sx * 0.9, yW + 1, 2), DARK, M.Leather, { Shadow = false })
	end
	vis(ctx, "WideBar", Vector3.new(3, 0.2, 0.2), CFrame.new(0, 2.6, 0.6), CHROME, M.Metal, { WeldTo = fk, Shadow = false })
end

function BikeStyles.scooter(ctx: Ctx, fk: BasePart)
	bikeCommon(ctx, fk)
	local yW = ctx.yW
	vis(ctx, "Floorboard", Vector3.new(1.2, 0.3, 1.8), CFrame.new(0, yW + 0.35, -0.5), DARK, M.SmoothPlastic, { Collide = true })
	vis(ctx, "BodyRear", Vector3.new(1.4, 1.2, 2.2), CFrame.new(0, yW + 0.9, 1.1), ctx.Color, M.SmoothPlastic)
	vis(ctx, "LegShield", Vector3.new(1.4, 1.8, 0.4), CFrame.new(0, 1.0, 0.6), ctx.Color, M.SmoothPlastic, { WeldTo = fk })
end

function BikeStyles.standard(ctx: Ctx, fk: BasePart)
	bikeCommon(ctx, fk)
	local yW = ctx.yW
	vis(ctx, "Tank", Vector3.new(1.4, 0.95, 2.1), CFrame.new(0, yW + 1.4, -0.85), ctx.Color, M.SmoothPlastic)
	vis(ctx, "RoundLamp", Vector3.new(0.3, 0.9, 0.9), cylCF(0, 1.8, 0.05, "Z"), CHROME, M.Metal, { WeldTo = fk, Shape = "Cylinder", Shadow = false })
end

-- ===================== TEKERLEK + SÜSPANSİYON =====================
local function buildWheel(ctx: Ctx, name: string, x: number, z: number, steer: boolean, driven: boolean, rear: boolean)
	local d = ctx.Def
	local chassis = ctx.Chassis
	local R, travel = d.WheelRadius, d.Travel
	local center = Vector3.new(x, ctx.yW, z)
	-- Kayıcının üst sınırı sürüş konumunun ne kadar üstünde: otomobilde BumpRoom (kursun %60'ı yukarıda,
	-- tümsekler için), motosiklette eskisi gibi kursun yarısı.
	local strutTop = if ctx.Derived then ctx.Derived.BumpRoom else travel / 2

	local knuckle = Instance.new("Part")
	knuckle.Name = "Knuckle_" .. name
	knuckle.Size = Vector3.new(0.6, 0.6, 0.6)
	knuckle.CFrame = chassis.CFrame * CFrame.new(center)
	knuckle.Transparency = 1
	knuckle.CanCollide = false
	knuckle.CanTouch = false
	knuckle.CanQuery = false
	knuckle.CollisionGroup = VehicleFactory.WheelGroup
	knuckle.Parent = ctx.Model
	table.insert(ctx.Physical, knuckle)

	local wheel = Instance.new("Part")
	wheel.Name = "Wheel_" .. name
	wheel.Shape = Enum.PartType.Cylinder
	wheel.Size = Vector3.new(d.WheelWidth, R * 2, R * 2)
	wheel.CFrame = chassis.CFrame * CFrame.new(center)
	wheel.Color = rgb(28, 28, 30)
	wheel.Material = M.SmoothPlastic
	wheel.CustomPhysicalProperties = PhysicalProperties.new(0.9, d.Grip, 0, 100, 1)
	wheel.CollisionGroup = VehicleFactory.WheelGroup
	wheel.CanTouch = false
	wheel.TopSurface = Enum.SurfaceType.Smooth
	wheel.BottomSurface = Enum.SurfaceType.Smooth
	wheel:SetAttribute("Wheel", name)
	wheel:SetAttribute("Rear", rear)
	wheel.Parent = ctx.Model
	table.insert(ctx.Physical, wheel)
	local knuckleVolume = knuckle.Size.X * knuckle.Size.Y * knuckle.Size.Z
	knuckle.CustomPhysicalProperties = PhysicalProperties.new(
		math.clamp(wheel:GetMass() * KNUCKLE_MASS_RATIO / knuckleVolume, 0.05, 100), 0.3, 0, 1, 1)
	vis(ctx, "Rim", Vector3.new(d.WheelWidth + 0.06, R * 1.25, R * 1.25), CFrame.new(), CHROME, M.Metal, { Shape = "Cylinder", WeldTo = wheel, Shadow = false })

	-- Süspansiyon kayıcısı + direksiyon servosu
	local strutA = attachment(chassis, "Strut_" .. name, center + Vector3.new(0, strutTop, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, -1))
	local strutK = attachment(knuckle, "Strut", Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(0, 0, -1))
	local cyl = Instance.new("CylindricalConstraint")
	cyl.Name = "Suspension_" .. name
	cyl.Attachment0 = strutA
	cyl.Attachment1 = strutK
	cyl.LimitsEnabled = true
	cyl.LowerLimit = -travel
	cyl.UpperLimit = 0
	cyl.Restitution = 0
	cyl.AngularActuatorType = Enum.ActuatorType.Servo
	cyl.AngularSpeed = 8
	cyl.TargetAngle = 0
	cyl:SetAttribute("Wheel", name)
	cyl:SetAttribute("Steer", steer)
	cyl:SetAttribute("Rear", rear)
	cyl.Parent = knuckle

	-- Yay + amortisör (sertlik kütle hesabından sonra ayarlanır)
	local springTop = attachment(chassis, "SpringTop_" .. name, center + Vector3.new(0, strutTop + 2, 0))
	local spring = Instance.new("SpringConstraint")
	spring.Name = "Spring_" .. name
	spring.Attachment0 = springTop
	spring.Attachment1 = strutK
	spring.Visible = false
	spring:SetAttribute("Rear", rear)
	spring.Parent = knuckle

	-- Tahrik/fren motoru
	local axleK = attachment(knuckle, "Axle", Vector3.zero, Vector3.new(1, 0, 0), Vector3.new(0, 1, 0))
	local axleW = attachment(wheel, "Axle", Vector3.zero, Vector3.new(1, 0, 0), Vector3.new(0, 1, 0))
	local hinge = Instance.new("HingeConstraint")
	hinge.Name = "Motor_" .. name
	hinge.Attachment0 = axleK
	hinge.Attachment1 = axleW
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = 0
	hinge.MotorMaxAcceleration = math.huge
	hinge:SetAttribute("Wheel", name)
	hinge:SetAttribute("Driven", driven)
	hinge:SetAttribute("Rear", rear)
	hinge.Parent = knuckle

	return knuckle, wheel, cyl, spring, hinge
end

-- ===================== DIŞ 3D MODEL (CarModelConfig) =====================
-- Sadece görünüm: fizik parçaları (şasi, balast, mafsallar, fizik tekerleri), çarpışma kabuğu (Body/Cabin) ve ışık
-- kaynakları aynen kalır, görünmez olur. Model fizikteki dingil mesafesine ölçeklenir; görünür tekerlekler modelin kendi
-- oranındadır ve yere değecek kadar alçakta durur (fizik tekerleği modelinkinden büyük). Teker görselleri mafsala
-- Motor6D ile bağlıdır: direksiyon ve süspansiyonla hareket eder, dönüşü istemci oynatır (VehicleVisualsController).
local function dressWithModel(ctx: Ctx, name: string): boolean
	local info = CarModelKit.Get(name)
	if not info then
		return false
	end
	local d, model, chassis = ctx.Def, ctx.Model, ctx.Chassis
	local physical = {}
	for _, p in ctx.Physical do
		physical[p] = true
	end
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and not p:IsA("Seat") and p ~= chassis and p.Name ~= "Ballast" and not physical[p] then
			p.Transparency = 1 -- eski kutu görseller: çarpışma kabuğu ve ışık kaynağı olarak kalır, görünmez
			p.CastShadow = false
		end
	end
	chassis.Transparency = 1
	local knuckles = {}
	for _, w in { "FL", "FR", "RL", "RR" } do
		local wheel = model:FindFirstChild("Wheel_" .. w)
		if wheel and wheel:IsA("BasePart") then
			wheel.Transparency = 1
			wheel.CastShadow = false
		end
		knuckles[w] = model:FindFirstChild("Knuckle_" .. w)
	end
	local s = d.Wheelbase / info.Wheelbase
	local visualRadius = info.WheelRadius * s
	local drop = math.max(d.WheelRadius - visualRadius, 0)
	local frame = chassis.CFrame * CFrame.new(0, ctx.yW - drop, 0)
	CarModelKit.Build(info, { Frame = frame, Scale = s, Parent = model, Body = chassis, Wheels = knuckles, Paint = ctx.Color })
	-- Koltuk: oturan karakterin başı (~3.4 stud) tavanın altında kalsın
	local roof = ctx.yW - drop + info.RoofY * s
	ctx.SeatDrop = math.max((ctx.yTop - 1.0) - (roof - 3.4), 0)
	model:SetAttribute("BodyModel", name)
	return true
end

-- ===================== İNŞA =====================
local function newVehicleId(): string
	return string.sub(HttpService:GenerateGUID(false), 1, 8)
end

function VehicleFactory.Build(defId: string, cframe: CFrame, options: { Color: Color3?, Seed: number? }?): Model?
	local def = VehicleDefinitions.Get(defId)
	if not def then
		warn("[VehicleFactory] Bilinmeyen araç:", defId)
		return nil
	end
	local opts = options or {}
	local rng = Random.new(opts.Seed or os.clock() * 1000)
	local isBike = def.Type == "Motorcycle"

	local model = Instance.new("Model")
	model.Name = def.DisplayName

	local chassisSize = if isBike
		then Vector3.new(0.9, 0.9, def.Wheelbase * 0.7)
		else Vector3.new(def.Track - def.WheelWidth - 0.5, 1, def.Length - 1.2)
	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = chassisSize
	chassis.CFrame = cframe
	chassis.Color = DARK
	chassis.Material = M.Metal
	chassis.Transparency = if isBike then 1 else 0
	chassis.CanTouch = false
	chassis.CollisionGroup = VehicleFactory.BodyGroup
	local volume = chassisSize.X * chassisSize.Y * chassisSize.Z
	local carPhysics = VehicleDefinitions.UsesCarPhysics(def)
	local derived = if carPhysics then VehiclePhysics.Derive(def) else nil
	-- Otomobilde kütlenin BallastFraction kadarı balast parçasına gider (ağırlık dağılımı / ağırlık merkezi)
	local chassisMass = if carPhysics then def.Mass * (1 - VehiclePhysics.Constants.BallastFraction) else def.Mass
	chassis.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(chassisMass / volume, 0.05, 100), 0.3, 0, 1, 1)
	chassis.Parent = model
	model.PrimaryPart = chassis

	local ballast: Part? = nil
	if carPhysics and derived then
		chassis.RootPriority = 10 -- montajın kökü şasi kalsın (balast ağır ama küçük)
		local b = Instance.new("Part")
		b.Name = "Ballast"
		b.Size = Vector3.new(math.max(chassisSize.X * 0.5, 1), 0.4, 1.2)
		local ballastVolume = b.Size.X * b.Size.Y * b.Size.Z
		b.CustomPhysicalProperties = PhysicalProperties.new(
			math.clamp(def.Mass * VehiclePhysics.Constants.BallastFraction / ballastVolume, 0.05, 100), 0.3, 0, 1, 1)
		-- Şasi tabanında, ağırlık dağılımı için Z'de kaydırılmış; CoGOffset ile yükseltilir
		b.CFrame = cframe * CFrame.new(0, -chassisSize.Y / 2 + 0.2 + def.Physics.CoGOffset, derived.BallastZ)
		b.Transparency = 1
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CollisionGroup = VehicleFactory.BodyGroup
		b.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = chassis
		weld.Part1 = b
		weld.Parent = b
		ballast = b
	end

	local ctx: Ctx = {
		Model = model, Chassis = chassis, Def = def,
		Color = opts.Color or def.Colors[rng:NextInteger(1, #def.Colors)],
		Rng = rng,
		yW = -(chassisSize.Y / 2 + def.Clearance) + def.WheelRadius,
		yTop = 0,
		Physical = { chassis },
		Derived = derived,
	}

	-- Tekerlekler
	local wheels = {}
	if isBike then
		local fk = buildWheel(ctx, "F", 0, -def.Wheelbase / 2, true, false, false)
		buildWheel(ctx, "R", 0, def.Wheelbase / 2, false, true, true)
		local styleFn = BikeStyles[def.Style] or BikeStyles.standard
		styleFn(ctx, fk)
		wheels = { "F", "R" }
	else
		local hx, hz = def.Track / 2, def.Wheelbase / 2
		local frontDriven = def.Drive == "FWD" or def.Drive == "AWD"
		local rearDriven = def.Drive == "RWD" or def.Drive == "AWD"
		buildWheel(ctx, "FL", -hx, -hz, true, frontDriven, false)
		buildWheel(ctx, "FR", hx, -hz, true, frontDriven, false)
		buildWheel(ctx, "RL", -hx, hz, false, rearDriven, true)
		buildWheel(ctx, "RR", hx, hz, false, rearDriven, true)
		local styleFn = CarStyles[def.Style] or CarStyles.sedan
		styleFn(ctx)
		local bodyModel = CarModelKit.Pick(defId, rng, false)
		if bodyModel then
			dressWithModel(ctx, bodyModel)
		end
		wheels = { "FL", "FR", "RL", "RR" }
		-- direksiyon simidi + IK el hedefleri
		local driver = def.Seats[1]
		local wheelPos = Vector3.new(driver.X, ctx.yTop + 0.25 - (ctx.SeatDrop or 0), driver.Z - 1.9)
		vis(ctx, "SteeringWheel", Vector3.new(0.15, 1.5, 1.5), cylCF(wheelPos.X, wheelPos.Y, wheelPos.Z, "Z") * CFrame.Angles(0, 0, math.rad(-25)), DARK, M.SmoothPlastic, { Shape = "Cylinder", Shadow = false })
		attachment(chassis, "HandL", wheelPos + Vector3.new(-0.62, 0, 0))
		attachment(chassis, "HandR", wheelPos + Vector3.new(0.62, 0, 0))
	end

	-- Koltuklar (sürücü + yolcular)
	for index, s in def.Seats do
		local seat = Instance.new("Seat")
		seat.Name = if s.Driver then "DriverSeat" else "PassengerSeat" .. index
		seat.Size = if isBike then Vector3.new(1.1, 0.4, 1.8) else Vector3.new(1.8, 0.4, 1.8)
		local seatY = if isBike then ctx.yW + 1.55 else ctx.yTop - 1.0 - (ctx.SeatDrop or 0)
		seat.CFrame = chassis.CFrame * CFrame.new(s.X, seatY, s.Z)
		seat.Color = DARK
		seat.Material = if isBike then M.Leather else M.Fabric
		seat.Transparency = if isBike then 0 else 1
		seat.Massless = true
		seat.CanCollide = false
		seat.CollisionGroup = VehicleFactory.BodyGroup
		seat:SetAttribute("VehicleSeat", true)
		seat:SetAttribute("DriverSeat", s.Driver == true)
		seat.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = chassis
		weld.Part1 = seat
		weld.Parent = seat

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EnterPrompt"
		prompt.ActionText = if s.Driver then "Sür" else "Bin"
		prompt.ObjectText = def.DisplayName
		prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.MaxActivationDistance = if s.Driver then 10 else 8
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		prompt.Style = Enum.ProximityPromptStyle.Default
		prompt.UIOffset = Vector2.new(0, if s.Driver then 0 else 40)
		prompt.Parent = seat
	end

	-- Motosiklet: dik durma / yatış
	local upright = attachment(chassis, "Upright", Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(0, 0, -1))
	local align = Instance.new("AlignOrientation")
	align.Name = "Upright"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.AlignType = Enum.AlignType.PrimaryAxisParallel
	align.Attachment0 = upright
	align.PrimaryAxis = Vector3.new(0, 1, 0)
	-- Araç fizik kararlılığı: motosiklette tepki 30 → 18 (gövdeyi bir anda yuvarlayıp dar tekerleri kenarına
	-- bastırmasın); tork aşağıda gerekenin ~12 katına indirildi.
	align.Responsiveness = if isBike then 18 else 8
	align.RigidityEnabled = false
	align.Enabled = isBike -- arabada sadece "ters dönme yardımı" için geçici açılır
	align.Parent = chassis

	-- Sesler (ID verilmişse)
	local audio = AudioConfig.Vehicle
	local engineId = AudioConfig.Resolve(if isBike then audio.EngineMotorcycle else audio.EngineCar)
	if engineId then
		local engine = Instance.new("Sound")
		engine.Name = "Engine"
		engine.SoundId = engineId
		engine.Looped = true
		engine.Volume = audio.EngineVolume
		engine.RollOffMinDistance = audio.RollOffMin
		engine.RollOffMaxDistance = audio.RollOffMax
		engine.Parent = chassis
	end
	local hornId = AudioConfig.Resolve(if isBike then audio.HornMotorcycle else audio.HornCar)
	if hornId then
		local horn = Instance.new("Sound")
		horn.Name = "Horn"
		horn.SoundId = hornId
		horn.Looped = true
		horn.Volume = audio.HornVolume
		horn.RollOffMinDistance = audio.RollOffMin
		horn.RollOffMaxDistance = audio.RollOffMax * 1.5
		horn.Parent = chassis
	end

	-- ===== Kütleye bağlı ayarlar =====
	if carPhysics and derived and ballast then
		VehicleFactory._tuneCar(model, defId, def, derived, chassis, ballast, ctx, align)
		CollectionService:AddTag(model, "Vehicle")
		return model
	end
	local sprung = chassis:GetMass()
	local total = 0
	for _, p in ctx.Physical do
		total += p:GetMass()
	end
	local n = #wheels
	local g = workspace.Gravity
	local cornerWeight = sprung * g / n
	local stiffness = cornerWeight / (0.6 * def.Travel)
	local damping = 2 * 0.45 * math.sqrt(stiffness * sprung / n)
	local nDriven = 0
	for _, d in model:GetDescendants() do
		if d:IsA("HingeConstraint") and d:GetAttribute("Driven") then
			nDriven += 1
		end
	end
	local R = def.WheelRadius
	local driveTorque = total * def.Accel * R / math.max(nDriven, 1)
	local brakeTorque = total * def.Brake * R / n
	local coastTorque = total * 4 * R / n
	for _, d in model:GetDescendants() do
		if d:IsA("SpringConstraint") then
			d.Stiffness = stiffness
			d.Damping = damping
			d.FreeLength = (2 + def.Travel / 2) + 0.6 * def.Travel
		elseif d:IsA("CylindricalConstraint") then
			d.ServoMaxTorque = steerServoTorque(total, g, n, def.Grip, R)
		elseif d:IsA("HingeConstraint") then
			d.MotorMaxTorque = brakeTorque -- park freni
		end
	end
	-- (motosiklette eskiden ×60: 40° yatışta dik tutmak için gerekenin ~85 katı)
	align.MaxTorque = total * g * (if isBike then 12 else 30)

	model:SetAttribute("VehicleId", newVehicleId())
	model:SetAttribute("DefId", defId)
	model:SetAttribute("VehicleType", def.Type)
	model:SetAttribute("DriveTorque", driveTorque)
	model:SetAttribute("BrakeTorque", brakeTorque)
	model:SetAttribute("CoastTorque", coastTorque)
	model:SetAttribute("TotalMass", total)
	model:SetAttribute("Lights", false)
	model:SetAttribute("Indicator", "")
	model:SetAttribute("Braking", false)
	model:SetAttribute("Reversing", false)
	-- yerden şasi merkezine yükseklik (doğurma/ışınlama için)
	model:SetAttribute("RideHeight", chassisSize.Y / 2 + def.Clearance + 0.25 * def.Travel)

	for _, p in ctx.Physical do
		p:SetAttribute("Physical", true)
	end
	CollectionService:AddTag(model, "Vehicle")
	return model
end

-- ===== Aşama 2: otomobil fizik modeli kurulumu =====
-- Yaylar ve sönüm aks başına yaylı kütleden; kaldırma kuvvetleri EffectiveGravity'den hesaplanır.
-- İstemcideki CarPhysics her karede sadece motor/fren/direksiyon/aero değerlerini yazar.
function VehicleFactory._tuneCar(model: Model, defId: string, def, derived, chassis: BasePart, ballast: BasePart, ctx: Ctx, align: AlignOrientation)
	local C = VehiclePhysics.Constants
	local p = def.Physics
	local G = workspace.Gravity
	local lift = G - C.EffectiveGravity -- araca uygulanan yerçekimi farkı (yukarı)
	local sprung = chassis:GetMass() + ballast:GetMass()
	local unsprung = 0

	for _, d in model:GetDescendants() do
		if d:IsA("SpringConstraint") then
			local rear = d:GetAttribute("Rear") == true
			d.Stiffness = sprung * (if rear then derived.StiffnessPerMassRear else derived.StiffnessPerMassFront)
			d.Damping = sprung * (if rear then derived.DampingPerMassRear else derived.DampingPerMassFront)
			-- Sürüş konumunda yay boyu = BumpRoom + 2; statik çökme kadar sıkışmış olmalı
			d.FreeLength = derived.BumpRoom + 2 + (if rear then derived.SagRear else derived.SagFront)
		elseif d:IsA("BasePart") and d:GetAttribute("Wheel") then
			local rear = d:GetAttribute("Rear") == true
			local mu = p.TireGrip * (if rear then p.GripRear else p.GripFront)
			d.CustomPhysicalProperties = PhysicalProperties.new(0.9, mu, 0, 100, 1)
			local knuckle = model:FindFirstChild("Knuckle_" .. d:GetAttribute("Wheel"))
			-- Tekerlek ve mafsal ayrı montajlardır: her birine KENDİ kütlesi kadar kaldırma kuvveti
			-- (mafsal artık ağır; kuvvet tekere toplanırsa menteşe üzerinden gereksiz iç kuvvet taşınırdı)
			for _, part in { d, knuckle } do
				if part then
					unsprung += part:GetMass()
					local a = attachment(part, "AntiGravity", Vector3.zero)
					local force = Instance.new("VectorForce")
					force.Name = "AntiGravity"
					force.Attachment0 = a
					force.RelativeTo = Enum.ActuatorRelativeTo.World
					force.ApplyAtCenterOfMass = true
					force.Force = Vector3.new(0, part:GetMass() * lift, 0)
					force.Parent = part
				end
			end
		end
	end
	local total = sprung + unsprung

	-- Şasi kuvvetleri: kaldırma (sabit, sunucuda) + aero/yuvarlanma (istemci her karede ekler)
	local core = attachment(chassis, "Core", Vector3.zero)
	local forces = Instance.new("VectorForce")
	forces.Name = "Forces"
	forces.Attachment0 = core
	forces.RelativeTo = Enum.ActuatorRelativeTo.World
	forces.ApplyAtCenterOfMass = true
	forces.Force = Vector3.new(0, sprung * lift, 0)
	forces.Parent = chassis
	forces:SetAttribute("BaseLift", sprung * lift)
	-- Savrulma denge yardımı (istemci yazar; sunucuda sıfır)
	local stability = Instance.new("Torque")
	stability.Name = "Stability"
	stability.Attachment0 = core
	stability.RelativeTo = Enum.ActuatorRelativeTo.World
	stability.Torque = Vector3.zero
	stability.Parent = chassis

	-- Park freni / yerinde tutma: %12 eğimde güvenle durduracak tork (sürtünme sınırını aşmaz)
	local R = def.WheelRadius
	local holdTorque = total * C.EffectiveGravity * 0.3 / 4 * R
	for _, d in model:GetDescendants() do
		if d:IsA("CylindricalConstraint") then
			d.ServoMaxTorque = steerServoTorque(total, C.EffectiveGravity, 4, p.TireGrip * math.max(p.GripFront, p.GripRear), R)
		elseif d:IsA("HingeConstraint") then
			d.MotorMaxTorque = holdTorque
		end
	end
	-- Havada dengeleme (istemci açar; yerdeyken kapalı)
	align.MaxTorque = total * C.EffectiveGravity * 30
	align.Responsiveness = 6

	model:SetAttribute("VehicleId", newVehicleId())
	model:SetAttribute("DefId", defId)
	model:SetAttribute("VehicleType", def.Type)
	model:SetAttribute("PhysicsModel", "Car2")
	model:SetAttribute("SprungMass", sprung)
	model:SetAttribute("TotalMass", total)
	model:SetAttribute("BrakeTorque", holdTorque) -- sunucu park freni bunu kullanır
	model:SetAttribute("DriveTorque", 0)
	model:SetAttribute("CoastTorque", 0)
	model:SetAttribute("Lights", false)
	model:SetAttribute("Indicator", "")
	model:SetAttribute("Braking", false)
	model:SetAttribute("Reversing", false)
	model:SetAttribute("RideHeight", VehiclePhysics.CarRideHeight(def))
	for _, part in ctx.Physical do
		part:SetAttribute("Physical", true)
	end
end

-- Doğurma yüksekliği (şasi merkezi ↔ zemin). Otomobil yeni modelde; motosiklet eski formülde.
function VehicleFactory.ComputeRideHeight(def): number
	if VehicleDefinitions.UsesCarPhysics(def) then
		return VehiclePhysics.CarRideHeight(def)
	end
	local chassisH = if def.Type == "Motorcycle" then 0.9 else 1
	return chassisH / 2 + def.Clearance + 0.25 * def.Travel
end

-- Uzak/park araçlarda fizik maliyetini sıfırlamak için (Bölüm 27.2)
function VehicleFactory.SetAnchored(model: Model, anchored: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Physical") then
			d.Anchored = anchored
		end
	end
end

function VehicleFactory.SetNetworkOwner(model: Model, player: Player?)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Physical") and not d.Anchored then
			pcall(function()
				d:SetNetworkOwner(player)
			end)
		end
	end
end

return VehicleFactory
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000023"><Properties>
<string name="Name">WorldGen</string>

</Properties>
<Item class="ModuleScript" referent="RBX00000024"><Properties>
<string name="Name">BuildingBuilder</string>

<ProtectedString name="Source"><![CDATA[-- BuildingBuilder: arsa verisinden bina üretir. Her stil farklı mimari dil kullanır
-- (Bölüm 3.1: "aynı bina modelini her yerde tekrarlama"). Boyut, kat, renk ve detaylar
-- arsanın tohumuna (seed) göre değişir; aynı tohum her zaman aynı binayı üretir.
--
-- Yerel koordinat: bina önü -Z yönüne (yola) bakar, genişlik X, derinlik Z, zemin y = 0.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapDefinitions = require(ReplicatedStorage.Shared.MapDefinitions)

local BuildingBuilder = {}

local M = Enum.Material
local rgb = Color3.fromRGB

local PALETTES = {
	glass = { rgb(92, 140, 168), rgb(70, 108, 132), rgb(120, 158, 170), rgb(84, 120, 110), rgb(60, 72, 96) },
	stone = { rgb(214, 208, 196), rgb(186, 180, 170), rgb(160, 156, 150), rgb(228, 224, 214), rgb(120, 116, 112) },
	brick = { rgb(150, 72, 54), rgb(128, 64, 50), rgb(170, 98, 70), rgb(112, 76, 62), rgb(160, 120, 92) },
	pastel = { rgb(244, 196, 196), rgb(176, 222, 214), rgb(250, 230, 170), rgb(196, 210, 240), rgb(240, 214, 236), rgb(255, 255, 248) },
	house = { rgb(236, 228, 210), rgb(208, 220, 228), rgb(232, 210, 184), rgb(196, 214, 190), rgb(250, 250, 246), rgb(214, 196, 176) },
	roof = { rgb(96, 70, 60), rgb(70, 74, 82), rgb(130, 76, 58), rgb(84, 92, 74) },
	industrial = { rgb(164, 150, 120), rgb(110, 128, 140), rgb(150, 150, 146), rgb(126, 108, 92), rgb(88, 108, 96) },
	container = { rgb(176, 64, 50), rgb(46, 98, 150), rgb(212, 160, 50), rgb(70, 130, 84), rgb(150, 150, 150), rgb(230, 230, 226) },
	neon = { rgb(255, 92, 168), rgb(64, 220, 255), rgb(255, 196, 64), rgb(150, 110, 255) },
}

local DECOR_SHOP_NAMES = { "Boutique Sol", "Bakery", "Florist", "Books & Co.", "Pharmacy", "Barber", "Laundry", "Tailor",
	"Surf Shop", "Gallery", "Hardware", "Bike Shop", "Deli", "Optics", "Phone Repair", "Gelato" }

type Ctx = {
	Kit: any, Model: Model, Base: CFrame, W: number, D: number, H: number,
	Rng: Random, Lot: any, Poi: any?,
}

local function pick(rng: Random, list)
	return list[rng:NextInteger(1, #list)]
end

-- Yerel kutu: merkez (x, alt-y, z) ve boyut. bottom = kutunun alt yüzü
local function box(ctx: Ctx, size: Vector3, x: number, bottom: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?)
	return ctx.Kit:Box(ctx.Model, size, ctx.Base * CFrame.new(x, bottom + size.Y / 2, z), color, material, props)
end

local function cyl(ctx: Ctx, height: number, diameter: number, x: number, bottom: number, z: number, color: Color3, material: Enum.Material?)
	return ctx.Kit:Cylinder(ctx.Model, height, diameter, ctx.Base * CFrame.new(x, bottom + height / 2, z), color, material)
end

local function wedge(ctx: Ctx, size: Vector3, x: number, bottom: number, z: number, yaw: number, color: Color3, material: Enum.Material?)
	return ctx.Kit:Wedge(ctx.Model, size, ctx.Base * CFrame.new(x, bottom + size.Y / 2, z) * CFrame.Angles(0, yaw, 0), color, material)
end

-- Ön cepheye tabela; metni okunur boyuta göre ölçeklenir
local function signBoard(ctx: Ctx, text: string, width: number, height: number, bottom: number, z: number, bg: Color3, fg: Color3?, glow: boolean?)
	local board = box(ctx, Vector3.new(width, height, 0.6), 0, bottom, z, bg, if glow then M.Neon else M.SmoothPlastic)
	ctx.Kit:Label(board, Enum.NormalId.Front, text, fg or Color3.new(1, 1, 1), glow)
	return board
end

local function poiName(ctx: Ctx, fallback: string): string
	return if ctx.Poi then ctx.Poi.Name else fallback
end

local function gableRoof(ctx: Ctx, width: number, depth: number, height: number, bottom: number, zCenter: number, color: Color3)
	-- İki kama sırt sırta: çatı mahyası X ekseni boyunca
	local half = depth / 2
	wedge(ctx, Vector3.new(width, height, half), 0, bottom, zCenter - half / 2, 0, color, M.Slate)
	wedge(ctx, Vector3.new(width, height, half), 0, bottom, zCenter + half / 2, math.pi, color, M.Slate)
end

local function tree(ctx: Ctx, x: number, z: number, bottom: number)
	local h = ctx.Rng:NextNumber(7, 10)
	cyl(ctx, h, 1.4, x, bottom, z, rgb(110, 80, 54), M.Wood)
	ctx.Kit:Ball(ctx.Model, ctx.Rng:NextNumber(9, 13), ctx.Base * CFrame.new(x, bottom + h + 3, z), rgb(78, 132, 64), M.Grass, { CastShadow = true })
end

-- ===================== STİLLER =====================
local Styles = {}

function Styles.glass_tower(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 60), ctx.Rng
	local stone = pick(rng, PALETTES.stone)
	local glass = pick(rng, PALETTES.glass)
	box(ctx, Vector3.new(w, 14, d), 0, 0, 0, stone, M.Concrete)
	local tw, td = w * rng:NextNumber(0.62, 0.78), d * rng:NextNumber(0.62, 0.78)
	box(ctx, Vector3.new(tw, h - 14, td), 0, 14, 0, glass, M.Glass, { Reflectance = 0.18 })
	local bandEvery = pick(rng, { 16, 20, 24 })
	local y = 14 + bandEvery
	while y < h - 4 do
		box(ctx, Vector3.new(tw + 1.2, 1.2, td + 1.2), 0, y, 0, stone, M.Concrete, { CastShadow = false })
		y += bandEvery
	end
	box(ctx, Vector3.new(tw * 0.6, 10, td * 0.6), 0, h, 0, stone, M.Concrete)
	cyl(ctx, 24, 1, 0, h + 10, 0, rgb(200, 200, 200), M.Metal)
	box(ctx, Vector3.new(w * 0.35, 1, 10), 0, 11, -d / 2 - 4, stone, M.Concrete) -- giriş saçağı
end

function Styles.setback_tower(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 60), ctx.Rng
	local stone = pick(rng, PALETTES.stone)
	local glass = pick(rng, PALETTES.glass)
	local tiers = { { 0.96, 0.45 }, { 0.76, 0.32 }, { 0.54, 0.23 } }
	local bottom = 0
	for i, t in tiers do
		local th = h * t[2]
		local tw, td = w * t[1], d * t[1]
		local isGlass = (i % 2 == 0) ~= (rng:NextNumber() < 0.5)
		box(ctx, Vector3.new(tw, th, td), 0, bottom, 0, if isGlass then glass else stone, if isGlass then M.Glass else M.Concrete, { Reflectance = if isGlass then 0.15 else 0 })
		box(ctx, Vector3.new(tw + 1.5, 2, td + 1.5), 0, bottom + th - 1, 0, stone, M.Concrete, { CastShadow = false })
		if i == 1 then
			-- Ön cephede dikey nervürler
			for _, x in { -tw / 4, tw / 4 } do
				box(ctx, Vector3.new(2, th - 4, 1.2), x, 2, -td / 2 - 0.6, stone, M.Concrete, { CastShadow = false })
			end
		end
		bottom += th
	end
	cyl(ctx, 30, 1.6, 0, bottom, 0, rgb(210, 210, 210), M.Metal)
end

function Styles.office(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 24), ctx.Rng
	local stone = pick(rng, PALETTES.stone)
	local glass = pick(rng, PALETTES.glass)
	box(ctx, Vector3.new(w, h, d), 0, 0, 0, stone, M.Concrete)
	local n = math.clamp(math.floor(w / 12), 2, 6)
	local sw = (w / n) * 0.55
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		box(ctx, Vector3.new(sw, h - 8, 0.6), x, 5, -d / 2 - 0.25, glass, M.Glass, { CastShadow = false, Reflectance = 0.1 })
		box(ctx, Vector3.new(sw, h - 8, 0.6), x, 5, d / 2 + 0.25, glass, M.Glass, { CastShadow = false, Reflectance = 0.1 })
	end
	box(ctx, Vector3.new(w * 0.3, 5, d * 0.3), w * 0.15, h, 0, rgb(140, 140, 140), M.Metal) -- çatı üniteleri
end

function Styles.apartment_modern(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 20), ctx.Rng
	local body = pick(rng, { rgb(240, 238, 232), rgb(220, 224, 228), rgb(70, 72, 78), rgb(200, 186, 170) })
	local glass = pick(rng, PALETTES.glass)
	box(ctx, Vector3.new(w, h, d), 0, 0, 0, body, M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.7, h - 6, 0.5), 0, 3, -d / 2 - 0.2, glass, M.Glass, { CastShadow = false })
	local floors = math.floor(h / 10)
	for f = 1, floors - 1 do
		box(ctx, Vector3.new(w * 0.78, 0.8, 4), 0, f * 10, -d / 2 - 2, body, M.Concrete)
	end
	box(ctx, Vector3.new(w + 1, 1.5, d + 1), 0, h, 0, body, M.Concrete, { CastShadow = false })
end

function Styles.apartment_brick(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 18), ctx.Rng
	local brick = pick(rng, PALETTES.brick)
	local trim = pick(rng, { rgb(230, 224, 210), rgb(60, 60, 64) })
	box(ctx, Vector3.new(w, h, d), 0, 0, 0, brick, M.Brick)
	local floors = math.min(math.floor(h / 9), 7)
	for f = 0, floors - 1 do
		local y = 3 + f * 9
		box(ctx, Vector3.new(w * 0.82, 3.6, 0.5), 0, y, -d / 2 - 0.2, rgb(60, 80, 96), M.Glass, { CastShadow = false })
		box(ctx, Vector3.new(w * 0.82, 3.6, 0.5), 0, y, d / 2 + 0.2, rgb(60, 80, 96), M.Glass, { CastShadow = false })
	end
	box(ctx, Vector3.new(w + 2, 2, d + 2), 0, h, 0, trim, M.Concrete)
	box(ctx, Vector3.new(6, 8, 1), 0, 0, -d / 2 - 0.5, trim, M.Wood) -- giriş
end

function Styles.hotel(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 40), ctx.Rng
	local body = pick(rng, { rgb(250, 250, 246), rgb(244, 236, 220), rgb(232, 242, 244) })
	local accent = pick(rng, { rgb(64, 196, 214), rgb(255, 160, 120), rgb(110, 170, 220) })
	box(ctx, Vector3.new(w, h, d * 0.8), 0, 0, d * 0.1, body, M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.22, h + 6, 2), 0, 0, -d * 0.3 - 1, accent, M.Glass, { Reflectance = 0.2 })
	local floors = math.floor(h / 10)
	for f = 1, floors - 1, 2 do
		box(ctx, Vector3.new(w * 0.32, 0.8, 4), -w * 0.33, f * 10, -d * 0.3 - 2, body, M.Concrete, { CastShadow = false })
		box(ctx, Vector3.new(w * 0.32, 0.8, 4), w * 0.33, f * 10, -d * 0.3 - 2, body, M.Concrete, { CastShadow = false })
	end
	box(ctx, Vector3.new(w * 0.6, 1.2, 12), 0, 12, -d * 0.3 - 6, accent, M.SmoothPlastic) -- giriş saçağı
	signBoard(ctx, poiName(ctx, "HOTEL"), math.min(w * 0.8, 50), 6, h + 1, -d * 0.3 + 1, rgb(30, 30, 36), rgb(255, 255, 255), true)
end

function Styles.deco_lowrise(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.clamp(ctx.H, 14, 40), ctx.Rng
	local body = pick(rng, PALETTES.pastel)
	local neon = pick(rng, PALETTES.neon)
	box(ctx, Vector3.new(w, h, d), 0, 0, 0, body, M.SmoothPlastic)
	local floors = math.floor(h / 9)
	for f = 1, floors do
		box(ctx, Vector3.new(w + 1, 0.6, 2.4), 0, f * 9 - 2, -d / 2 - 1.2, rgb(255, 255, 255), M.SmoothPlastic, { CastShadow = false })
		box(ctx, Vector3.new(w * 0.7, 3, 0.4), 0, f * 9 - 6, -d / 2 - 0.2, rgb(80, 130, 150), M.Glass, { CastShadow = false })
	end
	box(ctx, Vector3.new(3, h + 6, 2), 0, 0, -d / 2 - 1, rgb(255, 255, 255), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.9, 0.6, 0.4), 0, h - 1.5, -d / 2 - 0.3, neon, M.Neon, { CastShadow = false })
end

function Styles.house_a(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local hw, hd = math.min(w - 8, 34), math.min(d - 16, 28)
	if hw < 12 or hd < 10 then
		return Styles.house_b(ctx)
	end
	local zc = -d / 2 + 10 + hd / 2 -- ön bahçe 10 stud
	local wall = pick(rng, PALETTES.house)
	local roof = pick(rng, PALETTES.roof)
	box(ctx, Vector3.new(hw, 10, hd), 0, 0, zc, wall, M.Plaster)
	gableRoof(ctx, hw + 2, hd + 2, rng:NextNumber(5, 8), 10, zc, roof)
	box(ctx, Vector3.new(4, 7, 0.4), -hw * 0.15, 0, zc - hd / 2 - 0.2, rgb(110, 76, 52), M.Wood)
	for _, x in { -hw * 0.38, hw * 0.25 } do
		box(ctx, Vector3.new(5, 4, 0.4), x, 3.5, zc - hd / 2 - 0.2, rgb(130, 170, 190), M.Glass, { CastShadow = false })
	end
	-- garaj + araba yolu
	if w - hw > 16 then
		local gx = hw / 2 + 7
		box(ctx, Vector3.new(12, 9, 14), gx, 0, zc - hd / 2 + 7, wall, M.Plaster)
		box(ctx, Vector3.new(10, 7, 0.4), gx, 0, zc - hd / 2 - 0.2, rgb(240, 240, 240), M.SmoothPlastic)
		box(ctx, Vector3.new(10, 0.1, 10), gx, 0, -d / 2 + 5, rgb(120, 120, 118), M.Concrete, { CastShadow = false })
	else
		box(ctx, Vector3.new(4, 0.1, 10), -hw * 0.15, 0, -d / 2 + 5, rgb(200, 196, 188), M.Concrete, { CastShadow = false })
	end
	if rng:NextNumber() < 0.6 then
		tree(ctx, -w / 2 + 5, -d / 2 + 5, 0)
	end
end

function Styles.house_b(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local hw, hd = math.max(math.min(w - 8, 32), 10), math.max(math.min(d - 14, 26), 10)
	local zc = -d / 2 + 9 + hd / 2
	local wall = pick(rng, { rgb(244, 244, 240), rgb(60, 62, 66), rgb(214, 200, 180), rgb(196, 210, 214) })
	local wood = rgb(150, 108, 72)
	box(ctx, Vector3.new(hw, 9, hd), 0, 0, zc, wall, M.SmoothPlastic)
	box(ctx, Vector3.new(hw * 0.62, 8, hd * 0.7), hw * 0.16, 9, zc + hd * 0.1, if rng:NextNumber() < 0.5 then wood else wall, if rng:NextNumber() < 0.5 then M.WoodPlanks else M.SmoothPlastic)
	box(ctx, Vector3.new(hw * 0.5, 6, 0.4), -hw * 0.18, 1.5, zc - hd / 2 - 0.2, rgb(110, 150, 170), M.Glass, { CastShadow = false })
	box(ctx, Vector3.new(hw + 1, 0.8, hd + 1), 0, 9, zc, rgb(50, 50, 54), M.SmoothPlastic, { CastShadow = false })
	box(ctx, Vector3.new(8, 0.1, 9), hw * 0.3, 0, -d / 2 + 4.5, rgb(120, 120, 118), M.Concrete, { CastShadow = false })
	if rng:NextNumber() < 0.4 then
		tree(ctx, w / 2 - 5, -d / 2 + 4, 0)
	end
end

function Styles.townhouse(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.clamp(ctx.H, 18, 32), ctx.Rng
	local n = math.clamp(math.floor(w / 16), 2, 4)
	local uw = w / n
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * uw
		local color = pick(rng, PALETTES.brick)
		local uh = h + rng:NextNumber(-3, 3)
		box(ctx, Vector3.new(uw - 0.3, uh, d * 0.8), x, 0, d * 0.1, color, M.Brick)
		box(ctx, Vector3.new(uw, 1.4, d * 0.8 + 1), x, uh, d * 0.1, rgb(226, 220, 206), M.Concrete, { CastShadow = false })
		box(ctx, Vector3.new(3.5, 7, 0.4), x, 1.5, -d * 0.3 - 0.2, rgb(40, 48, 60), M.Wood)
		box(ctx, Vector3.new(5, 1.5, 3), x, 0, -d * 0.3 - 1.5, rgb(200, 196, 188), M.Concrete, { CastShadow = false })
	end
end

local function storefrontBase(ctx: Ctx, name: string, accent: Color3, bodyColor: Color3?)
	local w, d, h, rng = ctx.W, ctx.D, math.clamp(ctx.H, 10, 22), ctx.Rng
	local body = bodyColor or pick(rng, PALETTES.stone)
	local depth = d * 0.85
	local z = d / 2 - depth / 2
	box(ctx, Vector3.new(w, h, depth), 0, 0, z, body, M.Concrete)
	local front = z - depth / 2
	box(ctx, Vector3.new(w * 0.82, h * 0.5, 0.5), 0, 0.5, front - 0.2, rgb(150, 190, 210), M.Glass, { CastShadow = false, Transparency = 0.25 })
	box(ctx, Vector3.new(5, 7.5, 0.6), 0, 0, front - 0.4, rgb(60, 60, 64), M.Metal, { CastShadow = false })
	box(ctx, Vector3.new(w * 0.9, 0.5, 5), 0, h * 0.5 + 1.5, front - 2.5, accent, M.Fabric)
	signBoard(ctx, name, math.min(w * 0.8, 40), 3.2, h * 0.5 + 2.6, front - 0.6, rgb(28, 28, 32), accent, true)
	return front, h
end

local POI_ACCENT = {
	supermarket = rgb(80, 180, 90), convenience = rgb(255, 140, 40), grocery = rgb(120, 190, 80),
	restaurant = rgb(200, 60, 60), fastfood = rgb(250, 190, 40), cafe = rgb(150, 100, 70),
	general = rgb(80, 140, 220), garage = rgb(250, 200, 40), marina = rgb(40, 140, 200),
}

function Styles.storefront(ctx: Ctx)
	local accent = if ctx.Poi then POI_ACCENT[ctx.Poi.Type] or rgb(255, 122, 69) else rgb(255, 122, 69)
	if ctx.Poi and ctx.Poi.Type == "supermarket" then
		-- Süpermarket: daha geniş cephe, sepet/el arabası köşesi
		storefrontBase(ctx, poiName(ctx, "MARKET"), accent, rgb(236, 236, 230))
		box(ctx, Vector3.new(8, 3, 4), ctx.W / 2 - 6, 0, -ctx.D / 2 + 3, rgb(160, 160, 166), M.Metal)
	else
		storefrontBase(ctx, poiName(ctx, "SHOP"), accent)
	end
end

function Styles.storefront_plain(ctx: Ctx)
	local rng = ctx.Rng
	local accent = pick(rng, { rgb(200, 70, 80), rgb(60, 140, 120), rgb(70, 100, 180), rgb(220, 160, 50), rgb(130, 80, 160) })
	local front, h = storefrontBase(ctx, pick(rng, DECOR_SHOP_NAMES), accent, pick(rng, PALETTES.pastel))
	if ctx.H > 24 then
		-- üstte daire katları
		box(ctx, Vector3.new(ctx.W * 0.96, ctx.H - h, ctx.D * 0.8), 0, h, ctx.D * 0.1, pick(rng, PALETTES.stone), M.Concrete)
	end
	local _ = front
end

function Styles.mall(ctx: Ctx)
	local w, d, h = ctx.W, ctx.D, math.max(ctx.H, 24)
	box(ctx, Vector3.new(w, h, d), 0, 0, 0, rgb(232, 228, 220), M.Concrete)
	box(ctx, Vector3.new(w * 0.45, h * 0.85, 6), 0, 0, -d / 2 - 2, rgb(120, 170, 200), M.Glass, { Reflectance = 0.2, Transparency = 0.15 })
	box(ctx, Vector3.new(w * 0.6, 1.4, 14), 0, 13, -d / 2 - 7, rgb(255, 122, 69), M.SmoothPlastic)
	signBoard(ctx, poiName(ctx, "MALL"), math.min(w * 0.6, 60), 7, h - 9, -d / 2 - 0.4, rgb(30, 30, 34), rgb(255, 255, 255), true)
	box(ctx, Vector3.new(w * 0.4, 6, d * 0.4), -w * 0.2, h, d * 0.1, rgb(200, 196, 190), M.Concrete)
end

function Styles.parking_garage(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	local levels, lh = 4, 9
	local concrete = rgb(176, 172, 166)
	for i = 0, levels do
		box(ctx, Vector3.new(w, 1, d), 0, i * lh, 0, concrete, M.Concrete)
		if i > 0 then
			box(ctx, Vector3.new(w, 3, 0.8), 0, i * lh + 1, -d / 2 + 0.4, concrete, M.Concrete, { CastShadow = false })
			box(ctx, Vector3.new(w, 3, 0.8), 0, i * lh + 1, d / 2 - 0.4, concrete, M.Concrete, { CastShadow = false })
		end
	end
	for _, x in { -w / 2 + 2, 0, w / 2 - 2 } do
		for _, z in { -d / 2 + 2, 0, d / 2 - 2 } do
			box(ctx, Vector3.new(2, levels * lh, 2), x, 1, z, concrete, M.Concrete, { CastShadow = false })
		end
	end
	local sign = box(ctx, Vector3.new(8, 8, 1), w / 2 - 6, levels * lh + 1, -d / 2, rgb(30, 90, 180), M.SmoothPlastic)
	ctx.Kit:Label(sign, Enum.NormalId.Front, "P", rgb(255, 255, 255), true)
end

function Styles.hospital(ctx: Ctx)
	local w, d, h = ctx.W, ctx.D, math.max(ctx.H, 30)
	box(ctx, Vector3.new(w * 0.92, h, d * 0.55), 0, 0, -d * 0.18, rgb(244, 246, 248), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.5, h * 0.55, d * 0.36), -w * 0.2, 0, d * 0.28, rgb(230, 234, 238), M.SmoothPlastic)
	for f = 1, math.floor(h / 10) - 1 do
		box(ctx, Vector3.new(w * 0.86, 3.5, 0.5), 0, f * 10 - 6, -d * 0.18 - d * 0.275 - 0.2, rgb(110, 160, 190), M.Glass, { CastShadow = false })
	end
	local fz = -d * 0.18 - d * 0.275 - 0.6
	box(ctx, Vector3.new(10, 3, 0.6), 0, h - 9, fz, rgb(220, 40, 50), M.Neon)
	box(ctx, Vector3.new(3, 10, 0.6), 0, h - 12.5, fz, rgb(220, 40, 50), M.Neon)
	box(ctx, Vector3.new(24, 1, 12), w * 0.25, 10, fz - 6, rgb(220, 40, 50), M.SmoothPlastic) -- acil saçağı
	cyl(ctx, 0.6, 22, w * 0.2, h, -d * 0.18, rgb(70, 74, 80), M.Concrete) -- helipad
	signBoard(ctx, poiName(ctx, "HOSPITAL"), math.min(w * 0.6, 50), 5, h - 18, fz, rgb(255, 255, 255), rgb(200, 30, 40), false)
end

function Styles.police(ctx: Ctx)
	local w, d, h = ctx.W, ctx.D, math.max(ctx.H, 16)
	box(ctx, Vector3.new(w * 0.9, h, d * 0.75), 0, 0, d * 0.1, rgb(210, 214, 220), M.Concrete)
	local fz = d * 0.1 - d * 0.375
	box(ctx, Vector3.new(w * 0.9 + 0.4, 2, 0.6), 0, h - 4, fz - 0.3, rgb(30, 70, 160), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.6, 4, 0.5), 0, 2, fz - 0.2, rgb(110, 150, 180), M.Glass, { CastShadow = false })
	signBoard(ctx, poiName(ctx, "POLICE"), math.min(w * 0.6, 36), 3.5, h - 9, fz - 0.4, rgb(30, 70, 160), rgb(255, 255, 255), false)
	cyl(ctx, 30, 0.6, -w * 0.4, 0, fz - 6, rgb(220, 220, 220), M.Metal)
	box(ctx, Vector3.new(0.2, 5, 8), -w * 0.4, 24, fz - 10, rgb(30, 70, 160), M.Fabric)
end

function Styles.cinema(ctx: Ctx)
	local w, d, h = ctx.W, ctx.D, math.max(ctx.H, 20)
	box(ctx, Vector3.new(w, h, d * 0.85), 0, 0, d * 0.075, rgb(60, 40, 60), M.Concrete)
	local fz = d * 0.075 - d * 0.425
	box(ctx, Vector3.new(w * 0.9, 6, 4), 0, 10, fz - 2, rgb(30, 20, 30), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.9, 0.5, 4.2), 0, 16, fz - 2, rgb(255, 210, 90), M.Neon, { CastShadow = false })
	signBoard(ctx, poiName(ctx, "CINEMA"), math.min(w * 0.8, 40), 5, h - 7, fz - 0.4, rgb(120, 20, 40), rgb(255, 230, 160), true)
	box(ctx, Vector3.new(w * 0.5, 8, 0.5), 0, 0.5, fz - 0.2, rgb(40, 40, 50), M.Glass, { CastShadow = false })
end

function Styles.arcade(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 14), ctx.Rng
	box(ctx, Vector3.new(w, h, d * 0.85), 0, 0, d * 0.075, rgb(24, 24, 36), M.SmoothPlastic)
	local fz = d * 0.075 - d * 0.425
	for i, c in PALETTES.neon do
		box(ctx, Vector3.new(w * 0.9, 0.5, 0.4), 0, 3 + i * 2.2, fz - 0.3, c, M.Neon, { CastShadow = false })
	end
	signBoard(ctx, poiName(ctx, "ARCADE"), math.min(w * 0.8, 36), 4, h - 6, fz - 0.6, rgb(10, 10, 20), pick(rng, PALETTES.neon), true)
end

function Styles.dealership(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w * 0.9, 14, d * 0.55), 0, 0, d * 0.15, rgb(150, 190, 210), M.Glass, { Transparency = 0.3, Reflectance = 0.2 })
	box(ctx, Vector3.new(w * 0.95, 1.2, d * 0.62), 0, 14, d * 0.15, rgb(240, 240, 240), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.9, 0.12, d * 0.35), 0, 0, -d * 0.3, rgb(90, 90, 96), M.Asphalt, { CastShadow = false }) -- sergi alanı
	local pylon = box(ctx, Vector3.new(14, 20, 1.5), w * 0.4, 0, -d / 2 + 2, rgb(30, 30, 36), M.SmoothPlastic)
	ctx.Kit:Label(pylon, Enum.NormalId.Front, poiName(ctx, "MOTORS"), rgb(255, 122, 69), true)
end

function Styles.garage(ctx: Ctx)
	local w, d, h = ctx.W, ctx.D, math.max(ctx.H, 12)
	box(ctx, Vector3.new(w * 0.92, h, d * 0.8), 0, 0, d * 0.1, rgb(150, 154, 160), M.CorrodedMetal)
	local fz = d * 0.1 - d * 0.4
	for _, x in { -w * 0.22, w * 0.22 } do
		box(ctx, Vector3.new(w * 0.3, 9, 0.4), x, 0, fz - 0.2, rgb(200, 200, 196), M.DiamondPlate)
	end
	signBoard(ctx, poiName(ctx, "GARAGE"), math.min(w * 0.7, 30), 3, 10, fz - 0.4, rgb(250, 200, 40), rgb(20, 20, 20), false)
end

function Styles.gas_station(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	local accent = rgb(220, 60, 50)
	local cw, cd = math.min(w * 0.6, 70), math.min(d * 0.45, 40)
	local cz = -d / 2 + cd / 2 + 6
	box(ctx, Vector3.new(cw, 1.6, cd), 0, 14, cz, rgb(245, 245, 245), M.SmoothPlastic)
	box(ctx, Vector3.new(cw + 0.2, 0.8, cd + 0.2), 0, 14.4, cz, accent, M.Neon, { CastShadow = false })
	for _, x in { -cw / 2 + 2, cw / 2 - 2 } do
		for _, z in { cz - cd / 2 + 2, cz + cd / 2 - 2 } do
			box(ctx, Vector3.new(1.5, 14, 1.5), x, 0, z, rgb(230, 230, 230), M.Metal, { CastShadow = false })
		end
	end
	for _, x in { -cw / 4, cw / 4 } do
		box(ctx, Vector3.new(4, 0.6, cd * 0.6), x, 0, cz, rgb(200, 200, 200), M.Concrete, { CastShadow = false })
		box(ctx, Vector3.new(2.4, 5.5, 3), x, 0.6, cz, accent, M.SmoothPlastic)
	end
	-- market binası
	local sw, sd = math.min(w * 0.45, 40), math.min(d * 0.3, 24)
	local sz = d / 2 - sd / 2 - 3
	box(ctx, Vector3.new(sw, 12, sd), w / 2 - sw / 2 - 3, 0, sz, rgb(240, 238, 232), M.SmoothPlastic)
	box(ctx, Vector3.new(sw * 0.7, 6, 0.5), w / 2 - sw / 2 - 3, 0.5, sz - sd / 2 - 0.2, rgb(150, 190, 210), M.Glass, { CastShadow = false })
	local pylon = box(ctx, Vector3.new(10, 22, 1.2), -w / 2 + 7, 0, -d / 2 + 4, rgb(30, 30, 36), M.SmoothPlastic)
	ctx.Kit:Label(pylon, Enum.NormalId.Front, poiName(ctx, "FUEL"), rgb(255, 255, 255), true)
end

function Styles.warehouse(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 16), ctx.Rng
	local color = pick(rng, PALETTES.industrial)
	box(ctx, Vector3.new(w, h, d * 0.85), 0, 0, d * 0.075, color, M.CorrodedMetal)
	box(ctx, Vector3.new(w + 1, 1, d * 0.85 + 1), 0, h, d * 0.075, rgb(90, 92, 96), M.Metal, { CastShadow = false })
	local fz = d * 0.075 - d * 0.425
	local doors = math.clamp(math.floor(w / 20), 2, 5)
	for i = 1, doors do
		local x = -w / 2 + (i - 0.5) * (w / doors)
		box(ctx, Vector3.new(10, 11, 0.4), x, 0, fz - 0.2, rgb(70, 72, 76), M.DiamondPlate, { CastShadow = false })
	end
	box(ctx, Vector3.new(w * 0.9, 1.4, 6), 0, 0, fz - 3, rgb(150, 150, 146), M.Concrete, { CastShadow = false })
end

function Styles.factory(ctx: Ctx)
	local w, d, h, rng = ctx.W, ctx.D, math.max(ctx.H, 20), ctx.Rng
	local color = pick(rng, PALETTES.industrial)
	box(ctx, Vector3.new(w * 0.62, h, d * 0.7), -w * 0.17, 0, 0, color, M.CorrodedMetal)
	box(ctx, Vector3.new(w * 0.3, h * 0.6, d * 0.45), w * 0.3, 0, -d * 0.1, rgb(160, 156, 150), M.Concrete)
	for i, x in { -w * 0.35, -w * 0.1 } do
		cyl(ctx, h * 2 + i * 6, 5, x, 0, d * 0.25, rgb(150, 70, 56), M.Brick)
	end
	cyl(ctx, 18, 14, w * 0.32, 0, d * 0.3, rgb(210, 210, 206), M.Metal)
	box(ctx, Vector3.new(w * 0.3, 1.6, 1.6), w * 0.1, h * 0.7, d * 0.3, rgb(140, 140, 140), M.Metal, { CastShadow = false })
end

function Styles.construction(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	box(ctx, Vector3.new(w, 0.3, d), 0, 0, 0, rgb(150, 118, 84), M.Ground, { CastShadow = false })
	local floors = 4
	local fw, fd = w * 0.5, d * 0.5
	for f = 0, floors - 1 do
		box(ctx, Vector3.new(fw, 1, fd), 0, f * 10 + 0.3, 0, rgb(170, 168, 160), M.Concrete)
	end
	for _, x in { -fw / 2 + 1, fw / 2 - 1 } do
		for _, z in { -fd / 2 + 1, fd / 2 - 1 } do
			box(ctx, Vector3.new(1.5, floors * 10 + 4, 1.5), x, 0.3, z, rgb(170, 168, 160), M.Concrete, { CastShadow = false })
		end
	end
	-- kule vinç
	local mx, mz = w * 0.36, -d * 0.3
	local mast = 90
	box(ctx, Vector3.new(3, mast, 3), mx, 0, mz, rgb(250, 200, 40), M.Metal)
	box(ctx, Vector3.new(70, 2.5, 2.5), mx - 25, mast, mz, rgb(250, 200, 40), M.Metal)
	box(ctx, Vector3.new(6, 4, 6), mx + 12, mast - 4, mz, rgb(110, 110, 110), M.Concrete)
	box(ctx, Vector3.new(4, 4, 4), mx, mast - 6, mz - 3, rgb(240, 240, 240), M.SmoothPlastic)
	-- çit
	box(ctx, Vector3.new(w, 6, 0.4), 0, 0, -d / 2, rgb(80, 120, 90), M.Fabric, { Transparency = 0.2 })
	local _ = rng
end

function Styles.port_yard(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	box(ctx, Vector3.new(w, 0.2, d), 0, 0, 0, rgb(120, 118, 112), M.Concrete, { CastShadow = false })
	-- konteyner yığınları (8.5 x 9 x 40 benzeri)
	local rows = math.max(1, math.floor(d / 12))
	for r = 0, rows - 1 do
		local z = -d / 2 + 6 + r * 12
		local stack = rng:NextInteger(1, 3)
		for s = 0, stack - 1 do
			box(ctx, Vector3.new(math.min(w * 0.8, 40), 8.5, 8), rng:NextNumber(-3, 3), s * 8.5 + 0.2, z, pick(rng, PALETTES.container), M.CorrodedMetal)
		end
	end
end

function Styles.farm(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	-- tarlalar: ekin sıraları
	local fieldW, fieldD = w * 0.62, d * 0.9
	local fx = w / 2 - fieldW / 2 - 4
	local crop = pick(rng, { { rgb(196, 176, 80), rgb(150, 120, 70) }, { rgb(110, 160, 70), rgb(120, 96, 64) }, { rgb(220, 190, 90), rgb(170, 140, 90) } })
	local rows = 10
	local rowD = fieldD / rows
	for r = 0, rows - 1 do
		local z = -fieldD / 2 + (r + 0.5) * rowD
		box(ctx, Vector3.new(fieldW, if r % 2 == 0 then 1.4 else 0.3, rowD), fx, 0, z, crop[(r % 2) + 1], if r % 2 == 0 then M.Grass else M.Ground, { CastShadow = false })
	end
	-- çiftlik evi
	local hx, hz = -w / 2 + 30, -d / 2 + 30
	box(ctx, Vector3.new(30, 12, 22), hx, 0, hz, rgb(240, 236, 224), M.WoodPlanks)
	gableRoof(ctx, 32, 24, 7, 12, hz, rgb(96, 70, 60))
	-- ahır
	local bx, bz = -w / 2 + 34, -d / 2 + 90
	box(ctx, Vector3.new(36, 18, 28), bx, 0, bz, rgb(170, 52, 44), M.WoodPlanks)
	gableRoof(ctx, 38, 30, 10, 18, bz, rgb(70, 74, 82))
	box(ctx, Vector3.new(12, 14, 0.5), bx, 0, bz - 14.2, rgb(240, 236, 224), M.WoodPlanks)
	-- silolar
	for i = 0, 1 do
		local sx = -w / 2 + 64 + i * 14
		cyl(ctx, 34, 11, sx, 0, bz, rgb(200, 204, 208), M.Metal)
		ctx.Kit:Ball(ctx.Model, 11, ctx.Base * CFrame.new(sx, 34, bz), rgb(200, 204, 208), M.Metal)
	end
	-- çit (ön)
	box(ctx, Vector3.new(w, 0.5, 0.5), 0, 2.5, -d / 2 + 1, rgb(150, 116, 80), M.Wood, { CastShadow = false })
	box(ctx, Vector3.new(w, 0.5, 0.5), 0, 4.5, -d / 2 + 1, rgb(150, 116, 80), M.Wood, { CastShadow = false })
	-- traktör izi / toprak yol
	box(ctx, Vector3.new(8, 0.15, d * 0.8), -w / 2 + 60, 0, 0, rgb(150, 120, 84), M.Ground, { CastShadow = false })
end

function Styles.lighthouse(ctx: Ctx)
	local h = math.max(ctx.H, 50)
	cyl(ctx, 6, 26, 0, 0, 0, rgb(200, 196, 188), M.Concrete)
	local seg = (h - 6) / 4
	for i = 0, 3 do
		cyl(ctx, seg, 14 - i * 1.2, 0, 6 + i * seg, 0, if i % 2 == 0 then rgb(245, 245, 245) else rgb(200, 50, 50), M.SmoothPlastic)
	end
	local lamp = cyl(ctx, 6, 9, 0, h, 0, rgb(255, 240, 180), M.Neon)
	ctx.Kit:Ball(ctx.Model, 9, ctx.Base * CFrame.new(0, h + 7, 0), rgb(200, 50, 50), M.SmoothPlastic)
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 3
	light.Color = rgb(255, 230, 170)
	light.Shadows = false
	light.Parent = lamp
	ctx.Kit:Tag(lamp, "StreetLamp")
	box(ctx, Vector3.new(16, 10, 12), 18, 0, 0, rgb(245, 245, 245), M.SmoothPlastic) -- bekçi evi
end

function Styles.marina_club(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w * 0.8, 12, d * 0.6), 0, 0, -d * 0.1, rgb(250, 250, 248), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.86, 1, d * 0.68), 0, 12, -d * 0.1, rgb(40, 140, 200), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.8, 0.6, d * 0.3), 0, 0, d * 0.34, rgb(150, 112, 76), M.WoodPlanks, { CastShadow = false })
	signBoard(ctx, poiName(ctx, "MARINA"), math.min(w * 0.6, 40), 4, 13, -d * 0.4 - 0.4, rgb(40, 140, 200), rgb(255, 255, 255), true)
end

function Styles.park(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w, 0.1, d), 0, 0, 0, rgb(98, 150, 76), M.Grass, { CastShadow = false })
	box(ctx, Vector3.new(6, 0.12, d), 0, 0, 0, rgb(206, 196, 176), M.Pavement, { CastShadow = false })
	box(ctx, Vector3.new(w, 0.12, 6), 0, 0, 0, rgb(206, 196, 176), M.Pavement, { CastShadow = false })
end

function Styles.plaza(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w, 0.1, d), 0, 0, 0, rgb(226, 218, 200), M.Slate, { CastShadow = false })
	ctx.Kit:Cylinder(ctx.Model, 0.12, math.min(w, d) * 0.8, ctx.Base * CFrame.new(0, 0.06, 0), rgb(196, 160, 130), M.Pavement, { CastShadow = false })
end

function Styles.parking(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w, 0.1, d), 0, 0, 0, rgb(70, 72, 76), M.Asphalt, { CastShadow = false })
	local n = math.clamp(math.floor(w / 10), 2, 10)
	for i = 1, n - 1 do
		box(ctx, Vector3.new(0.3, 0.12, d * 0.35), -w / 2 + i * (w / n), 0, -d * 0.25, rgb(230, 230, 226), M.SmoothPlastic, { CastShadow = false })
		box(ctx, Vector3.new(0.3, 0.12, d * 0.35), -w / 2 + i * (w / n), 0, d * 0.25, rgb(230, 230, 226), M.SmoothPlastic, { CastShadow = false })
	end
end

-- ===================== GENİŞLETİLMİŞ HARİTA STİLLERİ (Aşama 3) =====================

-- Çok uzun kutuları Roblox'un 2048 stud parça sınırına göre X ekseninde böler
local function longBox(ctx: Ctx, size: Vector3, x: number, bottom: number, z: number, color: Color3, material: Enum.Material?, props: { [string]: any }?)
	local maxLen = 1900
	if size.X <= maxLen then
		return box(ctx, size, x, bottom, z, color, material, props)
	end
	local pieces = math.ceil(size.X / maxLen)
	local len = size.X / pieces
	for i = 0, pieces - 1 do
		box(ctx, Vector3.new(len, size.Y, size.Z), x - size.X / 2 + len * (i + 0.5), bottom, z, color, material, props)
	end
	return nil
end

function Styles.runway(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	local white = rgb(236, 236, 230)
	longBox(ctx, Vector3.new(w, 0.3, d), 0, 0, 0, rgb(64, 66, 70), M.Asphalt, { CastShadow = false })
	-- orta çizgi kesikleri
	local x = -w / 2 + 80
	while x < w / 2 - 80 do
		box(ctx, Vector3.new(30, 0.08, 1), x, 0.3, 0, white, M.SmoothPlastic, { CastShadow = false })
		x += 70
	end
	-- eşik çizgileri (iki uç)
	for _, sx in { -1, 1 } do
		for k = -3, 3 do
			box(ctx, Vector3.new(40, 0.08, 2.5), sx * (w / 2 - 30), 0.3, k * (d / 8), white, M.SmoothPlastic, { CastShadow = false })
		end
	end
	longBox(ctx, Vector3.new(w, 0.08, 0.8), 0, 0.3, d / 2 - 2, white, M.SmoothPlastic, { CastShadow = false })
	longBox(ctx, Vector3.new(w, 0.08, 0.8), 0, 0.3, -d / 2 + 2, white, M.SmoothPlastic, { CastShadow = false })
end

function Styles.taxiway(ctx: Ctx)
	longBox(ctx, Vector3.new(ctx.W, 0.3, ctx.D), 0, 0, 0, rgb(72, 74, 78), M.Asphalt, { CastShadow = false })
	longBox(ctx, Vector3.new(ctx.W, 0.08, 0.6), 0, 0.3, 0, rgb(240, 200, 60), M.SmoothPlastic, { CastShadow = false })
end

function Styles.apron(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w, 0.3, d), 0, 0, 0, rgb(176, 174, 168), M.Concrete, { CastShadow = false })
	for i = 1, 4 do
		local x = -w / 2 + i * (w / 5)
		box(ctx, Vector3.new(0.6, 0.08, d * 0.7), x, 0.3, 0, rgb(240, 200, 60), M.SmoothPlastic, { CastShadow = false })
	end
end

function Styles.terminal(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	box(ctx, Vector3.new(w, 26, d * 0.7), 0, 0, d * 0.1, rgb(226, 228, 232), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.9, 18, 1), 0, 2, d * 0.1 - d * 0.35 - 0.5, rgb(110, 160, 190), M.Glass, { Reflectance = 0.25, Transparency = 0.2 })
	box(ctx, Vector3.new(w + 8, 2, d * 0.85), 0, 26, d * 0.05, rgb(250, 250, 250), M.SmoothPlastic)
	box(ctx, Vector3.new(w * 0.7, 1.2, 16), 0, 12, -d / 2 + 4, rgb(255, 122, 69), M.SmoothPlastic) -- bırakma saçağı
	signBoard(ctx, poiName(ctx, "AIRPORT"), math.min(w * 0.6, 120), 8, 18, -d / 2 + 11.5, rgb(30, 30, 34), rgb(255, 255, 255), true)
	-- yolcu köprüleri (arka taraf, apron yönü)
	for _, x in { -w * 0.3, 0, w * 0.3 } do
		box(ctx, Vector3.new(6, 6, 40), x, 10, d * 0.45 + 20, rgb(200, 202, 206), M.Metal)
	end
end

function Styles.hangar(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	local color = pick(ctx.Rng, { rgb(200, 204, 210), rgb(170, 176, 186), rgb(214, 210, 196) })
	box(ctx, Vector3.new(w, 30, d), 0, 0, 0, color, M.CorrodedMetal)
	gableRoof(ctx, w + 2, d + 2, 10, 30, 0, rgb(120, 124, 130))
	box(ctx, Vector3.new(w * 0.85, 26, 0.6), 0, 0, -d / 2 - 0.3, rgb(90, 94, 100), M.DiamondPlate)
	local sign = box(ctx, Vector3.new(12, 8, 0.5), 0, 31, -d / 2 - 0.6, rgb(30, 90, 180), M.SmoothPlastic)
	ctx.Kit:Label(sign, Enum.NormalId.Front, "H" .. ctx.Lot.Id % 10, rgb(255, 255, 255), false)
end

function Styles.control_tower(ctx: Ctx)
	cyl(ctx, 70, 10, 0, 0, 0, rgb(226, 228, 232), M.Concrete)
	cyl(ctx, 12, 22, 0, 70, 0, rgb(80, 130, 160), M.Glass)
	cyl(ctx, 2, 26, 0, 82, 0, rgb(240, 240, 240), M.SmoothPlastic)
	cyl(ctx, 16, 0.8, 0, 84, 0, rgb(200, 60, 60), M.Metal)
	box(ctx, Vector3.new(30, 12, 24), 0, 0, 16, rgb(214, 216, 220), M.SmoothPlastic)
end

function Styles.motel(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local body = pick(rng, PALETTES.pastel)
	local depth = math.min(d * 0.4, 30)
	local z = d / 2 - depth / 2 - 4
	box(ctx, Vector3.new(w * 0.92, 20, depth), 0, 0, z, body, M.Plaster)
	box(ctx, Vector3.new(w * 0.92, 0.8, 5), 0, 10, z - depth / 2 - 2.5, rgb(240, 240, 236), M.Concrete) -- üst kat geçidi
	local rooms = math.clamp(math.floor(w / 12), 4, 10)
	for i = 1, rooms do
		local x = -w * 0.46 + (i - 0.5) * (w * 0.92 / rooms)
		box(ctx, Vector3.new(3.5, 7, 0.4), x, 0, z - depth / 2 - 0.2, rgb(70, 100, 140), M.Wood, { CastShadow = false })
		box(ctx, Vector3.new(3.5, 7, 0.4), x, 10.8, z - depth / 2 - 0.2, rgb(70, 100, 140), M.Wood, { CastShadow = false })
	end
	box(ctx, Vector3.new(w * 0.8, 0.12, d * 0.4), 0, 0, -d * 0.18, rgb(70, 72, 76), M.Asphalt, { CastShadow = false })
	local pylon = box(ctx, Vector3.new(12, 26, 1.2), -w / 2 + 8, 0, -d / 2 + 3, rgb(30, 30, 36), M.SmoothPlastic)
	ctx.Kit:Label(pylon, Enum.NormalId.Front, poiName(ctx, "MOTEL"), pick(rng, PALETTES.neon), true)
end

function Styles.golf(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	box(ctx, Vector3.new(w, 0.12, d), 0, 0, 0, rgb(96, 160, 80), M.Grass, { CastShadow = false })
	for k = 0, 3 do
		local x = -w / 2 + (k + 0.5) * (w / 4)
		box(ctx, Vector3.new(w / 5, 0.16, d * 0.7), x, 0, 0, rgb(124, 186, 96), M.Grass, { CastShadow = false })
		cyl(ctx, 0.2, 18, x, 0.12, -d * 0.28, rgb(140, 200, 110), M.Grass)
		cyl(ctx, 10, 0.3, x, 0.12, -d * 0.28, rgb(240, 240, 240), M.Metal)
		box(ctx, Vector3.new(0.1, 1.6, 2.4), x, 8.5, -d * 0.28 + 1.2, rgb(220, 40, 50), M.Fabric, { CastShadow = false })
		cyl(ctx, 0.2, rng:NextNumber(10, 16), x + w / 14, 0.12, d * 0.1, rgb(226, 206, 156), M.Sand)
	end
	box(ctx, Vector3.new(40, 12, 24), w / 2 - 30, 0, d / 2 - 20, rgb(250, 250, 246), M.SmoothPlastic) -- kulüp binası
	box(ctx, Vector3.new(44, 1, 28), w / 2 - 30, 12, d / 2 - 20, rgb(40, 120, 80), M.SmoothPlastic)
end

function Styles.villa(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local hw, hd = math.min(w * 0.7, 46), math.min(d * 0.45, 40)
	local zc = d / 2 - hd / 2 - 6
	box(ctx, Vector3.new(hw, 11, hd), 0, 0, zc, rgb(252, 250, 244), M.Plaster)
	box(ctx, Vector3.new(hw * 0.6, 9, hd * 0.6), hw * 0.15, 11, zc + hd * 0.1, rgb(252, 250, 244), M.Plaster)
	box(ctx, Vector3.new(hw + 2, 0.8, hd + 2), 0, 11, zc, pick(rng, { rgb(200, 120, 80), rgb(60, 140, 160) }), M.SmoothPlastic)
	box(ctx, Vector3.new(hw * 0.7, 6, 0.4), 0, 2, zc - hd / 2 - 0.2, rgb(130, 180, 200), M.Glass, { CastShadow = false })
	-- havuz
	box(ctx, Vector3.new(hw * 0.6, 0.2, 14), 0, 0, zc - hd / 2 - 12, rgb(240, 240, 236), M.Concrete, { CastShadow = false })
	box(ctx, Vector3.new(hw * 0.55, 0.25, 12), 0, 0.05, zc - hd / 2 - 12, rgb(60, 180, 220), M.Glass, { Transparency = 0.2, CastShadow = false })
end

function Styles.stilt_house(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local hw, hd = math.min(w * 0.6, 34), math.min(d * 0.5, 28)
	local wood = pick(rng, { rgb(130, 96, 66), rgb(110, 86, 64), rgb(150, 120, 88) })
	for _, x in { -hw / 2 + 1, hw / 2 - 1 } do
		for _, z in { -hd / 2 + 1, hd / 2 - 1 } do
			box(ctx, Vector3.new(1.2, 8, 1.2), x, -2, z, rgb(90, 70, 50), M.Wood, { CastShadow = false })
		end
	end
	box(ctx, Vector3.new(hw + 6, 0.8, hd + 6), 0, 6, 0, wood, M.WoodPlanks)
	box(ctx, Vector3.new(hw, 9, hd), 0, 6.8, 0, pick(rng, { rgb(200, 210, 200), rgb(226, 214, 190), rgb(180, 200, 210) }), M.WoodPlanks)
	gableRoof(ctx, hw + 2, hd + 2, 5, 15.8, 0, rgb(80, 90, 96))
	box(ctx, Vector3.new(4, 0.6, d / 2), 0, 3, -d / 4 - hd / 4, wood, M.WoodPlanks, { CastShadow = false }) -- iskele/rampa
end

function Styles.cabin(ctx: Ctx)
	local w, d, rng = ctx.W, ctx.D, ctx.Rng
	local hw, hd = math.min(w * 0.6, 30), math.min(d * 0.5, 24)
	local zc = d * 0.05
	box(ctx, Vector3.new(hw, 10, hd), 0, 0, zc, pick(rng, { rgb(122, 86, 56), rgb(140, 100, 66) }), M.WoodPlanks)
	gableRoof(ctx, hw + 3, hd + 3, 7, 10, zc, rgb(70, 74, 70))
	box(ctx, Vector3.new(3, 14, 3), hw / 2 - 3, 4, zc + hd / 4, rgb(120, 116, 110), M.Cobblestone)
	box(ctx, Vector3.new(hw, 0.6, 6), 0, 0.8, zc - hd / 2 - 3, rgb(110, 80, 54), M.WoodPlanks, { CastShadow = false })
	box(ctx, Vector3.new(4, 7, 0.4), 0, 1, zc - hd / 2 - 0.2, rgb(80, 56, 40), M.Wood)
	if ctx.Poi then
		signBoard(ctx, poiName(ctx, "RANGER"), 14, 2.5, 7.5, zc - hd / 2 - 0.6, rgb(40, 90, 60), rgb(255, 255, 255), false)
	end
end

function Styles.lodge(ctx: Ctx)
	local w, d = ctx.W, ctx.D
	local hw, hd = math.min(w * 0.8, 70), math.min(d * 0.6, 40)
	box(ctx, Vector3.new(hw, 18, hd), 0, 0, 0, rgb(130, 94, 62), M.WoodPlanks)
	gableRoof(ctx, hw + 4, hd + 4, 10, 18, 0, rgb(64, 70, 66))
	box(ctx, Vector3.new(hw * 0.6, 7, 0.4), 0, 2, -hd / 2 - 0.2, rgb(150, 190, 200), M.Glass, { CastShadow = false })
	box(ctx, Vector3.new(4, 24, 4), -hw / 2 + 4, 0, hd / 4, rgb(120, 116, 110), M.Cobblestone)
	signBoard(ctx, poiName(ctx, "LODGE"), math.min(hw * 0.6, 34), 4, 11, -hd / 2 - 0.6, rgb(50, 40, 30), rgb(255, 230, 180), false)
end

function Styles.observatory(ctx: Ctx)
	cyl(ctx, 16, 30, 0, 0, 0, rgb(226, 226, 222), M.Concrete)
	ctx.Kit:Ball(ctx.Model, 30, ctx.Base * CFrame.new(0, 16, 0), rgb(240, 240, 244), M.Metal)
	box(ctx, Vector3.new(4, 14, 16), 0, 16, -6, rgb(40, 44, 54), M.SmoothPlastic, { CastShadow = false })
	box(ctx, Vector3.new(26, 10, 18), 26, 0, 0, rgb(214, 214, 210), M.Concrete)
	signBoard(ctx, poiName(ctx, "OBSERVATORY"), 22, 3, 6, -15.4, rgb(30, 40, 70), rgb(255, 255, 255), false)
end

BuildingBuilder.Styles = Styles

-- ===================== İNŞA =====================
function BuildingBuilder.Build(kit, world: Instance)
	local data = MapDefinitions.GetData()
	local buildings = kit:Folder(world, "Buildings")
	local districtFolders = {}
	local built, failed = 0, 0

	for _, lot in data.Lots do
		local styleFn = Styles[lot.Style]
		if not styleFn then
			warn("[WorldGen] Bilinmeyen bina stili:", lot.Style)
			failed += 1
			continue
		end
		local folder = districtFolders[lot.District]
		if not folder then
			folder = kit:Folder(buildings, lot.District)
			districtFolders[lot.District] = folder
		end
		local model = Instance.new("Model")
		model.Name = string.format("%s_%d", lot.Style, lot.Id)
		model:SetAttribute("LotId", lot.Id)
		model:SetAttribute("Style", lot.Style)
		if lot.PoiId then
			model:SetAttribute("PoiId", lot.PoiId)
		end
		local ctx: Ctx = {
			Kit = kit,
			Model = model,
			Base = CFrame.new(lot.Center.X, lot.BaseY, lot.Center.Z) * CFrame.Angles(0, math.rad(lot.Rotation), 0),
			W = lot.Width,
			D = lot.Depth,
			H = lot.Height,
			Rng = Random.new(lot.Seed),
			Lot = lot,
			Poi = if lot.PoiId then data.POIById[lot.PoiId] else nil,
		}
		local ok, err = pcall(styleFn, ctx)
		if ok then
			built += 1
			model.Parent = folder
		else
			failed += 1
			warn("[WorldGen] Bina üretilemedi:", lot.Style, lot.Id, err)
			model:Destroy()
		end
	end
	return built, failed
end

return BuildingBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties>
<string name="Name">Kit</string>

<ProtectedString name="Source"><![CDATA[-- Kit: dünya inşası için parça fabrikası.
-- Tüm parçalar buradan geçer → sayım, periyodik bekleme (sunucu donmaz) ve tutarlı varsayılanlar.

local CollectionService = game:GetService("CollectionService")

local Kit = {}
Kit.__index = Kit

export type Kit = typeof(setmetatable({} :: { Count: number, YieldEvery: number }, Kit))

local CYL_ROT = CFrame.Angles(0, 0, math.pi / 2) -- silindir ekseni X → Y

function Kit.new(yieldEvery: number?): Kit
	return setmetatable({ Count = 0, YieldEvery = yieldEvery or 0 }, Kit)
end

function Kit._tick(self: Kit)
	self.Count += 1
	if self.YieldEvery > 0 and self.Count % self.YieldEvery == 0 then
		task.wait()
	end
end

local function finish(part: BasePart, color: Color3, material: Enum.Material?, props: { [string]: any }?)
	part.Anchored = true
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanTouch = false -- dekor parçaları Touched olayı üretmesin (performans)
	if props then
		for key, value in props do
			(part :: any)[key] = value
		end
	end
end

-- Dikdörtgen parça
function Kit.Box(self: Kit, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cframe
	finish(p, color, material, props)
	p.Parent = parent
	self:_tick()
	return p
end

-- Dik silindir: cframe silindirin MERKEZİ, ekseni dünya Y yönünde
function Kit.Cylinder(self: Kit, parent: Instance, height: number, diameter: number, cframe: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cframe * CYL_ROT
	finish(p, color, material, props)
	p.Parent = parent
	self:_tick()
	return p
end

function Kit.Ball(self: Kit, parent: Instance, diameter: number, cframe: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = cframe
	finish(p, color, material, props)
	p.Parent = parent
	self:_tick()
	return p
end

-- Kama: eğimli yüz -Z (ön) ve yukarı bakar; dik yüz +Z (arka) tarafında
function Kit.Wedge(self: Kit, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cframe
	finish(p, color, material, props)
	p.Parent = parent
	self:_tick()
	return p
end

-- Bir parçanın yüzüne yazı (tabela). Metin çok uzunsa otomatik küçülür.
function Kit.Label(self: Kit, part: BasePart, face: Enum.NormalId, text: string, textColor: Color3?, glow: boolean?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = if glow then 0 else 1
	gui.MaxDistance = 600 -- uzaktan çizilmez (performans)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.12, 0)
	pad.PaddingBottom = UDim.new(0.12, 0)
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.Parent = label
	label.Parent = gui
	gui.Parent = part
	return gui
end

function Kit.Folder(_self: Kit, parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.Model(_self: Kit, parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Kit.Tag(_self: Kit, instance: Instance, tag: string)
	CollectionService:AddTag(instance, tag)
end

-- İki üst-yüzey noktası arasında eğimli "şerit" (yol, kaldırım, çizgi) üretmek için CFrame.
-- Döndürülen CFrame parçanın MERKEZİ; parçanın üst yüzü a→b doğrusu üzerinde olur.
function Kit.StripCFrame(a: Vector3, b: Vector3, thickness: number, lateral: number?): (CFrame, number)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf
	if length < 1e-3 then
		cf = CFrame.new(mid)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return cf * CFrame.new(lateral or 0, -thickness / 2, 0), length
end

Kit.Colors = table.freeze({
	Asphalt = Color3.fromRGB(58, 60, 64),
	AsphaltLight = Color3.fromRGB(74, 76, 80),
	Sidewalk = Color3.fromRGB(196, 192, 184),
	Curb = Color3.fromRGB(170, 166, 160),
	LineWhite = Color3.fromRGB(236, 236, 230),
	LineYellow = Color3.fromRGB(242, 196, 60),
	Concrete = Color3.fromRGB(176, 172, 164),
	Barrier = Color3.fromRGB(190, 186, 178),
	Grass = Color3.fromRGB(104, 146, 82),
	GrassDark = Color3.fromRGB(78, 118, 64),
	Dirt = Color3.fromRGB(140, 110, 76),
	Sand = Color3.fromRGB(226, 206, 156),
	Wood = Color3.fromRGB(122, 86, 56),
	Leaf = Color3.fromRGB(76, 128, 62),
	Pine = Color3.fromRGB(52, 96, 58),
	Metal = Color3.fromRGB(120, 124, 130),
	Glass = Color3.fromRGB(110, 150, 170),
	SignGreen = Color3.fromRGB(28, 104, 62),
	Accent = Color3.fromRGB(255, 122, 69),
	Teal = Color3.fromRGB(64, 196, 214),
})

return Kit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties>
<string name="Name">LandBuilder</string>

<ProtectedString name="Source"><![CDATA[-- LandBuilder: zemin karoları, bloklar, su (Terrain), tepeler, kumsal, rıhtım duvarları, harita sınırı.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapDefinitions = require(ReplicatedStorage.Shared.MapDefinitions)

local LandBuilder = {}

local WATER_TOP = -1.5
local WATER_BOTTOM = -14
local BED_BOTTOM = -26

local BLOCK_MATERIAL = {
	Concrete = { Enum.Material.Concrete, Color3.fromRGB(184, 180, 172) },
	Pavement = { Enum.Material.Pavement, Color3.fromRGB(206, 196, 178) },
	Grass = { Enum.Material.Grass, Color3.fromRGB(106, 150, 84) },
	Asphalt = { Enum.Material.Asphalt, Color3.fromRGB(110, 108, 104) },
}

local function fillTerrainRect(terrain: Terrain, x0: number, z0: number, x1: number, z1: number, yBottom: number, yTop: number, material: Enum.Material, doYield: boolean)
	-- FillBlock büyük bölgeleri tek çağrıda doldurabilir ama 2048'lik parçalara bölmek daha güvenli
	local step = 1024
	local x = x0
	while x < x1 do
		local xe = math.min(x + step, x1)
		local z = z0
		while z < z1 do
			local ze = math.min(z + step, z1)
			local size = Vector3.new(xe - x, yTop - yBottom, ze - z)
			local center = Vector3.new((x + xe) / 2, (yBottom + yTop) / 2, (z + ze) / 2)
			terrain:FillBlock(CFrame.new(center), size, material)
			z = ze
		end
		x = xe
		if doYield then
			task.wait()
		end
	end
end

-- Su türüne göre derinlik ve taban: açık deniz tabansız (koyu mavi derinlik), göl/nehir çamur tabanlı
local WATER_SPEC = {
	sea = { Bottom = -13.5, Bed = nil },
	bay = { Bottom = -13.5, Bed = Enum.Material.Sand },
	river = { Bottom = -13.5, Bed = Enum.Material.Mud },
	lake = { Bottom = -17.5, Bed = Enum.Material.Mud },
	pond = { Bottom = -5.5, Bed = Enum.Material.Mud },
}

function LandBuilder.BuildTerrain(kit, _world: Instance)
	local data = MapDefinitions.GetData()
	local terrain = workspace.Terrain
	local doYield = kit.YieldEvery > 0
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(104, 146, 82))
	terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(226, 206, 156))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(128, 120, 110))
	terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(86, 74, 56))
	terrain.WaterColor = Color3.fromRGB(36, 120, 150)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8

	for _, w in data.Water do
		local spec = WATER_SPEC[w.Kind] or WATER_SPEC.sea
		if spec.Bed then
			fillTerrainRect(terrain, w.X0, w.Z0, w.X1, w.Z1, spec.Bottom - 8, spec.Bottom, spec.Bed, doYield)
		end
		fillTerrainRect(terrain, w.X0, w.Z0, w.X1, w.Z1, spec.Bottom, WATER_TOP, Enum.Material.Water, doYield)
	end

	for index, h in data.Hills do
		local material = if h.Radius > 120 then Enum.Material.Rock else Enum.Material.Grass
		terrain:FillBall(Vector3.new(h.X, h.CenterY, h.Z), h.Radius, material)
		-- Büyük kayalık tepelerin üstünü çimle kapla (doğal görünüm)
		if material == Enum.Material.Rock then
			terrain:FillBall(Vector3.new(h.X, h.CenterY + h.Radius * 0.35, h.Z), h.Radius * 0.62, Enum.Material.Grass)
		end
		if doYield and index % 6 == 0 then
			task.wait()
		end
	end
end

function LandBuilder.BuildGround(kit, world: Instance)
	local data = MapDefinitions.GetData()
	local meta = data.Meta
	local folder = kit:Folder(world, "Ground")

	for _, g in data.Ground do
		local size = Vector3.new(g.X1 - g.X0, 4, g.Z1 - g.Z0)
		kit:Box(folder, size, CFrame.new((g.X0 + g.X1) / 2, -2, (g.Z0 + g.Z1) / 2), Color3.fromRGB(104, 146, 82), Enum.Material.Grass, { CastShadow = false })
	end

	-- Bloklar (kaldırımla aynı yükseklikte arsa zemini)
	local blocksFolder = kit:Folder(world, "Blocks")
	for _, b in data.Blocks do
		local spec = BLOCK_MATERIAL[b.Material] or BLOCK_MATERIAL.Concrete
		local h = meta.BlockTop
		kit:Box(blocksFolder, Vector3.new(b.X1 - b.X0, h, b.Z1 - b.Z0), CFrame.new((b.X0 + b.X1) / 2, h / 2, (b.Z0 + b.Z1) / 2), spec[2], spec[1], { CastShadow = false })
	end
end

-- Uzun bir dikdörtgeni en fazla `step` uzunluğunda parçalara böler (Roblox parça sınırı 2048)
local function splitRect(x0: number, z0: number, x1: number, z1: number, step: number)
	local pieces = {}
	if x1 - x0 >= z1 - z0 then
		local x = x0
		while x < x1 do
			local xe = math.min(x + step, x1)
			table.insert(pieces, { x, z0, xe, z1 })
			x = xe
		end
	else
		local z = z0
		while z < z1 do
			local ze = math.min(z + step, z1)
			table.insert(pieces, { x0, z, x1, ze })
			z = ze
		end
	end
	return pieces
end

local BEACH_DROP = 6.3
local BEACH_YAW = { E = -90, W = 90, N = 0, S = 180 }

function LandBuilder.BuildCoast(kit, world: Instance)
	local data = MapDefinitions.GetData()
	local meta = data.Meta
	local h = meta.HalfSize
	local folder = kit:Folder(world, "Coast")
	local wallColor = Color3.fromRGB(150, 146, 138)

	for _, c in data.Coast do
		if c.Kind == "beach" then
			-- Kama: dik yüzü karaya, eğimi suya bakar
			local alongZ = c.Dir == "E" or c.Dir == "W"
			for _, r in splitRect(c.X0, c.Z0, c.X1, c.Z1, 400) do
				local sx, sz = r[3] - r[1], r[4] - r[2]
				local size = if alongZ then Vector3.new(sz, BEACH_DROP, sx) else Vector3.new(sx, BEACH_DROP, sz)
				local cf = CFrame.new((r[1] + r[3]) / 2, meta.RoadTop - BEACH_DROP / 2, (r[2] + r[4]) / 2) * CFrame.Angles(0, math.rad(BEACH_YAW[c.Dir] or -90), 0)
				kit:Wedge(folder, size, cf, Color3.fromRGB(226, 206, 156), Enum.Material.Sand, { CastShadow = false })
			end
		elseif c.Kind == "boardwalk" then
			for _, r in splitRect(c.X0, c.Z0, c.X1, c.Z1, 1800) do
				kit:Box(folder, Vector3.new(r[3] - r[1], 0.8, r[4] - r[2]), CFrame.new((r[1] + r[3]) / 2, 0.4, (r[2] + r[4]) / 2), Color3.fromRGB(150, 112, 76), Enum.Material.WoodPlanks)
			end
		elseif c.Kind == "seawall" then
			for _, r in splitRect(c.X0, c.Z0, c.X1, c.Z1, 1800) do
				kit:Box(folder, Vector3.new(r[3] - r[1], 12, r[4] - r[2]), CFrame.new((r[1] + r[3]) / 2, -5.2, (r[2] + r[4]) / 2), wallColor, Enum.Material.Concrete)
			end
		elseif c.Kind == "bank" then
			for _, r in splitRect(c.X0, c.Z0, c.X1, c.Z1, 1800) do
				kit:Box(folder, Vector3.new(r[3] - r[1], 6.4, r[4] - r[2]), CFrame.new((r[1] + r[3]) / 2, -3, (r[2] + r[4]) / 2), Color3.fromRGB(96, 82, 60), Enum.Material.Mud, { CastShadow = false })
			end
		end
	end

	-- Harita sınırı (görünmez duvarlar). Kuzey/batı/güneyde sırtlar, doğuda açık deniz.
	local bounds = kit:Folder(world, "Boundary")
	local thickness, height = 10, 600
	local function wall(x0: number, z0: number, x1: number, z1: number)
		for _, r in splitRect(x0, z0, x1, z1, 2000) do
			kit:Box(bounds, Vector3.new(r[3] - r[1], height, r[4] - r[2]), CFrame.new((r[1] + r[3]) / 2, height / 2 - 40, (r[2] + r[4]) / 2),
				Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Transparency = 1, CanQuery = false, CastShadow = false })
		end
	end
	wall(-h, -h - thickness, h, -h)
	wall(-h, h, h, h + thickness)
	wall(-h - thickness, -h, -h, h)
	wall(h, -h, h + thickness, h)
end

return LandBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties>
<string name="Name">PropBuilder</string>

<ProtectedString name="Source"><![CDATA[-- PropBuilder: sokak lambaları, ağaçlar, banklar, otobüs durakları, park metreleri, çeşme,
-- oyun parkı, palmiyeler, cankurtaran kuleleri, iskeleler, liman vinçleri, otoyol ayakları ve tabelaları.
-- Konumlar mapgen.py'de yol/arsa/su çakışmasına karşı doğrulanmıştır.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapDefinitions = require(ReplicatedStorage.Shared.MapDefinitions)
local Config = require(ReplicatedStorage.Shared.Config)

local PropBuilder = {}

local M = Enum.Material
local rgb = Color3.fromRGB

local LAMP_OFF = rgb(170, 170, 160)

local Props = {}

function Props.lamp(kit, folder, cf: CFrame, p, index: number)
	local C = kit.Colors
	kit:Cylinder(folder, 18, 0.7, cf * CFrame.new(0, 9, 0), rgb(60, 62, 66), M.Metal, { CastShadow = false })
	-- kol: yola doğru (-Z) uzanır, ucunda lamba başlığı
	local head = kit:Box(folder, Vector3.new(1.4, 0.6, 7), cf * CFrame.new(0, 18, -3.2), LAMP_OFF, M.SmoothPlastic, { CastShadow = false })
	head.Name = "LampHead"
	if index % Config.World.LampLightEvery == 0 then
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 36
		light.Angle = 110
		light.Brightness = 2.2
		light.Color = rgb(255, 214, 160)
		light.Shadows = false
		light.Enabled = false
		light.Parent = head
	end
	kit:Tag(head, "StreetLamp") -- ışık eklendikten SONRA etiketle (WeatherService anında açabilsin)
	local _ = C
end

function Props.tree(kit, folder, cf: CFrame, p)
	local rng = Random.new(math.floor(p.X * 7 + p.Z * 13))
	if p.Extra == "pine" then
		local h = rng:NextNumber(14, 22)
		kit:Cylinder(folder, h * 0.4, 1.4, cf * CFrame.new(0, h * 0.2, 0), rgb(96, 70, 48), M.Wood, { CastShadow = false })
		kit:Cylinder(folder, h * 0.45, h * 0.55, cf * CFrame.new(0, h * 0.5, 0), kit.Colors.Pine, M.Grass)
		kit:Cylinder(folder, h * 0.35, h * 0.32, cf * CFrame.new(0, h * 0.82, 0), kit.Colors.Pine, M.Grass)
	else
		local h = rng:NextNumber(8, 12)
		kit:Cylinder(folder, h, 1.6, cf * CFrame.new(0, h / 2, 0), rgb(110, 80, 54), M.Wood, { CastShadow = false })
		local green = kit.Colors.Leaf:Lerp(rgb(120, 150, 60), rng:NextNumber(0, 0.4))
		kit:Ball(folder, rng:NextNumber(11, 17), cf * CFrame.new(0, h + 3, 0), green, M.Grass)
	end
end

function Props.palm(kit, folder, cf: CFrame, p)
	local rng = Random.new(math.floor(p.Z * 3))
	local h = rng:NextNumber(18, 26)
	local lean = math.rad(rng:NextNumber(4, 10))
	local trunk = cf * CFrame.Angles(lean, 0, 0)
	kit:Cylinder(folder, h, 1.3, trunk * CFrame.new(0, h / 2, 0), rgb(150, 116, 80), M.Wood, { CastShadow = false })
	local top = trunk * CFrame.new(0, h, 0)
	for k = 0, 4 do
		local a = k * (2 * math.pi / 5)
		kit:Box(folder, Vector3.new(1.8, 0.3, 11), top * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-18), 0, 0) * CFrame.new(0, -1, -5), rgb(70, 140, 60), M.Grass, { CastShadow = false })
	end
end

function Props.bench(kit, folder, cf: CFrame)
	kit:Box(folder, Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.8, 0), kit.Colors.Wood, M.WoodPlanks, { CastShadow = false })
	kit:Box(folder, Vector3.new(6, 2, 0.4), cf * CFrame.new(0, 3, 0.8), kit.Colors.Wood, M.WoodPlanks, { CastShadow = false })
	kit:Box(folder, Vector3.new(5, 1.6, 1.2), cf * CFrame.new(0, 0.8, 0), rgb(60, 62, 66), M.Metal, { CastShadow = false })
end

function Props.trash(kit, folder, cf: CFrame)
	kit:Cylinder(folder, 3.2, 2, cf * CFrame.new(0, 1.6, 0), rgb(46, 90, 60), M.Metal, { CastShadow = false })
end

function Props.meter(kit, folder, cf: CFrame)
	kit:Cylinder(folder, 3.4, 0.3, cf * CFrame.new(0, 1.7, 0), rgb(80, 80, 84), M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(0.7, 1.1, 0.5), cf * CFrame.new(0, 3.8, 0), rgb(60, 70, 90), M.Metal, { CastShadow = false })
end

function Props.busstop(kit, folder, cf: CFrame)
	local glass = rgb(160, 200, 220)
	kit:Box(folder, Vector3.new(12, 0.5, 5), cf * CFrame.new(0, 8.5, 0.5), rgb(60, 62, 66), M.Metal)
	kit:Box(folder, Vector3.new(12, 7.5, 0.3), cf * CFrame.new(0, 4.6, 2.8), glass, M.Glass, { Transparency = 0.4, CastShadow = false })
	kit:Box(folder, Vector3.new(0.5, 8, 0.5), cf * CFrame.new(-5.8, 4.4, -1.5), rgb(60, 62, 66), M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(0.5, 8, 0.5), cf * CFrame.new(5.8, 4.4, -1.5), rgb(60, 62, 66), M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(8, 0.5, 1.6), cf * CFrame.new(0, 1.8, 2), kit.Colors.Wood, M.WoodPlanks, { CastShadow = false })
	local sign = kit:Box(folder, Vector3.new(2.4, 2.4, 0.3), cf * CFrame.new(7.5, 8, -1.5), rgb(30, 90, 180), M.SmoothPlastic, { CastShadow = false })
	kit:Label(sign, Enum.NormalId.Front, "BUS", rgb(255, 255, 255), false)
	kit:Cylinder(folder, 7, 0.3, cf * CFrame.new(7.5, 3.5, -1.5), rgb(60, 62, 66), M.Metal, { CastShadow = false })
end

function Props.fountain(kit, folder, cf: CFrame)
	kit:Cylinder(folder, 2, 26, cf * CFrame.new(0, 1, 0), rgb(200, 196, 188), M.Marble)
	kit:Cylinder(folder, 0.3, 24, cf * CFrame.new(0, 1.9, 0), rgb(80, 160, 200), M.Glass, { Transparency = 0.3, CastShadow = false })
	kit:Cylinder(folder, 8, 3, cf * CFrame.new(0, 4, 0), rgb(200, 196, 188), M.Marble)
	kit:Cylinder(folder, 1, 9, cf * CFrame.new(0, 8, 0), rgb(200, 196, 188), M.Marble)
	local spray = kit:Box(folder, Vector3.new(1, 1, 1), cf * CFrame.new(0, 8.8, 0), rgb(200, 230, 255), M.Glass, { Transparency = 1, CanCollide = false, CanQuery = false })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 30
	emitter.Lifetime = NumberRange.new(1, 1.4)
	emitter.Speed = NumberRange.new(10, 12)
	emitter.SpreadAngle = Vector2.new(12, 12)
	emitter.Acceleration = Vector3.new(0, -24, 0)
	emitter.Size = NumberSequence.new(0.6, 0.2)
	emitter.Transparency = NumberSequence.new(0.3, 1)
	emitter.Color = ColorSequence.new(rgb(220, 240, 255))
	emitter.Parent = spray
end

function Props.playground(kit, folder, cf: CFrame)
	local red, blue, yellow = rgb(220, 70, 60), rgb(60, 120, 210), rgb(250, 200, 50)
	local base = cf * CFrame.new(30, 0, 30)
	kit:Box(folder, Vector3.new(24, 0.2, 20), base * CFrame.new(0, 0.1, 0), rgb(200, 160, 110), M.Sand, { CastShadow = false })
	kit:Box(folder, Vector3.new(6, 0.6, 6), base * CFrame.new(-6, 5, 0), blue, M.SmoothPlastic)
	for _, o in { Vector3.new(-8.5, 0, -2.5), Vector3.new(-3.5, 0, -2.5), Vector3.new(-8.5, 0, 2.5), Vector3.new(-3.5, 0, 2.5) } do
		kit:Box(folder, Vector3.new(0.6, 5, 0.6), base * CFrame.new(o + Vector3.new(0, 2.5, 0)), yellow, M.SmoothPlastic, { CastShadow = false })
	end
	kit:Wedge(folder, Vector3.new(3, 5, 9), base * CFrame.new(1.5, 2.5, 0) * CFrame.Angles(0, math.rad(-90), 0), red, M.SmoothPlastic)
	kit:Box(folder, Vector3.new(10, 0.5, 0.5), base * CFrame.new(5, 7, -7), blue, M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(0.5, 7, 0.5), base * CFrame.new(0.2, 3.5, -7), blue, M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(0.5, 7, 0.5), base * CFrame.new(9.8, 3.5, -7), blue, M.Metal, { CastShadow = false })
end

function Props.lifeguard(kit, folder, cf: CFrame)
	kit:Box(folder, Vector3.new(5, 6, 5), cf * CFrame.new(0, 3, 0), rgb(250, 250, 250), M.WoodPlanks, { Transparency = 0, CastShadow = false })
	kit:Box(folder, Vector3.new(6, 5, 6), cf * CFrame.new(0, 8.5, 0), rgb(240, 80, 70), M.WoodPlanks)
	kit:Box(folder, Vector3.new(7, 0.6, 7), cf * CFrame.new(0, 11.3, 0), rgb(250, 250, 250), M.WoodPlanks)
	kit:Wedge(folder, Vector3.new(2, 6, 5), cf * CFrame.new(0, 3, -5), rgb(220, 210, 190), M.WoodPlanks)
end

function Props.pier(kit, folder, _cf: CFrame, p)
	local length = tonumber(p.Extra) or 100
	local meta = MapDefinitions.GetMeta()
	local z0 = meta.BayZ
	local cf = CFrame.new(p.X, 0.4, z0 + length / 2)
	kit:Box(folder, Vector3.new(8, 0.8, length), cf, rgb(150, 112, 76), M.WoodPlanks)
	for k = 0, math.floor(length / 20) do
		local z = z0 + k * 20
		kit:Cylinder(folder, 16, 1.2, CFrame.new(p.X - 4, -7, z), rgb(110, 84, 60), M.Wood, { CastShadow = false })
		kit:Cylinder(folder, 16, 1.2, CFrame.new(p.X + 4, -7, z), rgb(110, 84, 60), M.Wood, { CastShadow = false })
	end
end

function Props.crane(kit, folder, cf: CFrame)
	local color = rgb(60, 140, 200)
	for _, z in { -10, 10 } do
		kit:Box(folder, Vector3.new(2, 50, 2), cf * CFrame.new(-10, 25, z), color, M.Metal)
		kit:Box(folder, Vector3.new(2, 50, 2), cf * CFrame.new(10, 25, z), color, M.Metal)
	end
	kit:Box(folder, Vector3.new(24, 4, 24), cf * CFrame.new(0, 50, 0), color, M.Metal)
	-- bom: suya doğru (-Z yerel = yaw'a göre)
	kit:Box(folder, Vector3.new(3, 3, 70), cf * CFrame.new(0, 54, -30), color, M.Metal)
	kit:Box(folder, Vector3.new(6, 5, 6), cf * CFrame.new(0, 47, -16), rgb(240, 240, 240), M.SmoothPlastic)
end

function Props.pillar(kit, folder, cf: CFrame, p)
	local h = tonumber(p.Extra) or 16
	local w = tonumber(p.Extra2) or 54
	kit:Box(folder, Vector3.new(5, h, 5), cf * CFrame.new(0, h / 2, 0), kit.Colors.Concrete, M.Concrete)
	kit:Box(folder, Vector3.new(w * 0.7, 2, 5), cf * CFrame.new(0, h - 1, 0) * CFrame.Angles(0, math.rad(90), 0), kit.Colors.Concrete, M.Concrete)
end

function Props.fwysign(kit, folder, cf: CFrame, p)
	local green = kit.Colors.SignGreen
	-- Yükseltilmiş otoyolun dışında yerden yükselen direkler; tabela bariyerin üstünde kalır
	kit:Box(folder, Vector3.new(1, 30, 1), cf * CFrame.new(-6, 15, 0), rgb(150, 150, 150), M.Metal, { CastShadow = false })
	kit:Box(folder, Vector3.new(1, 30, 1), cf * CFrame.new(6, 15, 0), rgb(150, 150, 150), M.Metal, { CastShadow = false })
	local board = kit:Box(folder, Vector3.new(16, 5, 0.5), cf * CFrame.new(0, 28, 0), green, M.SmoothPlastic)
	kit:Label(board, Enum.NormalId.Front, p.Extra, rgb(255, 255, 255), false)
	kit:Label(board, Enum.NormalId.Back, p.Extra, rgb(255, 255, 255), false)
end

PropBuilder.Props = Props

function PropBuilder.Build(kit, world: Instance)
	local data = MapDefinitions.GetData()
	local folder = kit:Folder(world, "Props")
	local sub = {}
	local lampIndex = 0
	local failures = 0
	for _, p in data.Props do
		local fn = Props[p.Kind]
		if not fn then
			continue
		end
		local target = sub[p.Kind]
		if not target then
			target = kit:Folder(folder, p.Kind)
			sub[p.Kind] = target
		end
		local y = p.Y -- taban yüksekliği mapgen.py tarafından hesaplandı (kaldırım 0.8, zemin 0)
		local cf = CFrame.new(p.X, y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
		if p.Kind == "lamp" then
			lampIndex += 1
		end
		local ok, err = pcall(fn, kit, target, cf, p, lampIndex)
		if not ok then
			failures += 1
			if failures <= 5 then
				warn("[WorldGen] Dekor hatası:", p.Kind, err)
			end
		end
	end
	return failures
end

return PropBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties>
<string name="Name">RoadBuilder</string>

<ProtectedString name="Source"><![CDATA[-- RoadBuilder: yol yüzeyleri, kavşak platformları, kaldırımlar, şerit çizgileri, yaya geçitleri,
-- otoyol bariyerleri ve köprüler. Tüm geometri MapDefinitions'taki yol grafiğinden türetilir;
-- trafik/GPS sistemleri (Aşama 4/9) aynı düğüm ve kenarları kullanır.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapDefinitions = require(ReplicatedStorage.Shared.MapDefinitions)

local RoadBuilder = {}

local LINE_T = 0.06
local LINE_LIFT = 0.03
-- Şerit çizgileri ve yaya geçidi şeritleri yolun 0.03 üstünde: sadece görsel, ÇARPIŞMAZ (araç fizik kararlılığı:
-- çarpışmalı oldukları için teker her çizgide küçük bir basamağa çarpıyor, hız arttıkça araç titriyordu)

type Adj = { Edge: any, Dir: Vector2, Width: number, Sidewalk: boolean, Ramp: boolean }

local function flatDir(from: Vector3, to: Vector3): Vector2
	local d = Vector2.new(to.X - from.X, to.Z - from.Z)
	if d.Magnitude < 1e-6 then
		return Vector2.new(1, 0)
	end
	return d.Unit
end

local function axisOf(dir: Vector2): string?
	if dir.X > 0.99 then
		return "E"
	elseif dir.X < -0.99 then
		return "W"
	elseif dir.Y > 0.99 then
		return "S"
	elseif dir.Y < -0.99 then
		return "N"
	end
	return nil
end

-- Her (kenar, düğüm) çifti için yol ve kaldırım kırpma mesafeleri + kavşak geometrisi
local function planNodes(data)
	local roadTrim: { [number]: { [number]: number } } = {}
	local walkTrim: { [number]: { [number]: number } } = {}
	local pads = {} -- { Position, SizeX, SizeZ, Dir (Vector2?), Thickness, Disc, Sidewalk = {...} }
	-- Araç fizik kararlılığı: kırpılan yol ucunun bağlandığı yüzey. "pad" = düz platform (uç platform yüksekliğinde
	-- biter), "deck" = otoyol tabliyesine yandan bağlanan rampa (EdgeDist: rampa ekseninde tabliye kenarına uzaklık)
	local joins: { [number]: { [number]: { Kind: string, EdgeDist: number? } } } = {}
	local function setJoin(edgeId: number, nodeId: number, join)
		joins[edgeId] = joins[edgeId] or {}
		joins[edgeId][nodeId] = join
	end
	local function setTrim(edgeId: number, nodeId: number, road: number, walk: number)
		roadTrim[edgeId] = roadTrim[edgeId] or {}
		walkTrim[edgeId] = walkTrim[edgeId] or {}
		roadTrim[edgeId][nodeId] = road
		walkTrim[edgeId][nodeId] = walk
	end

	local sidewalkW = data.Meta.Sidewalk
	for _, node in data.NodeList do
		local adj: { Adj } = {}
		for _, edgeId in node.Edges do
			local e = data.Edges[edgeId]
			local otherId = if e.A == node.Id then e.B else e.A
			local other = data.Nodes[otherId]
			table.insert(adj, {
				Edge = e,
				Dir = flatDir(node.Position, other.Position),
				Width = e.Width,
				Sidewalk = e.Sidewalk,
				Ramp = e.Kind == "ramp",
			})
		end
		local elevated = node.Position.Y > 2
		local thickness = if elevated then 2 else 1
		local allAxis = true
		for _, a in adj do
			if not axisOf(a.Dir) then
				allAxis = false
				break
			end
		end

		if #adj <= 1 then
			continue
		end

		if allAxis then
			local w = { E = 0, W = 0, N = 0, S = 0 }
			local anyWalk = false
			for _, a in adj do
				local ax = axisOf(a.Dir) :: string
				w[ax] = math.max(w[ax], a.Width)
				anyWalk = anyWalk or a.Sidewalk
			end
			local collinear = #adj == 2 and ((w.E > 0 and w.W > 0) or (w.N > 0 and w.S > 0))
			if collinear then
				continue -- düz devam: kırpma yok, platform yok
			end
			local wNS = math.max(w.N, w.S)
			local wEW = math.max(w.E, w.W)
			local sx = if wNS > 0 then wNS else wEW
			local sz = if wEW > 0 then wEW else wNS
			for _, a in adj do
				local ax = axisOf(a.Dir)
				local half = if ax == "E" or ax == "W" then sx / 2 else sz / 2
				setTrim(a.Edge.Id, node.Id, half, half + (if anyWalk then sidewalkW else 0))
				setJoin(a.Edge.Id, node.Id, { Kind = "pad" })
			end
			table.insert(pads, {
				Position = node.Position, SizeX = sx, SizeZ = sz, Dir = nil, Thickness = thickness,
				Disc = false, Walk = anyWalk, Open = { E = w.E > 0, W = w.W > 0, N = w.N > 0, S = w.S > 0 },
				Crosswalk = node.Crosswalk, Adj = adj,
			})
		else
			local mains, ramps = {}, {}
			for _, a in adj do
				table.insert(if a.Ramp then ramps else mains, a)
			end
			local maxW = 0
			for _, a in mains do
				maxW = math.max(maxW, a.Width)
			end
			if #mains == 2 and mains[1].Dir:Dot(mains[2].Dir) < -0.98 then
				-- Düz ana yol + yan rampalar: rampa kenarı otoyol tabliyesinin kenarından başlar
				local mainDir = mains[1].Dir
				for _, r in ramps do
					local t = if elevated then maxW / 2 - 4 else maxW / 2
					setTrim(r.Edge.Id, node.Id, t, t)
					-- rampa ekseninin tabliye kenarını kestiği uzaklık (açılı bağlantı)
					-- (rampanın en uzak kenarının tabliye kenarını kestiği yer: ana parça her şerit konumunda tabliyenin dışında başlar)
					local sinA = math.max(math.abs(mainDir.X * r.Dir.Y - mainDir.Y * r.Dir.X), 0.3)
					local cosA = math.abs(mainDir:Dot(r.Dir))
					setJoin(r.Edge.Id, node.Id, { Kind = "deck", EdgeDist = (maxW / 2) / sinA + (r.Width / 2) * cosA / sinA })
				end
			elseif #mains == 2 and #ramps == 0 then
				-- Açılı dönüş (otoyol köşesi): disk dolgu
				local light = false
				for _, a in mains do
					light = light or a.Edge.Kind == "freeway" or a.Edge.Kind == "ramp"
				end
				table.insert(pads, { Position = node.Position, SizeX = maxW, SizeZ = maxW, Thickness = thickness, Disc = true, Light = light })
			else
				local dir = if #mains > 0 then mains[1].Dir else adj[1].Dir
				local size = math.max(maxW, 16)
				local perp = Vector2.new(-dir.Y, dir.X)
				for _, a in adj do
					setTrim(a.Edge.Id, node.Id, size / 2, size / 2)
					-- yönlü kare platforma açılı giren yolun ekseni platform kenarını daha uzakta keser
					local c1, c2 = math.abs(a.Dir:Dot(dir)), math.abs(a.Dir:Dot(perp))
					local along, across = math.max(c1, c2, 0.3), math.min(c1, c2)
					setJoin(a.Edge.Id, node.Id, { Kind = "pad", EdgeDist = (size / 2) / along + (a.Width / 2) * across / along })
				end
				table.insert(pads, { Position = node.Position, SizeX = size, SizeZ = size, Dir = dir, Thickness = thickness, Disc = false })
			end
		end
	end
	return roadTrim, walkTrim, pads, joins
end

local function trimmedEnds(data, e, trims): (Vector3, Vector3)
	local a = data.Nodes[e.A].Position
	local b = data.Nodes[e.B].Position
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local len = flat.Magnitude
	if len < 1e-3 then
		return a, b
	end
	local ta = trims and trims[e.A] or 0
	local tb = trims and trims[e.B] or 0
	local fa = math.clamp(ta / len, 0, 0.49)
	local fb = math.clamp(tb / len, 0, 0.49)
	return a:Lerp(b, fa), a:Lerp(b, 1 - fb)
end

function RoadBuilder.Build(kit, world: Instance)
	local data = MapDefinitions.GetData()
	local meta = data.Meta
	local C = kit.Colors
	local roads = kit:Folder(world, "Roads")
	local surfaces = kit:Folder(roads, "Surfaces")
	local markings = kit:Folder(roads, "Markings")
	local sidewalksFolder = kit:Folder(world, "Sidewalks")
	local junctions = kit:Folder(roads, "Intersections")
	local sw = meta.Sidewalk
	local lift = Vector3.new(0, LINE_LIFT, 0)

	local roadTrim, walkTrim, pads, joins = planNodes(data)

	local function strip(parent: Instance, a: Vector3, b: Vector3, width: number, thickness: number, lateral: number, color: Color3, material: Enum.Material, props)
		local cf, length = kit.StripCFrame(a, b, thickness, lateral)
		if length < 0.3 then
			return nil
		end
		return kit:Box(parent, Vector3.new(width, thickness, length), cf, color, material, props)
	end

	-- ===== Yol kenarları =====
	for _, e in data.EdgeList do
		local a, b = trimmedEnds(data, e, roadTrim[e.Id])
		local elevated = math.min(a.Y, b.Y) > 2
		local sloped = math.abs(a.Y - b.Y) > 0.5
		local thickness = if elevated then 2 elseif sloped then 1.5 else 1
		local surfaceColor = if e.Kind == "freeway" or e.Kind == "ramp" then C.AsphaltLight else C.Asphalt
		-- Araç fizik kararlılığı: eğimli yol kırpılıp düz platforma/tabliyeye bağlanırken ucu kendi eğimiyle alçalıyor,
		-- birleşimde 0.2–1.3 studluk basamak kalıyordu (teker hızla çarpıyordu). Uç, bağlandığı yüzeyin yüksekliğinde
		-- biter. Rampa otoyol tabliyesine açılı girdiği için: ana parça tabliye kenarında tabliye yüksekliğinde biter,
		-- tabliyenin altına uzanan kısım tabliyenin 0.02 altında düz bir dolgu olur (kenarda boşluk ve çıkıntı yok).
		local fillers = {}
		local join = joins[e.Id]
		if join then
			for nodeId, j in join do
				local nodePos = data.Nodes[nodeId].Position
				local atA = nodeId == e.A
				local endPt = if atA then a else b
				local farPt = if atA then b else a
				local flat = Vector3.new(farPt.X - nodePos.X, 0, farPt.Z - nodePos.Z)
				local trimDist = Vector3.new(endPt.X - nodePos.X, 0, endPt.Z - nodePos.Z).Magnitude
				if j.EdgeDist and j.EdgeDist > trimDist + 0.5 and flat.Magnitude > j.EdgeDist + 1 then
					-- açılı bağlantı: ana parça yüzeyin kenarında, yüzey yüksekliğinde biter; kenarın içinde kalan kısım
					-- yüzeyin 0.02 altında düz dolgu (kenarda boşluk yok, yüzeyin üstüne çıkıntı yok)
					local edgePt = nodePos + flat.Unit * j.EdgeDist
					local under = Vector3.new(0, 0.02, 0)
					table.insert(fillers, { Vector3.new(endPt.X, nodePos.Y, endPt.Z) - under, edgePt - under })
					endPt = edgePt
				else
					endPt = Vector3.new(endPt.X, nodePos.Y, endPt.Z)
				end
				if atA then
					a = endPt
				else
					b = endPt
				end
			end
		end
		for _, f in fillers do
			strip(surfaces, f[1], f[2], e.Width, thickness, 0, surfaceColor, Enum.Material.Asphalt, { CastShadow = false })
		end
		local road = strip(surfaces, a, b, e.Width, thickness, 0, surfaceColor, Enum.Material.Asphalt, { CastShadow = elevated or sloped })
		if road then
			road.Name = "Road_" .. e.Id
			road:SetAttribute("EdgeId", e.Id)
		end

		-- Şerit çizgileri
		local la, lb = a + lift, b + lift
		if e.Kind == "street" or e.Kind == "country" then
			strip(markings, la, lb, 0.5, LINE_T, 0, C.LineYellow, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
		elseif e.Kind == "avenue" or e.Kind == "highway" then
			local lane = e.Width / 4
			strip(markings, la, lb, 0.35, LINE_T, 0.6, C.LineYellow, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			strip(markings, la, lb, 0.35, LINE_T, -0.6, C.LineYellow, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			strip(markings, la, lb, 0.35, LINE_T, lane, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			strip(markings, la, lb, 0.35, LINE_T, -lane, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			if e.Kind == "highway" then
				-- kenar çizgileri
				strip(markings, la, lb, 0.35, LINE_T, e.Width / 2 - 1, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
				strip(markings, la, lb, 0.35, LINE_T, -(e.Width / 2 - 1), C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			end
		elseif e.Kind == "freeway" then
			strip(markings, la, lb, 0.35, LINE_T, 13, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			strip(markings, la, lb, 0.35, LINE_T, -13, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
			-- Orta refüj ve kenar bariyerleri (jersey duvar)
			local up = Vector3.new(0, 1.25, 0)
			strip(markings, a + up * 2, b + up * 2, 1.6, 2.5, 0, C.Barrier, Enum.Material.Concrete)
			if elevated or sloped then
				strip(markings, a + up * 2, b + up * 2, 1.2, 2.5, e.Width / 2 - 0.6, C.Barrier, Enum.Material.Concrete)
				strip(markings, a + up * 2, b + up * 2, 1.2, 2.5, -(e.Width / 2 - 0.6), C.Barrier, Enum.Material.Concrete)
			end
		elseif e.Kind == "ramp" then
			if math.max(a.Y, b.Y) > 4 then
				local up = Vector3.new(0, 2.5, 0)
				strip(markings, a + up, b + up, 1, 2.5, e.Width / 2 - 0.5, C.Barrier, Enum.Material.Concrete)
				strip(markings, a + up, b + up, 1, 2.5, -(e.Width / 2 - 0.5), C.Barrier, Enum.Material.Concrete)
			end
		end

		-- Kaldırımlar
		if e.Sidewalk then
			local wa, wb = trimmedEnds(data, e, walkTrim[e.Id])
			local top = Vector3.new(0, meta.BlockTop, 0)
			wa = Vector3.new(wa.X, 0, wa.Z) + top
			wb = Vector3.new(wb.X, 0, wb.Z) + top
			local off = e.Width / 2 + sw / 2
			strip(sidewalksFolder, wa, wb, sw, 1, off, C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
			strip(sidewalksFolder, wa, wb, sw, 1, -off, C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
		end

		-- Köprü: su üzerindeki bölümde korkuluk ve ayaklar (bölüm sınırları mapgen.py'de hesaplandı)
		if e.Bridge and e.BridgeSpan then
			local pa, pb = data.Nodes[e.A].Position, data.Nodes[e.B].Position
			local ra, rb = pa:Lerp(pb, e.BridgeSpan[1]), pa:Lerp(pb, e.BridgeSpan[2])
			local up = Vector3.new(0, 3, 0)
			strip(markings, ra + up, rb + up, 0.8, 3, e.Width / 2 + 0.4, C.Metal, Enum.Material.Metal)
			strip(markings, ra + up, rb + up, 0.8, 3, -(e.Width / 2 + 0.4), C.Metal, Enum.Material.Metal)
			local spanLength = (rb - ra).Magnitude
			local count = math.max(1, math.floor(spanLength / 70))
			local dir = Vector3.new(pb.X - pa.X, 0, pb.Z - pa.Z)
			for k = 1, count do
				local pc = ra:Lerp(rb, k / (count + 1))
				local cf = CFrame.lookAt(Vector3.new(pc.X, -8, pc.Z), Vector3.new(pc.X, -8, pc.Z) + dir)
				kit:Box(markings, Vector3.new(e.Width * 0.7, 16, 5), cf, C.Concrete, Enum.Material.Concrete)
			end
		end
	end

	-- ===== Kavşaklar =====
	for _, pad in pads do
		local pos = pad.Position
		if pad.Disc then
			-- yolla aynı seviye ve aynı renk (eskiden 0.06 aşağıdaydı: teker köşede çukura düşüp çarpıyordu)
			kit:Cylinder(junctions, pad.Thickness, pad.SizeX, CFrame.new(pos - Vector3.new(0, pad.Thickness / 2, 0)), if pad.Light then C.AsphaltLight else C.Asphalt, Enum.Material.Asphalt)
		elseif pad.Dir then
			local d = pad.Dir
			local cf = CFrame.lookAt(pos, pos + Vector3.new(d.X, 0, d.Y)) * CFrame.new(0, -pad.Thickness / 2, 0)
			kit:Box(junctions, Vector3.new(pad.SizeX, pad.Thickness, pad.SizeZ), cf, C.AsphaltLight, Enum.Material.Asphalt)
		else
			kit:Box(junctions, Vector3.new(pad.SizeX, pad.Thickness, pad.SizeZ), CFrame.new(pos - Vector3.new(0, pad.Thickness / 2, 0)), C.Asphalt, Enum.Material.Asphalt, { CastShadow = false })

			-- Kaldırım köşeleri ve kapalı kenar dolguları
			if pad.Walk then
				local hx, hz = pad.SizeX / 2, pad.SizeZ / 2
				local y = meta.BlockTop - 0.5
				for _, sxs in { -1, 1 } do
					for _, szs in { -1, 1 } do
						kit:Box(sidewalksFolder, Vector3.new(sw, 1, sw), CFrame.new(pos.X + sxs * (hx + sw / 2), y, pos.Z + szs * (hz + sw / 2)), C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
					end
				end
				if not pad.Open.N then
					kit:Box(sidewalksFolder, Vector3.new(pad.SizeX, 1, sw), CFrame.new(pos.X, y, pos.Z - hz - sw / 2), C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
				end
				if not pad.Open.S then
					kit:Box(sidewalksFolder, Vector3.new(pad.SizeX, 1, sw), CFrame.new(pos.X, y, pos.Z + hz + sw / 2), C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
				end
				if not pad.Open.W then
					kit:Box(sidewalksFolder, Vector3.new(sw, 1, pad.SizeZ), CFrame.new(pos.X - hx - sw / 2, y, pos.Z), C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
				end
				if not pad.Open.E then
					kit:Box(sidewalksFolder, Vector3.new(sw, 1, pad.SizeZ), CFrame.new(pos.X + hx + sw / 2, y, pos.Z), C.Sidewalk, Enum.Material.Concrete, { CastShadow = false })
				end
			end

			-- Yaya geçitleri: her kaldırımlı kolda iki enine beyaz çizgi
			if pad.Crosswalk and pad.Adj then
				for _, a in pad.Adj do
					if a.Sidewalk then
						local axis = axisOf(a.Dir)
						local half = if axis == "E" or axis == "W" then pad.SizeX / 2 else pad.SizeZ / 2
						local dir3 = Vector3.new(a.Dir.X, 0, a.Dir.Y)
						for _, dist in { half + 1, half + 7 } do
							local p = pos + dir3 * dist + Vector3.new(0, LINE_LIFT - LINE_T / 2, 0)
							local cf = CFrame.lookAt(p, p + dir3)
							kit:Box(markings, Vector3.new(a.Width - 1, LINE_T, 0.7), cf, C.LineWhite, Enum.Material.SmoothPlastic, { CastShadow = false, CanCollide = false })
						end
					end
				end
			end
		end
	end
end

return RoadBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties>
<string name="Name">WorldBuilder</string>

<ProtectedString name="Source"><![CDATA[-- WorldBuilder: SOLARA County'yi MapDefinitions verisinden inşa eder.
--
-- İki kullanım:
--   1) Çalışma anında (WorldService otomatik çağırır): kademeli inşa, sunucu donmaz.
--   2) Studio'da "pişirme" (bake) — Command Bar'a:
--        require(game.ServerScriptService.WorldGen.WorldBuilder).Bake()
--      Dünya Workspace'e kalıcı olarak yazılır, Studio'da görünür/düzenlenebilir olur ve
--      sunucu açılışında tekrar üretilmez (World.Baked = true).
--      Silmek için: require(...).Clear()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapDefinitions = require(ReplicatedStorage.Shared.MapDefinitions)
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local LandBuilder = require(script.Parent.LandBuilder)
local RoadBuilder = require(script.Parent.RoadBuilder)
local BuildingBuilder = require(script.Parent.BuildingBuilder)
local PropBuilder = require(script.Parent.PropBuilder)

local WorldBuilder = {}

-- Bu klasörler inşacıya aittir; Clear() sadece bunları siler (elle eklediklerine dokunmaz)
local GENERATED = { "Ground", "Blocks", "Coast", "Boundary", "Roads", "Sidewalks", "Buildings", "Props" }

local SHOP_TYPES = MapDefinitions.ShopTypes

local function ensureFolder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Doğma noktaları (her şeyden önce: oyuncular boşluğa düşmesin)
function WorldBuilder.BuildSpawns(kit, world: Instance)
	local folder = ensureFolder(world, "SpawnPoints")
	for _, child in folder:GetChildren() do
		if child:GetAttribute("Generated") then
			child:Destroy()
		end
	end
	local first = nil
	for index, s in MapDefinitions.GetSpawns() do
		local part = kit:Box(folder, Vector3.new(4, 1, 4), CFrame.new(s.Position.X, 0.5, s.Position.Z) * CFrame.Angles(0, math.rad(s.Yaw), 0),
			Color3.fromRGB(255, 122, 69), Enum.Material.SmoothPlastic,
			{ Transparency = 1, CanCollide = false, CanQuery = false, Name = "SpawnPoint" .. index })
		part:SetAttribute("SpawnGroup", s.Group)
		part:SetAttribute("Generated", true)
		if not first and s.Group == Config.World.DefaultSpawnGroup then
			first = s
		end
	end
	if first then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "FallbackSpawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = CFrame.new(first.Position.X, 0.8, first.Position.Z)
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn:SetAttribute("Generated", true)
		spawn.Parent = folder
	end
end

-- Dükkân girişleri ve etkileşim noktaları (Aşama 5/7 bu parçaları kullanır)
function WorldBuilder.BuildInteractionPoints(kit, world: Instance)
	local shops = ensureFolder(world, "Shops")
	local interactive = ensureFolder(world, "InteractiveLocations")
	for _, folder in { shops, interactive } do
		for _, child in folder:GetChildren() do
			if child:GetAttribute("Generated") then
				child:Destroy()
			end
		end
	end
	for _, poi in MapDefinitions.GetPOIs() do
		local parent = if SHOP_TYPES[poi.Type] then shops else interactive
		local zone = kit:Box(parent, Vector3.new(8, 8, 8), CFrame.new(poi.Entrance.X, 4.8, poi.Entrance.Z), Color3.fromRGB(255, 122, 69), Enum.Material.ForceField,
			{ Transparency = 1, CanCollide = false, CanQuery = true, Name = poi.Id, CastShadow = false })
		zone:SetAttribute("PoiId", poi.Id)
		zone:SetAttribute("PoiType", poi.Type)
		zone:SetAttribute("DisplayName", poi.Name)
		zone:SetAttribute("District", poi.District)
		zone:SetAttribute("Generated", true)
	end
end

type BuildOptions = { Yield: boolean?, OnProgress: ((string, number) -> ())? }

function WorldBuilder.Build(options: BuildOptions?)
	local opts = options or {}
	local started = os.clock()
	local kit = Kit.new(if opts.Yield == false then 0 else Config.World.BuildYieldEvery)
	local world = ensureFolder(workspace, "World")
	world:SetAttribute("WorldReady", false)

	local steps = {
		{ "Doğma noktaları", function() WorldBuilder.BuildSpawns(kit, world) end },
		{ "Zemin ve bloklar", function() LandBuilder.BuildGround(kit, world) end },
		{ "Su ve tepeler", function() LandBuilder.BuildTerrain(kit, world) end },
		{ "Kıyı ve sınırlar", function() LandBuilder.BuildCoast(kit, world) end },
		{ "Yollar", function() RoadBuilder.Build(kit, world) end },
		{ "Binalar", function() BuildingBuilder.Build(kit, world) end },
		{ "Dekor", function() PropBuilder.Build(kit, world) end },
		{ "Etkileşim noktaları", function() WorldBuilder.BuildInteractionPoints(kit, world) end },
	}
	local errors = {}
	for index, step in steps do
		local ok, err = pcall(step[2])
		if not ok then
			table.insert(errors, step[1] .. ": " .. tostring(err))
			warn("[WorldGen] Adım hatası:", step[1], err)
		end
		world:SetAttribute("BuildProgress", index / #steps)
		if opts.OnProgress then
			opts.OnProgress(step[1], index / #steps)
		end
	end

	local seconds = os.clock() - started
	world:SetAttribute("PartCount", kit.Count)
	world:SetAttribute("BuildSeconds", math.floor(seconds * 10) / 10)
	world:SetAttribute("WorldReady", true)
	print(string.format("[WorldGen] Dünya hazır: %d parça, %.1f sn, %d hata", kit.Count, seconds, #errors))
	return { PartCount = kit.Count, Seconds = seconds, Errors = errors }
end

-- clearTerrain = true ise Terrain da silinir (dikkat: elle yaptığın arazi de gider)
function WorldBuilder.Clear(clearTerrain: boolean?)
	local world = workspace:FindFirstChild("World")
	if world then
		for _, name in GENERATED do
			local f = world:FindFirstChild(name)
			if f then
				f:Destroy()
			end
		end
		for _, name in { "SpawnPoints", "Shops", "InteractiveLocations" } do
			local f = world:FindFirstChild(name)
			if f then
				for _, child in f:GetChildren() do
					if child:GetAttribute("Generated") then
						child:Destroy()
					end
				end
			end
		end
		world:SetAttribute("Baked", nil)
		world:SetAttribute("WorldReady", nil)
	end
	if clearTerrain then
		workspace.Terrain:Clear()
	end
	print("[WorldGen] Üretilmiş dünya silindi.")
end

-- Studio düzenleme modunda tek seferde inşa et ve kalıcı yap
function WorldBuilder.Bake()
	if RunService:IsRunning() then
		warn("[WorldGen] Bake sadece düzenleme modunda (Play kapalıyken) çalıştırılmalı.")
		return
	end
	WorldBuilder.Clear()
	local result = WorldBuilder.Build({ Yield = false })
	local world = workspace:FindFirstChild("World")
	if world then
		world:SetAttribute("Baked", true)
		world:SetAttribute("WorldReady", nil)
	end
	print("[WorldGen] Pişirme tamamlandı. Place'i kaydetmeyi unutma (Ctrl+S).")
	return result
end

return WorldBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBXC387EC90N"><Properties>
<string name="Name">Testing</string>
</Properties>
<Item class="ModuleScript" referent="RBX3B5C7848N"><Properties>
<string name="Name">VehicleTestCourse</string>

<ProtectedString name="Source"><![CDATA[-- VehicleTestCourse: otomobil fiziği için TEKRARLANABİLİR test pisti (Aşama 2).
-- Dünya üretimine dokunmaz: Dry Creek ovasının çok üstünde (Y = 400) bağımsız bir asfalt platform kurar.
-- Her çalıştırmada birebir aynı yerleşim (rastgelelik yok).
--
-- İstasyonlar (yerel koordinat; +X ileri):
--   1 HIZLANMA + FREN      z = 0 şeridi, x 20 → 2700. 200 stud'da bir mesafe tabelası, x 1900'den sonra fren bölgesi.
--   2 SLALOM               z = 250, 9 koni / 60 stud aralık. Kapılar x 240 → 840.
--   3 KESKİN VİRAJ         x 1150 → 1300 çevresinde 180° firkete (iç yarıçap 15, dış 45). Aynı x=1150 kapısından girip çıkılır.
--   4 SKIDPAD              merkez (2050, 270), koni halkaları R 80 / 100 (sabit yarıçap → sürekli yanal g).
--   5 BOZUK YOL            z = -300, x 300 → 1200: hız tümsekleri, sağ/sol tümsekler, 0.66 stud basamak (gerçek yollardaki
--                          kavşak basamağıyla aynı), pürüzlü yama.
--   6 YÜKSEK HIZ           z = 0 şeridinde x 1450 → 1750 ani şerit değiştirme (14 stud).
-- Kapılar (görünmez, çarpışmasız) istemcideki telemetri kaydedicisi tarafından okunur (attribute: Test, Role).

local VehicleTestCourse = {}

VehicleTestCourse.Origin = Vector3.new(-3600, 400, -200)
VehicleTestCourse.FolderName = "SolaraTestCourse"

local M = Enum.Material
local rgb = Color3.fromRGB
local ASPHALT = rgb(62, 64, 68)
local PAINT = rgb(236, 236, 230)
local CONE = rgb(255, 122, 40)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, props: { [string]: any }?): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function wedge(parent: Instance, size: Vector3, cf: CFrame)
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.Size = size
	w.CFrame = cf
	w.Color = ASPHALT
	w.Material = M.Asphalt
	w.CanTouch = false
	w.Parent = parent
	return w
end

-- Boya: çarpışmasız, sorgulanmaz (tekerleri etkilemez)
local function paint(parent: Instance, o: Vector3, x: number, z: number, sx: number, sz: number)
	part(parent, Vector3.new(sx, 0.05, sz), CFrame.new(o + Vector3.new(x, 0.03, z)), PAINT, M.SmoothPlastic,
		{ CanCollide = false, CanQuery = false, CastShadow = false })
end

local function cone(parent: Instance, o: Vector3, x: number, z: number, test: string)
	local c = part(parent, Vector3.new(2, 1.2, 1.2), CFrame.new(o + Vector3.new(x, 1, z)) * CFrame.Angles(0, 0, math.pi / 2),
		CONE, M.SmoothPlastic, { Shape = Enum.PartType.Cylinder, CanCollide = false, CanQuery = false, CastShadow = false })
	c.Name = "Cone"
	c:SetAttribute("Test", test)
	return c
end

local function gate(parent: Instance, o: Vector3, x: number, z: number, width: number, test: string, role: string, yaw: number?)
	local g = part(parent, Vector3.new(1, 12, width), CFrame.new(o + Vector3.new(x, 6, z)) * CFrame.Angles(0, math.rad(yaw or 0), 0),
		PAINT, M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false })
	g.Name = "Gate_" .. test .. "_" .. role
	g:SetAttribute("Test", test)
	g:SetAttribute("Role", role)
	-- yerdeki çizgi
	paint(parent, o, x, z, 1, width)
	return g
end

local function board(parent: Instance, o: Vector3, x: number, z: number, text: string, yaw: number?)
	local b = part(parent, Vector3.new(18, 6, 0.6), CFrame.new(o + Vector3.new(x, 7, z)) * CFrame.Angles(0, math.rad(yaw or 0), 0),
		rgb(24, 26, 34), M.SmoothPlastic, { CanCollide = false, CanQuery = false })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.MaxDistance = 400
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.TextColor3 = rgb(255, 214, 150)
		label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
		label.Text = text
		label.Parent = gui
		gui.Parent = b
	end
	return b
end

-- Pist kurulur; mevcutsa yeniden kurulur. Döndürür: klasör, araç başlangıç noktaları, oyuncu başlangıcı
function VehicleTestCourse.Build()
	local existing = workspace:FindFirstChild(VehicleTestCourse.FolderName)
	if existing then
		existing:Destroy()
	end
	local o = VehicleTestCourse.Origin
	local folder = Instance.new("Folder")
	folder.Name = VehicleTestCourse.FolderName
	folder:SetAttribute("Origin", o)

	-- Zemin ve kenar bariyerleri
	part(folder, Vector3.new(2900, 4, 1000), CFrame.new(o + Vector3.new(1350, -2, 0)), ASPHALT, M.Asphalt)
	for _, z in { -500, 500 } do
		part(folder, Vector3.new(2900, 3, 2), CFrame.new(o + Vector3.new(1350, 1.5, z)), rgb(200, 200, 196), M.Concrete)
	end
	for _, x in { -100, 2800 } do
		part(folder, Vector3.new(2, 3, 1000), CFrame.new(o + Vector3.new(x, 1.5, 0)), rgb(200, 200, 196), M.Concrete)
	end

	-- 1 HIZLANMA + FREN (+ 6 YÜKSEK HIZ aynı şeritte)
	board(folder, o, 60, -28, "1 · HIZLANMA / FREN")
	for x = 0, 2700, 50 do
		paint(folder, o, x + 12, 15, 12, 0.4)
		paint(folder, o, x + 12, -15, 12, 0.4)
	end
	for d = 200, 2600, 200 do
		board(folder, o, 20 + d, -34, tostring(d))
	end
	gate(folder, o, 20, 0, 30, "Accel", "Start")
	board(folder, o, 1900, 30, "FREN BÖLGESİ")
	-- 6 Şerit değiştirme: x 1500'de z 0 şeridi, x 1620'de z -14 şeridi (koni çiftleri)
	board(folder, o, 1420, -34, "6 · ŞERİT DEĞİŞTİR")
	for _, c in { { 1500, 0 }, { 1520, 0 }, { 1620, -14 }, { 1640, -14 }, { 1700, -14 } } do
		cone(folder, o, c[1], c[2] - 6, "LaneChange")
		cone(folder, o, c[1], c[2] + 6, "LaneChange")
	end
	gate(folder, o, 1450, -5, 40, "LaneChange", "Start")
	gate(folder, o, 1750, -10, 40, "LaneChange", "Finish")

	-- 2 SLALOM
	board(folder, o, 200, 225, "2 · SLALOM")
	for k = 0, 8 do
		cone(folder, o, 300 + 60 * k, 250, "Slalom")
	end
	gate(folder, o, 240, 250, 40, "Slalom", "Start")
	gate(folder, o, 840, 250, 40, "Slalom", "Finish")

	-- 3 KESKİN VİRAJ (180° firkete): x=1150'den +X yönünde gir (z 230..270), etrafından dön, -X yönünde çık (z 150..190)
	board(folder, o, 1100, 300, "3 · KESKİN VİRAJ")
	local pivot = Vector3.new(1300, 0, 210)
	for k = 0, 12 do
		local a = math.rad(-90 + 15 * k) -- yarım çember (sağdan dolaşma)
		local inner = pivot + Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
		local outer = pivot + Vector3.new(math.cos(a) * 45, 0, math.sin(a) * 45)
		cone(folder, o, inner.X, inner.Z, "Hairpin")
		cone(folder, o, outer.X, outer.Z, "Hairpin")
	end
	for x = 1160, 1300, 20 do
		cone(folder, o, x, 210, "Hairpin") -- giriş ve çıkış şeritlerini ayıran orta çizgi
	end
	gate(folder, o, 1150, 250, 40, "Hairpin", "Start")
	gate(folder, o, 1150, 170, 40, "Hairpin", "Finish")

	-- 4 SKIDPAD
	board(folder, o, 1930, 150, "4 · SKIDPAD (R 90)")
	local center = Vector3.new(2050, 0, 270)
	for k = 0, 35 do
		local a = math.rad(k * 10)
		cone(folder, o, center.X + math.cos(a) * 80, center.Z + math.sin(a) * 80, "Skidpad")
		cone(folder, o, center.X + math.cos(a) * 100, center.Z + math.sin(a) * 100, "Skidpad")
	end
	local marker = part(folder, Vector3.new(1, 1, 1), CFrame.new(o + center), PAINT, M.SmoothPlastic,
		{ Transparency = 1, CanCollide = false, CanQuery = false })
	marker.Name = "SkidpadCenter"
	marker:SetAttribute("Radius", 90)

	-- 5 BOZUK YOL
	board(folder, o, 260, -330, "5 · BOZUK YOL")
	local rz = -300
	local rough = Instance.new("Folder")
	rough.Name = "RoughRoad"
	rough.Parent = folder
	-- a) hız tümsekleri: 0.35 yüksek, 6 stud uzun (rampa + rampa), 15 stud arayla
	for x = 350, 500, 15 do
		wedge(rough, Vector3.new(30, 0.35, 3), CFrame.new(o + Vector3.new(x - 1.5, 0.175, rz)) * CFrame.Angles(0, math.rad(90), 0))
		wedge(rough, Vector3.new(30, 0.35, 3), CFrame.new(o + Vector3.new(x + 1.5, 0.175, rz)) * CFrame.Angles(0, math.rad(-90), 0))
	end
	-- b) sağ/sol dönüşümlü tümsekler (gövde yatışını uyarır)
	for i, x in { 560, 590, 620, 650, 680 } do
		local side = if i % 2 == 0 then 1 else -1
		wedge(rough, Vector3.new(12, 0.5, 3), CFrame.new(o + Vector3.new(x - 1.5, 0.25, rz + side * 7)) * CFrame.Angles(0, math.rad(90), 0))
		wedge(rough, Vector3.new(12, 0.5, 3), CFrame.new(o + Vector3.new(x + 1.5, 0.25, rz + side * 7)) * CFrame.Angles(0, math.rad(-90), 0))
	end
	-- c) 0.66 stud keskin basamak (şehirdeki rampa-kavşak basamağının kopyası) — çık, 150 stud sonra in
	part(rough, Vector3.new(150, 0.66, 30), CFrame.new(o + Vector3.new(825, 0.33, rz)), ASPHALT, M.Asphalt)
	-- d) pürüzlü yama: sabit desenli 0.1–0.3 stud plakalar
	local heights = { 0.12, 0.28, 0.18, 0.3, 0.1, 0.22, 0.26, 0.14 }
	local n = 0
	for x = 960, 1140, 10 do
		for zz = -10, 10, 10 do
			n += 1
			local h = heights[(n % #heights) + 1]
			part(rough, Vector3.new(8, h, 8), CFrame.new(o + Vector3.new(x, h / 2, rz + zz)), ASPHALT, M.Asphalt)
		end
	end
	gate(folder, o, 300, rz, 34, "Rough", "Start")
	gate(folder, o, 1200, rz, 34, "Rough", "Finish")

	folder.Parent = workspace

	-- Başlangıç: araçlar x = -40'ta, +X'e bakarak (araç önü -Z → yaw -90°)
	local carSpots = {}
	for i = 0, 6 do
		table.insert(carSpots, CFrame.new(o + Vector3.new(-40, 0, -180 + 60 * i)) * CFrame.Angles(0, math.rad(-90), 0))
	end
	board(folder, o, -40, -240, "TEST ARAÇLARI · F ile bin")
	return folder, carSpots, CFrame.new(o + Vector3.new(-75, 4, -230)) * CFrame.Angles(0, math.rad(-90), 0)
end

return VehicleTestCourse
]]></ProtectedString>
</Properties>
</Item>
</Item>
