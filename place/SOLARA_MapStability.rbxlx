<Item class="StarterPlayerScripts" referent="RBX0000002B"><Properties>
<string name="Name">StarterPlayerScripts</string>

</Properties>
<Item class="LocalScript" referent="RBX0000002C"><Properties>
<string name="Name">ClientBootstrap</string>

<ProtectedString name="Source"><![CDATA[-- ClientBootstrap: istemcideki TEK giriş noktası.
-- Kontrolcü sözleşmesi sunucudakiyle aynı: Name, Priority, Init(controllers), Start().

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log).new("ClientBootstrap")
local RemoteRegistry = require(Shared.RemoteRegistry)

local controllersFolder = script.Parent:WaitForChild("Controllers")
local controllers = {}
local ordered = {}

for _, moduleScript in controllersFolder:GetChildren() do
	if moduleScript:IsA("ModuleScript") then
		local ok, result = pcall(require, moduleScript)
		if ok and type(result) == "table" then
			controllers[result.Name or moduleScript.Name] = result
			table.insert(ordered, result)
		else
			Log.Error("Kontrolcü yüklenemedi:", moduleScript.Name, result)
		end
	end
end

table.sort(ordered, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

for _, controller in ordered do
	if type(controller.Init) == "function" then
		local ok, err = pcall(controller.Init, controller, controllers)
		if not ok then
			Log.Error("Init hatası:", controller.Name, err)
			controller._failed = true
		end
	end
end

for _, controller in ordered do
	if not controller._failed and type(controller.Start) == "function" then
		local ok, err = pcall(controller.Start, controller)
		if not ok then
			Log.Error("Start hatası:", controller.Name, err)
		end
	end
end

-- Sunucuya hazır olduğumuzu bildir
local sessionInfo = RemoteRegistry.Get("PlayerRemotes", "SessionInfo") :: RemoteEvent
sessionInfo.OnClientEvent:Connect(function(info)
	if type(info) == "table" then
		Log.Info("Oturum:", info.GameMode, "sürüm", info.Version)
		if controllers.DebugHUDController then
			controllers.DebugHUDController:SetSessionInfo(info)
		end
	end
end)

local clientReady = RemoteRegistry.Get("PlayerRemotes", "ClientReady") :: RemoteEvent
local device = controllers.InputController and controllers.InputController:GetDeviceType() or "Unknown"
clientReady:FireServer(device)
Log.Info("İstemci hazır. Cihaz:", device)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX0000002D"><Properties>
<string name="Name">Controllers</string>

</Properties>
<Item class="ModuleScript" referent="RBX0000002E"><Properties>
<string name="Name">AnimationController</string>

<ProtectedString name="Source"><![CDATA[-- AnimationController: ÖZEL eylem animasyonları için merkezi yönetim (Bölüm 20).
-- * Avatarın kendi hareket animasyonlarına (Animate scripti) DOKUNMAZ.
-- * Rig tipine (R6/R15) göre doğru animasyon ID'sini seçer.
-- * Aynı animasyonu üst üste başlatmaz (tekrar oynatma koruması).
-- * Karakter değişince tüm track'leri durdurur ve temizler (bellek sızıntısı yok).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Shared.Utilities.Maid)
local AnimationConfig = require(Modules.AnimationConfig)
local Log = require(Shared.Utilities.Log).new("Animation")

local AnimationController = {
	Name = "AnimationController",
	Priority = 4,
}

local controllers
local charMaid = Maid.new()
local animator: Animator? = nil
local rigType = "R15"
local tracks: { [string]: AnimationTrack } = {}
local warnedMissing: { [string]: boolean } = {}

local function resolveId(actionName: string): string?
	local def = AnimationConfig.Actions[actionName]
	if not def then
		return nil
	end
	local id = def[rigType]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	if not id:find("rbxassetid://") then
		id = "rbxassetid://" .. id
	end
	return id
end

local function getTrack(actionName: string): AnimationTrack?
	local cached = tracks[actionName]
	if cached then
		return cached
	end
	if not animator then
		return nil
	end
	local id = resolveId(actionName)
	if not id then
		if not warnedMissing[actionName .. rigType] then
			warnedMissing[actionName .. rigType] = true
			Log.Info("Animasyon ID'si yok, atlanıyor:", actionName, rigType)
		end
		return nil
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	animation:Destroy()
	if not ok or not track then
		Log.Warn("Animasyon yüklenemedi:", actionName, track)
		return nil
	end
	local def = AnimationConfig.Actions[actionName]
	track.Looped = def.Looped
	track.Priority = def.Priority
	tracks[actionName] = track
	return track
end

-- Oynatır; animasyon yoksa nil döner (çağıran taraf buna hazırlıklı olmalı)
function AnimationController:Play(actionName: string, fadeTime: number?, speed: number?): AnimationTrack?
	local track = getTrack(actionName)
	if not track then
		return nil
	end
	if track.IsPlaying then
		if speed then
			track:AdjustSpeed(speed)
		end
		return track -- tekrar başlatma
	end
	track:Play(fadeTime or AnimationConfig.DefaultFadeTime, 1, speed or 1)
	return track
end

function AnimationController:Stop(actionName: string, fadeTime: number?)
	local track = tracks[actionName]
	if track and track.IsPlaying then
		track:Stop(fadeTime or AnimationConfig.DefaultFadeTime)
	end
end

function AnimationController:StopAll(fadeTime: number?)
	for _, track in tracks do
		if track.IsPlaying then
			track:Stop(fadeTime or AnimationConfig.DefaultFadeTime)
		end
	end
end

function AnimationController:IsPlaying(actionName: string): boolean
	local track = tracks[actionName]
	return track ~= nil and track.IsPlaying
end

local function clearTracks()
	for _, track in tracks do
		pcall(function()
			track:Stop(0)
			track:Destroy()
		end)
	end
	table.clear(tracks)
end

local function onCharacterChanged(character: Model?)
	charMaid:Clean()
	clearTracks()
	animator = nil
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	rigType = if humanoid.RigType == Enum.HumanoidRigType.R15 then "R15" else "R6"
	animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5) :: Animator?
	if not animator then
		Log.Warn("Animator bulunamadı")
	end
	charMaid:Give(clearTracks)
end

function AnimationController:Init(allControllers)
	controllers = allControllers
end

function AnimationController:Start()
	controllers.CharacterController.CharacterChanged:Connect(onCharacterChanged)
	local current = controllers.CharacterController:GetCharacter()
	if current then
		task.spawn(onCharacterChanged, current)
	end
end

return AnimationController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties>
<string name="Name">AudioController</string>

<ProtectedString name="Source"><![CDATA[-- AudioController: istemci tarafı ses yönetimi (Bölüm 23).
-- Aşama 3: yakındaki araçların motor sesi perdesi hıza göre ayarlanır (yerel; ağ trafiği yok).
-- Ses kaynakları AudioConfig'tedir; ID verilmemişse araçlarda Sound nesnesi olmaz ve bu döngü boşa çalışmaz.
--
-- Aşama 1 (ana menü): yerel ses mikseri.
--   SoundService/SolaraMaster (SoundGroup)
--     ├─ SolaraVehicles   (araç motoru, korna)
--     ├─ SolaraWorld      (ileride: ortam, NPC, hava)
--     └─ SolaraInterface  (menü sesleri)
--   Hacimler SettingsController'daki MasterVolume / VehicleVolume / WorldVolume / InterfaceVolume ayarlarından gelir.
--   Gruplar istemcide oluşturulur (yerel), diğer oyuncuları etkilemez.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Modules.AudioConfig)
local VehicleDefinitions = require(Shared.VehicleDefinitions)

local AudioController = {
	Name = "AudioController",
	Priority = 10,
}

local HEAR_DISTANCE = 160

local controllers
local groups: { [string]: SoundGroup } = {}
local interfaceSounds: { [string]: Sound } = {}

local GROUP_SETTINGS = {
	Master = "MasterVolume",
	Vehicles = "VehicleVolume",
	World = "WorldVolume",
	Interface = "InterfaceVolume",
}

local function ensureGroup(name: string, parent: Instance): SoundGroup
	local fullName = "Solara" .. name
	local existing = parent:FindFirstChild(fullName)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = fullName
	group.Parent = parent
	return group
end

local function applyVolumes()
	local settings = controllers.SettingsController
	for name, key in GROUP_SETTINGS do
		local group = groups[name]
		local value = settings:Get(key)
		if group and type(value) == "number" then
			group.Volume = value
		end
	end
end

-- Araç seslerini (sunucuda yaratılır) yerelde Vehicles grubuna bağla → hacim ayarı etkili olur
local function routeVehicleSound(sound: Instance?)
	if sound and sound:IsA("Sound") and sound.SoundGroup ~= groups.Vehicles then
		sound.SoundGroup = groups.Vehicles
	end
end

function AudioController:GetGroup(name: string): SoundGroup?
	return groups[name]
end

-- Arayüz sesi çal ("Move" | "Select" | "Back"). ID yoksa sessizce hiçbir şey yapmaz.
function AudioController:PlayInterface(kind: string)
	local id = AudioConfig.Resolve(AudioConfig.Interface[kind])
	if not id then
		return
	end
	local sound = interfaceSounds[kind]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "UI_" .. kind
		sound.SoundId = id
		sound.Volume = AudioConfig.Interface.Volume
		sound.SoundGroup = groups.Interface
		sound.Parent = SoundService
		interfaceSounds[kind] = sound
	end
	sound.TimePosition = 0
	sound:Play()
end

function AudioController:Init(allControllers)
	controllers = allControllers
end

function AudioController:Start()
	groups.Master = ensureGroup("Master", SoundService)
	for _, name in { "Vehicles", "World", "Interface" } do
		groups[name] = ensureGroup(name, groups.Master)
	end
	applyVolumes()
	controllers.SettingsController.Changed:Connect(function(key)
		for _, settingKey in GROUP_SETTINGS do
			if settingKey == key then
				applyVolumes()
				return
			end
		end
	end)

	local cfg = AudioConfig.Vehicle
	task.spawn(function()
		while true do
			task.wait(0.15)
			local camera = workspace.CurrentCamera
			if not camera then
				continue
			end
			local listener = camera.CFrame.Position
			for _, model in CollectionService:GetTagged("Vehicle") do
				local chassis = model.PrimaryPart
				local engine = chassis and chassis:FindFirstChild("Engine")
				if chassis and (chassis.Position - listener).Magnitude < HEAR_DISTANCE then
					routeVehicleSound(engine)
					routeVehicleSound(chassis:FindFirstChild("Horn"))
				end
				if engine and engine:IsA("Sound") and engine.IsPlaying and (chassis.Position - listener).Magnitude < HEAR_DISTANCE then
					local def = VehicleDefinitions.Get(model:GetAttribute("DefId"))
					local maxSpeed = if def then def.MaxSpeed else 100
					local t = math.clamp(chassis.AssemblyLinearVelocity.Magnitude / maxSpeed, 0, 1)
					engine.PlaybackSpeed = cfg.EngineBasePitch + (cfg.EngineMaxPitch - cfg.EngineBasePitch) * t
				end
			end
		end
	end)
end

return AudioController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties>
<string name="Name">CameraController</string>

<ProtectedString name="Source"><![CDATA[-- CameraController: BİRLEŞİK kamera denetleyicisi (Bölüm 19).
--
-- Kuralı: Kameranın CFrame'ini SADECE bu modül yazar. Diğer sistemler kamerayı
-- doğrudan değiştirmez; bunun yerine "istek" (override) bırakır:
--
--   CameraController:RequestMode(owner, mode, priority)          -- takip modları (Vehicle, Motorcycle)
--   CameraController:RequestScripted(owner, mode, priority, fn)  -- Menu / Cinematic: fn(dt) -> CFrame, FOV?
--   CameraController:Release(owner)
--   CameraController:PlayCinematic(keyframes, owner?)            -- güvenli, zaman aşımlı geçiş
--
-- En yüksek öncelikli istek kazanır; hiç istek yoksa oyuncunun ayarlardaki modu (temel mod) kullanılır.
-- Böylece bir sistem çökse bile Release ile ya da güvenlik zamanlayıcısıyla kamera normale döner.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Constants = require(Shared.Constants)
local Signal = require(Shared.Utilities.Signal)
local MathUtil = require(Shared.Utilities.MathUtil)
local CameraConfig = require(Modules.CameraConfig)
local Log = require(Shared.Utilities.Log).new("Camera")

local CameraController = {
	Name = "CameraController",
	Priority = 5,
	ModeChanged = Signal.new(), -- (newMode, oldMode)
}

local Modes = Constants.CameraModes
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controllers

local RENDER_NAME = "OW_CameraController"
local DEG = math.pi / 180

-- ===== Durum =====
local baseMode = CameraConfig.DefaultMode
local currentMode: string? = nil
local overrides: { [string]: { Mode: string, Priority: number, Supplier: ((number) -> (CFrame, number?))?, Order: number } } = {}
local overrideOrder = 0

local targetYaw, targetPitch = 0, -10 * DEG
local yaw, pitch = targetYaw, targetPitch
local userDistance: { [string]: number } = {} -- oyuncunun moda göre yakınlaştırma tercihi
local currentDistance = 6
local pivot: Vector3? = nil
local snapNextFrame = true
local currentFov = 70
local followSubject: BasePart? = nil -- araç modunda takip edilecek parça (Aşama 3)
-- Araç çerçeveleme (Aşama 3 sürüş kamerası): aracın boyuna göre mesafe/yükseklik. nil → profil değerleri
type Framing = { Length: number, RoofHeight: number, MaxSpeed: number }
local followFraming: Framing? = nil
local vehicleZoom: { [string]: number } = {} -- araç modlarında oyuncu yakınlaştırması (çerçeveye oran)
local vehicleRoll = 0

-- Geçiş: kontrol el değiştirirken (araca binme/inme, mod değişimi, menüden dönüş) kamera eski karesinden
-- yeni hedefine yumuşakça kayar. Kamerayı yine sadece bu modül yazar.
local TRANSITION_TIME = 0.45
local transitionFrom: CFrame? = nil
local transitionFromFov = 70
local transitionTime = 0
local transitionDuration = TRANSITION_TIME
local autoFollowHeading = false -- araçta: oyuncu kamerayı çevirmezse aracın arkasına döner
local lastLookInput = 0
local AUTO_FOLLOW_DELAY = 1.2

local cursorFreeOwners: { [string]: boolean } = {}
local rightMouseHeld = false
local pendingTouchDelta = Vector2.zero
local cameraTouches: { [InputObject]: boolean } = {}
local gamepadLook = Vector2.zero
local lastPinchScale: number? = nil

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.RespectCanCollide = true
raycastParams.IgnoreWater = true
local filterRefreshTimer = 0

local characterParts: { BasePart } = {}
local lastTransparency = -1
local lastHeadOnly = false
local consecutiveErrors = 0
local descendantConnection: RBXScriptConnection? = nil
local running = false

-- ===== Yardımcılar =====
local function getSettings()
	return controllers.SettingsController
end

local function getProfile(mode: string)
	return CameraConfig.Profiles[mode] or CameraConfig.Profiles.ThirdPerson
end

local function isFollowMode(mode: string): boolean
	return CameraConfig.Profiles[mode] ~= nil
end

local function resolveMode(): (string, any)
	local best = nil
	for _, entry in overrides do
		if not best or entry.Priority > best.Priority or (entry.Priority == best.Priority and entry.Order > best.Order) then
			best = entry
		end
	end
	if best then
		return best.Mode, best
	end
	return baseMode, nil
end

local function isCursorFree(): boolean
	return next(cursorFreeOwners) ~= nil
end

local function refreshFilter()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(list, other.Character)
		end
	end
	if followSubject then
		local model = followSubject:FindFirstAncestorOfClass("Model")
		table.insert(list, model or followSubject)
	end
	raycastParams.FilterDescendantsInstances = list
end

-- Kamera mevcut açısından yaw/pitch'i al (sinematikten oyuna geçişte zıplama olmasın)
local function syncAnglesFromCamera()
	local look = camera.CFrame.LookVector
	targetYaw = math.atan2(-look.X, -look.Z)
	targetPitch = math.asin(math.clamp(look.Y, -1, 1))
	yaw, pitch = targetYaw, targetPitch
end

local function beginTransition(seconds: number?)
	local settings = controllers and controllers.SettingsController
	local reduce = settings and settings:Get("ReduceMotion") == true
	local d = (seconds or TRANSITION_TIME) * (if reduce then 0.35 else 1)
	if d <= 0.01 then
		transitionFrom = nil
		return
	end
	transitionFrom = camera.CFrame
	transitionFromFov = camera.FieldOfView
	transitionTime = 0
	transitionDuration = d
end

local function cancelTransition()
	transitionFrom = nil
end

-- Aktif profilin araç çerçevelemesiyle düzeltilmiş değerleri: omuz yüksekliği, mesafe, min, max
local function framedValues(profile): (number, number, number, number)
	local shoulderY = profile.ShoulderOffset.Y
	local distance, minD, maxD = profile.Distance, profile.MinDistance, profile.MaxDistance
	local f = followFraming
	if followSubject and f and profile.Distance > 0 then
		-- Kamera tavanın üstünde dursun (uzun/yüksek araçlar görüşü kapatmasın)
		shoulderY = math.max(shoulderY, f.RoofHeight + (profile.RoofClearance or 1))
		-- Mesafe aracın boyuyla ölçeklenir; en yakın konum aracın arka ucunun dışında kalır
		distance = math.max(distance, f.Length * (profile.LengthFactor or 0.7) + (profile.DistancePad or 2))
		minD = math.max(minD, f.Length / 2 + 3)
		maxD = math.max(maxD, distance + 8)
	end
	return shoulderY, distance, minD, maxD
end

-- ===== Karakter görünürlüğü (birinci şahıs / çok yakın kamera) =====
local function collectCharacterParts(character: Model?)
	table.clear(characterParts)
	lastTransparency = -1
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(characterParts, d)
		end
	end
end

local function isHeadPart(part: BasePart): boolean
	if part.Name == "Head" then
		return true
	end
	-- Aksesuarlar (şapka, saç, gözlük...) birinci şahısta görüşü kapatır
	return part:FindFirstAncestorOfClass("Accessory") ~= nil
end

local function applyCharacterTransparency(value: number, headOnly: boolean)
	if math.abs(value - lastTransparency) < 0.02 and headOnly == lastHeadOnly then
		return
	end
	lastTransparency = value
	lastHeadOnly = headOnly
	for _, part in characterParts do
		if part.Parent then
			if headOnly then
				part.LocalTransparencyModifier = if isHeadPart(part) then value else 0
			else
				part.LocalTransparencyModifier = value
			end
		end
	end
end

-- ===== Mod geçişi =====
local function setAutoRotate(enabled: boolean)
	local humanoid = controllers.CharacterController:GetHumanoid()
	if humanoid then
		humanoid.AutoRotate = enabled
	end
end

local function onModeChanged(newMode: string, oldMode: string?)
	local wasFollow = oldMode == nil or isFollowMode(oldMode)
	if oldMode ~= nil and isFollowMode(newMode) then
		beginTransition() -- eski kareden yumuşak geçiş (gerekirse çağıran SnapBehindCharacter ile iptal eder)
	end
	if isFollowMode(newMode) then
		if not wasFollow then
			-- Senaryolu kameradan dönüş: mevcut bakış açısını koru, pivotu anında yerleştir
			syncAnglesFromCamera()
		end
		snapNextFrame = true
		local profile = getProfile(newMode)
		if userDistance[newMode] == nil then
			userDistance[newMode] = profile.Distance
		end
		currentDistance = math.min(currentDistance, userDistance[newMode])
	end
	-- Birinci şahısta karakter kameranın yönüne döner
	setAutoRotate(newMode ~= Modes.FirstPerson)
	applyCharacterTransparency(0, false)
	CameraController.ModeChanged:Fire(newMode, oldMode)
	Log.Info("Kamera modu:", newMode)
end

local function updateResolvedMode()
	local mode = resolveMode()
	if mode ~= currentMode then
		local old = currentMode
		currentMode = mode
		onModeChanged(mode, old)
	end
end

-- ===== Giriş =====
local function applyLookInput(dt: number, profile)
	local s = getSettings()
	local sensitivity = s:Get("CameraSensitivity")
	local invert = if s:Get("InvertY") then -1 else 1

	-- Fare
	local wantLock = not isCursorFree() and not controllers.InputController:IsTouch()
	if wantLock then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	elseif rightMouseHeld then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	if wantLock or rightMouseHeld then
		local delta = UserInputService:GetMouseDelta()
		if delta.Magnitude > 0.5 then
			lastLookInput = os.clock()
		end
		targetYaw -= delta.X * CameraConfig.MouseSensitivity * sensitivity
		targetPitch -= delta.Y * CameraConfig.MouseSensitivity * sensitivity * invert
	end

	-- Dokunmatik
	if pendingTouchDelta.Magnitude > 0 then
		lastLookInput = os.clock()
		targetYaw -= pendingTouchDelta.X * CameraConfig.TouchSensitivity * sensitivity
		targetPitch -= pendingTouchDelta.Y * CameraConfig.TouchSensitivity * sensitivity * invert
		pendingTouchDelta = Vector2.zero
	end

	-- Gamepad
	if gamepadLook.Magnitude > CameraConfig.GamepadDeadzone then
		lastLookInput = os.clock()
		local rate = CameraConfig.GamepadSensitivity * sensitivity * dt
		targetYaw -= gamepadLook.X * rate
		targetPitch += gamepadLook.Y * rate * invert
	end

	targetPitch = math.clamp(targetPitch, profile.MinPitch * DEG, profile.MaxPitch * DEG)
end

-- Dokunuş Roblox'un hareket joystick'i üstünde mi başladı? (PlayerGui.TouchGui.TouchControlFrame)
-- Roblox'un DİNAMİK joystick'i dokunuşu "işlenmiş" (processed) olarak işaretlemez; Roblox kendi kamerasında
-- (PlayerModule/CameraInput) joystick alanında başlayan parmağı ayrıca hariç tutar. Kamerayı biz yazdığımız için
-- aynı kontrol burada: joystick parmağı kamerayı çevirmez, yürürken ikinci parmakla kamera sürüklenebilir.
-- Klasik joystick de dahil; sadece joystick katmanı açık ve görünürken (araçta Roblox kontrolleri kapalıdır).
local THUMBSTICK_FRAMES = { "DynamicThumbstickFrame", "ThumbstickFrame" }
local function isGuiShown(gui: GuiObject): boolean
	local node: Instance? = gui
	while node and node:IsA("GuiObject") do
		if not (node :: GuiObject).Visible then
			return false
		end
		node = node.Parent
	end
	return true
end
local function isOverThumbstick(position: Vector3): boolean
	if not GuiService.TouchControlsEnabled then
		return false
	end
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	local touchGui = playerGui and playerGui:FindFirstChild("TouchGui")
	if not touchGui or not touchGui:IsA("ScreenGui") or not touchGui.Enabled then
		return false
	end
	local touchFrame = touchGui:FindFirstChild("TouchControlFrame")
	if not touchFrame then
		return false
	end
	for _, name in THUMBSTICK_FRAMES do
		local frame = touchFrame:FindFirstChild(name)
		if frame and frame:IsA("GuiObject") and isGuiShown(frame) then
			local topLeft = frame.AbsolutePosition
			local bottomRight = topLeft + frame.AbsoluteSize
			if position.X >= topLeft.X and position.Y >= topLeft.Y and position.X <= bottomRight.X and position.Y <= bottomRight.Y then
				return true
			end
		end
	end
	return false
end

local function countCameraTouches(): number
	local count = 0
	for _ in cameraTouches do
		count += 1
	end
	return count
end

local function connectInput()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
			rightMouseHeld = true
		elseif input.UserInputType == Enum.UserInputType.Touch and not processed and not isOverThumbstick(input.Position) then
			-- Butonlar "processed" gelir; Roblox joystick'i gelmez, onu alanından tanırız. Kalan dokunuşlar kamerayı çevirir.
			cameraTouches[input] = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rightMouseHeld = false
		elseif input.UserInputType == Enum.UserInputType.Touch then
			cameraTouches[input] = nil
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.zero
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.Touch then
			if cameraTouches[input] then
				-- İki parmak aynı anda kameradaysa pinch işler, çevirme yapma
				if countCameraTouches() == 1 then
					pendingTouchDelta += Vector2.new(input.Delta.X, input.Delta.Y)
				end
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			local mode = currentMode
			if mode and isFollowMode(mode) then
				local profile = getProfile(mode)
				if followSubject then
					local _, base, minD, maxD = framedValues(profile)
					local d = base * (vehicleZoom[mode] or 1) - input.Position.Z * CameraConfig.ZoomStep * 1.5
					vehicleZoom[mode] = math.clamp(d, minD, maxD) / base
				else
					local d = (userDistance[mode] or profile.Distance) - input.Position.Z * CameraConfig.ZoomStep
					userDistance[mode] = math.clamp(d, profile.MinDistance, profile.MaxDistance)
				end
			end
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		-- Yakınlaştırma sadece iki parmak da kamera alanındayken (joystick parmağı + kamera parmağı pinch sayılmaz)
		if processed or (state ~= Enum.UserInputState.End and countCameraTouches() < 2) then
			lastPinchScale = nil
			return
		end
		-- Başlangıçta ya da (ikinci kamera parmağı pinch başladıktan sonra kaydedildiyse) ilk değişimde başla
		if state == Enum.UserInputState.Begin or (state == Enum.UserInputState.Change and not lastPinchScale) then
			lastPinchScale = scale
		elseif state == Enum.UserInputState.Change and lastPinchScale then
			local mode = currentMode
			if mode and isFollowMode(mode) then
				local profile = getProfile(mode)
				local ratio = scale / math.max(lastPinchScale, 0.01)
				if followSubject then
					local _, base, minD, maxD = framedValues(profile)
					local d = base * (vehicleZoom[mode] or 1) / math.max(ratio, 0.01)
					vehicleZoom[mode] = math.clamp(d, minD, maxD) / base
				else
					local d = (userDistance[mode] or profile.Distance) / math.max(ratio, 0.01)
					userDistance[mode] = math.clamp(d, profile.MinDistance, profile.MaxDistance)
				end
			end
			lastPinchScale = scale
		else
			lastPinchScale = nil
		end
	end)
end

-- ===== Çarpışma =====
local function castSafe(origin: Vector3, target: Vector3, radius: number): Vector3
	local offset = target - origin
	local length = offset.Magnitude
	if length < 1e-3 then
		return target
	end
	local result = workspace:Spherecast(origin, radius, offset, raycastParams)
	if result then
		return origin + offset.Unit * math.max(result.Distance - 0.05, 0)
	end
	return target
end

-- ===== Kare güncellemesi =====
local function stepFollow(dt: number, mode: string)
	local profile = getProfile(mode)
	local character = controllers.CharacterController
	local root = character:GetRootPart()
	local subject: BasePart? = followSubject or root
	if not subject or not subject.Parent then
		return -- karakter yok (ölüm/yeniden doğma): son kareyi koru
	end

	applyLookInput(dt, profile)

	-- Araç hızı (hız hissi, takip keskinliği)
	local subjectVelocity = if followSubject then followSubject.AssemblyLinearVelocity else Vector3.zero
	local flatSpeed = Vector3.new(subjectVelocity.X, 0, subjectVelocity.Z).Magnitude
	local speedFrac = if followSubject then math.clamp(flatSpeed / (if followFraming then followFraming.MaxSpeed else 100), 0, 1) else 0

	-- Araç kamerası: oyuncu bir süre bakış girişi yapmazsa aracın arkasına yumuşakça döner.
	-- Yüksek hızda daha sıkı takip; yokuşta aracın eğimini kısmen izler (rampada yol görünür kalır).
	if autoFollowHeading and followSubject and os.clock() - lastLookInput > AUTO_FOLLOW_DELAY then
		if flatSpeed > 4 then
			local look = followSubject.CFrame.LookVector
			local heading = math.atan2(-look.X, -look.Z) -- aracın burnu: geri giderken kamera dönmez
			local sharpness = (profile.AutoFollowSharpness or 2.2) * (0.7 + 0.8 * speedFrac)
			local alpha = MathUtil.SmoothAlpha(sharpness, dt)
			local vehiclePitch = math.asin(math.clamp(look.Y, -1, 1))
			local wantedPitch = (profile.AutoPitch or -12) * DEG + vehiclePitch * (profile.PitchFollow or 0)
			targetYaw = MathUtil.LerpAngle(targetYaw, heading, alpha)
			targetPitch = MathUtil.Lerp(targetPitch, wantedPitch, alpha)
		end
	end

	local smoothing = getSettings():Get("CameraSmoothing")
	local rotAlpha = if smoothing then MathUtil.SmoothAlpha(profile.RotationSharpness, dt) else 1
	yaw = MathUtil.LerpAngle(yaw, targetYaw, rotAlpha)
	pitch = MathUtil.Lerp(pitch, targetPitch, rotAlpha)

	-- Pivot: avatarın GERÇEK göz yüksekliği (kısa/uzun avatarlar, R6/R15)
	local eyeHeight = if followSubject then 0 else character:GetEyeHeight()
	local targetPivot = subject.Position + Vector3.new(0, eyeHeight, 0)
	-- Işınlanma algılama: hedef çok uzaktaysa yumuşatma yerine anında yerleş
	if pivot and ((pivot :: Vector3) - targetPivot).Magnitude > 25 then
		snapNextFrame = true
	end
	if snapNextFrame or pivot == nil or profile.Distance == 0 then
		pivot = targetPivot
	elseif followSubject then
		-- Araç: yatayda hız ileri beslemesi → hızla artan gecikme (eski: hız/keskinlik ≈ 12 stud) yok;
		-- dikeyde ayrı, daha yumuşak süzgeç → tümsekler kamerayı sarsmaz.
		local current = pivot :: Vector3
		local predicted = current + Vector3.new(subjectVelocity.X, 0, subjectVelocity.Z) * dt
		local a = MathUtil.SmoothAlpha(profile.FollowSharpness, dt)
		local ay = MathUtil.SmoothAlpha(profile.VerticalSharpness or profile.FollowSharpness, dt)
		pivot = Vector3.new(
			MathUtil.Lerp(predicted.X, targetPivot.X, a),
			MathUtil.Lerp(current.Y, targetPivot.Y, ay),
			MathUtil.Lerp(predicted.Z, targetPivot.Z, a)
		)
	else
		pivot = (pivot :: Vector3):Lerp(targetPivot, MathUtil.SmoothAlpha(profile.FollowSharpness, dt))
	end
	local pivotPos = pivot :: Vector3

	local rotation = CFrame.fromOrientation(pitch, yaw, 0)
	local yawOnly = CFrame.fromOrientation(0, yaw, 0)
	-- Motosiklette yatışın bir kısmını izle (profil RollFollow); otomobilde 0
	local rollTarget = 0
	if followSubject and profile.RollFollow and profile.RollFollow > 0 then
		rollTarget = math.asin(math.clamp(followSubject.CFrame.RightVector.Y, -1, 1)) * profile.RollFollow
	end
	vehicleRoll = MathUtil.Lerp(vehicleRoll, rollTarget, MathUtil.SmoothAlpha(6, dt))

	local cameraPosition: Vector3
	if profile.Distance == 0 then
		-- Birinci şahıs: göz hizası, hafif ileri (gövdeye bakınca içini görmesin)
		local forward = yawOnly.LookVector
		cameraPosition = pivotPos + Vector3.new(0, profile.ShoulderOffset.Y, 0) + forward * 0.25
		applyCharacterTransparency(1, true)

		-- Karakter kameranın yönüne bakar (koltukta değilse)
		local humanoid = character:GetHumanoid()
		if root and humanoid and humanoid.SeatPart == nil and humanoid.Health > 0 then
			root.CFrame = CFrame.new(root.Position) * CFrame.fromOrientation(0, yaw, 0)
		end
		currentDistance = 0
	else
		local side = getSettings():Get("ShoulderSide")
		local shoulder = profile.ShoulderOffset
		local shoulderY, framedDistance = framedValues(profile)
		-- 1) Pivot → omuz noktası (yan + yukarı), duvara girmesin
		local shoulderTarget = pivotPos + yawOnly:VectorToWorldSpace(Vector3.new(shoulder.X * side, shoulderY, 0))
		local shoulderPoint = castSafe(pivotPos, shoulderTarget, profile.CollisionRadius)

		-- 2) Omuz → geri (oyuncu yakınlaştırma tercihi; araçta hızla biraz açılır)
		local wanted
		if followSubject then
			wanted = framedDistance * (vehicleZoom[mode] or 1) + (profile.SpeedDistanceBoost or 0) * speedFrac
		else
			wanted = userDistance[mode] or profile.Distance
		end
		local backTarget = shoulderPoint - rotation.LookVector * wanted
		local safePoint = castSafe(shoulderPoint, backTarget, profile.CollisionRadius)
		local allowed = (safePoint - shoulderPoint).Magnitude

		if snapNextFrame or allowed < currentDistance then
			currentDistance = allowed -- içeri anında (duvar içinden görmemek için)
		else
			currentDistance = MathUtil.Lerp(currentDistance, allowed, MathUtil.SmoothAlpha(6, dt)) -- dışarı yumuşak
		end
		cameraPosition = shoulderPoint - rotation.LookVector * currentDistance

		-- Kamera kafaya çok yaklaşırsa karakteri soldur
		local closeness = (cameraPosition - pivotPos).Magnitude
		local fadeDistance = CameraConfig.CharacterFadeDistance
		if closeness < fadeDistance and not followSubject then
			applyCharacterTransparency(math.clamp(1 - (closeness / fadeDistance), 0, 0.9), false)
		else
			applyCharacterTransparency(0, false)
		end
	end
	snapNextFrame = false

	-- FOV: depar sırasında / araçta hızla hafif artış = hız hissi ("Hareketi azalt" kapatır)
	local reduceMotion = getSettings():Get("ReduceMotion") == true
	local fovTarget = profile.FieldOfView + getSettings():Get("FieldOfViewOffset")
	if character:GetMovementState() == Constants.MovementStates.Sprint and not followSubject then
		fovTarget += profile.SprintFovBoost
	end
	if followSubject and not reduceMotion then
		fovTarget += (profile.SpeedFovBoost or 0) * speedFrac ^ 1.5
	end
	currentFov = MathUtil.Lerp(currentFov, fovTarget, MathUtil.SmoothAlpha(8, dt))

	local final = CFrame.new(cameraPosition) * rotation * CFrame.Angles(0, 0, vehicleRoll)
	local fov = currentFov
	if transitionFrom then
		transitionTime += dt
		local t = math.clamp(transitionTime / transitionDuration, 0, 1)
		local e = t * t * (3 - 2 * t)
		final = (transitionFrom :: CFrame):Lerp(final, e)
		fov = MathUtil.Lerp(transitionFromFov, currentFov, e)
		if t >= 1 then
			transitionFrom = nil
		end
	end
	camera.CFrame = final
	camera.Focus = CFrame.new(pivotPos)
	camera.FieldOfView = fov
end

local function stepScripted(dt: number, entry)
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	applyCharacterTransparency(0, false)
	-- Supplier: fn(dt) -> CFrame, FOV?, Focus? (Focus: render ayrıntı/ışık merkezi; menü çekimleri için)
	local ok, cframe, fov, focus = pcall(entry.Supplier, dt)
	if ok and typeof(cframe) == "CFrame" then
		camera.CFrame = cframe
		if type(fov) == "number" then
			currentFov = fov
			camera.FieldOfView = fov
		end
		if typeof(focus) == "CFrame" then
			camera.Focus = focus
		end
	else
		Log.Warn("Senaryolu kamera fonksiyonu hata verdi, istek kaldırılıyor:", cframe)
		for owner, e in overrides do
			if e == entry then
				CameraController:Release(owner)
			end
		end
	end
end

local function restoreDefaultCamera()
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	running = false
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = controllers.CharacterController:GetHumanoid()
	if humanoid then
		camera.CameraSubject = humanoid
		humanoid.AutoRotate = true
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	applyCharacterTransparency(0, false)
end

local function step(dt: number)
	local ok, err = pcall(function()
		if camera ~= workspace.CurrentCamera then
			camera = workspace.CurrentCamera
		end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		filterRefreshTimer -= dt
		if filterRefreshTimer <= 0 then
			filterRefreshTimer = 0.5
			refreshFilter()
		end
		updateResolvedMode()
		local mode, entry = resolveMode()
		if entry and entry.Supplier then
			stepScripted(dt, entry)
		else
			stepFollow(dt, mode)
		end
	end)
	if ok then
		consecutiveErrors = 0
	else
		consecutiveErrors += 1
		Log.Warn("Kamera karesi hata verdi:", err)
		if consecutiveErrors >= CameraConfig.MaxConsecutiveErrors then
			Log.Error("Kamera güvenlik ağı devrede: Roblox varsayılan kamerasına dönülüyor.")
			restoreDefaultCamera()
		end
	end
end

-- ===== Genel API =====
function CameraController:GetMode(): string
	return currentMode or baseMode
end

function CameraController:SetBaseMode(mode: string)
	if not table.find(Constants.PlayerSelectableCameraModes, mode) then
		Log.Warn("Temel mod olarak seçilemez:", mode)
		return
	end
	baseMode = mode
	updateResolvedMode()
end

function CameraController:RequestMode(owner: string, mode: string, priority: number?)
	assert(isFollowMode(mode), "RequestMode sadece takip modları içindir: " .. tostring(mode))
	overrideOrder += 1
	overrides[owner] = { Mode = mode, Priority = priority or 10, Supplier = nil, Order = overrideOrder }
	updateResolvedMode()
end

function CameraController:RequestScripted(owner: string, mode: string, priority: number?, supplier: (number) -> (CFrame, number?))
	overrideOrder += 1
	overrides[owner] = { Mode = mode, Priority = priority or 50, Supplier = supplier, Order = overrideOrder }
	updateResolvedMode()
end

function CameraController:Release(owner: string)
	if overrides[owner] then
		overrides[owner] = nil
		updateResolvedMode()
	end
end

-- Araç sistemleri takip edilecek parçayı burada verir; nil → karakter.
-- framing: { Length, RoofHeight (şasi merkezine göre), MaxSpeed } → mesafe/yükseklik araca göre.
-- smooth: true ise kamera eski karesinden yumuşakça yeni hedefe geçer (araca binme/inme).
function CameraController:SetFollowSubject(part: BasePart?, framing: Framing?, smooth: boolean?)
	if smooth then
		beginTransition()
	end
	followSubject = part
	followFraming = if part then framing else nil
	vehicleRoll = 0
	snapNextFrame = true
	refreshFilter()
end

function CameraController:SetAutoFollowHeading(enabled: boolean)
	autoFollowHeading = enabled
end

function CameraController:SetCursorFree(owner: string, free: boolean)
	cursorFreeOwners[owner] = if free then true else nil
end

-- smooth = false/nil: anında yerleş (yeniden doğma, perde arkasında geçiş) ve süren geçişi iptal et.
-- smooth = true: aynı hedef, ama kamera bulunduğu kareden oraya yumuşakça kayar.
function CameraController:SnapBehindCharacter(smooth: boolean?)
	if smooth then
		if not transitionFrom then
			beginTransition()
		end
	else
		cancelTransition()
	end
	local root = followSubject or controllers.CharacterController:GetRootPart()
	if root then
		local look = root.CFrame.LookVector
		targetYaw = math.atan2(-look.X, -look.Z)
		targetPitch = -10 * DEG
		yaw, pitch = targetYaw, targetPitch
		snapNextFrame = true
	end
	-- Ani yerleşmede birikmiş bakış girişini at (ör. menüdeyken yapılan dokunmatik kaydırmalar)
	pendingTouchDelta = Vector2.zero
	gamepadLook = Vector2.zero
end

-- Anahtar karelerle sinematik geçiş. Bitince (veya hata/zaman aşımında) kamera MUTLAKA geri döner.
-- keyframes: { { CFrame = CFrame, Duration = number, FieldOfView = number? }, ... }
-- İlk karenin Duration'ı yok sayılır (başlangıç noktası).
function CameraController:PlayCinematic(keyframes: { any }, owner: string?)
	local ownerName = owner or "Cinematic"
	assert(#keyframes >= 2, "En az 2 anahtar kare gerekli")
	local completed = Signal.new()
	local total = 0
	for i = 2, #keyframes do
		total += math.max(keyframes[i].Duration or 1, 0.01)
	end
	local elapsed = 0
	local finished = false

	local function finish()
		if finished then
			return
		end
		finished = true
		CameraController:Release(ownerName)
		completed:Fire()
	end

	local function ease(t: number): number
		return if t < 0.5 then 4 * t * t * t else 1 - (-2 * t + 2) ^ 3 / 2 -- cubic in-out
	end

	CameraController:RequestScripted(ownerName, Modes.Cinematic, 90, function(dt)
		elapsed += dt
		local time = elapsed
		for i = 2, #keyframes do
			local duration = math.max(keyframes[i].Duration or 1, 0.01)
			if time <= duration or i == #keyframes then
				local a, b = keyframes[i - 1], keyframes[i]
				local t = ease(math.clamp(time / duration, 0, 1))
				local fovA = a.FieldOfView or 70
				local fovB = b.FieldOfView or fovA
				if elapsed >= total then
					task.defer(finish)
				end
				return a.CFrame:Lerp(b.CFrame, t), MathUtil.Lerp(fovA, fovB, t)
			end
			time -= duration
		end
		task.defer(finish)
		return keyframes[#keyframes].CFrame, keyframes[#keyframes].FieldOfView
	end)

	-- Güvenlik zamanlayıcısı: ne olursa olsun kamera kilitli kalmaz (Bölüm 18.4)
	task.delay(total + 2, finish)

	return {
		Completed = completed,
		Cancel = finish,
	}
end

-- ===== Yaşam döngüsü =====
function CameraController:Init(allControllers)
	controllers = allControllers
end

function CameraController:Start()
	local settingsController = controllers.SettingsController
	baseMode = settingsController:Get("CameraMode")
	settingsController.Changed:Connect(function(key, value)
		if key == "CameraMode" then
			CameraController:SetBaseMode(value)
		end
	end)

	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "CameraCycle" then
			local list = Constants.PlayerSelectableCameraModes
			local index = table.find(list, baseMode) or 0
			local nextMode = list[(index % #list) + 1]
			settingsController:Set("CameraMode", nextMode)
		elseif action == "FreeCursor" then
			CameraController:SetCursorFree("FreeCursorKey", true)
		end
	end)
	controllers.InputController.ActionEnded:Connect(function(action)
		if action == "FreeCursor" then
			CameraController:SetCursorFree("FreeCursorKey", false)
		end
	end)

	controllers.CharacterController.CharacterChanged:Connect(function(character)
		collectCharacterParts(character)
		if character then
			local root = controllers.CharacterController:GetRootPart()
			if root then
				-- Yeni doğumda kamera karakterin arkasına yerleşir
				task.defer(function()
					CameraController:SnapBehindCharacter()
				end)
			end
			setAutoRotate(currentMode ~= Modes.FirstPerson)
			if descendantConnection then
				descendantConnection:Disconnect()
			end
			descendantConnection = character.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") then
					table.insert(characterParts, d)
					lastTransparency = -1
				end
			end)
		elseif descendantConnection then
			descendantConnection:Disconnect()
			descendantConnection = nil
		end
	end)
	collectCharacterParts(controllers.CharacterController:GetCharacter())

	connectInput()
	updateResolvedMode()
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, step)
	running = true
end

function CameraController:IsRunning(): boolean
	return running
end

return CameraController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties>
<string name="Name">CharacterController</string>

<ProtectedString name="Source"><![CDATA[-- CharacterController: yerel oyuncunun (kendi avatarı) karakter takibi ve hareket durumları.
-- Yürüme (Walk) / Koşma (Run, varsayılan) / Depar (Sprint).
-- Hareket animasyonları avatarın kendi Animate scriptiyle oynar; hız değişince
-- Animate otomatik olarak yürüme/koşma animasyonunu ve hızını ayarlar.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Signal = require(Shared.Utilities.Signal)
local Maid = require(Shared.Utilities.Maid)
local Log = require(Shared.Utilities.Log).new("Character")

local CharacterController = {
	Name = "CharacterController",
	Priority = 3,
	CharacterChanged = Signal.new(), -- (character | nil)
	MovementStateChanged = Signal.new(), -- (state)
}

local player = Players.LocalPlayer
local controllers
local charMaid = Maid.new()

local character: Model? = nil
local humanoid: Humanoid? = nil
local rootPart: BasePart? = nil
local walkToggled = false
local movementState = Constants.MovementStates.Run
local movementLocks: { [string]: boolean } = {} -- örn. diyalog sırasında hareketi kilitlemek için

function CharacterController:GetCharacter(): Model?
	return character
end

function CharacterController:GetHumanoid(): Humanoid?
	return humanoid
end

function CharacterController:GetRootPart(): BasePart?
	return rootPart
end

function CharacterController:GetRigType(): string
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return "R15"
	end
	return "R6"
end

-- Kökten göz hizasına yükseklik. Sunucunun ölçtüğü değer yoksa yerelde ölçer.
function CharacterController:GetEyeHeight(): number
	if not character or not rootPart then
		return 1.5
	end
	local attr = character:GetAttribute(Constants.Attributes.EyeHeight)
	if type(attr) == "number" then
		return attr
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return (head.Position.Y - rootPart.Position.Y) + head.Size.Y * 0.1
	end
	return 1.5
end

function CharacterController:GetMovementState(): string
	return movementState
end

function CharacterController:IsAlive(): boolean
	return humanoid ~= nil and humanoid.Health > 0
end

-- Hareketi kilitle/aç (diyalog, sinematik vb.). Birden fazla sahip olabilir.
function CharacterController:SetMovementLocked(owner: string, locked: boolean)
	movementLocks[owner] = if locked then true else nil
	CharacterController:_applySpeed()
end

function CharacterController:IsMovementLocked(): boolean
	return next(movementLocks) ~= nil
end

function CharacterController:_applySpeed()
	if not humanoid then
		return
	end
	if self:IsMovementLocked() then
		humanoid.WalkSpeed = 0
		return
	end
	local m = Config.Movement
	if movementState == Constants.MovementStates.Sprint then
		humanoid.WalkSpeed = m.SprintSpeed
	elseif movementState == Constants.MovementStates.Walk then
		humanoid.WalkSpeed = m.WalkSpeed
	else
		humanoid.WalkSpeed = m.RunSpeed
	end
end

local function setMovementState(newState: string)
	if newState == movementState then
		return
	end
	movementState = newState
	CharacterController:_applySpeed()
	CharacterController.MovementStateChanged:Fire(newState)
end

local function evaluateMovementState()
	if not humanoid then
		return
	end
	local input = controllers.InputController
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	if input:IsActionActive("Sprint") and moving and humanoid.SeatPart == nil then
		setMovementState(Constants.MovementStates.Sprint)
	elseif walkToggled then
		setMovementState(Constants.MovementStates.Walk)
	else
		setMovementState(Constants.MovementStates.Run)
	end
end

local function onCharacterAdded(newCharacter: Model)
	charMaid:Clean()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid", 10) :: Humanoid?
	rootPart = newCharacter:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not rootPart or player.Character ~= newCharacter then
		return
	end
	movementState = Constants.MovementStates.Run
	CharacterController:_applySpeed()

	charMaid:Give(humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(evaluateMovementState))
	charMaid:Give(humanoid.Died:Connect(function()
		setMovementState(Constants.MovementStates.Run)
	end))
	charMaid:Give(newCharacter.AncestryChanged:Connect(function(_, parent)
		if parent == nil and character == newCharacter then
			charMaid:Clean()
			character, humanoid, rootPart = nil, nil, nil
			CharacterController.CharacterChanged:Fire(nil)
		end
	end))

	Log.Info("Karakter yüklendi:", CharacterController:GetRigType())
	CharacterController.CharacterChanged:Fire(newCharacter)
end

function CharacterController:Init(allControllers)
	controllers = allControllers
end

function CharacterController:Start()
	local input = controllers.InputController
	input.ActionBegan:Connect(function(action)
		if action == "Sprint" then
			evaluateMovementState()
		elseif action == "WalkToggle" then
			walkToggled = not walkToggled
			evaluateMovementState()
		end
	end)
	input.ActionEnded:Connect(function(action)
		if action == "Sprint" then
			evaluateMovementState()
		end
	end)

	-- Başka bir script WalkSpeed'i değiştirirse (ör. Roblox varsayılanları) düzelt — düşük frekans
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.5 then
			accumulator = 0
			if humanoid and not CharacterController:IsMovementLocked() then
				CharacterController:_applySpeed()
			end
		end
	end)

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
end

return CharacterController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties>
<string name="Name">DebugHUDController</string>

<ProtectedString name="Source"><![CDATA[-- DebugHUDController: Aşama testleri için küçük bilgi paneli (sağ üst).
-- Her kare DEĞİL, 0.25 sn'de bir güncellenir (Bölüm 27.4). F3 ile açılır/kapanır.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Config = require(Shared.Config)
local MapDefinitions = require(Shared.MapDefinitions)
local Lighting = game:GetService("Lighting")
local UIConfig = require(Modules.UIConfig)

local DebugHUDController = {
	Name = "DebugHUDController",
	Priority = 9,
}

local player = Players.LocalPlayer
local controllers
local gui: ScreenGui
local label: TextLabel
local sessionInfo = { GameMode = "?", Version = Config.Version }
local frameTimes = {}

function DebugHUDController:SetSessionInfo(info)
	sessionInfo = info
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "DebugHUD"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 100
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.Enabled = RunService:IsStudio() and Config.Debug.ShowDebugHUDInStudio

	label = Instance.new("TextLabel")
	label.Name = "Info"
	label.AnchorPoint = Vector2.new(1, 0)
	label.Position = UDim2.new(1, -10, 0, 10)
	label.Size = UDim2.fromOffset(270, 196)
	label.BackgroundColor3 = UIConfig.Colors.Background
	label.BackgroundTransparency = 0.35
	label.TextColor3 = UIConfig.Colors.Text
	label.FontFace = UIConfig.Fonts.Mono
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Text = ""
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingTop = UDim.new(0, 6)
	padding.Parent = label
	label.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui")
end

local function refresh()
	if not gui.Enabled then
		return
	end
	local sum = 0
	for _, t in frameTimes do
		sum += t
	end
	local fps = if #frameTimes > 0 and sum > 0 then #frameTimes / sum else 0
	table.clear(frameTimes)

	local cc = controllers.CharacterController
	local root = cc:GetRootPart()
	local speed = if root then Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude else 0
	local pos = if root then root.Position else Vector3.zero
	local ping = math.floor(player:GetNetworkPing() * 2000) -- gidiş-dönüş ms

	label.Text = table.concat({
		string.format("%s  %s  [%s]", Config.GameName, sessionInfo.Version or "?", sessionInfo.GameMode or "?"),
		string.format("FPS %d   Ping %d ms   Bellek %d MB", math.floor(fps + 0.5), ping, math.floor(Stats:GetTotalMemoryUsageMb())),
		string.format("Cihaz: %s", controllers.InputController:GetDeviceType()),
		string.format("Kamera: %s", controllers.CameraController:GetMode()),
		string.format("Rig: %s   Göz: %.2f", cc:GetRigType(), cc:GetEyeHeight()),
		string.format("Hareket: %s   Hız: %.1f", cc:GetMovementState(), speed),
		string.format("Konum: %d, %d, %d", math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z)),
		string.format("Bölge: %s", (function()
			local d = MapDefinitions.GetDistrictAt(pos)
			return if d then d.Name else "—"
		end)()),
		string.format("Saat: %02d:%02d   Dünya: %s", math.floor(Lighting.ClockTime), math.floor((Lighting.ClockTime % 1) * 60),
			(function()
				local world = workspace:FindFirstChild("World")
				if not world then
					return "?"
				end
				if world:GetAttribute("Baked") then
					return "pişmiş"
				end
				local progress = world:GetAttribute("BuildProgress") or 0
				return if world:GetAttribute("WorldReady") then string.format("%d parça", world:GetAttribute("PartCount") or 0)
					else string.format("inşa %%%d", math.floor(progress * 100))
			end)()),
	}, "\n")
end

function DebugHUDController:Init(allControllers)
	controllers = allControllers
end

function DebugHUDController:Start()
	build()
	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "ToggleDebug" then
			gui.Enabled = not gui.Enabled
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if gui.Enabled and #frameTimes < 240 then
			table.insert(frameTimes, dt)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			pcall(refresh)
		end
	end)
end

return DebugHUDController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties>
<string name="Name">InputController</string>

<ProtectedString name="Source"><![CDATA[-- InputController: cihaz algılama + eylem tabanlı giriş.
-- Diğer sistemler tuşlarla değil EYLEMLERLE çalışır ("Sprint", "CameraCycle"...).
-- Klavye, gamepad ve mobil butonlar aynı eylem hattından geçer (Bölüm 21).

local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Signal = require(Shared.Utilities.Signal)
local Constants = require(Shared.Constants)
local InputConfig = require(Modules.InputConfig)
local Log = require(Shared.Utilities.Log).new("Input")

local InputController = {
	Name = "InputController",
	Priority = 2,
	ActionBegan = Signal.new(), -- (actionName)
	ActionEnded = Signal.new(), -- (actionName)
	DeviceChanged = Signal.new(), -- (deviceType)
}

local activeActions: { [string]: boolean } = {}
-- Analog kanallar (ör. mobil direksiyon pedi "VehSteer": -1..1). Sahibi değeri yazar, okuyan çeker.
local analogValues: { [string]: number } = {}
local deviceType = Constants.DeviceTypes.KeyboardMouse

local function classify(inputType: Enum.UserInputType): string?
	if inputType == Enum.UserInputType.Touch then
		return Constants.DeviceTypes.Touch
	end
	if inputType.Name:find("Gamepad") then
		return Constants.DeviceTypes.Gamepad
	end
	if inputType == Enum.UserInputType.Keyboard or inputType.Name:find("Mouse") then
		return Constants.DeviceTypes.KeyboardMouse
	end
	return nil
end

local function setDevice(newType: string?)
	if newType and newType ~= deviceType then
		deviceType = newType
		Log.Info("Cihaz değişti:", newType)
		InputController.DeviceChanged:Fire(newType)
	end
end

function InputController:GetDeviceType(): string
	return deviceType
end

function InputController:IsTouch(): boolean
	return deviceType == Constants.DeviceTypes.Touch
end

function InputController:IsActionActive(actionName: string): boolean
	return activeActions[actionName] == true
end

function InputController:SetAnalog(name: string, value: number?)
	if value == nil or value == 0 or value ~= value then
		analogValues[name] = nil
	else
		analogValues[name] = math.clamp(value, -1, 1)
	end
end

function InputController:GetAnalog(name: string): number
	return analogValues[name] or 0
end

-- Mobil butonlar ve testler bu fonksiyonla eylem tetikler
function InputController:Trigger(actionName: string, began: boolean)
	if began then
		if activeActions[actionName] then
			return
		end
		activeActions[actionName] = true
		InputController.ActionBegan:Fire(actionName)
	else
		if not activeActions[actionName] then
			return
		end
		activeActions[actionName] = nil
		InputController.ActionEnded:Fire(actionName)
	end
end

local function bindAction(actionName: string, def)
	local inputs = {}
	for _, key in def.Keys do
		table.insert(inputs, key)
	end
	for _, key in def.Gamepad do
		table.insert(inputs, key)
	end
	if #inputs == 0 then
		return
	end
	-- Bağlam eylemleri (Vehicle, Menu) yürürken varsayılan kontrollerin önüne geçmeli
	local priority = if def.Context and def.Context ~= "OnFoot" then Enum.ContextActionPriority.High.Value else Enum.ContextActionPriority.Default.Value
	ContextActionService:BindActionAtPriority("OW_" .. actionName, function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:Trigger(actionName, true)
			if not def.Hold then
				-- Tek seferlik eylem: hemen bitir
				InputController:Trigger(actionName, false)
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			if def.Hold then
				InputController:Trigger(actionName, false)
			end
		end
		return Enum.ContextActionResult.Sink
	end, false, priority, table.unpack(inputs))
end

local activeContexts: { [string]: boolean } = { OnFoot = true }

-- Bağlam aç/kapat: o bağlamdaki eylemler bağlanır veya çözülür (basılı kalanlar bırakılır)
function InputController:SetContext(contextName: string, enabled: boolean)
	if (activeContexts[contextName] == true) == enabled then
		return
	end
	activeContexts[contextName] = if enabled then true else nil
	for actionName, def in InputConfig.Actions do
		if (def.Context or "OnFoot") == contextName then
			if enabled then
				bindAction(actionName, def)
			else
				ContextActionService:UnbindAction("OW_" .. actionName)
				InputController:Trigger(actionName, false)
			end
		end
	end
	if not enabled and contextName == "Vehicle" then
		analogValues.VehSteer = nil -- araçtan çıkınca direksiyon değeri takılı kalmasın
	end
end

function InputController:IsContextActive(contextName: string): boolean
	return activeContexts[contextName] == true
end

function InputController:Init()
	-- İlk cihaz tahmini
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		deviceType = Constants.DeviceTypes.Touch
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		deviceType = Constants.DeviceTypes.Gamepad
	end
	local last = classify(UserInputService:GetLastInputType())
	if last then
		deviceType = last
	end
end

function InputController:Start()
	for actionName, def in InputConfig.Actions do
		if (def.Context or "OnFoot") == "OnFoot" then
			bindAction(actionName, def)
		end
	end
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		setDevice(classify(inputType))
	end)
	-- Pencere odağı kaybolursa basılı eylemleri bırak (takılı kalan depar vb. olmasın)
	UserInputService.WindowFocusReleased:Connect(function()
		for actionName in table.clone(activeActions) do
			InputController:Trigger(actionName, false)
		end
		table.clear(analogValues)
	end)
end

return InputController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties>
<string name="Name">MobileControlsController</string>

<ProtectedString name="Source"><![CDATA[-- MobileControlsController: dokunmatik cihazlar için ÖZEL buton katmanı (Bölüm 21).
--
-- Yaya (OnFoot): Depar (toggle) ve Kamera modu. Joystick ve zıplama Roblox'un kendi dokunmatik kontrolleridir;
-- bizim butonlar zıplama butonunun SOLUNA ve ÜSTÜNE dizilir.
--
-- Sürüş (Aşama 3): yerleşimin tamamı ReplicatedStorage/Modules/DrivingLayout'tan gelir (HUD ile aynı hesap):
--   sol alt  : analog direksiyon pedi (parmağın konumu = direksiyon açısı) ya da ◀ ▶ butonları (ayar)
--   sağ alt  : büyük GAZ, solunda FREN, frenin üstünde EL FRENİ, gazın üstünde KORNA
--   üst sağ  : İN · FAR · ÇEVİR;   sinyaller direksiyonun üstünde
--   ayrılmış : sol üst harita alanı, üst orta hız çubuğu (VehicleHUDController)
-- tools/test_driving_layout.py bu yerleşimi 10 ekran boyutu × ölçek × araç türü için çakışma/taşma/
-- en küçük dokunma hedefi (44 px) açısından denetler.
--
-- Sürüşte Roblox'un joystick ve zıplama butonu gizlenir (GuiService.TouchControlsEnabled = false):
-- zıplama koltuktan atar ve gaz butonunun altında kalabilirdi.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local UIConfig = require(Modules.UIConfig)
local DrivingLayout = require(Modules:WaitForChild("DrivingLayout"))
local Log = require(Shared.Utilities.Log).new("MobileControls")

local MobileControlsController = {
	Name = "MobileControlsController",
	Priority = 8,
}

local player = Players.LocalPlayer
local controllers
local Strings -- FrontEnd/Strings (Init'te yüklenir)
local screenGui: ScreenGui? = nil
local root: Frame? = nil
local buttons: { [string]: GuiObject } = {}
local layoutName = "OnFoot"
local holdInputs: { [InputObject]: string } = {}
local warnedLayout = false

-- Sürüş butonları: { isim, etiket anahtarı, eylem, basılı-tut?, görünür olduğu düzenler, stil }
local VEHICLE_BUTTONS = {
	{ "SteerL", nil, "VehLeft", true, { Car = true, Motorcycle = true }, "ChevronL" },
	{ "SteerR", nil, "VehRight", true, { Car = true, Motorcycle = true }, "ChevronR" },
	{ "Gas", "Mobile.Gas", "VehGas", true, { Car = true, Motorcycle = true }, "Gas" },
	{ "Brake", "Mobile.Brake", "VehBrake", true, { Car = true, Motorcycle = true }, "Brake" },
	{ "Handbrake", "Mobile.Handbrake", "VehHandbrake", true, { Car = true }, "Round" },
	{ "Horn", "Mobile.Horn", "VehHorn", true, { Car = true, Motorcycle = true }, "Round" },
	{ "Exit", "Mobile.Exit", "VehExit", false, { Car = true, Motorcycle = true, Passenger = true }, "Round" },
	{ "Lights", "Mobile.Lights", "VehLights", false, { Car = true, Motorcycle = true }, "Round" },
	{ "Flip", "Mobile.Flip", "VehFlip", false, { Car = true }, "Round" },
	{ "IndL", nil, "VehIndLeft", false, { Car = true, Motorcycle = true }, "ChevronL" },
	{ "IndR", nil, "VehIndRight", false, { Car = true, Motorcycle = true }, "ChevronR" },
}
local vehicleButtons: { [string]: GuiObject } = {}

-- Direksiyon pedi
local pad: TextButton? = nil
local padKnob: Frame? = nil
local padInput: InputObject? = nil
local PAD_DEADZONE = 0.06
local PAD_CURVE = 1.25 -- merkez çevresinde ince ayar, uçta tam direksiyon

local CAMERA_LABELS = {
	ThirdPerson = "OMUZ",
	ThirdPersonAlt = "TAKİP",
	FirstPerson = "GÖZ",
}

local function text(key: string): string
	return if Strings then Strings.Get(key) else key
end

local function isVehicleLayout(name: string): boolean
	return name == "Car" or name == "Motorcycle" or name == "Passenger"
end

-- Roblox zıplama butonunun kapladığı alan (TouchGui'deki resmi yerleşimle aynı mantık)
local function getJumpButtonRect(viewport: Vector2): (number, number, number)
	local minAxis = math.min(viewport.X, viewport.Y)
	if minAxis <= 500 then
		return 70, 25, 20 -- boyut, sağ boşluk, alt boşluk
	end
	return 120, 50, 90
end

local function getUserScale(): number
	return controllers and controllers.SettingsController and controllers.SettingsController:Get("MobileButtonScale") or 1
end

local function getButtonSize(viewport: Vector2): number
	return DrivingLayout.ButtonSize(viewport.X, viewport.Y, getUserScale())
end

-- ===== Buton görünümü =====
local function decorate(button: GuiObject, radiusScale: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(radiusScale, 0)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = 2
	stroke.Color = UIConfig.Colors.TextMuted
	stroke.Transparency = 0.3
	stroke.Parent = button
end

local function makeButton(name: string, label: string, radiusScale: number?): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AutoButtonColor = false
	button.AutoLocalize = false
	button.Text = label
	button.TextScaled = true
	button.FontFace = UIConfig.Fonts.Title
	button.TextColor3 = UIConfig.Colors.Text
	button.BackgroundColor3 = UIConfig.Colors.Background
	button.BackgroundTransparency = UIConfig.Mobile.BackgroundTransparency
	button.AnchorPoint = Vector2.new(1, 1)
	decorate(button, radiusScale or 0.5)
	local padding = Instance.new("UIPadding")
	local p = UDim.new(0.22, 0)
	padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = p, p, p, p
	padding.Parent = button
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 22
	limit.Parent = button

	-- Basma geri bildirimi
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			TweenService:Create(button, UIConfig.Tween.Fast, { BackgroundTransparency = 0.1 }):Play()
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			TweenService:Create(button, UIConfig.Tween.Normal, { BackgroundTransparency = UIConfig.Mobile.BackgroundTransparency }):Play()
		end
	end)
	return button
end

-- İki ince çubuktan ok başı (glif yazı tipine bağlı kalmasın). Kare buton varsayılır.
-- Çubuk boyu L = 0.42; 40° açıyla tepe noktasında birleşirler: merkezler tepeden (L/2)(cos40, sin40) uzakta.
local function addChevron(button: GuiObject, pointsLeft: boolean)
	local halfX, halfY = 0.21 * math.cos(math.rad(40)), 0.21 * math.sin(math.rad(40))
	local apexX = if pointsLeft then 0.42 else 0.58
	for _, sign in { -1, 1 } do -- -1 üst çubuk, +1 alt çubuk
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(apexX + (if pointsLeft then halfX else -halfX), 0.5 + sign * halfY)
		bar.Size = UDim2.new(0.42, 0, 0, 4)
		bar.Rotation = (if pointsLeft then 1 else -1) * sign * 40
		bar.BackgroundColor3 = UIConfig.Colors.Text
		bar.BorderSizePixel = 0
		bar.Parent = button
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = bar
	end
end

local function setActiveLook(button: GuiObject, active: boolean)
	local stroke = button:FindFirstChild("Stroke") :: UIStroke?
	if stroke then
		stroke.Color = if active then UIConfig.Colors.Accent else UIConfig.Colors.TextMuted
		stroke.Thickness = if active then 3 else 2
	end
	if button:IsA("TextButton") then
		button.TextColor3 = if active then UIConfig.Colors.Accent else UIConfig.Colors.Text
	end
end

-- ===== Direksiyon pedi =====
local function setPadValue(x: number?)
	local input = controllers.InputController
	if x == nil then
		input:SetAnalog("VehSteer", nil)
		if padKnob then
			padKnob.Position = UDim2.fromScale(0.5, 0.5)
		end
		return
	end
	local magnitude = math.abs(x)
	local steer = 0
	if magnitude > PAD_DEADZONE then
		steer = math.sign(x) * ((magnitude - PAD_DEADZONE) / (1 - PAD_DEADZONE)) ^ PAD_CURVE
	end
	input:SetAnalog("VehSteer", steer)
	if padKnob then
		padKnob.Position = UDim2.fromScale((x + 1) / 2, 0.5)
	end
end

local function updatePadFrom(position: Vector3)
	if not pad then
		return
	end
	local width = math.max(pad.AbsoluteSize.X, 1)
	local rel = (position.X - pad.AbsolutePosition.X) / width
	setPadValue(math.clamp(rel * 2 - 1, -1, 1))
end

local function releasePad()
	padInput = nil
	setPadValue(nil)
	if pad then
		setActiveLook(pad, false)
	end
end

local function buildPad(parent: Instance)
	local p = Instance.new("TextButton")
	p.Name = "SteerPad"
	p.Text = ""
	p.AutoButtonColor = false
	p.AutoLocalize = false
	p.BackgroundColor3 = UIConfig.Colors.Background
	p.BackgroundTransparency = 0.5
	p.Visible = false
	decorate(p, 0.5)
	-- ray ve orta çizgi
	local rail = Instance.new("Frame")
	rail.AnchorPoint = Vector2.new(0.5, 0.5)
	rail.Position = UDim2.fromScale(0.5, 0.5)
	rail.Size = UDim2.new(0.86, 0, 0, 4)
	rail.BackgroundColor3 = UIConfig.Colors.TextMuted
	rail.BackgroundTransparency = 0.4
	rail.BorderSizePixel = 0
	rail.Parent = p
	local center = Instance.new("Frame")
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.new(0, 2, 0.5, 0)
	center.BackgroundColor3 = UIConfig.Colors.TextMuted
	center.BorderSizePixel = 0
	center.Parent = p
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.fromScale(0.5, 0.06)
	label.Size = UDim2.fromScale(0.6, 0.22)
	label.TextScaled = true
	label.FontFace = UIConfig.Fonts.Title
	label.TextColor3 = UIConfig.Colors.TextMuted
	label.TextTransparency = 0.3
	label.AutoLocalize = false
	label.Text = text("Mobile.Steer")
	label.Parent = p
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.Size = UDim2.fromScale(0.62, 0.62)
	knob.SizeConstraint = Enum.SizeConstraint.RelativeYY
	knob.BackgroundColor3 = UIConfig.Colors.Accent
	knob.BackgroundTransparency = 0.15
	knob.BorderSizePixel = 0
	knob.Parent = p
	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(0.5, 0)
	kc.Parent = knob

	p.InputBegan:Connect(function(io)
		if padInput == nil and (io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1) then
			padInput = io
			setActiveLook(p, true)
			updatePadFrom(io.Position)
		end
	end)
	p.Parent = parent
	pad = p
	padKnob = knob
end

-- ===== Yerleşim =====
local function placeRect(button: GuiObject?, r)
	if button and r then
		button.AnchorPoint = Vector2.zero
		button.Position = UDim2.fromOffset(r.X, r.Y)
		button.Size = UDim2.fromOffset(r.W, r.H)
	end
end

local function layout()
	if not screenGui or not root then
		return
	end
	local viewport = workspace.CurrentCamera.ViewportSize
	local size = getButtonSize(viewport)
	local jumpSize, jumpRight, jumpBottom = getJumpButtonRect(viewport)
	local gap = UIConfig.Mobile.Spacing

	-- Yaya düzeni (zıplama butonuna göre; değişmedi)
	local sprint = buttons.Sprint
	if sprint then
		sprint.AnchorPoint = Vector2.new(1, 1)
		sprint.Size = UDim2.fromOffset(size, size)
		sprint.Position = UDim2.new(1, -(jumpRight + jumpSize + gap), 1, -jumpBottom)
	end
	local cam = buttons.Camera
	if cam then
		local small = math.floor(size * 0.8)
		cam.AnchorPoint = Vector2.new(1, 1)
		cam.Size = UDim2.fromOffset(small, small)
		cam.Position = UDim2.new(1, -jumpRight, 1, -(jumpBottom + jumpSize + gap))
	end

	-- Sürüş düzeni (DrivingLayout)
	if isVehicleLayout(layoutName) then
		local area = root.AbsoluteSize
		local steering = controllers.SettingsController:Get("MobileSteering") or "Pad"
		local rects = DrivingLayout.Touch(area.X, area.Y, size, { Kind = layoutName, Steering = steering })
		for name, b in vehicleButtons do
			placeRect(b, rects[name])
		end
		placeRect(pad, rects.Pad)
		if RunService:IsStudio() and not warnedLayout then
			local problems = DrivingLayout.FindOverlaps(rects, 2)
			if #problems > 0 then
				warnedLayout = true
				Log.Warn("Sürüş düzeni çakışması:", table.concat(problems, ", "), "ekran", area)
			end
		end
	end
end

local function applyLayoutVisibility()
	if buttons.Sprint then
		buttons.Sprint.Visible = layoutName == "OnFoot"
	end
	if buttons.Camera then
		buttons.Camera.Visible = layoutName == "OnFoot"
	end
	local steering = controllers.SettingsController:Get("MobileSteering") or "Pad"
	local usePad = steering == "Pad"
	for _, def in VEHICLE_BUTTONS do
		local b = vehicleButtons[def[1]]
		if b then
			local visible = def[5][layoutName] == true
			if def[1] == "SteerL" or def[1] == "SteerR" then
				visible = visible and not usePad
			end
			b.Visible = visible
		end
	end
	if pad then
		pad.Visible = usePad and (layoutName == "Car" or layoutName == "Motorcycle")
	end
end

local function releaseAllHolds()
	for io, action in holdInputs do
		holdInputs[io] = nil
		controllers.InputController:Trigger(action, false)
	end
	for _, b in vehicleButtons do
		setActiveLook(b, false)
	end
	releasePad()
end

local function build()
	if screenGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "MobileControls"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	-- Roblox üst çubuğu ve çentik dışında kalan alan (sürüş butonları üst çubuğun altına yerleşir)
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local area = Instance.new("Frame")
	area.Name = "Root"
	area.Size = UDim2.fromScale(1, 1)
	area.BackgroundTransparency = 1
	area.Parent = gui
	root = area

	local sprint = makeButton("Sprint", text("Mobile.Sprint"))
	sprint.Activated:Connect(function()
		local input = controllers.InputController
		input:Trigger("Sprint", not input:IsActionActive("Sprint"))
	end)
	sprint.Parent = area
	buttons.Sprint = sprint

	local cam = makeButton("Camera", CAMERA_LABELS[controllers.CameraController:GetMode()] or text("Mobile.Camera"))
	cam.Activated:Connect(function()
		controllers.InputController:Trigger("CameraCycle", true)
		controllers.InputController:Trigger("CameraCycle", false)
	end)
	cam.Parent = area
	buttons.Camera = cam

	buildPad(area)

	for _, def in VEHICLE_BUTTONS do
		local name, labelKey, action, hold, style = def[1], def[2], def[3], def[4], def[6]
		local radius = if style == "Gas" or style == "Brake" then 0.22 else 0.5
		local b = makeButton(name, if labelKey then text(labelKey) else "", radius)
		b.Visible = false
		if style == "ChevronL" or style == "ChevronR" then
			addChevron(b, style == "ChevronL")
		elseif style == "Gas" then
			b.BackgroundColor3 = UIConfig.Colors.Accent
			b.BackgroundTransparency = 0.35
		end
		if hold then
			b.InputBegan:Connect(function(io)
				if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
					holdInputs[io] = action
					controllers.InputController:Trigger(action, true)
					setActiveLook(b, true)
				end
			end)
		else
			b.Activated:Connect(function()
				controllers.InputController:Trigger(action, true)
				controllers.InputController:Trigger(action, false)
			end)
		end
		b.Parent = area
		vehicleButtons[name] = b
	end

	-- Parmak butondan / pedden kayarak kalksa bile bırakılır
	UserInputService.InputChanged:Connect(function(io)
		local current = padInput
		if not current then
			return
		end
		if io == current or (current.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseMovement) then
			updatePadFrom(io.Position)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		local current = padInput
		if current and (io == current or (current.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseButton1)) then
			releasePad()
		end
		local action = holdInputs[io]
		if action then
			holdInputs[io] = nil
			controllers.InputController:Trigger(action, false)
			for _, def in VEHICLE_BUTTONS do
				if def[3] == action and vehicleButtons[def[1]] then
					setActiveLook(vehicleButtons[def[1]], false)
				end
			end
		end
	end)

	gui.Parent = player:WaitForChild("PlayerGui")
	screenGui = gui
	layout()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	area:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	Log.Info("Mobil kontroller oluşturuldu")
end

-- Roblox'un joystick/zıplama katmanı: yayayken açık, sürüşte ve menüde kapalı (sadece dokunmatikte)
local function applyRobloxTouchControls()
	if not controllers.InputController:IsTouch() then
		return
	end
	pcall(function()
		GuiService.TouchControlsEnabled = layoutName == "OnFoot"
	end)
end

local function refreshVisibility()
	local isTouch = controllers.InputController:IsTouch()
	if isTouch and not screenGui then
		build()
	end
	if screenGui then
		screenGui.Enabled = isTouch and layoutName ~= "Hidden"
		applyLayoutVisibility()
		layout()
	end
	applyRobloxTouchControls()
end

-- "OnFoot" | "Car" | "Motorcycle" | "Passenger" | "Hidden" (diyalog, menü)
function MobileControlsController:SetLayout(name: string)
	layoutName = name
	-- düzen değişince basılı kalan araç eylemlerini ve direksiyonu bırak
	releaseAllHolds()
	refreshVisibility()
end

function MobileControlsController:GetLayout(): string
	return layoutName
end

function MobileControlsController:Init(allControllers)
	controllers = allControllers
	local ok, strings = pcall(function()
		return require(script.Parent.Parent:WaitForChild("FrontEnd"):WaitForChild("Strings"))
	end)
	if ok then
		Strings = strings
	end
end

function MobileControlsController:Start()
	local input = controllers.InputController
	input.DeviceChanged:Connect(refreshVisibility)
	input.ActionBegan:Connect(function(action)
		if action == "Sprint" and buttons.Sprint then
			setActiveLook(buttons.Sprint, true)
		end
	end)
	input.ActionEnded:Connect(function(action)
		if action == "Sprint" and buttons.Sprint then
			setActiveLook(buttons.Sprint, false)
		end
	end)
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "MobileButtonScale" or key == "MobileSteering" then
			releaseAllHolds()
			applyLayoutVisibility()
			layout()
		end
	end)
	controllers.CameraController.ModeChanged:Connect(function(mode)
		if buttons.Camera and CAMERA_LABELS[mode] then
			(buttons.Camera :: TextButton).Text = CAMERA_LABELS[mode]
		end
	end)
	-- Ölünce depar toggle'ı kapat
	controllers.CharacterController.CharacterChanged:Connect(function()
		if input:IsActionActive("Sprint") and input:IsTouch() then
			input:Trigger("Sprint", false)
		end
	end)
	refreshVisibility()
end

return MobileControlsController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties>
<string name="Name">SettingsController</string>

<ProtectedString name="Source"><![CDATA[-- SettingsController: oyuncu ayarları (istemci tarafı).
--
-- Aşama 1 (ana menü): ayarlar artık Shared/SettingsSchema'dan gelir (tip, aralık, varsayılan, kategori).
-- Ayarlar ekranı şemayı okuyarak satırları kendisi üretir; doğrulama tek yerde.
--
-- Kalıcılık mimarisi (sonraki aşama için hazır):
--   Ayarlar bir "depo" (store) üzerinden yüklenir/kaydedilir:
--     store.Load() -> { Version, Values }?     (yield edebilir)
--     store.Save({ Version, Values })          (yield edebilir; burada task.spawn içinde çağrılır)
--   Bugünkü depo SessionStore'dur: değerler sadece bu oturum boyunca (yeniden doğmalar dahil) yaşar.
--   Veri aşamasında sunucudaki DataService'e giden bir depo SetStore() ile takılır; başka kod değişmez.
--
-- Genel API (geriye uyumlu): Get, Set, ResetToDefaults, Changed sinyali.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Utilities.Signal)
local SettingsSchema = require(Shared.SettingsSchema)
local Log = require(Shared.Utilities.Log).new("Settings")

local SettingsController = {
	Name = "SettingsController",
	Priority = 1,
	Changed = Signal.new(), -- (key, newValue, oldValue)
	Loaded = Signal.new(), -- () depodan değerler yüklendi
}

local SAVE_DEBOUNCE = 1.5

local values = SettingsSchema.Defaults()
local dirty = false
local saveScheduled = false

-- ===== Depolar =====
local SessionStore = {}
SessionStore.__index = SessionStore

function SessionStore.new()
	return setmetatable({ _data = nil }, SessionStore)
end

function SessionStore:Load()
	return self._data
end

function SessionStore:Save(payload)
	self._data = table.clone(payload)
end

local store = SessionStore.new()

-- ===== İç yardımcılar =====
local function scheduleSave()
	dirty = true
	if saveScheduled then
		return
	end
	saveScheduled = true
	task.delay(SAVE_DEBOUNCE, function()
		saveScheduled = false
		if not dirty then
			return
		end
		dirty = false
		local payload = SettingsController:Export()
		local ok, err = pcall(function()
			store:Save(payload)
		end)
		if not ok then
			Log.Warn("Ayarlar kaydedilemedi:", err)
		end
	end)
end

local function apply(key: string, value: any, save: boolean): boolean
	local normalized = SettingsSchema.Normalize(key, value)
	if normalized == nil then
		if SettingsSchema.Get(key) then
			Log.Warn("Geçersiz ayar değeri:", key, value)
		else
			Log.Warn("Bilinmeyen ayar:", key)
		end
		return false
	end
	local old = values[key]
	if old == normalized then
		return true
	end
	values[key] = normalized
	SettingsController.Changed:Fire(key, normalized, old)
	if save then
		scheduleSave()
	end
	return true
end

-- ===== Genel API =====
function SettingsController:Get(key: string): any
	return values[key]
end

function SettingsController:Set(key: string, value: any): boolean
	return apply(key, value, true)
end

-- category verilirse sadece o sekmenin ayarları sıfırlanır
function SettingsController:ResetToDefaults(category: string?)
	for _, def in SettingsSchema.Definitions do
		if category == nil or def.Category == category then
			apply(def.Key, def.Default, true)
		end
	end
end

function SettingsController:GetSchema()
	return SettingsSchema
end

function SettingsController:IsDefault(key: string): boolean
	local def = SettingsSchema.Get(key)
	return def ~= nil and values[key] == def.Default
end

function SettingsController:Export()
	return { Version = SettingsSchema.Version, Values = table.clone(values) }
end

-- Dışarıdan gelen veriyi (kayıt) şemaya göre temizleyip uygular. Kaydetmez (zaten kayıttan geldi).
function SettingsController:Import(payload: any)
	local data = if type(payload) == "table" then payload.Values else nil
	for key, value in SettingsSchema.Sanitize(data) do
		apply(key, value, false)
	end
end

-- Veri aşaması burayı kullanacak: SettingsController:SetStore(RemoteSettingsStore.new(...))
function SettingsController:SetStore(newStore)
	assert(type(newStore) == "table" and newStore.Load and newStore.Save, "Geçersiz ayar deposu")
	store = newStore
	task.spawn(function()
		local ok, payload = pcall(function()
			return store:Load()
		end)
		if ok and payload then
			SettingsController:Import(payload)
		elseif not ok then
			Log.Warn("Ayarlar yüklenemedi, varsayılanlar kullanılıyor:", payload)
		end
		SettingsController.Loaded:Fire()
	end)
end

function SettingsController:Init() end

function SettingsController:Start()
	local payload = store:Load()
	if payload then
		self:Import(payload)
	end
	SettingsController.Loaded:Fire()
end

return SettingsController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000036"><Properties>
<string name="Name">VehicleController</string>

<ProtectedString name="Source"><![CDATA[-- VehicleController: yerel oyuncu araçtayken sürüş (Bölüm 8.2, 8.3, 9.2, 21.2, 21.3).
--
-- Sürücü olunca araç fiziğinin ağ sahibi bu istemcidir; tekerlek motorlarını ve direksiyon servolarını
-- burada her karede ayarlarız → gecikmesiz, gerçek fizikle sürüş. Diğer oyuncular konumu çoğaltma ile görür.
-- Sunucuya sadece görsel durum (far, stop, sinyal, korna) gönderilir; sunucu sürücü olduğumuzu doğrular.
--
-- Giriş kaynakları: klavye (W/A/S/D, Space, H, F, L, Q, E, R), gamepad (tetikler + sol çubuk),
-- mobil butonlar (MobileControlsController araç düzeni). Hepsi InputController eylemlerinden geçer.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local CarPhysics = require(script.Parent.Parent:WaitForChild("Vehicles"):WaitForChild("CarPhysics"))
local RemoteRegistry = require(Shared.RemoteRegistry)
local Signal = require(Shared.Utilities.Signal)
local Maid = require(Shared.Utilities.Maid)
local Log = require(Shared.Utilities.Log).new("Vehicle")

local VehicleController = {
	Name = "VehicleController",
	Priority = 6,
	Entered = Signal.new(), -- (model, isDriver)
	Exited = Signal.new(),
}

local player = Players.LocalPlayer
local controllers
local maid = Maid.new()
local playerControls = nil

local exitRemote: RemoteEvent
local stateRemote: RemoteEvent
local flipRemote: RemoteEvent

-- Aktif araç durumu
local current = nil :: any

-- Fizik adımından önce çalışan bağlantı: PreSimulation (dt) yoksa Stepped (time, dt)
local function connectPreSimulation(fn: (number) -> ()): RBXScriptConnection
	local ok, signal = pcall(function()
		return (RunService :: any).PreSimulation
	end)
	if ok and signal then
		return signal:Connect(fn)
	end
	return RunService.Stepped:Connect(function(_, dt)
		fn(dt)
	end)
end

local function getControls()
	if playerControls then
		return playerControls
	end
	local ok, controls = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		return playerModule:GetControls()
	end)
	if ok then
		playerControls = controls
	else
		Log.Warn("PlayerModule kontrolleri alınamadı:", controls)
	end
	return playerControls
end

local function setDefaultControls(enabled: boolean)
	local controls = getControls()
	if controls then
		pcall(function()
			if enabled then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

local function findVehicleModel(seat: Instance): Model?
	local node = seat.Parent
	while node and node ~= workspace do
		if node:IsA("Model") and node:GetAttribute("VehicleId") then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- ===== Gamepad analog değerleri =====
local stickX, triggerR, triggerL = 0, 0, 0

-- Motosiklet (eski fizik): tetikler dijital gibi davranır — Aşama 2 öncesiyle birebir aynı his
local function readInputs()
	local input = controllers.InputController
	local throttle = math.max(if input:IsActionActive("VehGas") then 1 else 0, if triggerR > 0.1 then 1 else 0)
	local brake = math.max(if input:IsActionActive("VehBrake") then 1 else 0, if triggerL > 0.1 then 1 else 0)
	local steer = (if input:IsActionActive("VehRight") then 1 else 0) - (if input:IsActionActive("VehLeft") then 1 else 0)
	if math.abs(stickX) > 0.15 then
		steer = stickX
	end
	local touchSteer = input:GetAnalog("VehSteer") -- mobil direksiyon pedi (Aşama 3)
	if math.abs(touchSteer) > 0.02 then
		steer = touchSteer
	end
	return throttle, brake, math.clamp(steer, -1, 1), input:IsActionActive("VehHandbrake"), input:IsActionActive("VehHorn")
end

-- Otomobil (Aşama 2): tetikler ANALOG; çubuk ölü bölgesi yeniden ölçeklenir ve hafif üstel eğri uygulanır
-- (merkez çevresinde ince ayar, uçta tam direksiyon).
local STICK_DEADZONE = 0.12
local STICK_EXPO = 1.5
local function readCarInputs()
	local input = controllers.InputController
	local throttle = math.max(if input:IsActionActive("VehGas") then 1 else 0, triggerR)
	local brake = math.max(if input:IsActionActive("VehBrake") then 1 else 0, triggerL)
	local steer = (if input:IsActionActive("VehRight") then 1 else 0) - (if input:IsActionActive("VehLeft") then 1 else 0)
	local magnitude = math.abs(stickX)
	if magnitude > STICK_DEADZONE then
		local scaled = math.clamp((magnitude - STICK_DEADZONE) / (1 - STICK_DEADZONE), 0, 1)
		steer = math.sign(stickX) * scaled ^ STICK_EXPO
	end
	local touchSteer = input:GetAnalog("VehSteer") -- mobil direksiyon pedi (eğri pedin kendisinde)
	if math.abs(touchSteer) > 0.02 then
		steer = touchSteer
	end
	return throttle, brake, math.clamp(steer, -1, 1), input:IsActionActive("VehHandbrake"), input:IsActionActive("VehHorn")
end

-- ===== Sunucuya görsel durum =====
local function pushState(force: boolean?)
	local c = current
	if not c or not c.IsDriver then
		return
	end
	local s = c.State
	local key = string.format("%s|%s|%s|%s|%s", tostring(s.Lights), s.Indicator, tostring(s.Braking), tostring(s.Reversing), tostring(s.Horn))
	local now = os.clock()
	if not force and (key == c.LastSentKey or now - c.LastSent < 0.12) then
		return
	end
	c.LastSentKey = key
	c.LastSent = now
	stateRemote:FireServer({
		Lights = s.Lights, Indicator = s.Indicator, Braking = s.Braking, Reversing = s.Reversing, Horn = s.Horn,
	})
end

-- ===== Sürüş döngüsü =====
local function setRearGrip(c, low: boolean)
	if c.LowGrip == low then
		return
	end
	c.LowGrip = low
	for _, wheel in c.RearWheels do
		wheel.CustomPhysicalProperties = PhysicalProperties.new(0.9, if low then c.Def.Grip * 0.45 else c.Def.Grip, 0, 100, 1)
	end
end

-- Motosiklet (eski sürüş adımı) — araç fizik kararlılığı düzeltmesi:
--   * Çekiş kontrolü: tahrikli teker hedefi "yer hızı + izinli patinaj" (eskiden her zaman azami hız / R). Teker bir
--     an yükünü kaybedince (tümsek, basamak) artık azami hıza fırlamaz; yere fazla hızla değip arkayı kaydırmaz.
--     Yerdeyken çekiş kuvveti yine motor torkuyla sınırlı → hızlanma değişmez.
--   * ABS: frenlenen teker yer hızının %90'ının altına inmez (arka teker kilitlenip kaymaz).
--   * Yatış hedefi saniyede en fazla LEAN_RATE kadar değişir (klavyede ±40°'ye 0.3 sn'de sıçramaz).
local BIKE_SLIP = 0.12 -- izinli patinaj oranı
local BIKE_MIN_SLIP = 1.5 -- stud/sn: kalkışta tekerin yerden hızlı dönebileceği en küçük fark
local BIKE_ABS_SLIP = 0.1
local LEAN_RATE = 1.5 -- rad/sn (~86°/sn)

-- F4 telemetrisi için motosiklet ölçümleri (sürüşü etkilemez)
local function bikeTelemetry(c, forwardSpeed: number, throttle: number, brake: number, tcActive: boolean, absActive: boolean)
	local t = c.BikeTelemetry
	if not t then
		t = { Wheels = {}, Order = {} }
		c.BikeTelemetry = t
	end
	local def = c.Def
	local cf = c.Chassis.CFrame
	t.Speed = c.Chassis.AssemblyLinearVelocity.Magnitude
	t.ForwardSpeed = forwardSpeed
	t.Throttle, t.Brake = throttle, brake
	t.Pitch = math.deg(math.asin(math.clamp(cf.LookVector.Y, -1, 1)))
	t.LeanActual = math.deg(math.asin(math.clamp(-cf.RightVector.Y, -1, 1)))
	t.LeanTarget = math.deg(c.Lean or 0)
	t.TcActive, t.AbsActive = tcActive, absActive
	for _, s in c.Struts do
		local name = tostring(s:GetAttribute("Wheel"))
		local w = t.Wheels[name]
		if not w then
			w = { Name = name, Lifts = 0, Contact = true, Compression = 0, SurfaceSpeed = 0 }
			t.Wheels[name] = w
			table.insert(t.Order, w)
		end
		local contact = s.CurrentPosition > -def.Travel + 0.03
		if w.Contact and not contact then
			w.Lifts += 1 -- yerden kesilme sayısı
		end
		w.Contact = contact
		w.Compression = (s.CurrentPosition + def.Travel) / def.Travel
		local wheel = c.Model:FindFirstChild("Wheel_" .. name)
		local knuckle = s.Parent
		if wheel and wheel:IsA("BasePart") and knuckle and knuckle:IsA("BasePart") then
			local omega = (wheel.AssemblyAngularVelocity - knuckle.AssemblyAngularVelocity):Dot(knuckle.CFrame.RightVector)
			w.SurfaceSpeed = omega * def.WheelRadius * VehicleDefinitions.DriveSign
		end
	end
end

local function driveStep(dt: number)
	local c = current
	if not c or not c.IsDriver or not c.Chassis.Parent then
		return
	end
	local def = c.Def
	local chassis = c.Chassis
	local cf = chassis.CFrame
	local velocity = chassis.AssemblyLinearVelocity
	local forwardSpeed = velocity:Dot(cf.LookVector)
	local speed = velocity.Magnitude
	local throttle, brake, steerInput, handbrake, horn = readInputs()

	-- Direksiyon: yumuşak geçiş, bırakınca daha hızlı ortalanır
	local rate = if math.abs(steerInput) < 0.01 then 4.5 else 3.2
	c.Steer += math.clamp(steerInput - c.Steer, -rate * dt, rate * dt)
	local maxAngle = VehicleDefinitions.SteerAngleAt(def, speed)
	for _, steerConstraint in c.SteerConstraints do
		steerConstraint.TargetAngle = -c.Steer * maxAngle
	end

	-- Motor / fren / geri vites
	local R = def.WheelRadius
	local sign = VehicleDefinitions.DriveSign
	local driveTorque, brakeTorque, coastTorque = c.DriveTorque, c.BrakeTorque, c.CoastTorque
	local braking, reversing = false, false
	local driveVelocity, driveMax, freeMax = 0, coastTorque, coastTorque
	local brakeVelocity = 0 -- frende tekerlerin hedef açısal hızı (motosiklette ABS)

	if throttle > 0.05 then
		if forwardSpeed < -2 then
			braking = true
			driveVelocity, driveMax, freeMax = 0, brakeTorque * throttle, brakeTorque * throttle
		else
			local taper = math.clamp(1 - (forwardSpeed / def.MaxSpeed) ^ 2, 0.12, 1)
			driveVelocity = sign * def.MaxSpeed / R
			if c.IsBike then
				local allow = math.max(BIKE_MIN_SLIP, BIKE_SLIP * math.abs(forwardSpeed))
				driveVelocity = sign * math.min(math.max(forwardSpeed, 0) + allow, def.MaxSpeed) / R
			end
			driveMax = driveTorque * taper * throttle
			freeMax = 0 -- tahriksiz tekerlekler serbest döner
		end
	elseif brake > 0.05 then
		if forwardSpeed > 2 then
			braking = true
			driveVelocity, driveMax, freeMax = 0, brakeTorque * brake, brakeTorque * brake
			if c.IsBike then
				brakeVelocity = sign * forwardSpeed * (1 - BIKE_ABS_SLIP) / R
				driveVelocity = brakeVelocity
			end
		else
			reversing = true
			driveVelocity = -sign * def.ReverseSpeed / R
			driveMax = driveTorque * 0.6 * brake
			freeMax = 0
		end
	end

	for _, motor in c.Motors do
		local isRear = motor:GetAttribute("Rear") == true
		if handbrake and isRear then
			motor.AngularVelocity = 0
			motor.MotorMaxTorque = brakeTorque * 1.6
		elseif motor:GetAttribute("Driven") then
			motor.AngularVelocity = driveVelocity
			motor.MotorMaxTorque = driveMax
		else
			motor.AngularVelocity = if braking then brakeVelocity else 0
			motor.MotorMaxTorque = if braking then brakeTorque * math.max(throttle, brake) else freeMax
		end
	end
	setRearGrip(c, handbrake and speed > 8)

	-- Motosiklet: dik durma + viraj yatışı
	if c.Upright then
		local forward = cf.LookVector
		local right = forward:Cross(Vector3.yAxis)
		if right.Magnitude > 0.05 then
			right = right.Unit
			local baseUp = right:Cross(forward).Unit
			local leanTarget = c.Steer * math.clamp(speed / 25, 0, 1) * math.rad(def.MaxLean or 30)
			local lean = c.Lean + math.clamp(leanTarget - c.Lean, -LEAN_RATE * dt, LEAN_RATE * dt)
			c.Lean = lean
			c.Upright.PrimaryAxis = (baseUp * math.cos(lean) + right * math.sin(lean)).Unit
		end
	else
		-- Araba: uzun süre ters kalırsa otomatik düzeltme isteği
		if cf.UpVector.Y < 0.3 and speed < 4 then
			c.FlipTimer += dt
			if c.FlipTimer > 2.5 then
				c.FlipTimer = -4
				flipRemote:FireServer()
			end
		else
			c.FlipTimer = math.max(c.FlipTimer - dt, 0)
		end
	end

	if c.IsBike then
		-- telemetri (F4): çekiş kontrolü / ABS gerçekten sınırlıyor mu
		local tcActive, absActive = false, false
		for _, motor in c.Motors do
			local wheel = c.Model:FindFirstChild("Wheel_" .. tostring(motor:GetAttribute("Wheel")))
			local knuckle = motor.Parent
			if wheel and wheel:IsA("BasePart") and knuckle and knuckle:IsA("BasePart") then
				local omega = (wheel.AssemblyAngularVelocity - knuckle.AssemblyAngularVelocity):Dot(knuckle.CFrame.RightVector)
				local surface = omega * R * sign
				if throttle > 0.3 and motor:GetAttribute("Driven") and surface > forwardSpeed + 2.5 then
					tcActive = true
				elseif braking and forwardSpeed > 3 and surface < forwardSpeed * 0.92 then
					absActive = true
				end
			end
		end
		bikeTelemetry(c, forwardSpeed, throttle, brake, tcActive, absActive)
	end

	c.Speed = speed
	c.ForwardSpeed = forwardSpeed
	c.Gear = if reversing then "R" elseif math.abs(forwardSpeed) < 1 and throttle < 0.05 then "N" else "D"
	c.State.Braking = braking or (handbrake and speed > 2)
	c.State.Reversing = reversing
	c.State.Horn = horn
	pushState(false)
end

-- ===== Otomobil sürüşü (Aşama 2 fizik modeli) =====
local CAR_INIT_TIMEOUT = 5
local function carStep(dt: number)
	local c = current
	if not c or not c.IsDriver or not c.Chassis.Parent then
		return
	end
	if not c.Car then
		-- Akış nedeniyle parçalar henüz gelmemiş olabilir: kısa süre tekrar dene
		c.Car = CarPhysics.new(c.Model, c.Def)
		if not c.Car then
			c.CarWait += dt
			if c.CarWait > CAR_INIT_TIMEOUT and not c.CarWarned then
				c.CarWarned = true
				Log.Warn("Otomobil fizik parçaları bulunamadı:", c.Model.Name)
			end
			return
		end
	end
	local throttle, brake, steer, handbrake, horn = readCarInputs()
	local car = c.Car
	car:Step(dt, throttle, brake, steer, handbrake)
	if car:ConsumeRecoveryRequest() then
		flipRemote:FireServer() -- sunucu: durmuş + (devrik veya takılı) ise düzeltir
	end
	local t = car.Telemetry
	c.Speed = t.Speed
	c.ForwardSpeed = t.ForwardSpeed
	c.Gear = t.Gear
	c.Steer = t.Steer
	c.State.Braking = car:IsBraking()
	c.State.Reversing = car:IsReversing()
	c.State.Horn = horn
	pushState(false)
end

-- ===== Binme / inme =====
local function leave()
	local c = current
	if not c then
		return
	end
	if c.Car then
		c.Car:Release() -- yerinde tut, kuvvetleri sıfırla, lastikleri normale döndür (sunucu devralana kadar)
	end
	current = nil
	maid:Clean()
	local camera = controllers.CameraController
	camera:Release("Vehicle")
	camera:SetFollowSubject(nil, nil, true) -- araç kamerasından karaktere yumuşak geçiş
	camera:SetAutoFollowHeading(false)
	camera:SnapBehindCharacter(true)
	controllers.InputController:SetContext("Vehicle", false)
	controllers.MobileControlsController:SetLayout("OnFoot")
	setDefaultControls(true)
	ProximityPromptService.Enabled = true
	stickX, triggerR, triggerL = 0, 0, 0
	VehicleController.Exited:Fire()
end

local function enter(seat: Seat)
	local model = findVehicleModel(seat)
	if not model then
		return
	end
	local def = VehicleDefinitions.Get(model:GetAttribute("DefId"))
	if not def then
		Log.Warn("Araç tanımı yok:", model:GetAttribute("DefId"))
		return
	end
	if current then
		leave()
	end
	local isDriver = seat:GetAttribute("DriverSeat") == true
	local isBike = VehicleDefinitions.IsMotorcycle(def)
	local c = {
		Model = model, Def = def, Seat = seat, IsDriver = isDriver, IsBike = isBike,
		Chassis = model.PrimaryPart :: BasePart,
		Motors = {}, SteerConstraints = {}, RearWheels = {}, Struts = {},
		Upright = nil :: AlignOrientation?,
		DriveTorque = model:GetAttribute("DriveTorque") or 1e4,
		BrakeTorque = model:GetAttribute("BrakeTorque") or 1e4,
		CoastTorque = model:GetAttribute("CoastTorque") or 1e3,
		Steer = 0, Lean = 0, Speed = 0, ForwardSpeed = 0, Gear = "N", FlipTimer = 0, LowGrip = false,
		UsesCar = VehicleDefinitions.UsesCarPhysics(def), Car = nil, CarWait = 0, CarWarned = false,
		State = { Lights = model:GetAttribute("Lights") == true, Indicator = "", Braking = false, Reversing = false, Horn = false },
		LastSent = 0, LastSentKey = "",
	}
	for _, d in model:GetDescendants() do
		if d:IsA("HingeConstraint") and d:GetAttribute("Wheel") then
			table.insert(c.Motors, d)
		elseif d:IsA("CylindricalConstraint") and d:GetAttribute("Steer") then
			table.insert(c.SteerConstraints, d)
			table.insert(c.Struts, d)
		elseif d:IsA("CylindricalConstraint") and d:GetAttribute("Wheel") then
			table.insert(c.Struts, d)
		elseif d:IsA("BasePart") and d:GetAttribute("Rear") and d:GetAttribute("Wheel") then
			table.insert(c.RearWheels, d)
		elseif d:IsA("AlignOrientation") and d.Name == "Upright" and isBike then
			c.Upright = d
		end
	end
	current = c

	-- Kamera çerçevesi aracın gerçek boyutundan (sınır kutusu): uzunluk ve şasi merkezine göre tavan yüksekliği
	local framing = nil
	local okBox, boxCFrame, boxSize = pcall(function()
		return model:GetBoundingBox()
	end)
	if okBox and c.Chassis then
		local roof = (boxCFrame.Position.Y + boxSize.Y / 2) - c.Chassis.Position.Y
		framing = { Length = boxSize.Z, RoofHeight = math.max(roof, 0.5), MaxSpeed = def.MaxSpeed }
	end
	local camera = controllers.CameraController
	camera:RequestMode("Vehicle", if isBike then "Motorcycle" else "Vehicle", 20)
	camera:SetFollowSubject(c.Chassis, framing, true)
	camera:SetAutoFollowHeading(true)
	camera:SnapBehindCharacter(true)

	setDefaultControls(false)
	ProximityPromptService.Enabled = false
	controllers.InputController:SetContext("Vehicle", true)
	controllers.MobileControlsController:SetLayout(if not isDriver then "Passenger" elseif isBike then "Motorcycle" else "Car")

	if isDriver then
		if c.UsesCar then
			-- Fizik adımından ÖNCE hedefleri yaz (bir kare gecikme olmasın)
			maid:Give(connectPreSimulation(carStep))
		else
			maid:Give(RunService.Heartbeat:Connect(driveStep)) -- motosiklet: eski adım, değişmedi
		end
		pushState(true)
	end
	-- Araç yok olursa (yeniden doğma vb.) güvenle çık
	maid:Give(model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			leave()
		end
	end))
	VehicleController.Entered:Fire(model, isDriver)
end

-- ===== Genel API (HUD için) =====
function VehicleController:GetCurrent()
	return current
end

function VehicleController:IsInVehicle(): boolean
	return current ~= nil
end

-- Mobil buton düzeni (menüden araca dönüşte geri yüklemek için)
function VehicleController:GetMobileLayout(): string
	local c = current
	if not c then
		return "OnFoot"
	end
	return if not c.IsDriver then "Passenger" elseif c.IsBike then "Motorcycle" else "Car"
end

function VehicleController:Init(allControllers)
	controllers = allControllers
end

function VehicleController:Start()
	exitRemote = RemoteRegistry.Get("VehicleRemotes", "RequestExit") :: RemoteEvent
	stateRemote = RemoteRegistry.Get("VehicleRemotes", "DriveState") :: RemoteEvent
	flipRemote = RemoteRegistry.Get("VehicleRemotes", "RequestFlip") :: RemoteEvent

	local input = controllers.InputController
	input.ActionBegan:Connect(function(action)
		local c = current
		if not c then
			return
		end
		if action == "VehExit" then
			exitRemote:FireServer()
		elseif not c.IsDriver then
			return
		elseif action == "VehLights" then
			c.State.Lights = not c.State.Lights
			pushState(true)
		elseif action == "VehIndLeft" then
			c.State.Indicator = if c.State.Indicator == "L" then "" else "L"
			pushState(true)
		elseif action == "VehIndRight" then
			c.State.Indicator = if c.State.Indicator == "R" then "" else "R"
			pushState(true)
		elseif action == "VehFlip" then
			flipRemote:FireServer()
		end
	end)

	UserInputService.InputChanged:Connect(function(io)
		if not current then
			return
		end
		if io.KeyCode == Enum.KeyCode.Thumbstick1 then
			stickX = io.Position.X
		elseif io.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerR = io.Position.Z
		elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerL = io.Position.Z
		end
	end)
	-- Tetik bırakılınca son analog değer takılı kalmasın (gaz açık kalmasın)
	UserInputService.InputEnded:Connect(function(io)
		if io.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerR = 0
		elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerL = 0
		elseif io.KeyCode == Enum.KeyCode.Thumbstick1 then
			stickX = 0
		end
	end)

	-- Koltuk değişimi: binme/inme tespiti (sunucunun Sit/inişi buraya yansır)
	local function watchCharacter(character: Model?)
		if not character then
			leave()
			return
		end
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		local function check()
			local seat = humanoid.SeatPart
			if seat and seat:IsA("Seat") and seat:GetAttribute("VehicleSeat") then
				if not current or current.Seat ~= seat then
					enter(seat)
				end
			elseif current then
				leave()
			end
		end
		humanoid:GetPropertyChangedSignal("SeatPart"):Connect(check)
		humanoid.Died:Connect(leave)
		check()
	end
	controllers.CharacterController.CharacterChanged:Connect(watchCharacter)
	if controllers.CharacterController:GetCharacter() then
		task.spawn(watchCharacter, controllers.CharacterController:GetCharacter())
	end
end

return VehicleController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000037"><Properties>
<string name="Name">VehicleHUDController</string>

<ProtectedString name="Source"><![CDATA[-- VehicleHUDController: sürüş göstergesi (Aşama 3).
--
-- Masaüstü / gamepad:  sağ alt yuvarlak gösterge (devir yayı, büyük hız, vites), solunda durum şeridi
--                      (sinyal ◀ ▶, far, el freni, ABS, TCS, ESC), sol altta HARİTA alanı (ileride minimap).
-- Dokunmatik:          üst ortada kompakt çubuk + sol üstte harita alanı. Yerleri DrivingLayout'tan gelir;
--                      mobil sürüş butonları aynı hesabı kullandığından üst üste binmezler.
--
-- Sadece araçtayken görünür. 20 Hz güncellenir; kare başına tablo yaratmaz. Görsel varlık kullanmaz
-- (oklar ve yay çizgileri düz Frame'lerden).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local DrivingLayout = require(Modules:WaitForChild("DrivingLayout"))

local FrontEnd = script.Parent.Parent:WaitForChild("FrontEnd")
local Theme = require(FrontEnd:WaitForChild("Theme"))
local Strings = require(FrontEnd:WaitForChild("Strings"))

local VehicleHUDController = {
	Name = "VehicleHUDController",
	Priority = 9,
}

local C = Theme.Colors
local player = Players.LocalPlayer
local controllers

local TICKS = 27 -- devir yayı çizgi sayısı (270°)
local UPDATE_INTERVAL = 0.05

local COLOR_LIGHTS = Color3.fromRGB(120, 200, 255)
local COLOR_SIGNAL = Color3.fromRGB(90, 220, 120)
local COLOR_ASSIST = Color3.fromRGB(255, 186, 60)

local gui: ScreenGui
local root: Frame
local views = {} -- Desktop / Touch: { Frame, Speed, Unit, Gear, Ticks/Segments, Icons, Status, Minimap }
local activeView = nil
local litCount = -1

-- ===== Yardımcılar =====
local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function round(parent: Instance, scale: number?)
	new("UICorner", { CornerRadius = UDim.new(scale or 0.5, 0), Parent = parent })
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = C.Text,
		FontFace = Theme.Fonts.Title,
		TextScaled = true,
		AutoLocalize = false,
		Text = "",
		Parent = parent,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

-- İki çubuktan ok (sinyal); sola/sağa
local function chevron(parent: Instance, pointsLeft: boolean): { Frame }
	local bars = {}
	local halfX, halfY = 0.21 * math.cos(math.rad(40)), 0.21 * math.sin(math.rad(40))
	local apexX = if pointsLeft then 0.3 else 0.7
	for _, sign in { -1, 1 } do
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(apexX + (if pointsLeft then halfX else -halfX), 0.5 + sign * halfY),
			Size = UDim2.new(0.42, 0, 0, 3),
			Rotation = (if pointsLeft then 1 else -1) * sign * 40,
			BackgroundColor3 = C.TextDim,
			BorderSizePixel = 0,
			Parent = parent,
		})
		round(bar)
		table.insert(bars, bar)
	end
	return bars
end

-- Durum rozeti (metin) ya da ok rozeti
local function badge(parent: Instance, name: string, textValue: string?, pointsLeft: boolean?, order: number)
	local holder = new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	local item = { Holder = holder, On = false, Color = C.Text }
	if textValue then
		holder.Size = UDim2.new(0, 0, 1, 0)
		holder.AutomaticSize = Enum.AutomaticSize.X
		holder.SizeConstraint = Enum.SizeConstraint.RelativeXY
		item.Label = label(holder, {
			Text = textValue,
			TextScaled = false,
			TextSize = 13,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromScale(0, 1),
			TextColor3 = C.TextDim,
		})
		new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = holder })
	else
		item.Bars = chevron(holder, pointsLeft == true)
	end
	return item
end

local function setBadge(item, on: boolean, color: Color3)
	if item.On == on and item.Color == color then
		return
	end
	item.On, item.Color = on, color
	local value = if on then color else C.TextDim
	if item.Label then
		item.Label.TextColor3 = value
		item.Label.TextTransparency = if on then 0 else 0.35
	elseif item.Bars then
		for _, bar in item.Bars do
			bar.BackgroundColor3 = value
			bar.BackgroundTransparency = if on then 0 else 0.35
		end
	end
end

-- Durum satırı: ◀ FAR P ABS TCS ESC ▶ (masaüstü tek satır). twoRows: ◀ FAR P ▶ / ABS TCS ESC (dar çubuk)
local function statusRow(parent: Instance, textSize: number, twoRows: boolean?)
	local function makeRow(name: string, position: UDim2, size: UDim2): Frame
		local row = new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Position = position,
			Size = size,
			Parent = parent,
		})
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, if twoRows then 2 else 4),
			Parent = row,
		})
		return row
	end
	local top, bottom
	if twoRows then
		top = makeRow("StatusTop", UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.5))
		bottom = makeRow("StatusBottom", UDim2.fromScale(0, 0.5), UDim2.fromScale(1, 0.5))
	else
		top = makeRow("Status", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
		bottom = top
	end
	local icons = {
		IndL = badge(top, "IndL", nil, true, 1),
		Lights = badge(top, "Lights", Strings.Get("HUD.Lights"), nil, 2),
		Hand = badge(top, "Hand", "P", nil, 3),
		Abs = badge(bottom, "Abs", "ABS", nil, 4),
		Tcs = badge(bottom, "Tcs", "TCS", nil, 5),
		Esc = badge(bottom, "Esc", "ESC", nil, 6),
		IndR = badge(top, "IndR", nil, false, 7),
	}
	for _, item in icons do
		if item.Label then
			item.Label.TextSize = textSize
		end
	end
	return top, icons
end

-- Harita alanı (ileride minimap buraya yerleşir). Şimdilik ince bir halka ve "yakında" etiketi.
local function minimapSlot(parent: Instance): Frame
	local slot = new("Frame", {
		Name = "MinimapSlot",
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.55,
		Parent = parent,
	})
	slot:SetAttribute("ReservedFor", "Minimap")
	slot.Visible = false -- Aşama 4: MinimapController aynı dikdörtgene gerçek haritayı çizer
	round(slot)
	new("UIStroke", { Color = C.White, Transparency = 0.75, Thickness = 1.5, Parent = slot })
	label(slot, {
		Text = "N",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.05),
		Size = UDim2.fromScale(0.14, 0.12),
		TextColor3 = C.Accent,
	})
	label(slot, {
		Text = Strings.Get("HUD.Map"),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.1),
		FontFace = Theme.Fonts.Body,
		TextColor3 = C.TextMuted,
		TextTransparency = 0.25,
	})
	return slot
end

-- ===== Masaüstü görünümü =====
local function buildDesktop()
	local frame = new("Frame", { Name = "Desktop", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = root })
	local cluster = new("Frame", {
		Name = "Cluster",
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.2,
		Parent = frame,
	})
	round(cluster)
	new("UIStroke", { Color = C.White, Transparency = 0.8, Thickness = 1.5, Parent = cluster })
	-- devir yayı: 135° (sol alt) → 405° (sağ alt), saat yönünde üstten geçer
	local ticks = {}
	for i = 0, TICKS - 1 do
		local t = i / (TICKS - 1)
		local angle = math.rad(135 + 270 * t)
		local major = i % 3 == 0
		local tick = new("Frame", {
			Name = "Tick" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + math.cos(angle) * 0.42, 0.5 + math.sin(angle) * 0.42),
			Size = UDim2.new(0, if major then 3 else 2, if major then 0.09 else 0.06, 0),
			Rotation = math.deg(angle) + 90,
			BackgroundColor3 = C.TextDim,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Parent = cluster,
		})
		ticks[i + 1] = tick
	end
	local speed = label(cluster, {
		Name = "Speed",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromScale(0.62, 0.3),
		FontFace = Theme.Fonts.Display,
		Text = "0",
	})
	local unit = label(cluster, {
		Name = "Unit",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromScale(0.3, 0.07),
		FontFace = Theme.Fonts.Body,
		TextColor3 = C.TextMuted,
		Text = Strings.Get("HUD.Unit"),
	})
	local gearBox = new("Frame", {
		Name = "GearBox",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.79),
		Size = UDim2.fromScale(0.17, 0.17),
		BackgroundTransparency = 1,
		Parent = cluster,
	})
	round(gearBox)
	local gearStroke = new("UIStroke", { Color = C.Accent, Thickness = 2, Parent = gearBox })
	local gear = label(gearBox, { Name = "Gear", Size = UDim2.fromScale(0.8, 0.8), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Text = "N" })

	local strip = new("Frame", {
		Name = "Strip",
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.25,
		Size = UDim2.fromOffset(250, 32),
		Parent = frame,
	})
	round(strip)
	local _, icons = statusRow(strip, 13)
	local status = label(frame, {
		Name = "Vehicle",
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(250, 18),
		FontFace = Theme.Fonts.Body,
		TextScaled = false,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.TextMuted,
	})
	return {
		Frame = frame, Cluster = cluster, Speed = speed, Unit = unit, Gear = gear, GearStroke = gearStroke,
		Ticks = ticks, Strip = strip, Icons = icons, Status = status, Minimap = minimapSlot(frame),
	}
end

-- ===== Dokunmatik görünüm =====
local function buildTouch()
	local frame = new("Frame", { Name = "Touch", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = root })
	local bar = new("Frame", { Name = "Bar", BackgroundColor3 = C.Background, BackgroundTransparency = 0.2, Parent = frame })
	round(bar, 0.3)
	new("UIStroke", { Color = C.White, Transparency = 0.82, Thickness = 1, Parent = bar })
	local speed = label(bar, {
		Name = "Speed",
		Position = UDim2.fromScale(0.03, 0.08),
		Size = UDim2.fromScale(0.27, 0.6),
		FontFace = Theme.Fonts.Display,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0",
	})
	local unit = label(bar, {
		Name = "Unit",
		Position = UDim2.fromScale(0.31, 0.4),
		Size = UDim2.fromScale(0.14, 0.24),
		FontFace = Theme.Fonts.Body,
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = Strings.Get("HUD.Unit"),
	})
	local gearBox = new("Frame", {
		Name = "GearBox",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.6, 0.6),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 1,
		Parent = bar,
	})
	round(gearBox)
	local gearStroke = new("UIStroke", { Color = C.Accent, Thickness = 2, Parent = gearBox })
	local gear = label(gearBox, { Name = "Gear", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.75, 0.75), Text = "N" })
	local iconsHolder = new("Frame", {
		Name = "Icons",
		Position = UDim2.fromScale(0.58, 0.06),
		Size = UDim2.fromScale(0.4, 0.68),
		BackgroundTransparency = 1,
		Parent = bar,
	})
	local _, icons = statusRow(iconsHolder, 10, true)
	-- devir: alt kenarda segmentli çubuk
	local rpm = new("Frame", {
		Name = "Rpm",
		Position = UDim2.fromScale(0.05, 0.8),
		Size = UDim2.fromScale(0.9, 0.1),
		BackgroundTransparency = 1,
		Parent = bar,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0.01, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rpm })
	local segments = {}
	for i = 1, 16 do
		segments[i] = new("Frame", {
			Size = UDim2.fromScale(1 / 16 - 0.01, 1),
			BackgroundColor3 = C.TextDim,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = rpm,
		})
	end
	return {
		Frame = frame, Bar = bar, Speed = speed, Unit = unit, Gear = gear, GearStroke = gearStroke,
		Ticks = segments, Icons = icons, Minimap = minimapSlot(frame),
	}
end

-- ===== Yerleşim =====
local function applyLayout()
	if not root then
		return
	end
	local area = root.AbsoluteSize
	if area.X < 10 then
		return
	end
	local touch = controllers.InputController:IsTouch()
	local d = views.Desktop
	local t = views.Touch
	if touch then
		local scale = controllers.SettingsController:Get("MobileButtonScale") or 1
		local base = DrivingLayout.ButtonSize(area.X, area.Y, scale)
		local rects = DrivingLayout.Touch(area.X, area.Y, base, { Kind = "Car" })
		t.Bar.Position = UDim2.fromOffset(rects.Hud.X, rects.Hud.Y)
		t.Bar.Size = UDim2.fromOffset(rects.Hud.W, rects.Hud.H)
		t.Minimap.Position = UDim2.fromOffset(rects.Minimap.X, rects.Minimap.Y)
		t.Minimap.Size = UDim2.fromOffset(rects.Minimap.W, rects.Minimap.H)
		activeView = t
	else
		local rects = DrivingLayout.Desktop(area.X, area.Y)
		local c = rects.Cluster
		d.Cluster.Position = UDim2.fromOffset(c.X, c.Y)
		d.Cluster.Size = UDim2.fromOffset(c.W, c.H)
		d.Strip.Position = UDim2.fromOffset(c.X - 12, c.Y + c.H - math.floor(c.H * 0.08))
		d.Status.Position = UDim2.fromOffset(c.X - 14, c.Y + c.H - math.floor(c.H * 0.08) - 38)
		d.Minimap.Position = UDim2.fromOffset(rects.Minimap.X, rects.Minimap.Y)
		d.Minimap.Size = UDim2.fromOffset(rects.Minimap.W, rects.Minimap.H)
		activeView = d
	end
	d.Frame.Visible = not touch
	t.Frame.Visible = touch
	litCount = -1
end

-- ===== Güncelleme =====
local function setRpm(view, rpm: number)
	local count = #view.Ticks
	local lit = math.clamp(math.floor(rpm * count + 0.5), 0, count)
	if lit == litCount then
		return
	end
	litCount = lit
	for i, tick in view.Ticks do
		local t = i / count
		local on = i <= lit
		tick.BackgroundColor3 = if not on then C.TextDim elseif t > 0.9 then C.Danger elseif t > 0.75 then C.Accent else C.Text
		tick.BackgroundTransparency = if on then 0 else 0.35
	end
end

local function refresh()
	local vehicle = controllers.VehicleController
	local c = vehicle:GetCurrent()
	if not c then
		gui.Enabled = false
		return
	end
	gui.Enabled = true
	local view = activeView
	if not view then
		return
	end
	local chassis = c.Chassis
	-- Sürücüde araç modelinin hesapladığı hız; yolcuda şasi hızı
	local speed = 0
	if chassis and chassis.Parent then
		speed = if c.IsDriver and c.Speed then c.Speed else chassis.AssemblyLinearVelocity.Magnitude
	end
	view.Speed.Text = tostring(math.floor(VehicleDefinitions.ToKmh(speed) + 0.5))

	local car = c.Car
	local telemetry = car and car.Telemetry
	local gear = if c.IsDriver then tostring(c.Gear or "N") else "—"
	view.Gear.Text = gear
	view.Gear.TextColor3 = if gear == "R" then C.Accent else C.Text

	local rpm
	if telemetry then
		rpm = telemetry.RpmNorm
	else
		rpm = math.clamp(speed / math.max(c.Def.MaxSpeed, 1), 0, 1)
	end
	setRpm(view, if c.IsDriver then rpm else 0)

	local model = c.Model
	local indicator = model:GetAttribute("Indicator") or ""
	local blink = (os.clock() * 2.5) % 1 < 0.5
	local icons = view.Icons
	setBadge(icons.IndL, blink and (indicator == "L" or indicator == "H"), COLOR_SIGNAL)
	setBadge(icons.IndR, blink and (indicator == "R" or indicator == "H"), COLOR_SIGNAL)
	setBadge(icons.Lights, model:GetAttribute("Lights") == true, COLOR_LIGHTS)
	local hand = if telemetry then telemetry.Handbrake > 0.5 else (c.IsDriver and controllers.InputController:IsActionActive("VehHandbrake"))
	setBadge(icons.Hand, hand == true, C.Danger)
	setBadge(icons.Abs, telemetry ~= nil and telemetry.AbsActive, COLOR_ASSIST)
	setBadge(icons.Tcs, telemetry ~= nil and telemetry.TcActive, COLOR_ASSIST)
	setBadge(icons.Esc, telemetry ~= nil and telemetry.EscActive, COLOR_ASSIST)
	if view.Status then
		view.Status.Text = c.Def.DisplayName .. "  ·  " .. Strings.Get(if c.IsDriver then "HUD.Driver" else "HUD.Passenger")
	end
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "VehicleHUD"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 6
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- mobil butonlarla aynı koordinat alanı
	gui.Enabled = false
	root = new("Frame", { Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	views.Desktop = buildDesktop()
	views.Touch = buildTouch()
	gui.Parent = player:WaitForChild("PlayerGui")
end

function VehicleHUDController:Init(allControllers)
	controllers = allControllers
end

function VehicleHUDController:Start()
	build()
	applyLayout()
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyLayout)
	controllers.InputController.DeviceChanged:Connect(applyLayout)
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "MobileButtonScale" then
			applyLayout()
		end
	end)
	controllers.VehicleController.Entered:Connect(function()
		applyLayout()
		pcall(refresh)
	end)
	controllers.VehicleController.Exited:Connect(function()
		gui.Enabled = false
	end)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < UPDATE_INTERVAL then
			return
		end
		accumulator = 0
		if controllers.VehicleController:IsInVehicle() then
			local ok, err = pcall(refresh)
			if not ok then
				warn("[VehicleHUD]", err)
			end
		elseif gui.Enabled then
			gui.Enabled = false
		end
	end)
end

return VehicleHUDController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX65E3EFF5N"><Properties>
<string name="Name">VehicleVisualsController</string>

<ProtectedString name="Source"><![CDATA[-- VehicleVisualsController: dış 3D modelli oyuncu araçlarında görünür tekerlerin dönüşü.
--
-- VehicleFactory görünür tekerleri dönmeyen mafsala Motor6D ("SpinMotor") ile bağlar (fizik tekeri modelinkinden
-- büyük olduğu için görünür teker fizik tekerine kaynaklanırsa merkez kayar ve yalpalardı). Bu kontrolcü, kameraya
-- yakın araçlarda fizik tekerinin mafsala göre açısal hızını okur ve görünür tekeri aynı açıyla döndürür
-- (Motor6D.Transform, sadece bu istemcide; ağ trafiği yok). Fizik etkilenmez.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local VehicleVisualsController = {
	Name = "VehicleVisualsController",
	Priority = 36,
}

local RADIUS = 180 -- stud: bu mesafeden uzaktaki tekerler döndürülmez
local cacheOf: { [Model]: { { Motor: Motor6D, Wheel: BasePart?, Knuckle: BasePart?, Angle: number } } } = {}

local function collect(model: Model)
	local list = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Name == "SpinMotor" then
			local w = d:GetAttribute("Wheel")
			table.insert(list, {
				Motor = d,
				Wheel = model:FindFirstChild("Wheel_" .. tostring(w)) :: BasePart?,
				Knuckle = model:FindFirstChild("Knuckle_" .. tostring(w)) :: BasePart?,
				Angle = 0,
			})
		end
	end
	return list
end

function VehicleVisualsController:Init() end

function VehicleVisualsController:Start()
	CollectionService:GetInstanceRemovedSignal("Vehicle"):Connect(function(model)
		cacheOf[model] = nil
	end)
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		for _, model in CollectionService:GetTagged("Vehicle") do
			if model:IsA("Model") and model:GetAttribute("BodyModel") then
				local root = model.PrimaryPart
				if root and (root.Position - camPos).Magnitude < RADIUS then
					local list = cacheOf[model]
					if not list or (#list > 0 and (not list[1].Wheel or not list[1].Knuckle)) then
						list = collect(model) -- akış (streaming) parçaları sonradan getirebilir
						cacheOf[model] = list
					end
					for _, s in list do
						local wheel, knuckle = s.Wheel, s.Knuckle
						if wheel and knuckle and wheel.Parent and s.Motor.Parent then
							local omega = (wheel.AssemblyAngularVelocity - knuckle.AssemblyAngularVelocity):Dot(knuckle.CFrame.RightVector)
							s.Angle = (s.Angle + omega * dt) % (math.pi * 2)
							s.Motor.Transform = CFrame.Angles(s.Angle, 0, 0)
						end
					end
				end
			end
		end
	end)
end

return VehicleVisualsController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6E04C7F1N"><Properties>
<string name="Name">VehicleTelemetryController</string>

<ProtectedString name="Source"><![CDATA[-- VehicleTelemetryController: otomobil telemetrisi + otomatik test ölçümleri (Aşama 2, geliştirme aracı).
--
-- F4 ile açılır/kapanır. Test pisti açıkken (Workspace.SolaraTestCourseReady) otomobile binince kendiliğinden açılır.
-- Ölçümler hem panelde hem Output'ta "[TEST]" satırı olarak görünür (Studio test raporu için kopyalanabilir).
--
-- Kaydediciler:
--   ACCEL     dururken gaza basınca başlar: 0-60 / 0-100 / 0-140 km/s süreleri, ulaşılan azami hız.
--   BRAKE     ≥80 km/s'te tam frene basınca: durma mesafesi (stud / m), süre, 100→0 eşdeğeri, en büyük yana kayma.
--   Kapılı testler (Slalom, Hairpin, Rough, LaneChange): başlangıç → bitiş kapısı süresi, koni temasları,
--             en büyük yanal g, yana kayma; Rough'ta dikey ivme RMS'i, dip vurma ve havada kalma sayısı.
--   SKIDPAD   R 90 halkasında ≥5 sn dönünce: sürdürülebilir en yüksek yanal g.
-- Kare başına tablo yaratılmaz; panel 10 Hz güncellenir.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local UIConfig = require(Modules.UIConfig)

local VehicleTelemetryController = {
	Name = "VehicleTelemetryController",
	Priority = 12,
}

local player = Players.LocalPlayer
local controllers
local gui: ScreenGui
local liveLabel: TextLabel
local resultsLabel: TextLabel
local visible = false
local userToggled = false

local REAL_G = 9.81 / VehicleDefinitions.MetersPerStud
local KMH = VehicleDefinitions.ToKmh(1)
local MAX_RESULTS = 10

local results: { string } = {}
local ACCEL_MARKS = { 60, 100, 140 }

-- ===== Pist verisi (kapılar, koniler, skidpad) =====
type Gate = { Part: BasePart, Test: string, Role: string }
local gates: { Gate } = {}
local cones: { [string]: { BasePart } } = {}
local skidCenter: BasePart? = nil

local function registerCourseObject(d: Instance)
	if not d:IsA("BasePart") then
		return
	end
	local test = d:GetAttribute("Test")
	if d.Name == "SkidpadCenter" then
		skidCenter = d
	elseif type(test) == "string" and d:GetAttribute("Role") then
		table.insert(gates, { Part = d, Test = test, Role = d:GetAttribute("Role") })
	elseif type(test) == "string" and d.Name == "Cone" then
		cones[test] = cones[test] or {}
		table.insert(cones[test], d)
	end
end

local function watchCourse(folder: Instance)
	for _, d in folder:GetDescendants() do
		registerCourseObject(d)
	end
	folder.DescendantAdded:Connect(registerCourseObject)
end

-- ===== Sonuç =====
local function report(text: string)
	local line = string.format("[TEST] %s", text)
	print(line)
	table.insert(results, 1, text)
	if #results > MAX_RESULTS then
		table.remove(results)
	end
end

-- ===== Kaydedici durumları =====
local accel = { State = "Idle", T0 = 0, P0 = Vector3.zero, Marks = { [60] = 0, [100] = 0, [140] = 0 }, LowThrottle = 0, TopKmh = 0 }
local brake = { Active = false, T0 = 0, P0 = Vector3.zero, V0 = 0, MaxSlip = 0, Yaw0 = 0, MaxYawRate = 0 }
local timed = {
	Test = nil :: string?, T0 = 0, MaxLat = 0, MaxSlip = 0, MaxYawRate = 0, Cones = 0, EntryKmh = 0,
	VertSum = 0, VertPeak = 0, Samples = 0, BottomOuts = 0, AirEvents = 0, LastVy = 0, WasBottomed = false, WasAir = false,
}
local coneHit: { [BasePart]: boolean } = {}
local skid = { Time = 0, Ema = 0, Best = 0, SpeedSum = 0, Samples = 0 }
local lastPosition: Vector3? = nil

local function carName(c): string
	return c.Def.DisplayName
end

local function headingOf(cf: CFrame): number
	local look = cf.LookVector
	return math.deg(math.atan2(-look.X, -look.Z))
end

local function resetRecorders()
	accel.State = "Idle"
	brake.Active = false
	timed.Test = nil
	table.clear(coneHit)
	skid.Time, skid.Ema = 0, 0
	lastPosition = nil
end

local function beginTimed(test: string, kmh: number)
	timed.Test = test
	timed.T0 = os.clock()
	timed.MaxLat, timed.MaxSlip, timed.MaxYawRate, timed.Cones = 0, 0, 0, 0
	timed.EntryKmh = kmh
	timed.VertSum, timed.VertPeak, timed.Samples, timed.BottomOuts, timed.AirEvents = 0, 0, 0, 0, 0
	timed.WasBottomed, timed.WasAir = false, false
	timed.LastVy = 0
	table.clear(coneHit)
end

local function finishTimed(c)
	local elapsed = os.clock() - timed.T0
	local name = carName(c)
	if timed.Test == "Rough" then
		local rms = if timed.Samples > 0 then math.sqrt(timed.VertSum / timed.Samples) / REAL_G else 0
		report(string.format("ROUGH %s t=%.2fs entry=%dkm/h vertRMS=%.2fg vertPeak=%.2fg bottomOuts=%d airborne=%d maxSlip=%.1f°",
			name, elapsed, timed.EntryKmh, rms, timed.VertPeak / REAL_G, timed.BottomOuts, timed.AirEvents, timed.MaxSlip))
	elseif timed.Test == "LaneChange" then
		report(string.format("LANECHANGE %s t=%.2fs entry=%dkm/h maxLat=%.2fg maxSlip=%.1f° maxYaw=%.0f°/s cones=%d",
			name, elapsed, timed.EntryKmh, timed.MaxLat, timed.MaxSlip, timed.MaxYawRate, timed.Cones))
	else
		report(string.format("%s %s t=%.2fs entry=%dkm/h maxLat=%.2fg maxSlip=%.1f° cones=%d",
			string.upper(timed.Test or "?"), name, elapsed, timed.EntryKmh, timed.MaxLat, timed.MaxSlip, timed.Cones))
	end
	timed.Test = nil
end

local function crossed(gatePart: BasePart, from: Vector3, to: Vector3): boolean
	local cf = gatePart.CFrame
	local a = cf:PointToObjectSpace(from)
	local b = cf:PointToObjectSpace(to)
	if (a.X < 0) == (b.X < 0) then
		return false
	end
	return math.abs(b.Z) <= gatePart.Size.Z / 2 and math.abs(b.Y) <= gatePart.Size.Y
end

-- ===== Her kare: ölçüm =====
local function step(dt: number)
	local vehicle = controllers.VehicleController
	local c = vehicle and vehicle:GetCurrent()
	local car = c and c.Car
	if not car or not c.IsDriver then
		if lastPosition then
			resetRecorders()
		end
		return
	end
	local t = car.Telemetry
	local chassis = car.Chassis
	local position = chassis.Position
	local kmh = t.Speed * KMH
	local now = os.clock()
	local name = carName(c)

	-- ACCEL
	if accel.State == "Idle" then
		if t.Speed < 0.5 and t.Throttle < 0.05 then
			accel.State = "Armed"
		end
	elseif accel.State == "Armed" then
		if t.Throttle > 0.02 and t.Gear ~= "R" then
			accel.State = "Running"
			accel.T0, accel.P0 = now, position
			accel.Marks[60], accel.Marks[100], accel.Marks[140] = 0, 0, 0
			accel.LowThrottle, accel.TopKmh = 0, 0
		elseif t.Speed > 1 then
			accel.State = "Idle"
		end
	elseif accel.State == "Running" then
		for _, mark in ACCEL_MARKS do
			if accel.Marks[mark] == 0 and kmh >= mark then
				accel.Marks[mark] = now - accel.T0
			end
		end
		accel.TopKmh = math.max(accel.TopKmh, kmh)
		accel.LowThrottle = if t.Throttle < 0.5 then accel.LowThrottle + dt else 0
		local topReached = t.Speed >= c.Def.MaxSpeed * 0.985
		if t.Brake > 0.05 or accel.LowThrottle > 0.4 or topReached or now - accel.T0 > 40 then
			local function mark(m: number): string
				return if accel.Marks[m] > 0 then string.format("%.2fs", accel.Marks[m]) else "—"
			end
			if accel.TopKmh > 30 then
				report(string.format("ACCEL %s 0-60=%s 0-100=%s 0-140=%s top=%dkm/h%s dist=%.0fstud",
					name, mark(60), mark(100), mark(140), math.floor(accel.TopKmh + 0.5),
					if topReached then " (tavan)" else "", (position - accel.P0).Magnitude))
			end
			accel.State = "Idle"
		end
	end

	-- BRAKE
	if not brake.Active then
		if t.Brake > 0.85 and kmh >= 80 and t.Throttle < 0.05 and t.Gear ~= "R" then
			brake.Active = true
			brake.T0, brake.P0, brake.V0 = now, position, kmh
			brake.MaxSlip, brake.MaxYawRate = 0, 0
			brake.Yaw0 = headingOf(chassis.CFrame)
		end
	else
		brake.MaxSlip = math.max(brake.MaxSlip, math.abs(t.SideSlip))
		brake.MaxYawRate = math.max(brake.MaxYawRate, math.abs(t.YawRate))
		if t.Speed < 0.5 then
			local dist = (position - brake.P0).Magnitude
			local normalized = dist * (100 / brake.V0) ^ 2
			local drift = (headingOf(chassis.CFrame) - brake.Yaw0 + 180) % 360 - 180
			report(string.format("BRAKE %s %d->0km/h dist=%.1fstud (%.1fm) t=%.2fs eq100->0=%.1fm maxSlip=%.1f° headingDrift=%.1f°",
				name, math.floor(brake.V0 + 0.5), dist, dist * VehicleDefinitions.MetersPerStud, now - brake.T0,
				normalized * VehicleDefinitions.MetersPerStud, brake.MaxSlip, drift))
			brake.Active = false
		elseif t.Brake < 0.3 then
			brake.Active = false -- frenden çıkıldı; geçersiz
		end
	end

	-- Kapılı testler
	if lastPosition then
		for _, g in gates do
			if g.Part.Parent and g.Test ~= "Accel" and crossed(g.Part, lastPosition, position) then
				if g.Role == "Start" and timed.Test ~= g.Test then
					beginTimed(g.Test, kmh)
				elseif g.Role == "Finish" and timed.Test == g.Test then
					finishTimed(c)
				end
			end
		end
	end
	if timed.Test then
		timed.MaxLat = math.max(timed.MaxLat, math.abs(t.LatG))
		timed.MaxSlip = math.max(timed.MaxSlip, math.abs(t.SideSlip))
		timed.MaxYawRate = math.max(timed.MaxYawRate, math.abs(t.YawRate))
		local list = cones[timed.Test]
		if list then
			local reach = c.Def.Width / 2 + 0.4
			for _, cone in list do
				if not coneHit[cone] and cone.Parent then
					local offset = cone.Position - position
					if offset.X * offset.X + offset.Z * offset.Z < reach * reach then
						coneHit[cone] = true
						timed.Cones += 1
					end
				end
			end
		end
		if timed.Test == "Rough" then
			local vy = chassis.AssemblyLinearVelocity.Y
			local ay = (vy - timed.LastVy) / dt
			timed.LastVy = vy
			if timed.Samples > 0 or math.abs(ay) < REAL_G * 5 then
				timed.VertSum += ay * ay
				timed.Samples += 1
				timed.VertPeak = math.max(timed.VertPeak, math.abs(ay))
			end
			local bottomed = false
			for _, w in car.Wheels do
				if w.Compression >= 0.97 then
					bottomed = true
				end
			end
			if bottomed and not timed.WasBottomed then
				timed.BottomOuts += 1
			end
			timed.WasBottomed = bottomed
			if t.Contacts == 0 and not timed.WasAir then
				timed.AirEvents += 1
			end
			timed.WasAir = t.Contacts == 0
		end
		if now - timed.T0 > 60 then
			timed.Test = nil -- terk edildi
		end
	end

	-- SKIDPAD
	if skidCenter and skidCenter.Parent then
		local offset = position - skidCenter.Position
		local radius = math.sqrt(offset.X * offset.X + offset.Z * offset.Z)
		if radius > 65 and radius < 115 and t.Speed > 15 and math.abs(t.SideSlip) < 12 and t.Contacts >= 3 then
			skid.Time += dt
			local alpha = math.clamp(dt / 1.5, 0, 1)
			skid.Ema += (math.abs(t.LatG) - skid.Ema) * alpha
			skid.SpeedSum += kmh
			skid.Samples += 1
			if skid.Time > 3 then
				skid.Best = math.max(skid.Best, skid.Ema)
			end
		elseif skid.Time > 0 then
			if skid.Time >= 5 then
				report(string.format("SKIDPAD %s sustainedLat=%.2fg avgSpeed=%dkm/h duration=%.1fs",
					name, skid.Best, math.floor(skid.SpeedSum / math.max(skid.Samples, 1)), skid.Time))
			end
			skid.Time, skid.Ema, skid.Best, skid.SpeedSum, skid.Samples = 0, 0, 0, 0, 0
		end
	end

	lastPosition = position
end

-- ===== Panel =====
local function bar(value: number, width: number): string
	local filled = math.clamp(math.floor(value * width + 0.5), 0, width)
	return string.rep("#", filled) .. string.rep(".", width - filled)
end

local function driveLabel(p): string
	if p.DriveSplitFront >= 0.99 then
		return "FWD"
	elseif p.DriveSplitFront <= 0.01 then
		return "RWD"
	end
	return string.format("AWD %d/%d", math.floor(p.DriveSplitFront * 100 + 0.5), math.floor((1 - p.DriveSplitFront) * 100 + 0.5))
end

local function refreshPanel()
	local vehicle = controllers.VehicleController
	local c = vehicle and vehicle:GetCurrent()
	local car = c and c.Car
	local lines = {}
	if car then
		local t = car.Telemetry
		local p = c.Def.Physics
		table.insert(lines, string.format("%s  %s  vites %s  devir %s", c.Def.DisplayName, driveLabel(p), t.Gear, bar(t.RpmNorm, 10)))
		table.insert(lines, string.format("hız %5.1f km/h   boyuna %+.2fg   yanal %+.2fg", t.Speed * KMH, t.LongG, t.LatG))
		table.insert(lines, string.format("gaz %3d%%  fren %3d%%  elfreni %3d%%", math.floor(t.Throttle * 100), math.floor(t.Brake * 100), math.floor(t.Handbrake * 100)))
		table.insert(lines, string.format("direksiyon %+.2f -> %+.1f° (sınır %.1f°)", t.Steer, t.SteerDeg, t.SteerLimit))
		table.insert(lines, string.format("kayma β %+.1f°  yaw %+.0f°/s  denge %+.1f", t.SideSlip, t.YawRate, t.StabilityTorque))
		table.insert(lines, string.format("temas %d/4  havada %s", t.Contacts, if t.Airborne then "EVET" else "hayır"))
		table.insert(lines, "TEKER  sıkış  yük   kayma%  açı°   μ    zemin  dir.hata°  titreme°")
		for _, w in car.Wheels do
			table.insert(lines, string.format("%-5s  %4.2f  %4.2f  %+5.0f  %5.1f  %4.2f  %4.2f  %+6.2f  %6.2f%s",
				w.Name, w.Compression, w.Load, w.SlipRatio * 100, w.SlipAngle, w.Mu, w.SurfaceGrip,
				w.SteerError, w.Wobble, if w.Sliding then "  KAYIYOR" else ""))
		end
	elseif c and c.IsBike and c.IsDriver and c.BikeTelemetry then
		-- Motosiklet (araç fizik kararlılığı): teker teması, yerden kesilme sayısı, çekiş kontrolü / ABS, yatış
		local t = c.BikeTelemetry
		table.insert(lines, string.format("%s  (motosiklet)", c.Def.DisplayName))
		table.insert(lines, string.format("hız %5.1f km/h   gaz %3d%%  fren %3d%%   ÇK %s  ABS %s", t.Speed * KMH,
			math.floor(t.Throttle * 100), math.floor(t.Brake * 100), if t.TcActive then "AKTİF" else "-", if t.AbsActive then "AKTİF" else "-"))
		table.insert(lines, string.format("burun %+5.1f°   yatış hedef %+5.1f°  gerçek %+5.1f°", t.Pitch, t.LeanTarget, t.LeanActual))
		table.insert(lines, "TEKER  temas  sıkış  yüzey hızı  yer hızı  kesilme")
		for _, w in t.Order do
			table.insert(lines, string.format("%-5s  %-5s  %4.2f   %7.1f    %7.1f    %d", w.Name, if w.Contact then "var" else "YOK",
				w.Compression, w.SurfaceSpeed, t.ForwardSpeed, w.Lifts))
		end
	else
		table.insert(lines, "Otomobile ya da motosiklete sürücü olarak bin.")
	end
	liveLabel.Text = table.concat(lines, "\n")
	resultsLabel.Text = if #results > 0 then "SON ÖLÇÜMLER\n" .. table.concat(results, "\n") else "SON ÖLÇÜMLER\n(henüz yok)"
end

local function setVisible(value: boolean)
	visible = value
	gui.Enabled = value
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "SolaraTelemetry"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 90
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.Enabled = false
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Position = UDim2.fromOffset(10, 60)
	panel.Size = UDim2.fromOffset(470, 470)
	panel.BackgroundColor3 = UIConfig.Colors.Background
	panel.BackgroundTransparency = 0.25
	panel.Active = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = panel
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft, padding.PaddingTop, padding.PaddingRight = UDim.new(0, 10), UDim.new(0, 8), UDim.new(0, 10)
	padding.Parent = panel
	local function label(name: string, y: number, height: number, color: Color3): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromOffset(0, y)
		l.Size = UDim2.new(1, 0, 0, height)
		l.FontFace = UIConfig.Fonts.Mono
		l.TextSize = 13
		l.TextColor3 = color
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextWrapped = true
		l.AutoLocalize = false
		l.Parent = panel
		return l
	end
	liveLabel = label("Live", 0, 200, UIConfig.Colors.Text)
	resultsLabel = label("Results", 206, 250, Color3.fromRGB(255, 214, 150))
	panel.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui")
end

function VehicleTelemetryController:Init(allControllers)
	controllers = allControllers
end

function VehicleTelemetryController:Start()
	build()
	local course = workspace:FindFirstChild("SolaraTestCourse")
	if course then
		watchCourse(course)
	end
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "SolaraTestCourse" then
			watchCourse(child)
		end
	end)

	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "ToggleTelemetry" then
			userToggled = true
			setVisible(not visible)
		end
	end)
	-- Test pistindeyken otomobile binince otomatik aç (oyuncu F4 ile kapattıysa açma)
	controllers.VehicleController.Entered:Connect(function(_, isDriver)
		if isDriver and not userToggled and workspace:GetAttribute("SolaraTestCourseReady") == true then
			setVisible(true)
		end
	end)

	RunService.Heartbeat:Connect(step)
	task.spawn(function()
		while true do
			task.wait(0.1)
			if visible then
				pcall(refreshPanel)
			end
		end
	end)
end

return VehicleTelemetryController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX26CF15BCN"><Properties>
<string name="Name">NavigationController</string>

<ProtectedString name="Source"><![CDATA[-- NavigationController: GPS durumu (Aşama 4). Hedef, rota, ilerleme, yeniden rota, varış.
-- Harita görünümleri (minimap, tam harita) sadece buradan OKUR; rota hesabı Shared/Navigation'da.
--
-- Konum kaynağı: araçtaysak aracın şasisi, değilsek karakterin kökü (MapDefinitions ile aynı dünya koordinatı).
-- Güncelleme 10 Hz; rota yalnızca hedef değişince ya da oyuncu rotadan sapınca yeniden hesaplanır.
-- Hedef yerel bir tercihtir (sunucuya gitmez); yeniden doğmada korunur.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapDefinitions = require(Shared.MapDefinitions)
local Navigation = require(Shared:WaitForChild("Navigation"))
local MapView = require(Shared:WaitForChild("MapView"))
local Signal = require(Shared.Utilities.Signal)
local Log = require(Shared.Utilities.Log).new("Navigation")

local NavigationController = {
	Name = "NavigationController",
	Priority = 7,
	DestinationChanged = Signal.new(), -- (destination | nil)
	RouteChanged = Signal.new(), -- (route | nil, status)   status: "Active" | "Unreachable" | "NoRoadNearStart" | "Cleared"
	Arrived = Signal.new(), -- (destination)
}

local UPDATE_INTERVAL = 0.1
local REROUTE_DEVIATION = 35 -- stud: rotadan bu kadar uzaklaşınca…
local REROUTE_AFTER = 1.2 -- sn sürerse yeniden hesapla
local REROUTE_COOLDOWN = 1.0
local ARRIVE_DISTANCE = 30 -- stud (≈ 8 m)

local controllers
local nav = nil
local destination = nil -- { Kind = "POI" | "Waypoint", Id, Name, Position: Vector3 }
local route = nil
local progress = nil
local status = "Idle" -- Idle | Active | Unreachable | NoRoadNearStart | Arrived
local offRouteTime = 0
local lastRouteAt = -100
local beacon: Part? = nil

-- ===== Konum =====
function NavigationController:GetSubject(): BasePart?
	local vehicle = controllers.VehicleController and controllers.VehicleController:GetCurrent()
	if vehicle and vehicle.Chassis and vehicle.Chassis.Parent then
		return vehicle.Chassis
	end
	return controllers.CharacterController:GetRootPart()
end

-- Kuzey = 0°, doğu (+X) = 90° (haritada saat yönü). Konumla aynı kaynaktan (GetSubject). Bakış yatay düzleme
-- izdüşürülür; araç dikleşmiş/devrilmişse (yatay bileşen < 0.3) son geçerli yön korunur — eskiden ok rastgele
-- yönlere dönüyordu. Yumuşatma yok: ok gerçek yönü gecikmesiz gösterir.
local lastHeading = 0
function NavigationController:GetHeading(): number
	local subject = self:GetSubject()
	if not subject then
		return lastHeading
	end
	local look = subject.CFrame.LookVector
	lastHeading = MapView.Heading(look.X, look.Z, lastHeading)
	return lastHeading
end

-- ===== Dünyadaki hedef işareti (sadece bu oyuncuda görünür: kameraya bağlı parça) =====
local function updateBeacon()
	if destination and status ~= "Arrived" then
		if not beacon then
			local p = Instance.new("Part")
			p.Name = "SolaraDestinationBeacon"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(64, 196, 214)
			p.Transparency = 0.6
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(260, 5, 5)
			beacon = p
		end
		local position = destination.Position
		beacon.CFrame = CFrame.new(position.X, position.Y + 130, position.Z) * CFrame.Angles(0, 0, math.pi / 2)
		beacon.Parent = workspace.CurrentCamera
	elseif beacon then
		beacon.Parent = nil
	end
end

-- ===== Rota =====
local function recompute(reason: string)
	if not destination or not nav then
		return
	end
	local subject = NavigationController:GetSubject()
	if not subject then
		return -- karakter yok (menü): doğunca hesaplanır
	end
	lastRouteAt = os.clock()
	offRouteTime = 0
	local result, failure = nav:FindRoute(subject.Position, destination.Position)
	if result then
		route = result
		status = "Active"
		progress = Navigation.Progress(route, subject.Position, nil)
		Log.Info("Rota", reason, string.format("%.0f stud, %d manevra", route.Length, #route.Maneuvers))
	else
		route = nil
		progress = nil
		status = failure or "Unreachable"
		Log.Info("Rota bulunamadı:", status)
	end
	NavigationController.RouteChanged:Fire(route, status)
	updateBeacon()
end

-- ===== Genel API =====
function NavigationController:GetDestination()
	return destination
end

function NavigationController:GetRoute()
	return route
end

function NavigationController:GetProgress()
	return progress
end

function NavigationController:GetStatus(): string
	return status
end

function NavigationController:SetDestinationPOI(poiId: string): boolean
	local poi = MapDefinitions.GetPOI(poiId)
	if not poi then
		return false
	end
	destination = { Kind = "POI", Id = poi.Id, Name = poi.Name, Type = poi.Type, Position = Vector3.new(poi.Entrance.X, 0.8, poi.Entrance.Z) }
	status = "Idle"
	NavigationController.DestinationChanged:Fire(destination)
	recompute("hedef")
	return true
end

-- Haritada işaretlenen nokta (dünya X/Z). Y: zemin seviyesi varsayılır (yükseltilmiş yollar cezalandırılır).
function NavigationController:SetWaypoint(x: number, z: number)
	local half = MapDefinitions.GetMeta().HalfSize
	x, z = math.clamp(x, -half, half), math.clamp(z, -half, half)
	destination = { Kind = "Waypoint", Id = nil, Name = nil, Position = Vector3.new(x, 0.8, z) }
	status = "Idle"
	NavigationController.DestinationChanged:Fire(destination)
	recompute("işaret")
end

function NavigationController:ClearDestination()
	destination = nil
	route = nil
	progress = nil
	status = "Idle"
	NavigationController.DestinationChanged:Fire(nil)
	NavigationController.RouteChanged:Fire(nil, "Cleared")
	updateBeacon()
end

-- ===== Döngü =====
local function step()
	if not destination then
		return
	end
	local subject = NavigationController:GetSubject()
	if not subject then
		return
	end
	if not route then
		-- karakter yoktu ya da rota bulunamamıştı: ara sıra yeniden dene (oyuncu yola çıkmış olabilir)
		if os.clock() - lastRouteAt > (if status == "Idle" then 0 else 4) then
			recompute("bekleyen")
		end
		return
	end
	local position = subject.Position
	progress = Navigation.Progress(route, position, progress and progress.Segment)
	-- Varış: hedefe yakın ya da (yol dışı bitişte) yolun sonuna gelindi ve hedef yakın
	local toDestination = (Vector3.new(position.X, 0, position.Z) - Vector3.new(destination.Position.X, 0, destination.Position.Z)).Magnitude
	if toDestination < ARRIVE_DISTANCE or (not route.Offroad and progress.Remaining < ARRIVE_DISTANCE * 0.5) then
		status = "Arrived"
		local arrivedAt = destination
		route = nil
		progress = nil
		NavigationController.RouteChanged:Fire(nil, "Arrived")
		NavigationController.Arrived:Fire(arrivedAt)
		destination = nil
		NavigationController.DestinationChanged:Fire(nil)
		updateBeacon()
		return
	end
	-- Sapma → yeniden rota
	if progress.Deviation > REROUTE_DEVIATION then
		offRouteTime += UPDATE_INTERVAL
		if offRouteTime > REROUTE_AFTER and os.clock() - lastRouteAt > REROUTE_COOLDOWN then
			recompute("sapma")
		end
	else
		offRouteTime = 0
	end
end

function NavigationController:IsRerouting(): boolean
	return offRouteTime > 0.4
end

function NavigationController:Init(allControllers)
	controllers = allControllers
end

function NavigationController:Start()
	local ok, result = pcall(function()
		return Navigation.new(MapDefinitions.GetData())
	end)
	if ok then
		nav = result
	else
		Log.Warn("Navigasyon kurulamadı:", result)
	end
	-- Yeniden doğunca (konum değişti) rota yeni konumdan
	controllers.CharacterController.CharacterChanged:Connect(function(character)
		if character and destination then
			task.delay(1, function()
				recompute("doğma")
			end)
		end
	end)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < UPDATE_INTERVAL then
			return
		end
		accumulator = 0
		local okStep, err = pcall(step)
		if not okStep then
			Log.Warn("Navigasyon adımı hata verdi:", err)
		end
	end)
end

return NavigationController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0D7E389DN"><Properties>
<string name="Name">MinimapController</string>

<ProtectedString name="Source"><![CDATA[-- MinimapController: köşe haritası + yönlendirme paneli (Aşama 4).
--
-- Yerleşim DrivingLayout'tan: masaüstü sol alt (harita) + hemen üstünde yönlendirme; dokunmatik sol üst +
-- altında yönlendirme. Sürüş HUD'u ve mobil butonlar aynı hesaptan beslendiği için çakışmazlar.
-- Harita kuzey-yukarıdır; oyuncu oku ortada sabit, yönü döner. Her karede hesaplanır ama özellik sadece değişince
-- yazılır: harita konumu tam piksel değişince, ok açısı 0.5° değişince (GPS/harita kararlılık düzeltmesi).
-- Yakınlaştırma yürürken sabit, araçta YATAY hızla açılır (≈300 → ≈800 stud yarıçap). Uygulanan yakınlık %2.5'lik
-- adımlarla değişir (MapView.ZoomStep): binlerce harita parçası her karede yeniden yerleşmez; konum her zaman
-- uygulanan ölçekle hesaplandığı için bu adımlar konum hatası yaratmaz.
-- Sadece oyun sırasında görünür (ana menüde gizli). Dokununca/tıklayınca tam harita açılır.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local DrivingLayout = require(Modules:WaitForChild("DrivingLayout"))
local MapView = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapView"))

local FrontEnd = script.Parent.Parent:WaitForChild("FrontEnd")
local Theme = require(FrontEnd:WaitForChild("Theme"))
local Strings = require(FrontEnd:WaitForChild("Strings"))
local MapCanvas = require(FrontEnd:WaitForChild("Map"):WaitForChild("MapCanvas"))

local MinimapController = {
	Name = "MinimapController",
	Priority = 13, -- FrontEnd (11) ve Navigation (7) sonrası
}

local C = Theme.Colors
local player = Players.LocalPlayer
local controllers

local SCALE_ON_FOOT = 0.34 -- piksel/stud (temel boyutlu harita için; harita boyutuna göre ölçeklenir)
local SCALE_SLOW = 0.22
local SCALE_FAST = 0.12
local REFERENCE_SIZE = 200 -- yukarıdaki ölçekler bu piksel çaplı harita içindir
local ZOOM_STEP = 0.025 -- uygulanan yakınlık hedeften bu oran kadar uzaklaşınca güncellenir
local ARROW_STEP = 0.5 -- derece: okun açısı bundan küçük değişimde yeniden yazılmaz

local gui: ScreenGui
local root: Frame
local clip: Frame
local canvas
local arrow: Frame
local northTag: TextLabel
local openButton: TextButton
local guide: Frame
local guideIcon: Frame
local guideDistance: TextLabel
local guideText: TextLabel
local guideSub: TextLabel
local currentScale = SCALE_ON_FOOT -- yumuşak hedef yakınlık
local appliedScale = nil -- tuvale uygulanan yakınlık (ZOOM_STEP adımlı)
local arrowHeading = nil
local guideAccumulator = 0
local lastWarnAt = -100

local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

-- Manevra oku: gövde + uç; dönüş açısı kadar döndürülür. Varış = halka.
local function buildGuideIcon(parent: Instance): Frame
	local holder = new("Frame", { Name = "Icon", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), SizeConstraint = Enum.SizeConstraint.RelativeYY, Parent = parent })
	local arrowFrame = new("Frame", { Name = "Arrow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8), Parent = holder })
	new("Frame", { Name = "Shaft", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromScale(0.16, 0.62), BackgroundColor3 = C.AccentAlt, BorderSizePixel = 0, Parent = arrowFrame })
	for _, sign in { -1, 1 } do
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + sign * 0.14, 0.24),
			Size = UDim2.fromScale(0.16, 0.42),
			Rotation = sign * 40,
			BackgroundColor3 = C.AccentAlt,
			BorderSizePixel = 0,
			Parent = arrowFrame,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = bar })
	end
	local ring = new("Frame", { Name = "Ring", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6), BackgroundTransparency = 1, Visible = false, Parent = holder })
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
	new("UIStroke", { Color = C.AccentAlt, Thickness = 4, Parent = ring })
	return holder
end

local MANEUVER_TEXT = {
	Left = "Nav.Left", Right = "Nav.Right", SlightLeft = "Nav.SlightLeft", SlightRight = "Nav.SlightRight",
	UTurn = "Nav.UTurn", Continue = "Nav.Continue", Arrive = "Nav.Arrive",
}

local function build()
	gui = new("ScreenGui", {
		Name = "SolaraMinimap",
		ResetOnSpawn = false,
		DisplayOrder = 7, -- araç HUD'unun (6) üstünde, menünün (50) altında
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Enabled = false,
	})
	root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })

	-- Harita çerçevesi (Hata düzeltme 4 + 5): sabit kare alan, ClipsDescendants'lı SIRADAN Frame. CanvasGroup
	-- kullanılmaz (düşük bellekte kırpamayıp 10240²'lik koyu tuvali ekrana yayıyordu); harita tuvalinde döndürülmüş
	-- öğe yok, bu yüzden bu kırpma her cihazda tam çalışır. Görünür kenarlık = "Ring" (aynı dikdörtgen).
	-- Köşeler bilerek düz: ClipsDescendants UICorner'a uymaz, yuvarlak köşede harita dışarı taşardı.
	clip = new("Frame", {
		Name = "Minimap", BackgroundColor3 = MapCanvas.LandColor, BackgroundTransparency = 0,
		ClipsDescendants = true, Parent = root,
	})
	canvas = MapCanvas.new(clip, { Detail = "Mini" })
	local ring = new("Frame", { Name = "Ring", BackgroundTransparency = 1, ZIndex = 4, Parent = root })
	new("UIStroke", { Color = C.White, Transparency = 0.35, Thickness = 2, Parent = ring })
	arrow = MapCanvas.MakeArrow(root, 5)
	northTag = new("TextLabel", {
		Name = "North", BackgroundColor3 = C.Background, BackgroundTransparency = 0.2, Text = "N", TextScaled = true,
		FontFace = Theme.Fonts.Title, TextColor3 = C.Accent, AutoLocalize = false, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 5, Parent = root,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = northTag })
	openButton = new("TextButton", { Name = "Open", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 6, Parent = root })
	openButton.Activated:Connect(function()
		local frontEnd = controllers.FrontEndController
		if frontEnd and frontEnd.OpenMap then
			frontEnd:OpenMap()
		end
	end)

	-- Yönlendirme paneli
	guide = new("Frame", { Name = "Guidance", BackgroundColor3 = C.Background, BackgroundTransparency = 0.15, Visible = false, ZIndex = 10, Parent = root })
	new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = guide })
	new("UIStroke", { Color = C.AccentAlt, Transparency = 0.55, Thickness = 1.5, Parent = guide })
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = guide })
	guideIcon = buildGuideIcon(guide)
	guideDistance = new("TextLabel", {
		Name = "Distance", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0.5, 0),
		TextScaled = true, FontFace = Theme.Fonts.Display, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left, AutoLocalize = false, Parent = guide,
	})
	guideText = new("TextLabel", {
		Name = "Instruction", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.28, 0),
		TextScaled = true, FontFace = Theme.Fonts.Body, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, AutoLocalize = false, Parent = guide,
	})
	guideSub = new("TextLabel", {
		Name = "Remaining", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.22, 0),
		TextScaled = true, FontFace = Theme.Fonts.Light, TextColor3 = C.TextMuted, TextXAlignment = Enum.TextXAlignment.Right, AutoLocalize = false, Parent = guide,
	})
	gui.Parent = player:WaitForChild("PlayerGui")
	return ring
end

local ringFrame: Frame

local function place(target: GuiObject, r)
	target.Position = UDim2.fromOffset(r.X, r.Y)
	target.Size = UDim2.fromOffset(r.W, r.H)
end

local function layout()
	local area = root.AbsoluteSize
	if area.X < 10 then
		return
	end
	local rects
	if controllers.InputController:IsTouch() then
		local scale = controllers.SettingsController:Get("MobileButtonScale") or 1
		local base = DrivingLayout.ButtonSize(area.X, area.Y, scale)
		local vehicle = controllers.VehicleController:GetCurrent()
		local kind = if vehicle then (if not vehicle.IsDriver then "Passenger" elseif vehicle.IsBike then "Motorcycle" else "Car") else "Car"
		rects = DrivingLayout.Touch(area.X, area.Y, base, { Kind = kind, Steering = controllers.SettingsController:Get("MobileSteering") })
	else
		rects = DrivingLayout.Desktop(area.X, area.Y)
	end
	local m = rects.Minimap
	place(clip, m)
	place(ringFrame, m)
	place(openButton, m)
	local arrowSize = math.floor(math.clamp(m.W * 0.13, 14, 28))
	arrow.Position = UDim2.fromOffset(m.X + m.W / 2, m.Y + m.H / 2)
	arrow.Size = UDim2.fromOffset(arrowSize, arrowSize)
	local tag = math.floor(math.clamp(m.W * 0.12, 14, 24))
	northTag.Position = UDim2.fromOffset(m.X + m.W / 2, m.Y + tag / 2 + 3) -- çerçevenin içinde
	northTag.Size = UDim2.fromOffset(tag, tag)
	local g = rects.Guidance
	place(guide, g)
	-- panel içi: sol kare ikon, sağda metin
	local iconW = g.H - 8
	guideDistance.Position = UDim2.fromOffset(iconW + 6, 0)
	guideDistance.Size = UDim2.new(0.55, -(iconW + 6), 0.48, 0) -- sağdaki kalan-mesafe yazısıyla çakışmasın
	guideText.Position = UDim2.new(0, iconW + 6, 0.5, 0)
	guideText.Size = UDim2.new(1, -(iconW + 6), 0.3, 0)
	guideSub.Position = UDim2.new(0, 0, 0.04, 0)
	guideSub.Size = UDim2.new(1, 0, 0.3, 0)
end

local function shouldShow(): boolean
	local frontEnd = controllers.FrontEndController
	return frontEnd == nil or frontEnd:GetState() == "Playing"
end

local function updateGuidance()
	local navigation = controllers.NavigationController
	local route = navigation:GetRoute()
	local progress = navigation:GetProgress()
	local status = navigation:GetStatus()
	local destination = navigation:GetDestination()
	if not destination then
		guide.Visible = false
		return
	end
	guide.Visible = true
	local arrowFrame = guideIcon:FindFirstChild("Arrow") :: Frame
	local ringIcon = guideIcon:FindFirstChild("Ring") :: Frame
	if not route or not progress then
		arrowFrame.Visible, ringIcon.Visible = false, true
		guideDistance.Text = "—"
		guideText.Text = Strings.Get(if status == "NoRoadNearStart" then "Map.NoRoad" else "Map.Unreachable")
		guideSub.Text = ""
		return
	end
	local nextManeuver = progress.Next
	local arriving = nextManeuver.Type == "Arrive"
	arrowFrame.Visible, ringIcon.Visible = not arriving, arriving
	if not arriving then
		arrowFrame.Rotation = math.clamp(nextManeuver.Angle, -150, 150)
		if nextManeuver.Type == "UTurn" then
			arrowFrame.Rotation = 180
		end
	end
	guideDistance.Text = Strings.Distance(progress.NextDistance)
	if navigation:IsRerouting() then
		guideText.Text = Strings.Get("Nav.Rerouting")
	elseif arriving and route.Offroad then
		local destinationPos = route.Destination
		local last = route.Points[#route.Points]
		local gap = math.sqrt((destinationPos.X - last.X) ^ 2 + (destinationPos.Z - last.Z) ^ 2)
		guideText.Text = Strings.Get("Nav.OffroadEnd", Strings.Distance(gap))
	else
		local text = Strings.Get(MANEUVER_TEXT[nextManeuver.Type] or "Nav.Continue")
		if nextManeuver.Street ~= "" and not arriving then
			text ..= " · " .. nextManeuver.Street
		elseif arriving and destination.Name then
			text ..= " · " .. destination.Name
		end
		guideText.Text = text
	end
	guideSub.Text = Strings.Get("Nav.Remaining", Strings.Distance(progress.Remaining))
end

local function step(dt: number)
	local show = shouldShow()
	if gui.Enabled ~= show then
		gui.Enabled = show
	end
	if not show then
		return
	end
	local navigation = controllers.NavigationController
	-- Tek konum kaynağı: araçtaysa aracın şasisi (kök parça), değilse karakterin kökü. Tam harita ve GPS de bunu okur.
	local subject = navigation:GetSubject()
	if not subject then
		return
	end
	-- Yakınlaştırma: yürürken sabit; araçta yatay hızla uzaklaş (yol sarsıntısındaki dikey hız yakınlığı oynatmaz)
	local target = SCALE_ON_FOOT
	local vehicle = controllers.VehicleController:GetCurrent()
	if vehicle then
		local v = subject.AssemblyLinearVelocity
		local planar = math.sqrt(v.X * v.X + v.Z * v.Z)
		local speedFrac = math.clamp(planar / math.max(vehicle.Def.MaxSpeed, 1), 0, 1)
		target = SCALE_SLOW + (SCALE_FAST - SCALE_SLOW) * speedFrac
	end
	currentScale += (target - currentScale) * math.clamp(dt * 1.5, 0, 1)
	appliedScale = MapView.ZoomStep(appliedScale, currentScale, ZOOM_STEP)
	local size = clip.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return -- yerleşim henüz yok
	end
	local scale = appliedScale * (size.X / REFERENCE_SIZE)
	local position = subject.Position
	canvas:SetView(position.X, position.Z, scale, size)
	local heading = navigation:GetHeading()
	if arrowHeading == nil or math.abs(MapView.AngleDelta(heading, arrowHeading)) >= ARROW_STEP then
		arrowHeading = heading
		arrow.Rotation = heading
	end
end

function MinimapController:Init(allControllers)
	controllers = allControllers
end

function MinimapController:Start()
	ringFrame = build()
	layout()
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	controllers.InputController.DeviceChanged:Connect(layout)
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "MobileButtonScale" or key == "MobileSteering" then
			layout()
		end
	end)
	controllers.VehicleController.Entered:Connect(layout)
	controllers.VehicleController.Exited:Connect(layout)

	local navigation = controllers.NavigationController
	navigation.RouteChanged:Connect(function(route)
		canvas:SetRoute(route)
		updateGuidance()
	end)
	navigation.DestinationChanged:Connect(function(destination)
		canvas:SetDestination(destination and destination.Position)
		updateGuidance()
	end)

	-- Her karede (kamera ile aynı karede): eskiden 30 Hz ve düzensiz (2-3 karede bir) güncelleniyordu.
	-- Yazma işi sadece değişimde olduğu için kare başına maliyet birkaç aritmetik işlemdir.
	RunService.RenderStepped:Connect(function(dt)
		guideAccumulator += dt
		local ok, err = pcall(step, dt)
		if not ok and os.clock() - lastWarnAt > 5 then
			lastWarnAt = os.clock() -- her karede uyarı basma
			warn("[Minimap]", err)
		end
		if guideAccumulator >= 0.2 then
			guideAccumulator = 0
			if gui.Enabled then
				pcall(updateGuidance)
			end
		end
	end)
end

return MinimapController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXF5E07629N"><Properties>
<string name="Name">GraphicsController</string>

<ProtectedString name="Source"><![CDATA[-- GraphicsController: oyuncunun grafik tercihlerini YEREL olarak uygular (Aşama 1).
--
-- WeatherService Lighting efektlerini sunucuda bir kez kurar (SolaraBloom, SolaraSunRays, SolaraColor).
-- İstemcideki Enabled/GlobalShadows değişiklikleri sadece bu oyuncuyu etkiler ve sunucu bu
-- özellikleri tekrar yazmadığı için kalıcıdır.
--
-- Not: Roblox'un kendi "Grafik Kalitesi" kaydırıcısı oyun scriptlerinden değiştirilemez
-- (Esc → Ayarlar). Ayarlar ekranı bunu oyuncuya açıkça söyler.

local Lighting = game:GetService("Lighting")

local GraphicsController = {
	Name = "GraphicsController",
	Priority = 2,
}

local controllers

local EFFECT_NAMES = { "SolaraBloom", "SolaraSunRays", "SolaraColor" }

local function applyEffects()
	local enabled = controllers.SettingsController:Get("VisualEffects") ~= false
	for _, name in EFFECT_NAMES do
		local effect = Lighting:FindFirstChild(name)
		if effect and effect:IsA("PostEffect") then
			effect.Enabled = enabled
		end
	end
end

local function applyShadows()
	Lighting.GlobalShadows = controllers.SettingsController:Get("Shadows") ~= false
end

function GraphicsController:Init(allControllers)
	controllers = allControllers
end

function GraphicsController:Start()
	applyEffects()
	applyShadows()
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "VisualEffects" then
			applyEffects()
		elseif key == "Shadows" then
			applyShadows()
		end
	end)
	-- Efektler istemci yüklendikten sonra çoğalırsa da tercihe uysun
	Lighting.ChildAdded:Connect(function(child)
		if table.find(EFFECT_NAMES, child.Name) then
			task.defer(applyEffects)
		end
	end)
end

return GraphicsController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXE63D1E2AN"><Properties>
<string name="Name">FrontEndController</string>

<ProtectedString name="Source"><![CDATA[-- FrontEndController: ana menü ve oyuna giriş akışı (Aşama 1). Durum makinesi + sahiplik kuralları.
-- Görsel katmanlar FrontEnd/ klasöründedir (Shell, Backdrop, Screens/*, Widgets...); bu dosya sadece yönetir.
--
-- Durumlar:
--   Title     İlk açılış. Karakter YOK (Players.CharacterAutoLoads = false). Menü kamerası şehri gösterir.
--   Spawning  OYNA'ya basıldı; sunucudan karakter bekleniyor (tek istek, zaman aşımlı, tekrar denenebilir).
--   Playing   Menü kapalı; normal oyun.
--   Paused    Oyun içinde menü yeniden açıldı (P / D-Pad Sol / dokunmatik ☰). Çok oyunculu dünya durmaz;
--             karakter yerinde kalır, oyun girişleri kilitlenir.
--
-- Sahiplik kuralları (mevcut mimariye uyum):
--   * Kamera: CFrame'i sadece CameraController yazar. Menü "FrontEnd" adına RequestScripted isteği bırakır;
--     kapanırken Release + SnapBehindCharacter → normal kamera eksiksiz geri gelir.
--   * Girişler: menü açıkken InputController "OnFoot" bağlamı kapanır, "Menu" bağlamı açılır; PlayerModule
--     kontrolleri, ProximityPrompt'lar, dokunmatik joystick/zıplama ve mobil butonlar kapanır.
--   * Araçtayken menü açılmaz (kontrolleri, kamerayı ve mobil düzeni araç sistemi yönetir).
--   * Tek ScreenGui (Shell). ResetOnSpawn = false; yeniden doğmada yeniden yaratılmaz.

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local RemoteRegistry = require(Shared.RemoteRegistry)
local Signal = require(Shared.Utilities.Signal)
local Log = require(Shared.Utilities.Log).new("FrontEnd")
local FrontEndConfig = require(Modules.FrontEndConfig)

local FrontEndFolder = script.Parent.Parent:WaitForChild("FrontEnd")
local ScreensFolder = FrontEndFolder:WaitForChild("Screens")
local Strings = require(FrontEndFolder:WaitForChild("Strings"))
local Fader = require(FrontEndFolder:WaitForChild("Fader"))
local Shell = require(FrontEndFolder:WaitForChild("Shell"))
local MenuInput = require(FrontEndFolder:WaitForChild("MenuInput"))
local MenuCamera = require(FrontEndFolder:WaitForChild("MenuCamera"))
local MainScreen = require(ScreensFolder:WaitForChild("MainScreen"))
local SettingsScreen = require(ScreensFolder:WaitForChild("SettingsScreen"))
local GarageScreen = require(ScreensFolder:WaitForChild("GarageScreen"))
local MapScreen = require(ScreensFolder:WaitForChild("MapScreen"))

local FrontEndController = {
	Name = "FrontEndController",
	Priority = 11, -- diğer tüm kontrolcüler başladıktan sonra
	StateChanged = Signal.new(), -- (newState, oldState)
	Opened = Signal.new(), -- (mode)
	Closed = Signal.new(),
}

local OWNER = "FrontEnd"
local CAMERA_PRIORITY = 80 -- araç kamerası (20) ile sinematik (90) arasında
local HIDDEN_CORE_GUIS = { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu }

local player = Players.LocalPlayer
local controllers
local shell
local screens = {}

local state = "Title"
local menuVisible = false
local gameplayLocked = false
local currentScreenName: string? = nil
local spawnToken = 0
local lastSpawnStatus: string? = nil
local savedCoreGui: { [Enum.CoreGuiType]: boolean } = {}
local playerControls = nil
local grade: ColorCorrectionEffect? = nil
local streamRequestDone = false
local requestSpawnRemote: RemoteEvent

-- ===== Yardımcılar =====
local function reduceMotion(): boolean
	return controllers.SettingsController:Get("ReduceMotion") == true
end

local function duration(seconds: number): number
	return if reduceMotion() then 0 else seconds
end

local function playSound(kind: string)
	local audio = controllers.AudioController
	if audio and audio.PlayInterface then
		audio:PlayInterface(kind)
	end
end

local function setState(newState: string)
	if newState ~= state then
		local old = state
		state = newState
		FrontEndController.StateChanged:Fire(newState, old)
	end
end

local function inVehicle(): boolean
	return controllers.VehicleController ~= nil and controllers.VehicleController:IsInVehicle()
end

-- Araçtayken menü/harita sadece araç neredeyse dururken açılır (sürüş girişleri o sırada askıya alınır)
local STOPPED_SPEED = 3 -- stud/sn
local function vehicleMoving(): boolean
	local c = controllers.VehicleController and controllers.VehicleController:GetCurrent()
	return c ~= nil and c.Chassis ~= nil and c.Chassis.AssemblyLinearVelocity.Magnitude > STOPPED_SPEED
end

local function isTouch(): boolean
	return controllers.InputController:GetDeviceType() == Constants.DeviceTypes.Touch
end

local function currentScreen()
	return currentScreenName and screens[currentScreenName]
end

local function getControls()
	if not playerControls then
		local ok, controls = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		end)
		if ok then
			playerControls = controls
		else
			Log.Warn("PlayerModule kontrolleri alınamadı:", controls)
		end
	end
	return playerControls
end

local function setDefaultControls(enabled: boolean)
	local controls = getControls()
	if controls then
		pcall(function()
			if enabled then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

-- ===== Oyun girişlerini kilitle / aç =====
local function setCoreGuiHidden(hidden: boolean)
	for _, kind in HIDDEN_CORE_GUIS do
		pcall(function()
			if hidden then
				if savedCoreGui[kind] == nil then
					savedCoreGui[kind] = StarterGui:GetCoreGuiEnabled(kind)
				end
				StarterGui:SetCoreGuiEnabled(kind, false)
			elseif savedCoreGui[kind] ~= nil then
				StarterGui:SetCoreGuiEnabled(kind, savedCoreGui[kind])
				savedCoreGui[kind] = nil
			end
		end)
	end
end

local function lockGameplay(lock: boolean)
	if gameplayLocked == lock then
		return
	end
	gameplayLocked = lock
	local input = controllers.InputController
	if lock then
		setDefaultControls(false)
		ProximityPromptService.Enabled = false
		pcall(function()
			GuiService.TouchControlsEnabled = false
		end)
		controllers.MobileControlsController:SetLayout("Hidden")
		input:SetContext("OnFoot", false)
		if inVehicle() then
			input:SetContext("Vehicle", false) -- araç tuşları menü tuşlarıyla aynı önceliktedir; askıya al
		end
		input:SetContext("Menu", true)
		controllers.CharacterController:SetMovementLocked(OWNER, true)
		setCoreGuiHidden(true)
	else
		input:SetContext("Menu", false)
		input:SetContext("OnFoot", true)
		if inVehicle() then
			input:SetContext("Vehicle", true)
		end
		controllers.CharacterController:SetMovementLocked(OWNER, false)
		pcall(function()
			GuiService.TouchControlsEnabled = true
		end)
		-- Araçtaysa kontroller/istemler/mobil düzen araç sistemine aittir; dokunma.
		if not inVehicle() then
			setDefaultControls(true)
			ProximityPromptService.Enabled = true
			controllers.MobileControlsController:SetLayout("OnFoot")
		else
			controllers.MobileControlsController:SetLayout(controllers.VehicleController:GetMobileLayout())
		end
		setCoreGuiHidden(false)
	end
end

-- ===== Kamera =====
local function setGrade(on: boolean)
	local camera = workspace.CurrentCamera
	if on and (not grade or grade.Parent ~= camera) then
		if grade then
			grade:Destroy()
		end
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "SolaraMenuGrade"
		effect.Saturation = 0.12
		effect.Contrast = 0.06
		effect.TintColor = Color3.fromRGB(255, 240, 232)
		effect.Parent = camera -- kameraya bağlı efekt sadece bu oyuncuda görünür
		grade = effect
	end
	if grade then
		grade.Enabled = on
	end
end

local function requestMenuCamera(kind: string)
	local camera = controllers.CameraController
	local supplier
	if kind == "Pause" then
		local look = workspace.CurrentCamera.CFrame.LookVector
		local startYaw = math.atan2(-look.X, -look.Z) -- mevcut bakışın arkasından başla
		supplier = MenuCamera.PauseSupplier(function()
			return controllers.CharacterController:GetRootPart()
		end, reduceMotion, startYaw)
	else
		supplier = MenuCamera.TitleSupplier(reduceMotion)
	end
	camera:RequestScripted(OWNER, Constants.CameraModes.Menu, CAMERA_PRIORITY, supplier)
	setGrade(true)
end

-- smooth: oyun içi menüden dönüşte kamera yumuşakça arkaya kayar; perde arkasındaki girişte anında yerleşir
local function releaseMenuCamera(smooth: boolean?)
	local camera = controllers.CameraController
	camera:Release(OWNER)
	setGrade(false)
	if not inVehicle() then
		camera:SnapBehindCharacter(smooth)
	end
end

-- ===== Ekranlar =====
local function refreshHints()
	shell:SetHints(controllers.InputController:GetDeviceType(), if menuVisible then currentScreenName else nil, state == "Paused")
end

local function refreshPauseButton()
	shell:SetPauseButtonVisible(state == "Playing" and not menuVisible and isTouch() and not inVehicle())
end

local function navigate(name: string)
	if currentScreenName == name then
		return
	end
	local old = currentScreen()
	local target = screens[name]
	local d = duration(0.22)
	if old then
		old:OnHide()
		Fader.Fade(old.Root, false, d, if name == "Main" then 24 else -24)
	end
	currentScreenName = name
	target:OnShow()
	target.Focus:SetHighlight(not isTouch())
	Fader.Fade(target.Root, true, d, if name == "Main" then -24 else 24, function()
		target.Focus:Refresh()
	end)
	shell.Backdrop:SetStyle(if state == "Paused" then "Paused" else "Title", name ~= "Main", d)
	refreshHints()
end

local function showMenu(mode: string, animate: boolean)
	menuVisible = true
	screens.Main:SetMode(mode)
	if mode ~= "Title" then
		shell.Backdrop:SetFallbackVisible(false, 0) -- oyun içinde arka plan oyunun kendisi
	end
	shell:SetMenuShown(true, if animate then duration(0.35) else 0)
	currentScreenName = nil
	navigate("Main")
	refreshPauseButton()
	FrontEndController.Opened:Fire(mode)
end

local function hideMenu(d: number)
	menuVisible = false
	local screen = currentScreen()
	if screen then
		screen:OnHide()
		Fader.Fade(screen.Root, false, d, 0)
	end
	currentScreenName = nil
	shell:SetMenuShown(false, d)
	refreshPauseButton()
	FrontEndController.Closed:Fire()
end

-- ===== Oyun içi menü =====
local function openPause(): boolean
	if state ~= "Playing" or menuVisible then
		return menuVisible
	end
	if inVehicle() and vehicleMoving() then
		shell:Toast(Strings.Get("Toast.InVehicle"), duration(0.2))
		return false
	end
	lockGameplay(true)
	requestMenuCamera("Pause")
	setState("Paused")
	screens.Main:SetStatus(Strings.Get("Status.Paused"), "info")
	showMenu("Paused", true)
	playSound("Select")
	return true
end

-- Tam ekran harita: oyundaysa menüyü açıp doğrudan HARİTA ekranına geçer
local function openMap()
	if state == "Spawning" then
		return
	end
	if state == "Playing" and not openPause() then
		return
	end
	if menuVisible then
		navigate("Map")
	end
end

local function resume()
	if state ~= "Paused" then
		return
	end
	hideMenu(duration(0.25))
	lockGameplay(false)
	releaseMenuCamera(true)
	setState("Playing")
	refreshPauseButton()
	playSound("Back")
end

-- ===== Doğma (OYNA) =====
-- Karakter gelene ve sunucu onu doğma noktasına taşıyana (SpawnedAt) kadar bekler.
local function characterReady(deadline: number): Model?
	local firstSeen: number? = nil
	while os.clock() < deadline do
		if lastSpawnStatus == "Rejected" then
			return nil
		end
		local character = player.Character
		if character and character.Parent and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
			if lastSpawnStatus == "Spawned" and character:GetAttribute(Constants.Attributes.SpawnedAt) ~= nil then
				return character
			end
			firstSeen = firstSeen or os.clock()
			if os.clock() - firstSeen > FrontEndConfig.ClientCharacterReadyTimeout then
				return character
			end
		end
		task.wait(0.1)
	end
	return nil
end

local function enterWorld(token: number)
	local character = characterReady(os.clock() + FrontEndConfig.ClientSpawnTimeout)
	if token ~= spawnToken or state ~= "Spawning" then
		return
	end
	if not character then
		Log.Warn("Doğma başarısız ya da zaman aşımı. Son durum:", lastSpawnStatus)
		setState("Title")
		screens.Main:SetBusy(false)
		screens.Main:SetStatus(Strings.Get("Status.SpawnFailed"), "error")
		playSound("Back")
		return
	end
	-- Perde arkasında: menüyü kapat, girişleri aç, kamerayı karaktere ver
	local fade = duration(0.35)
	shell:SetVeil(true, fade)
	if fade > 0 then
		task.wait(fade)
	end
	-- Perde siyahken bir adım hata verirse perde açılmadan kalıyor ve ekran kapkara kalıyordu.
	-- Hata yine de günlüğe yazılır ama perde HER durumda kalkar (Hata düzeltme 4).
	local ok, err = pcall(function()
		hideMenu(0)
		lockGameplay(false)
		releaseMenuCamera()
		screens.Main:SetBusy(false)
		setState("Playing")
		refreshPauseButton()
	end)
	if not ok then
		Log.Error("Oyuna geçişte hata (perde yine de kaldırılıyor):", err)
	end
	task.wait(0.1) -- kamera yeni konumda bir kare otursun
	shell:SetVeil(false, duration(0.5))
	Log.Info("Oyuna girildi")
end

local function play()
	if state == "Paused" then
		resume()
		return
	end
	if state ~= "Title" then
		return -- çift tıklama / zaten bağlanıyor
	end
	setState("Spawning")
	spawnToken += 1
	lastSpawnStatus = nil
	screens.Main:SetBusy(true)
	screens.Main:SetStatus(Strings.Get("Status.Spawning"), "busy")
	requestSpawnRemote:FireServer()
	task.spawn(enterWorld, spawnToken)
end

-- ===== Şehir hazır mı? (Title arka planı) =====
local function cityVisible(): boolean
	if workspace:GetAttribute("WorldReady") ~= true or not streamRequestDone then
		return false
	end
	-- Çekimin ortasından kulelere ışın: kuleler akmışsa çarpar
	local from, target = MenuCamera.TitleProbe()
	local offset = target - from
	return workspace:Raycast(from, offset.Unit * (offset.Magnitude * 1.2)) ~= nil
end

local function cityWatchLoop()
	task.spawn(function()
		local ok = pcall(function()
			player:RequestStreamAroundAsync(FrontEndConfig.StreamFocus, FrontEndConfig.StreamRequestTimeout)
		end)
		if not ok then
			Log.Info("Akış isteği yapılamadı (StreamingEnabled kapalı olabilir)")
		end
		streamRequestDone = true
	end)
	task.spawn(function()
		while shell.Gui.Parent do
			if state == "Title" or state == "Spawning" then
				local visible = cityVisible()
				shell.Backdrop:SetFallbackVisible(not visible, duration(FrontEndConfig.BackdropFadeTime))
				if state == "Title" and not screens.Main:IsShowingError() then
					if workspace:GetAttribute("WorldReady") ~= true then
						local world = workspace:FindFirstChild("World")
						local progress = world and world:GetAttribute("BuildProgress")
						local percent = if type(progress) == "number" then math.floor(progress * 100) else 0
						screens.Main:SetStatus(Strings.Get("Status.CityLoading", percent), "busy")
					elseif not visible then
						screens.Main:SetStatus(Strings.Get("Status.CityStreaming"), "busy")
					else
						screens.Main:SetStatus(Strings.Get("Status.CityReady"), "ok")
					end
				end
			end
			task.wait(FrontEndConfig.CityProbeInterval)
		end
	end)
end

-- ===== Kurulum =====
local function build()
	local function onMove()
		playSound("Move")
	end
	local function back()
		playSound("Back")
		navigate("Main")
	end
	shell = Shell.new({
		OnPauseButton = function()
			openPause()
		end,
		OnLayout = function(compact: boolean)
			for _, screen in screens do
				screen:SetCompact(compact)
			end
		end,
	})
	local function getScale(): number
		return shell:GetScale()
	end
	screens.Main = MainScreen.new({
		Parent = shell.Canvas,
		GetScale = getScale,
		OnMove = onMove,
		Actions = {
			Play = play,
			Garage = function()
				navigate("Garage")
			end,
			Map = function()
				navigate("Map")
			end,
			Settings = function()
				navigate("Settings")
			end,
		},
	})
	screens.Settings = SettingsScreen.new({
		Parent = shell.Canvas,
		GetScale = getScale,
		OnMove = onMove,
		Settings = controllers.SettingsController,
		Back = back,
	})
	screens.Map = MapScreen.new({
		Parent = shell.Canvas,
		GetScale = getScale,
		OnMove = onMove,
		Back = back,
		Navigation = controllers.NavigationController,
		IsTouch = isTouch,
	})
	screens.Garage = GarageScreen.new({
		Parent = shell.Canvas,
		GetScale = getScale,
		OnMove = onMove,
		Back = back,
	})
	shell:UpdateLayout()
end

local function updateVersion()
	local mode = player:GetAttribute(Constants.Attributes.GameMode) or "Normal"
	shell:SetVersion(Strings.Get("Main.Version", Config.Version, Strings.Get("Mode." .. tostring(mode))))
end

local function connectInput()
	MenuInput.connect(controllers.InputController, {
		IsActive = function()
			return menuVisible and state ~= "Spawning" and currentScreen() ~= nil
		end,
		Navigate = function(kind: string, dir: number)
			local screen = currentScreen()
			if screen.HandleNavigate and screen:HandleNavigate(kind, dir) then
				return -- harita: kaydırma
			end
			screen.Focus:SetHighlight(true)
			if kind == "Move" then
				screen.Focus:Move(dir)
			else
				screen.Focus:Adjust(dir)
			end
		end,
		Accept = function()
			local screen = currentScreen()
			if screen.HandleAccept and screen:HandleAccept() then
				playSound("Select")
				return
			end
			screen.Focus:SetHighlight(true)
			if screen.Focus:Activate() then
				playSound("Select")
			end
		end,
		Back = function()
			if currentScreenName ~= "Main" then
				playSound("Back")
				navigate("Main")
			elseif state == "Paused" then
				resume()
			end
		end,
		Tab = function(dir: number)
			currentScreen():HandleTab(dir)
		end,
		Close = resume,
		Open = function()
			openPause()
		end,
		OpenMap = openMap,
	})
end

-- ===== Genel API =====
function FrontEndController:GetState(): string
	return state
end

function FrontEndController:IsMenuOpen(): boolean
	return menuVisible
end

-- Başka sistemler (ör. ileride harita) oyun içi menüyü açabilir
function FrontEndController:OpenPauseMenu()
	openPause()
end

-- Tam ekran haritayı aç (M tuşu, köşe haritasına dokunma)
function FrontEndController:OpenMap()
	openMap()
end

function FrontEndController:Init(allControllers)
	controllers = allControllers
end

function FrontEndController:Start()
	requestSpawnRemote = RemoteRegistry.Get("PlayerRemotes", "RequestSpawn") :: RemoteEvent
	local spawnStatusRemote = RemoteRegistry.Get("PlayerRemotes", "SpawnStatus") :: RemoteEvent
	spawnStatusRemote.OnClientEvent:Connect(function(status: any, detail: any)
		if type(status) ~= "string" then
			return
		end
		lastSpawnStatus = status
		if status == "Queued" and state == "Spawning" then
			screens.Main:SetStatus(Strings.Get("Status.WaitingWorld"), "busy")
		end
		Log.Info("Doğma durumu:", status, detail)
	end)

	build()
	updateVersion()
	player:GetAttributeChangedSignal(Constants.Attributes.GameMode):Connect(updateVersion)

	-- Başlangıç: menü açık, oyun girişleri kilitli, kamera şehirde, perde açılır
	lockGameplay(true)
	requestMenuCamera("Title")
	showMenu("Title", false)
	cityWatchLoop()
	shell:SetVeil(false, duration(0.8))

	connectInput()
	controllers.InputController.DeviceChanged:Connect(function(device)
		local screen = currentScreen()
		if screen then
			screen.Focus:SetHighlight(device ~= Constants.DeviceTypes.Touch)
		end
		refreshHints()
		refreshPauseButton()
	end)

	-- Menü açıkken araca binilirse (ör. bir motosiklet koltuğuna değdi) menüyü kapat; araç sistemi devralır
	controllers.VehicleController.Entered:Connect(function()
		if state == "Paused" then
			resume()
		end
		refreshPauseButton()
	end)
	controllers.VehicleController.Exited:Connect(refreshPauseButton)

	-- Menü açıkken yeniden doğulursa PlayerModule kontrolleri kapalı kalsın
	controllers.CharacterController.CharacterChanged:Connect(function(character)
		if character and gameplayLocked then
			task.defer(function()
				if gameplayLocked then
					setDefaultControls(false)
				end
			end)
		end
	end)
end

return FrontEndController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2E3B6B4FN"><Properties>
<string name="Name">AmbientController</string>

<ProtectedString name="Source"><![CDATA[-- AmbientController: trafik ve yaya yapay zekâsının istemci tarafı (Aşama 6).
--
-- Mimari:
--   Shared/Ambient/TrafficGraph  şerit + kavşak grafiği (MapDefinitions'tan; RoadBuilder ile aynı geometri)
--   Shared/Ambient/PedGraph      kaldırım + geçit grafiği
--   Shared/Ambient/TrafficSim    araç yapay zekâsı (IDM, ışık/dur/yol ver, rezervasyon, engel, şerit değiştirme)
--   Shared/Ambient/PedSim        yaya yapay zekâsı (hedef, mola, geçitte bekleme, kaçınma)
--   Ambient/*Renderer            görseller + havuz (bu istemcide yerel parçalar)
--   Ambient/AmbientDebug         F7: rotalar, durma çizgileri, geçitler, durum etiketleri, istatistik
--
-- Simülasyon her oyuncunun kendi cihazında, oyuncunun çevresinde 10 Hz çalışır; görüntü her karede ara değerlenir.
-- Ağ trafiği yoktur. Işıklar sunucu saatine bağlıdır (Workspace:GetServerTimeNow) → herkes aynı ışığı görür.
-- Diğer oyuncular ve araçları engel olarak algılanır.
--
-- Çalışma anı sınır geçersiz kılma (Studio testleri için, Workspace attribute'ları):
--   AmbientEnabled (bool), AmbientMaxVehicles (sayı), AmbientMaxPedestrians (sayı)
--
-- Yaşayan Şehir: bütçe = AmbientConfig[cihaz sınıfı][Şehir yoğunluğu ayarı] × uyarlanır kalite. Cihaz sınıfı:
-- Desktop (dokunmatik değil), Tablet (dokunmatik, ekranın kısa kenarı ≥ 700), Mobile (telefon). Uyarlanır kalite:
-- kare hızı uzun süre 35'in altındaysa bütçe %10'ar azalır (en az %50), 55'in üstüne çıkınca geri artar.
-- Görünen NPC kaldırılmaz (IsVisible: ekranda ve bir bina arkasında değil).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AmbientShared = Shared:WaitForChild("Ambient")
local TrafficGraph = require(AmbientShared:WaitForChild("TrafficGraph"))
local PedGraph = require(AmbientShared:WaitForChild("PedGraph"))
local TrafficSim = require(AmbientShared:WaitForChild("TrafficSim"))
local PedSim = require(AmbientShared:WaitForChild("PedSim"))
local PedAnim = require(AmbientShared:WaitForChild("PedAnim"))
local Entrances = require(AmbientShared:WaitForChild("Entrances"))
local MapDefinitions = require(Shared:WaitForChild("MapDefinitions"))
local VehicleDefinitions = require(Shared:WaitForChild("VehicleDefinitions"))
local AmbientConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("AmbientConfig"))
local Log = require(Shared.Utilities.Log).new("Ambient")

local AmbientFolder = script.Parent.Parent:WaitForChild("Ambient")
local TrafficRenderer = require(AmbientFolder:WaitForChild("TrafficRenderer"))
local PedRenderer = require(AmbientFolder:WaitForChild("PedRenderer"))
local SignalRenderer = require(AmbientFolder:WaitForChild("SignalRenderer"))
local DoorRenderer = require(AmbientFolder:WaitForChild("DoorRenderer"))
local AmbientDebug = require(AmbientFolder:WaitForChild("AmbientDebug"))

local AmbientController = {
	Name = "AmbientController",
	Priority = 40,
}

local player = Players.LocalPlayer
local controllers
local graph, pedGraph, traffic, peds
local ready = false
local vehicleModels: { [any]: Model } = {}
local pedModels: { [any]: Model } = {}
local wrecks: { { Model: Model, Ped: boolean, Until: number } } = {}
local SIM_DT = 1 / AmbientConfig.SimRate
local accumulator = 0
local active = false
local debugOn = false
local lastDebug = 0
local lastSignals = 0
local costTraffic, costPeds = 0, 0
local quality = 1 -- uyarlanır kalite çarpanı (0.5..1)
local frameDt = 1 / 60
local slowFor, fastFor = 0, 0
local frameNo = 0
local lightsOn = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local TCFG = AmbientConfig.Traffic
local PCFG = AmbientConfig.Pedestrians

-- ===== Yardımcılar =====
local function dayWeight(hour: number): number
	if hour >= 7 and hour < 19 then
		return 1
	elseif hour >= 22 or hour < 5 then
		return 0
	elseif hour < 7 then
		return (hour - 5) / 2
	end
	return 1 - (hour - 19) / 3
end

local function districtDensity(x: number, z: number, hour: number): number
	local d = MapDefinitions.GetDistrictAt(Vector3.new(x, 0, z))
	if not d then
		return 0.1
	end
	local w = dayWeight(hour)
	return d.NightDensity + (d.DayDensity - d.NightDensity) * w
end

local function deviceClass(): string
	if not controllers.InputController:IsTouch() then
		return "Desktop"
	end
	local camera = Workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(800, 400)
	return if math.min(size.X, size.Y) >= 700 then "Tablet" else "Mobile"
end

local function densityPreset(): string
	local settings = controllers.SettingsController
	local value = settings and settings:Get("CityDensity")
	return if type(value) == "string" then value else "Normal"
end

-- t: sayı | { Desktop = sayı | { Low, Normal, High }, Tablet = ..., Mobile = ... }
local function budget(t: any): number
	if type(t) == "number" then
		return t
	end
	local row = t[deviceClass()] or t.Mobile or t.Desktop
	if type(row) == "number" then
		return row
	end
	return row[densityPreset()] or row.Normal
end

local function limit(kind: string): number
	local override = Workspace:GetAttribute(if kind == "Vehicles" then "AmbientMaxVehicles" else "AmbientMaxPedestrians")
	if type(override) == "number" then
		return math.max(0, math.floor(override))
	end
	local t = if kind == "Vehicles" then TCFG.MaxVehicles else PCFG.MaxPedestrians
	return math.floor(budget(t) * quality + 0.5)
end

-- Uyarlanır kalite: kare süresi ortalaması (her karede) → bütçe çarpanı
local function updateQuality(dt: number)
	frameDt += (math.min(dt, 0.25) - frameDt) * 0.05
	if frameDt > 1 / 35 then
		slowFor += dt
		fastFor = 0
		if slowFor > 3 and quality > 0.5 then
			quality = math.max(0.5, quality - 0.1)
			slowFor = 0
			Log.Info(string.format("Kare hızı düşük (%.0f FPS): NPC bütçesi %%%d", 1 / frameDt, math.round(quality * 100)))
		end
	elseif frameDt < 1 / 55 then
		fastFor += dt
		slowFor = 0
		if fastFor > 8 and quality < 1 then
			quality = math.min(1, quality + 0.1)
			fastFor = 0
		end
	else
		slowFor, fastFor = 0, 0
	end
end

local function enabled(): boolean
	local override = Workspace:GetAttribute("AmbientEnabled")
	if override == false then
		return false
	end
	return AmbientConfig.Enabled
end

local function subjectPart(): BasePart?
	local nav = controllers.NavigationController
	return nav and nav:GetSubject()
end

local function shouldRun(): boolean
	if not ready or not enabled() then
		return false
	end
	local fe = controllers.FrontEndController
	local state = fe and fe:GetState()
	if state ~= "Playing" and state ~= "Paused" then
		return false
	end
	return subjectPart() ~= nil
end

-- Nokta oyuncunun ekranında görünüyor mu? (ekran içinde ve kameradan bakışı bir binayla kapanmamış)
local function isVisible(x: number, y: number, z: number, _dist: number?): boolean
	local camera = Workspace.CurrentCamera
	if not camera then
		return false
	end
	local target = Vector3.new(x, y + 2.5, z)
	local _, onScreen = camera:WorldToViewportPoint(target)
	if not onScreen then
		return false
	end
	local origin = camera.CFrame.Position
	local hit = Workspace:Raycast(origin, target - origin, rayParams)
	return not (hit ~= nil and (hit.Position - origin).Magnitude < (target - origin).Magnitude - 4)
end

-- Doğma noktası uygun mu? (uzaksa ya da ekran dışında / bir binanın arkasındaysa doğabilir)
local function canSpawn(visibleMin: number)
	return function(x: number, y: number, z: number, dist: number): boolean
		if dist >= visibleMin then
			return true
		end
		return not isVisible(x, y, z, dist)
	end
end

-- Bölge türüne göre araç karışımı (AmbientConfig.Traffic.DistrictMix)
local function mixAt(x: number, z: number)
	local d = MapDefinitions.GetDistrictAt(Vector3.new(x, 0, z))
	return d and TCFG.DistrictMix and TCFG.DistrictMix[d.Type] or nil
end

local function vehicleModelOf(seat: Instance?): Model?
	local m = seat and seat:FindFirstAncestorWhichIsA("Model")
	while m and not CollectionService:HasTag(m, "Vehicle") do
		local parent = m.Parent
		m = if parent and parent:IsA("Model") then parent else nil
	end
	return m
end

-- Engeller: oyuncular (yaya ya da araçta), sahipsiz oyuncu araçları; trafik için karşıdan geçen NPC yayalar
local function gatherObstacles(focus: Vector3)
	local forTraffic, forPeds = {}, {}
	local seen = {}
	local R = TCFG.ObstacleRadius
	for _, plr in Players:GetPlayers() do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - focus).Magnitude < 700 then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local model = vehicleModelOf(humanoid and humanoid.SeatPart)
			if model and model.PrimaryPart then
				if not seen[model] then
					seen[model] = true
					local c = model.PrimaryPart
					local p, vel = c.Position, c.AssemblyLinearVelocity
					table.insert(forTraffic, { X = p.X, Y = p.Y, Z = p.Z, R = R.Vehicle, Kind = "Vehicle" })
					table.insert(forPeds, { X = p.X, Z = p.Z, R = 3, Kind = "Vehicle", Speed = vel.Magnitude })
				end
			else
				local p = root.Position
				local vel = root.AssemblyLinearVelocity -- yola doğru yürüyen oyuncu önceden görülsün
				table.insert(forTraffic, { X = p.X, Y = p.Y - 2, Z = p.Z, R = R.Player, Kind = "Player", VX = vel.X, VZ = vel.Z })
				table.insert(forPeds, { X = p.X, Z = p.Z, R = 2, Kind = "Player" })
			end
		end
	end
	for _, model in CollectionService:GetTagged("Vehicle") do
		if not seen[model] and model:IsA("Model") and model.PrimaryPart then
			local c = model.PrimaryPart
			local p = c.Position
			if (p - focus).Magnitude < 400 then
				seen[model] = true
				table.insert(forTraffic, { X = p.X, Y = p.Y, Z = p.Z, R = R.Vehicle, Kind = "Vehicle" })
				local speed = c.AssemblyLinearVelocity.Magnitude
				if speed > 3 then
					table.insert(forPeds, { X = p.X, Z = p.Z, R = 3, Kind = "Vehicle", Speed = speed })
				end
			end
		end
	end
	for _, p in peds.Peds do
		if p.State == "Geç" or (p.Link and p.Link.Crossing) then
			local spd = p.CurSpeed or 0
			table.insert(forTraffic, {
				X = p.X, Y = p.Y, Z = p.Z, R = R.Pedestrian, Kind = "Pedestrian", VX = (p.HX or 0) * spd, VZ = (p.HZ or 0) * spd,
			})
		end
	end
	return forTraffic, forPeds
end

-- ===== Model eşleme =====
local function syncModels()
	for _, v in traffic.Spawned do
		if not v.Removed and not vehicleModels[v] then
			local mix = mixAt(v.X, v.Z)
			vehicleModels[v] = TrafficRenderer.Acquire(v.Kind.Id, lightsOn, mix and mix.Taxi)
			v.PX, v.PY, v.PZ, v.PHX, v.PHZ = v.X, v.Y, v.Z, v.HX, v.HZ
		end
	end
	for _, v in traffic.Despawned do
		local model = vehicleModels[v]
		if model then
			vehicleModels[v] = nil
			TrafficRenderer.Release(model)
		end
	end
	for _, p in peds.Spawned do
		if not p.Removed and not pedModels[p] then
			pedModels[p] = PedRenderer.Acquire()
			p.PX, p.PY, p.PZ, p.PHX, p.PHZ = p.X, p.Y, p.Z, p.HX, p.HZ
			p.Anim = PedAnim.new(p.Seed or math.random())
		end
	end
	for _, p in peds.Despawned do
		local model = pedModels[p]
		if model then
			pedModels[p] = nil
			PedRenderer.Release(model)
		end
	end
end

local function clearAll()
	if not traffic then
		return
	end
	for _, v in table.clone(traffic.Vehicles) do
		traffic:Remove(v, "Kapat")
	end
	for _, p in table.clone(peds.Peds) do
		peds:Remove(p, "Kapat")
	end
	syncModels()
	traffic.Despawned, peds.Despawned = {}, {}
	SignalRenderer.Update(graph, nil, 0, 0)
	DoorRenderer.Update(nil, 0)
end

-- ===== Kaza: oyuncunun aracı NPC araca/yayaya çarparsa NPC fiziğe geçer (bu istemcide), sonra havuza döner =====
local function handleCollisions()
	local current = controllers.VehicleController:GetCurrent()
	if not current or not current.IsDriver or not current.Chassis then
		return
	end
	local chassis = current.Chassis
	local p = chassis.Position
	local vel = chassis.AssemblyLinearVelocity
	local myHalfLen = (current.Def.Length or 12) / 2
	for _, v in table.clone(traffic.Vehicles) do
		local dx, dz = p.X - v.X, p.Z - v.Z
		local d2 = dx * dx + dz * dz
		if d2 < 900 and math.abs(p.Y - v.Y) < 8 then
			-- 0.2 sn sonraki konum NPC kutusuna giriyor mu (sabit kutuya hızla çarpıp duvar gibi durmasın)
			local fx, fz = dx + vel.X * 0.2, dz + vel.Z * 0.2
			local along = fx * v.HX + fz * v.HZ
			local side = -fx * v.HZ + fz * v.HX
			local npcVel = Vector3.new(v.HX * v.V, 0, v.HZ * v.V)
			local rel = (vel - npcVel).Magnitude
			if math.abs(along) < v.Len / 2 + myHalfLen and math.abs(side) < v.Width / 2 + 2.5 and rel > 10 then
				local model = vehicleModels[v]
				vehicleModels[v] = nil
				traffic:Remove(v, "Kaza")
				traffic.Despawned = {}
				if model then
					TrafficRenderer.MakePhysical(model, npcVel)
					table.insert(wrecks, { Model = model, Ped = false, Until = os.clock() + 10 })
				end
			end
		end
	end
	if vel.Magnitude > 6 then
		for _, ped in table.clone(peds.Peds) do
			local dx, dz = ped.X - p.X, ped.Z - p.Z
			if dx * dx + dz * dz < (myHalfLen + 1.5) ^ 2 and math.abs(ped.Y - p.Y) < 6 then
				local model = pedModels[ped]
				pedModels[ped] = nil
				peds:Remove(ped, "Kaza")
				peds.Despawned = {}
				if model then
					PedRenderer.MakePhysical(model, vel * 0.6 + Vector3.new(0, 18, 0))
					table.insert(wrecks, { Model = model, Ped = true, Until = os.clock() + 8 })
				end
			end
		end
	end
end

local function cleanWrecks(focus: Vector3)
	local now = os.clock()
	for i = #wrecks, 1, -1 do
		local w = wrecks[i]
		local root = w.Model.PrimaryPart
		local far = not root or (root.Position - focus).Magnitude > 80 or root.Position.Y < -50
		if now > w.Until + 30 or (now > w.Until and far) then
			if w.Ped then
				PedRenderer.Release(w.Model)
			else
				TrafficRenderer.Release(w.Model)
			end
			table.remove(wrecks, i)
		end
	end
end

-- ===== Adım ve görüntü =====
local function statsText(focus: Vector3, time: number, hour: number, tDensity: number, pDensity: number): string
	local ts, pst = traffic.Stats, peds.Stats
	local stuck = 0
	for _, v in traffic.Vehicles do
		if v.Blocked > 10 then
			stuck += 1
		end
	end
	local lines = {
		string.format("TRAFİK  araç %d/%d (havuz %d)   yaya %d/%d (havuz %d)", #traffic.Vehicles, limit("Vehicles"), TrafficRenderer.PoolCount(), #peds.Peds, limit("Pedestrians"), PedRenderer.PoolCount()),
		string.format("cihaz %s  yoğunluk %s  kalite %%%d  FPS %.0f", deviceClass(), densityPreset(), math.round(quality * 100), 1 / frameDt),
		string.format("adım  trafik %.2f ms   yaya %.2f ms (%d Hz, ort.)", costTraffic * 1000, costPeds * 1000, AmbientConfig.SimRate),
		string.format("araç  doğan %d  kalkan %d  reddedilen %d", ts.Spawns, ts.Despawns, ts.Rejected),
		string.format("kavşak geçişi %d  şerit değiştirme %d  yön değiştirme %d  kilit %d  tıkalı>10sn %d", ts.Entries, ts.LaneChanges, ts.Reroutes or 0, ts.Locked or 0, stuck),
		string.format("yaya  doğan %d  geçiş %d  vazgeçen %d  yol yok %d", pst.Spawns, pst.Crossings, pst.GaveUp, pst.PathFail),
		string.format("bina  giren %d  çıkan %d  kapı hedefi %d  kapı modeli %d", pst.Entered or 0, pst.Exited or 0, pst.DoorGoals or 0, DoorRenderer.ActiveCount()),
		string.format("ışık direği %d   kaza modeli %d", SignalRenderer.ActiveCount(), #wrecks),
		string.format("saat %02d:%02d  yoğunluk trafik %.2f  yaya %.2f", math.floor(hour), math.floor(hour % 1 * 60), tDensity, pDensity),
	}
	-- en yakın kontrollü kavşak
	local best, bestD = nil, math.huge
	for _, node in graph.Nodes do
		if node.Control ~= "Free" then
			local d = (node.X - focus.X) ^ 2 + (node.Z - focus.Z) ^ 2
			if d < bestD then
				best, bestD = node, d
			end
		end
	end
	if best then
		local text = string.format("kavşak #%d %s (%.0f stud)", best.Id, best.Control, math.sqrt(bestD))
		if best.Control == "Signal" then
			local s1, r1 = TrafficGraph.SignalState(graph, best, 1, time)
			local s2, r2 = TrafficGraph.SignalState(graph, best, 2, time)
			text ..= string.format("  faz1 %s %.0fs  faz2 %s %.0fs", s1, r1, s2, r2)
		end
		table.insert(lines, text)
	end
	table.insert(lines, "F7: kapat")
	return table.concat(lines, "\n")
end

local function simStep()
	local subject = subjectPart()
	if not subject then
		return
	end
	local focus = subject.Position
	local time = Workspace:GetServerTimeNow()
	local hour = Lighting.ClockTime
	-- önceki pozlar (ara değer için)
	for _, v in traffic.Vehicles do
		v.PX, v.PY, v.PZ, v.PHX, v.PHZ = v.X, v.Y, v.Z, v.HX, v.HZ
	end
	for _, p in peds.Peds do
		p.PX, p.PY, p.PZ, p.PHX, p.PHZ = p.X, p.Y, p.Z, p.HX, p.HZ
	end
	local forTraffic, forPeds = gatherObstacles(focus)
	local foci = { { X = focus.X, Z = focus.Z } }
	local w = dayWeight(hour)
	local here = districtDensity(focus.X, focus.Z, hour)
	local tDensity = (TCFG.NightFactor + (1 - TCFG.NightFactor) * w) * math.clamp(here * 1.25 + 0.15, 0.3, 1)
	local pDensity = peds:HourDensity(hour) * math.clamp(here * 1.2, 0.1, 1)
	local t0 = os.clock()
	traffic:Step(SIM_DT, {
		Time = time, Focus = foci, Obstacles = forTraffic, MaxVehicles = limit("Vehicles"), Density = tDensity,
		CanSpawn = canSpawn(TCFG.SpawnVisibleMin),
		IsVisible = isVisible,
		MixAt = mixAt,
		DensityAt = function(x, z)
			return districtDensity(x, z, hour) * 1.25 + 0.1
		end,
	})
	local t1 = os.clock()
	peds:Step(SIM_DT, {
		Time = time, Hour = hour, Focus = foci, Obstacles = forPeds, MaxPeds = limit("Pedestrians"), Density = pDensity,
		CanSpawn = canSpawn(PCFG.SpawnVisibleMin),
		IsVisible = isVisible,
		DensityAt = function(x, z)
			return districtDensity(x, z, hour) * 1.2
		end,
	})
	local t2 = os.clock()
	costTraffic += ((t1 - t0) - costTraffic) * 0.05
	costPeds += ((t2 - t1) - costPeds) * 0.05
	syncModels()
	handleCollisions()
	cleanWrecks(focus)
	-- farlar: akşam/gece
	local night = hour >= 18.5 or hour < 6.5
	if night ~= lightsOn then
		lightsOn = night
		for _, model in vehicleModels do
			TrafficRenderer.SetLights(model, night)
		end
	end
	local now = os.clock()
	if now - lastSignals > 0.25 then
		lastSignals = now
		SignalRenderer.Update(graph, focus, time, 320)
	end
	DoorRenderer.Update(focus, peds.Time) -- yakındaki kapılar (havuzlu), yaya giriş/çıkışında açılır
	if debugOn and now - lastDebug > AmbientConfig.Debug.RefreshInterval then
		lastDebug = now
		AmbientDebug.Update({
			Graph = graph, TG = TrafficGraph, PedGraph = pedGraph, PG = PedGraph, Traffic = traffic, Peds = peds,
			VehicleModels = vehicleModels, PedModels = pedModels, Focus = focus, Time = time, Config = AmbientConfig,
			Stats = statsText(focus, time, hour, tDensity, pDensity),
		})
	end
end

local FAR_RENDER2 = 260 * 260 -- bundan uzaktaki araçlar iki karede bir konumlanır (görünmez fark, yarı maliyet)

local function render(dt: number, alpha: number)
	local camera = Workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position or Vector3.zero
	frameNo += 1
	for v, model in vehicleModels do
		local root = model.PrimaryPart
		local cdx, cdz = v.X - camPos.X, v.Z - camPos.Z
		local far = cdx * cdx + cdz * cdz > FAR_RENDER2
		if root and not (far and (frameNo + v.Id) % 2 == 1) then
			local x = v.PX + (v.X - v.PX) * alpha
			local y = v.PY + (v.Y - v.PY) * alpha
			local z = v.PZ + (v.Z - v.PZ) * alpha
			local hx = v.PHX + (v.HX - v.PHX) * alpha
			local hz = v.PHZ + (v.HZ - v.PHZ) * alpha
			if hx * hx + hz * hz < 1e-4 then
				hx, hz = v.HX, v.HZ
			end
			local pos = Vector3.new(x, y, z)
			root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(hx, v.Slope or 0, hz))
			TrafficRenderer.SetBrake(model, v.Brake)
			local dx, dz = x - camPos.X, z - camPos.Z
			if dx * dx + dz * dz < 14400 then
				TrafficRenderer.Spin(model, v.V, dt) -- yakındaki dış modelli araçlarda teker dönüşü
			end
		end
	end
	DoorRenderer.Animate(dt)
	local animR2 = PCFG.AnimateRadius * PCFG.AnimateRadius
	local fullAnimR2 = (PCFG.FullAnimateRadius or 45) ^ 2
	for p, model in pedModels do
		local cdx, cdz = p.X - camPos.X, p.Z - camPos.Z
		local cd2 = cdx * cdx + cdz * cdz
		if cd2 > 14400 and (frameNo + p.Id) % 2 == 1 then
			continue -- 120 studdan uzak yaya iki karede bir konumlanır
		end
		local x = p.PX + (p.X - p.PX) * alpha
		local y = p.PY + (p.Y - p.PY) * alpha
		local z = p.PZ + (p.Z - p.PZ) * alpha
		local hx = p.PHX + (p.HX - p.PHX) * alpha
		local hz = p.PHZ + (p.HZ - p.PHZ) * alpha
		if hx * hx + hz * hz < 1e-4 then
			hx, hz = p.HX, p.HZ
		end
		PedRenderer.Place(model, Vector3.new(x, y, z), hx, hz)
		PedRenderer.SetFade(model, p.Fade or 0)
		-- animasyon LOD: 45 stud içinde her kare, 90'a kadar iki karede bir (dt birikir), ötesinde duruş pozu
		local anim = p.Anim
		if anim and cd2 < animR2 then
			p.AnimDt = (p.AnimDt or 0) + dt
			if cd2 < fullAnimR2 or (frameNo + p.Id) % 2 == 0 then
				local adt = math.min(p.AnimDt, 0.1)
				p.AnimDt = 0
				-- dönüş hızı (görüntülenen yönden) ve kapı itme
				local lastH = p.AnimHX
				local turn = 0
				if lastH then
					local cross = lastH * hz - (p.AnimHZ or 0) * hx
					local dot = lastH * hx + (p.AnimHZ or 0) * hz
					turn = -math.atan2(cross, dot) / math.max(adt, 1e-3)
				end
				p.AnimHX, p.AnimHZ = hx, hz
				-- kapıyı itme: girmeden hemen önce ve girerken, çıkarken ilk yarım saniye
				local atDoor = p.State == "Kapı" and (p.Timer or 1) < 0.6
				local inDoor = p.State == "Gir" or (p.State == "Çık" and (p.Timer or 0) < 0.6)
				local reach = if atDoor or inDoor then 1 else 0
				local k = PedRenderer.Scale(model)
				local pose = PedAnim.Step(anim, adt, (p.CurSpeed or 0) / k, turn, reach)
				PedRenderer.Pose(model, pose)
				p.Posed = true
			end
		elseif p.Posed then
			p.Posed = false
			PedRenderer.Neutral(model)
		end
	end
end

local function onHeartbeat(dt: number)
	local run = shouldRun()
	if not run then
		if active then
			active = false
			clearAll()
			if debugOn then
				AmbientDebug.Disable()
			end
		end
		return
	end
	active = true
	updateQuality(dt)
	accumulator += dt
	if accumulator > SIM_DT * 3 then
		accumulator = SIM_DT -- uzun takılmadan sonra yetişmeye çalışma (tek adım)
	end
	while accumulator >= SIM_DT do
		accumulator -= SIM_DT
		local ok, err = pcall(simStep)
		if not ok then
			Log.Error("Ambient adımı hata verdi:", err)
		end
	end
	render(dt, accumulator / SIM_DT)
end

function AmbientController:Init(allControllers)
	controllers = allControllers
end

function AmbientController:Start()
	if not AmbientConfig.Enabled then
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		local data = MapDefinitions.GetData()
		local kinds = {}
		for _, k in TCFG.Kinds do
			local def = VehicleDefinitions.Get(k.Id)
			if def then
				table.insert(kinds, { Id = k.Id, Weight = k.Weight, Length = def.Length, Width = def.Width, MaxSpeed = def.MaxSpeed })
			end
		end
		local steps = 0
		graph = TrafficGraph.Build(data, TCFG, {
			Yield = function()
				steps += 1
				if steps % 2 == 0 then
					task.wait() -- kurulumu karelere yay (takılma olmasın)
				end
			end,
		})
		pedGraph = PedGraph.Build(data, graph)
		-- bina kapıları (arsa verisinden; harita değişmez): kaldırımı kapı noktalarında böler, kapı düğümleri ekler
		pedGraph.Entrances = Entrances.Build(data, pedGraph, PedGraph, graph, {
			Yield = function()
				task.wait()
			end,
		})
		traffic = TrafficSim.new(graph, TCFG, kinds, TrafficGraph, os.clock() * 1000)
		peds = PedSim.new(pedGraph, graph, traffic, PCFG, PedGraph, TrafficGraph, os.clock() * 777)
		TrafficRenderer.Init()
		PedRenderer.Init()
		SignalRenderer.Init(graph, TrafficGraph)
		local laneCount, connCount, walkCount = #graph.Lanes, #graph.Connectors, #pedGraph.Links
		DoorRenderer.Init(pedGraph.Entrances)
		ready = true
		AmbientController._updateRayFilter()
		Log.Info(string.format("Trafik/yaya hazır: %d şerit, %d kavşak bağlantısı, %d kaldırım bağlantısı, %d bina kapısı (%.0f ms)",
			laneCount, connCount, walkCount, #pedGraph.Entrances.List, (os.clock() - t0) * 1000))
		if walkCount == 0 then
			Log.Warn("Kaldırım grafiği boş: haritada kaldırım verisi okunamadı → yaya doğmaz (MapDefinitions kaldırım bayrağı).")
		end
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
	controllers.InputController.ActionBegan:Connect(function(action: string)
		if action == "AmbientDebug" then
			debugOn = not debugOn
			if not debugOn then
				AmbientDebug.Disable()
			end
		end
	end)
	-- görünürlük ışını kendi karakterimize ve NPC'lere çarpmasın
	player.CharacterAdded:Connect(function()
		AmbientController._updateRayFilter()
	end)
end

function AmbientController._updateRayFilter()
	local filter = {}
	if player.Character then
		table.insert(filter, player.Character)
	end
	if ready then
		table.insert(filter, TrafficRenderer.Folder())
		table.insert(filter, PedRenderer.Folder())
	end
	rayParams.FilterDescendantsInstances = filter
end

-- Dış sistemler için (ör. ileride görev/polis): anlık sayılar
function AmbientController:GetCounts(): (number, number)
	if not ready then
		return 0, 0
	end
	return #traffic.Vehicles, #peds.Peds
end

return AmbientController
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX60930333N"><Properties>
<string name="Name">Vehicles</string>
</Properties>
<Item class="ModuleScript" referent="RBXA7987384N"><Properties>
<string name="Name">CarPhysics</string>

<ProtectedString name="Source"><![CDATA[-- CarPhysics: otomobil sürüş modeli (Aşama 2). Sadece SÜRÜCÜNÜN istemcisinde, araç fiziğinin ağ sahibi
-- o istemciyken çalışır. Her karede fiziksel kısıtlamaların hedeflerini yazar; kuvvetleri Roblox fiziği üretir.
--
-- Fiziksel parçalar (VehicleFactory._tuneCar kurar):
--   Yay + amortisör (aks başına frekans/sönüm), balast (ağırlık dağılımı), tekerlek motorları (çekiş/fren tork
--   kaynağı), direksiyon servoları, şasi "Forces" (kaldırma + aero + yuvarlanma), "Stability" torku, "Upright".
--
-- Bu modülün katmanları (her karede, sırayla):
--   1. Giriş şekillendirme  gaz/fren rampası, ileri↔geri vites mantığı, hıza bağlı direksiyon hızı
--   2. Direksiyon           tutuş sınırlı açı + Ackermann + kayarken kendiliğinden karşı direksiyon
--   3. Motor                sanal vites, güç eğrisi, vites değişiminde çekiş kesintisi
--   4. Tekerlek başına      süspansiyon sıkışması → yük; kayma açısı/oranı → statik/kinetik tutuş;
--                           zemin malzemesi; motor hedefi (çekiş kontrolü / ABS / el freni / yerinde tutma)
--   5. Şasi kuvvetleri      hava direnci, yuvarlanma direnci, yere basma
--   6. Denge                yerde: savrulma hızı hedefe bağlanır; havada: dönme sönümü + dik tutma
--   7. Kurtarma             takılma/devrilme algılanırsa sunucudan düzeltme istenir (sunucu doğrular)
--
-- Kare başına tablo/closure yaratılmaz; zemin için karede TEK ışın atılır (tekerlekler sırayla).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleDefinitions = require(Shared.VehicleDefinitions)
local VehiclePhysics = require(Shared.VehiclePhysics)

local CarPhysics = {}
CarPhysics.__index = CarPhysics

local C = VehiclePhysics.Constants
local DRIVE_SIGN = VehicleDefinitions.DriveSign
local REAL_G = 9.81 / VehicleDefinitions.MetersPerStud -- telemetri: gerçek g (stud/sn²)
local WHEEL_ORDER = { "FL", "FR", "RL", "RR" }
local REVERSE_DELAY = 0.35 -- sn: durduktan sonra geri vitese geçiş beklemesi
local MU_STEP = 50 -- μ 1/50 = 0.02 adımla yazılır (gereksiz özellik yazımı olmasın)

-- PhysicalProperties önbelleği (μ 0.01 adımla) → sürtünme değişiminde yeni nesne yaratılmaz
local propCache: { [number]: PhysicalProperties } = {}
local function frictionProps(key: number): PhysicalProperties
	local props = propCache[key]
	if not props then
		props = PhysicalProperties.new(0.9, key / 50, 0, 100, 1)
		propCache[key] = props
	end
	return props
end

local function approach(current: number, target: number, rateUp: number, rateDown: number, dt: number): number
	if target > current then
		return math.min(target, current + rateUp * dt)
	end
	return math.max(target, current - rateDown * dt)
end

-- Araçtaki fiziksel parçaları toplar. Akış (streaming) yüzünden eksikse nil döner; çağıran sonra tekrar dener.
function CarPhysics.new(model: Model, def)
	if not VehicleDefinitions.UsesCarPhysics(def) then
		return nil
	end
	local chassis = model.PrimaryPart
	local forces = chassis and chassis:FindFirstChild("Forces")
	local stability = chassis and chassis:FindFirstChild("Stability")
	local upright = chassis and chassis:FindFirstChild("Upright")
	if not (chassis and forces and stability and upright) then
		return nil
	end
	local d = VehiclePhysics.Derive(def)
	local p = def.Physics
	local wheels = {}
	for _, name in WHEEL_ORDER do
		local wheel = model:FindFirstChild("Wheel_" .. name)
		local knuckle = model:FindFirstChild("Knuckle_" .. name)
		local motor = knuckle and knuckle:FindFirstChild("Motor_" .. name)
		local strut = knuckle and knuckle:FindFirstChild("Suspension_" .. name)
		if not (wheel and knuckle and motor and strut) then
			return nil
		end
		local rear = string.sub(name, 1, 1) == "R"
		local driveShare = if rear then (1 - p.DriveSplitFront) / 2 else p.DriveSplitFront / 2
		table.insert(wheels, {
			Name = name,
			Wheel = wheel,
			Knuckle = knuckle,
			Motor = motor,
			Strut = strut,
			Rear = rear,
			Left = string.sub(name, 2, 2) == "L",
			Steers = strut:GetAttribute("Steer") == true,
			DriveShare = driveShare,
			BrakeShare = if rear then (1 - p.BrakeBiasFront) / 2 else p.BrakeBiasFront / 2,
			Sag = if rear then d.SagRear else d.SagFront,
			BaseMu = p.TireGrip * (if rear then p.GripRear else p.GripFront),
			MuKey = -1,
			Sliding = false,
			SurfaceGrip = 1,
			SurfaceRolling = 1,
			-- telemetri
			Compression = 0,
			Load = 1,
			SlipRatio = 0,
			SlipAngle = 0,
			Mu = 0,
			Contact = false,
			SteerError = 0, -- gerçek direksiyon açısı − istenen (°)
			SteerMean = 0,
			Wobble = 0, -- titreme: hatanın ortalamasından ortalama sapması (°)
		})
	end
	local sprung = model:GetAttribute("SprungMass") or chassis.AssemblyMass
	-- Araç fizik kararlılığı: kayma algılama eşiği, çekiş kontrolünün izin verdiği patinajın üstünde olmalı.
	-- (Pikapta ikisi de 0.22'ydi: tam gazda arka tekerler "kayıyor/tutuyor" arasında gidip geliyor, tutuş %18
	-- düşüp kalkıyor ve otomatik karşı direksiyon devreye giriyordu.) Diğer araçlarda değer değişmez.
	local slideEnterRatio = math.max(C.SlideEnterRatio, p.TractionSlip + 0.08)
	local slideExitRatio = math.max(C.SlideExitRatio, p.TractionSlip * 0.6)
	local total = model:GetAttribute("TotalMass") or sprung
	local hx, hz = def.Track / 2, def.Wheelbase / 2
	local unsprung = math.max(total - sprung, 0)
	local probe = RaycastParams.new()
	probe.FilterType = Enum.RaycastFilterType.Exclude
	probe.FilterDescendantsInstances = { model }
	probe.RespectCanCollide = true

	local self = setmetatable({
		Model = model,
		Def = def,
		P = p,
		D = d,
		Chassis = chassis,
		Forces = forces,
		Stability = stability,
		Upright = upright,
		Wheels = wheels,
		Mass = total,
		BaseLift = forces:GetAttribute("BaseLift") or 0,
		HoldTorque = model:GetAttribute("BrakeTorque") or 0,
		-- savrulma ataleti (yaklaşık): gövde dikdörtgen + köşelerdeki tekerlekler
		YawInertia = sprung * (def.Length * def.Length + def.Width * def.Width) / 12 + unsprung * (hx * hx + hz * hz),
		Probe = probe,
		ProbeIndex = 1,
		SlideEnterRatio = slideEnterRatio,
		SlideExitRatio = slideExitRatio,
		-- durum
		Throttle = 0,
		BrakeInput = 0,
		Steer = 0,
		SteerDeg = 0,
		Reverse = false,
		StopTime = 0,
		Gear = 1,
		ShiftTimer = 0,
		Handbrake = 0,
		AirTime = 0,
		StuckTime = 0,
		TipTime = 0,
		LastRecovery = -100,
		LastVelocity = chassis.AssemblyLinearVelocity,
		RecoveryRequested = false,
		RearSliding = false, -- önceki karede arka lastiklerden biri kayıyor muydu
		-- telemetri (her karede yazılır, yeniden yaratılmaz)
		Telemetry = {
			Speed = 0, ForwardSpeed = 0, Gear = "N", RpmNorm = 0, Throttle = 0, Brake = 0,
			Steer = 0, SteerDeg = 0, SteerLimit = 0, SideSlip = 0, YawRate = 0, LongG = 0, LatG = 0,
			Contacts = 0, Handbrake = 0, StabilityTorque = 0, Airborne = false,
			-- Gösterge ışıkları (HUD): sürüş yardımı bu karede müdahale ediyor mu
			AbsActive = false, TcActive = false, EscActive = false,
		},
	}, CarPhysics)
	return self
end

-- Sürücü araçtan inerken: yerinde tut, kuvvetleri sıfırla, lastikleri normale döndür (yerel değerler)
function CarPhysics:Release()
	for _, w in self.Wheels do
		w.Motor.AngularVelocity = 0
		w.Motor.MotorMaxTorque = self.HoldTorque * 3
		local key = math.floor(w.BaseMu * MU_STEP + 0.5)
		w.Wheel.CustomPhysicalProperties = frictionProps(key)
		w.MuKey = key
		if w.Steers then
			w.Strut.TargetAngle = 0
		end
	end
	self.Forces.Force = Vector3.new(0, self.BaseLift, 0)
	self.Stability.Torque = Vector3.zero
	self.Upright.Enabled = false
end

-- Bir sonraki karede sunucuya kurtarma isteği gönderilmeli mi? (okununca sıfırlanır)
function CarPhysics:ConsumeRecoveryRequest(): boolean
	local requested = self.RecoveryRequested
	self.RecoveryRequested = false
	return requested
end

-- throttleIn, brakeIn: 0..1 (analog), steerIn: -1..1 (sağ +), handbrake: bool
function CarPhysics:Step(dt: number, throttleIn: number, brakeIn: number, steerIn: number, handbrake: boolean)
	local chassis = self.Chassis
	if not chassis.Parent or dt <= 0 then
		return
	end
	local def, d, p = self.Def, self.D, self.P
	local mass = self.Mass
	local cf = chassis.CFrame
	local forward, right, up = cf.LookVector, cf.RightVector, cf.UpVector
	local velocity = chassis.AssemblyLinearVelocity
	local angular = chassis.AssemblyAngularVelocity
	local vLong = velocity:Dot(forward)
	local vLat = velocity:Dot(right)
	local speed = velocity.Magnitude
	local planarSpeed = math.sqrt(vLong * vLong + vLat * vLat)

	-- ===== 1. Giriş: ileri / geri mantığı ve pedal rampaları =====
	local wantGas, wantBrake = throttleIn > 0.05, brakeIn > 0.05
	if self.Reverse then
		if wantGas and vLong > -C.HoldSpeed then
			self.Reverse = false -- neredeyse durdu ve gaza basıldı → ileri
		end
	elseif wantBrake and not wantGas and math.abs(vLong) < C.HoldSpeed then
		-- Durunca hemen geri gitme: fren tuşu durmuş araçta kısa bir süre tutulursa geri vitese geç
		self.StopTime += dt
		if self.StopTime > REVERSE_DELAY then
			self.Reverse = true
		end
	else
		self.StopTime = 0
	end
	local driveDemand, brakeDemand
	if self.Reverse then
		driveDemand, brakeDemand = brakeIn, throttleIn -- geride: "fren" tuşu gaz, "gaz" tuşu fren
	else
		driveDemand, brakeDemand = throttleIn, brakeIn
	end
	self.Throttle = approach(self.Throttle, driveDemand, p.ThrottleRise, p.ThrottleFall, dt)
	self.BrakeInput = approach(self.BrakeInput, brakeDemand, 7, 10, dt)
	self.Handbrake = approach(self.Handbrake, if handbrake then 1 else 0, 10, 3, dt)
	local throttle, brake, hb = self.Throttle, self.BrakeInput, self.Handbrake

	-- ===== 2. Direksiyon =====
	local speedFrac = math.clamp(planarSpeed / def.MaxSpeed, 0, 1)
	local rate = p.SteerRateLow + (p.SteerRateHigh - p.SteerRateLow) * speedFrac
	if math.abs(steerIn) < math.abs(self.Steer) or steerIn * self.Steer < 0 then
		rate *= 1.6 -- merkeze dönüş daha hızlı (bırakınca araç toparlanır)
	end
	self.Steer += math.clamp(steerIn - self.Steer, -rate * dt, rate * dt)
	local limit = VehiclePhysics.SteerLimit(def, d, planarSpeed)
	local steerDeg = self.Steer * limit
	-- Arka kayarken oyuncu direksiyonu bırakmışsa hız vektörüne doğru kendiliğinden karşı direksiyon.
	-- Sadece arka lastikler GERÇEKTEN kayarken (Hata düzeltme 3): normal sürüşte tekerleri kendi kendine oynatmasın.
	local sideSlip = if planarSpeed > 6 and vLong > 2 then math.atan2(vLat, vLong) else 0
	if self.RearSliding and math.abs(self.Steer) < 0.25 and math.abs(sideSlip) > math.rad(4) then
		steerDeg += math.clamp(math.deg(sideSlip) * p.CounterSteer, -def.MaxSteer * 0.5, def.MaxSteer * 0.5)
		-- Araç fizik kararlılığı: karşı direksiyon hıza bağlı sınırı en fazla ölçülen kayma açısı kadar aşabilir
		-- (yüksek hızda sınır ~5° iken 15–17° eklenip aracı ters yöne savurabiliyordu)
		local cap = limit + math.abs(math.deg(sideSlip))
		steerDeg = math.clamp(steerDeg, -cap, cap)
	end
	steerDeg = math.clamp(steerDeg, -def.MaxSteer, def.MaxSteer)
	self.SteerDeg = steerDeg
	-- Ackermann: iç teker daha fazla döner (dar virajda ön tekerler sürtmez)
	local innerDeg, outerDeg = steerDeg, steerDeg
	local absSteer = math.abs(steerDeg)
	if absSteer > 0.2 then
		local L, halfTrack = def.Wheelbase, def.Track / 2
		local radius = L / math.tan(math.rad(absSteer))
		local inner = math.deg(math.atan(L / math.max(radius - halfTrack, 0.5)))
		local outer = math.deg(math.atan(L / (radius + halfTrack)))
		local a = C.AckermannFactor
		local sign = if steerDeg > 0 then 1 else -1
		innerDeg = sign * math.min(absSteer + a * (inner - absSteer), def.MaxSteer * 1.15)
		outerDeg = sign * (absSteer + a * (outer - absSteer))
	end
	local turningRight = steerDeg > 0

	-- ===== 3. Motor ve vites =====
	local gears = p.Gears
	if self.Reverse then
		self.Gear = 1
	else
		local forwardSpeed = math.max(vLong, 0)
		if self.ShiftTimer > 0 then
			self.ShiftTimer -= dt
		elseif self.Gear < gears and forwardSpeed >= d.GearTops[self.Gear] * 0.97 and throttle > 0.1 then
			self.Gear += 1
			self.ShiftTimer = p.ShiftTime
		elseif self.Gear > 1 and forwardSpeed < d.GearTops[self.Gear - 1] * 0.75 then
			self.Gear -= 1
		end
	end
	local driveAccel
	if self.Reverse then
		driveAccel = d.ReverseAccel * throttle
	else
		local cut = if self.ShiftTimer > 0 then C.ShiftCut else 1
		driveAccel = VehiclePhysics.DriveAccel(d, math.max(vLong, 0), self.Gear) * throttle * cut
	end
	local driveForce = mass * driveAccel
	local holding = throttle < 0.02 and brake < 0.02 and hb < 0.5 and math.abs(vLong) < C.HoldSpeed

	-- ===== 4. Tekerlekler =====
	local contacts = 0
	local rearSliding = false
	local wobbleAlpha = math.clamp(dt * 2, 0, 1) -- ~0.5 sn zaman sabiti
	local absActive, tcActive = false, false
	local rollingFactor = 0
	local probeIndex = self.ProbeIndex
	for i, w in self.Wheels do
		local wheel, knuckle = w.Wheel, w.Knuckle
		local kcf = knuckle.CFrame
		local wForward, wRight = kcf.LookVector, kcf.RightVector
		local wv = wheel.AssemblyLinearVelocity
		local vl = wv:Dot(wForward)
		local vlat = wv:Dot(wRight)
		local R = wheel.Size.Y / 2
		local omega = (wheel.AssemblyAngularVelocity - knuckle.AssemblyAngularVelocity):Dot(wRight)
		local surfaceSpeed = omega * R * DRIVE_SIGN

		-- Süspansiyon: CurrentPosition sürüş konumunda -BumpRoom, tam açılmada -Travel
		local position = w.Strut.CurrentPosition
		local compression = position + def.Travel
		local contact = compression > 0.03
		local load = if contact then math.clamp(1 + (position + d.BumpRoom) / w.Sag, 0, 3) else 0
		local denominator = math.max(math.abs(vl), 3)
		local slipAngle = math.deg(math.atan(math.abs(vlat) / denominator))
		local slipRatio = (surfaceSpeed - vl) / denominator

		-- Statik ↔ kinetik tutuş (histerezisli: titreşmesin)
		if w.Sliding then
			if slipAngle < C.SlideExitAngle and math.abs(slipRatio) < self.SlideExitRatio then
				w.Sliding = false
			end
		elseif contact and planarSpeed > 3 and (slipAngle > C.SlideEnterAngle or math.abs(slipRatio) > self.SlideEnterRatio) then
			w.Sliding = true
		end

		-- Zemin (karede tek tekerlek)
		if i == probeIndex then
			local hit = workspace:Raycast(wheel.Position, -up * (R + 1), self.Probe)
			local surface = VehiclePhysics.Surface(if hit then hit.Material else nil)
			w.SurfaceGrip, w.SurfaceRolling = surface[1], surface[2]
		end

		local mu = w.BaseMu * w.SurfaceGrip
		if w.Sliding then
			mu *= C.KineticGrip
		end
		mu *= math.clamp(1 - C.LoadSensitivity * (load - 1), 0.85, 1.12)
		if w.Rear then
			mu *= 1 + (p.HandbrakeGrip - 1) * hb
		end
		local key = math.clamp(math.floor(mu * MU_STEP + 0.5), 2, 100)
		if key ~= w.MuKey then
			w.MuKey = key
			wheel.CustomPhysicalProperties = frictionProps(key)
		end

		-- Motor hedefi: hedef açısal hız + tork sınırı. Tork sınırı = kuvvet × yarıçap.
		local target, torque = 0, 0
		if w.Rear and hb > 0.5 then
			target, torque = 0, mass * d.HandbrakeAccel / 2 * R -- arka tekerler kilit
		elseif brake > 0.02 then
			-- ABS: tekerlek yüzey hızı (1 - AbsSlip) × araç hızının altına inmez → kilitlenmez
			local absTarget = if math.abs(vl) > 1.5 then vl * (1 - C.AbsSlip) else 0
			target = DRIVE_SIGN * absTarget / R
			torque = mass * d.BrakeAccel * brake * w.BrakeShare * R
		elseif holding then
			target, torque = 0, self.HoldTorque
		elseif w.DriveShare > 0 and throttle > 0.01 then
			-- Çekiş kontrolü: teker yüzeyi araçtan en fazla "allow" kadar hızlı dönebilir
			local allow = math.max(C.MinSlipSpeed, p.TractionSlip * math.abs(vl))
			local surfaceTarget
			if self.Reverse then
				surfaceTarget = math.max(math.min(vl, 0) - allow, -d.ReverseSpeed)
			else
				surfaceTarget = math.min(math.max(vl, 0) + allow, def.MaxSpeed)
			end
			target = DRIVE_SIGN * surfaceTarget / R
			torque = driveForce * w.DriveShare * R
		elseif w.DriveShare > 0 then
			target, torque = 0, mass * d.EngineBrakeAccel * w.DriveShare * R -- motor freni
		end
		w.Motor.AngularVelocity = target
		w.Motor.MotorMaxTorque = torque
		if contact and math.abs(vl) > 3 then
			if brake > 0.3 and slipRatio < -C.AbsSlip * 0.6 then
				absActive = true -- ABS kaymayı sınırlıyor
			elseif w.DriveShare > 0 and throttle > 0.3 and slipRatio > math.max(p.TractionSlip * 0.7, 0.05) then
				tcActive = true -- çekiş kontrolü patinajı sınırlıyor
			end
		end

		local wantedDeg = 0
		if w.Steers then
			wantedDeg = if (turningRight and not w.Left) or (not turningRight and w.Left) then innerDeg else outerDeg
			w.Strut.TargetAngle = -wantedDeg
		end
		-- Telemetri: mafsalın şasiye göre gerçek açısı (sağ +) ve titreme ölçüsü
		local actualDeg = math.deg(math.atan2(wForward:Dot(right), wForward:Dot(forward)))
		local steerError = actualDeg - wantedDeg
		w.SteerError = steerError
		w.SteerMean += (steerError - w.SteerMean) * wobbleAlpha
		w.Wobble += (math.abs(steerError - w.SteerMean) - w.Wobble) * wobbleAlpha
		if w.Rear and w.Sliding and contact then
			rearSliding = true
		end

		if contact then
			contacts += 1
			rollingFactor += w.SurfaceRolling
		end
		w.Compression = compression / def.Travel
		w.Load = load
		w.SlipRatio = slipRatio
		w.SlipAngle = slipAngle
		w.Mu = mu
		w.Contact = contact
	end
	self.ProbeIndex = (probeIndex % #self.Wheels) + 1
	self.RearSliding = rearSliding

	-- ===== 5. Şasi kuvvetleri: kaldırma (sabit) + hava direnci + yuvarlanma + yere basma =====
	local force = Vector3.new(0, self.BaseLift, 0)
	if speed > 0.5 then
		local direction = velocity / speed
		local resist = d.DragPerSpeed2 * speed * speed
		if contacts > 0 then
			resist += d.RollingAccel * (rollingFactor / contacts)
		end
		force -= direction * (mass * resist)
		if contacts > 0 and d.DownforcePerSpeed2 > 0 then
			force -= up * (mass * d.DownforcePerSpeed2 * vLong * vLong)
		end
	end
	self.Forces.Force = force

	-- ===== 6. Denge =====
	local yawRate = angular:Dot(up)
	local torque = Vector3.zero
	local stabilityTorque = 0
	if contacts >= 3 and planarSpeed > 10 and hb < 0.3 and not self.Reverse then
		-- Direksiyonun istediği savrulma hızı (sağa dönüş = negatif yaw), tutuş sınırıyla kırpılmış
		local wanted = -planarSpeed * math.tan(math.rad(steerDeg)) / def.Wheelbase
		local maxRate = d.LateralLimit * 1.1 / planarSpeed
		wanted = math.clamp(wanted, -maxRate, maxRate)
		local err = yawRate - wanted
		local deadband = 0.08
		if math.abs(err) > deadband then
			local excess = err - deadband * math.sign(err)
			stabilityTorque = math.clamp(-excess * p.StabilityGain * self.YawInertia, -self.YawInertia * 6, self.YawInertia * 6)
			torque = up * stabilityTorque
		end
	elseif contacts == 0 then
		torque = -angular * (self.YawInertia * 1.2) -- havada takla/fırıldak sönümü
	end
	self.Stability.Torque = torque

	-- ===== 7. Havada dik tutma, takılma ve devrilme kurtarma =====
	self.AirTime = if contacts == 0 then self.AirTime + dt else 0
	local airborne = self.AirTime > 0.35
	if self.Upright.Enabled ~= airborne then
		self.Upright.PrimaryAxis = Vector3.yAxis
		self.Upright.Enabled = airborne
	end
	local pushing = throttle > 0.5
	if pushing and planarSpeed < 1.5 and contacts <= 2 then
		self.StuckTime += dt
	else
		self.StuckTime = 0
	end
	if up.Y < 0.3 and speed < 4 then
		self.TipTime += dt
	else
		self.TipTime = 0
	end
	local now = os.clock()
	if (self.StuckTime > 2.5 or self.TipTime > 2.5) and now - self.LastRecovery > 5 then
		self.LastRecovery = now
		self.StuckTime, self.TipTime = 0, 0
		self.RecoveryRequested = true
	end

	-- ===== Telemetri =====
	local acceleration = (velocity - self.LastVelocity) / dt
	self.LastVelocity = velocity
	local t = self.Telemetry
	local smoothing = math.clamp(dt * 8, 0, 1)
	t.Speed = speed
	t.ForwardSpeed = vLong
	t.Gear = if self.Reverse then "R" elseif math.abs(vLong) < 0.5 and throttle < 0.05 then "N" else tostring(self.Gear)
	t.RpmNorm = if self.Reverse then 0.5 else math.clamp(math.max(vLong, 0) / d.GearTops[self.Gear], 0.15, 1)
	t.Throttle = throttle
	t.Brake = brake
	t.Steer = self.Steer
	t.SteerDeg = steerDeg
	t.SteerLimit = limit
	t.SideSlip = math.deg(sideSlip)
	t.YawRate = math.deg(yawRate)
	t.LongG += (acceleration:Dot(forward) / REAL_G - t.LongG) * smoothing
	t.LatG += (acceleration:Dot(right) / REAL_G - t.LatG) * smoothing
	t.Contacts = contacts
	t.Handbrake = hb
	t.StabilityTorque = stabilityTorque / math.max(self.YawInertia, 1)
	t.Airborne = airborne
	t.AbsActive = absActive
	t.TcActive = tcActive
	t.EscActive = math.abs(stabilityTorque) > self.YawInertia * 0.4
end

function CarPhysics:IsBraking(): boolean
	return self.BrakeInput > 0.05 or (self.Handbrake > 0.5 and self.Telemetry.Speed > 2)
end

function CarPhysics:IsReversing(): boolean
	return self.Reverse
end

return CarPhysics
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBXF9DD952CN"><Properties>
<string name="Name">FrontEnd</string>
</Properties>
<Item class="ModuleScript" referent="RBX1E184BCBN"><Properties>
<string name="Name">Backdrop</string>

<ProtectedString name="Source"><![CDATA[-- Backdrop: menünün arka plan katmanı.
--   * Vignette: metnin okunması için soldan ve alttan koyulaşan geçişler (her zaman, menü açıkken).
--   * Fallback: şehir henüz hazır/akmış değilken gösterilen hafif, varlıksız gün batımı sahnesi
--     (gökyüzü geçişi, çizgili güneş, deniz yansıması, silüet). ~60 düz Frame; doku/görüntü yok.

local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)
local Fader = require(script.Parent.Fader)

local C = Theme.Colors
local new = Widgets.new

local Backdrop = {}
Backdrop.__index = Backdrop

local HORIZON = 0.64

-- (x merkezi, genişlik, yükseklik) — ekran oranı cinsinden; deterministik silüet
local SKYLINE = {
	{ 0.05, 0.045, 0.07 }, { 0.09, 0.03, 0.11 }, { 0.13, 0.05, 0.06 }, { 0.48, 0.03, 0.13 },
	{ 0.52, 0.026, 0.2 }, { 0.555, 0.034, 0.27 }, { 0.59, 0.024, 0.16 }, { 0.62, 0.04, 0.31 },
	{ 0.655, 0.028, 0.22 }, { 0.685, 0.036, 0.36 }, { 0.72, 0.03, 0.24 }, { 0.75, 0.042, 0.29 },
	{ 0.785, 0.026, 0.17 }, { 0.815, 0.034, 0.21 }, { 0.85, 0.05, 0.12 }, { 0.9, 0.04, 0.09 },
	{ 0.94, 0.05, 0.06 },
}

local function vertical(sequence: ColorSequence, transparency: NumberSequence?): UIGradient
	return new("UIGradient", { Color = sequence, Rotation = 90, Transparency = transparency or NumberSequence.new(0) })
end

local function buildFallback(parent: Instance): Frame
	local root = new("Frame", {
		Name = "Fallback",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = parent,
	}, {
		vertical(ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.SkyTop),
			ColorSequenceKeypoint.new(0.42, C.SkyMid),
			ColorSequenceKeypoint.new(HORIZON, C.SkyLow),
			ColorSequenceKeypoint.new(HORIZON + 0.001, C.Sea),
			ColorSequenceKeypoint.new(1, C.Background),
		})),
	})
	-- güneş: ufkun hemen üstünde, sağ yarıda (soldaki menü sütunundan uzak)
	local sunHolder = new("Frame", {
		Name = "SunHolder",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.68, HORIZON),
		Size = UDim2.fromScale(0.3, 0.3),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = root,
	}, { new("UIAspectRatioConstraint", { AspectRatio = 2, DominantAxis = Enum.DominantAxis.Width }) })
	local sun = Widgets.Sun(10, C.SkyLow)
	sun.AnchorPoint = Vector2.new(0.5, 0)
	sun.Position = UDim2.fromScale(0.5, 0.1)
	sun.Size = UDim2.fromScale(0.55, 1.1)
	new("UIAspectRatioConstraint", { AspectRatio = 1 }).Parent = sun
	sun.Parent = sunHolder
	-- ufuk parıltısı
	new("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.68, HORIZON),
		Size = UDim2.new(0.6, 0, 0, 3),
		BackgroundColor3 = C.SunTop,
		BorderSizePixel = 0,
		Parent = root,
	}, {
		new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	-- silüet
	local skyline = new("Frame", {
		Name = "Skyline",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 0.4),
		BackgroundTransparency = 1,
		Parent = root,
	})
	for i, b in SKYLINE do
		local building = new("Frame", {
			Name = "B" .. i,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(b[1], 1),
			Size = UDim2.fromScale(b[2], b[3] / 0.4),
			BackgroundColor3 = C.Skyline,
			BorderSizePixel = 0,
			Parent = skyline,
		})
		if b[3] > 0.15 then
			-- birkaç yanan pencere şeridi
			for k = 1, 2 do
				new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.fromScale(0.5, 0.18 + k * 0.22),
					Size = UDim2.new(0.5, 0, 0, 2),
					BackgroundColor3 = C.SunTop,
					BackgroundTransparency = 0.55,
					BorderSizePixel = 0,
					Parent = building,
				})
			end
		end
	end
	-- denizdeki güneş yansıması
	for i = 1, 6 do
		new("Frame", {
			Name = "Reflection" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.68, HORIZON + 0.025 * i),
			Size = UDim2.new(0.18 - i * 0.022, 0, 0, 3),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 0.35 + i * 0.09,
			BorderSizePixel = 0,
			Parent = root,
		}, { Widgets.Round() })
	end
	return root
end

local function buildVignette(parent: Instance): Frame
	local root = new("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local left = new("Frame", {
		Name = "Left",
		Size = UDim2.fromScale(0.62, 1),
		BackgroundColor3 = C.Black,
		BorderSizePixel = 0,
		Parent = root,
	}, {
		new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.22),
				NumberSequenceKeypoint.new(0.55, 0.62),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	local bottom = new("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.22),
		BackgroundColor3 = C.Black,
		BorderSizePixel = 0,
		Parent = root,
	}, {
		new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0.35),
			}),
		}),
	})
	-- Ayarlar/garaj panelleri için tüm ekranı hafif karartan katman (varsayılan kapalı)
	local dim = new("Frame", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = root,
	})
	return root, left, bottom, dim
end

function Backdrop.new(parent: Instance)
	local self = setmetatable({}, Backdrop)
	self.Root = new("Frame", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		-- Menü açıkken arka plana yapılan dokunuş/tıklamalar oyuna (kamera kaydırma) geçmesin
		Active = true,
		Parent = parent,
	})
	self.Fallback = buildFallback(self.Root)
	self.Vignette, self._left, self._bottom, self._dim = buildVignette(self.Root)
	self._fallbackShown = true
	return self
end

-- Şehir görünür hale gelince yedek sahne yumuşakça kaybolur (ve gerekirse geri gelir)
function Backdrop:SetFallbackVisible(visible: boolean, duration: number)
	if self._fallbackShown == visible then
		return
	end
	self._fallbackShown = visible
	Fader.Fade(self.Fallback, visible, duration, 0)
end

function Backdrop:IsFallbackVisible(): boolean
	return self._fallbackShown
end

-- "Title": koyu sol geçiş; "Paused": oyun görünür kalsın diye daha hafif; panel: arka plan karartılır
function Backdrop:SetStyle(style: string, panelOpen: boolean, duration: number)
	local paused = style == "Paused"
	Fader.Tween(self._left, { Size = UDim2.fromScale(if paused then 0.5 else 0.62, 1) }, duration)
	Fader.Tween(self._dim, { BackgroundTransparency = if panelOpen then 0.45 elseif paused then 0.72 else 1 }, duration)
end

return Backdrop
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4BBDB1CFN"><Properties>
<string name="Name">Fader</string>

<ProtectedString name="Source"><![CDATA[-- Fader: hafif ekran geçişleri (saydamlık + küçük kayma).
-- CanvasGroup (render dokusu) KULLANMAZ: alt ağaçtaki saydamlık özelliklerini doğrudan tween'ler.
-- Geçiş başlarken mevcut değerler "taban" olarak alınır; gizleme bitince taban geri yazılır,
-- böylece gizli ağaç bir sonraki gösterimde doğru görünür.

local TweenService = game:GetService("TweenService")

local Fader = {}

type Entry = { Instance: Instance, Props: { [string]: number } }
type State = { Base: { Entry }, BasePosition: UDim2, Tweens: { Tween }, Token: number }

local states: { [GuiObject]: State } = {}
local tokenCounter = 0

local function propsFor(inst: Instance): { string }?
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		return { "BackgroundTransparency", "TextTransparency" }
	elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		return { "BackgroundTransparency", "ImageTransparency" }
	elseif inst:IsA("ScrollingFrame") then
		return { "BackgroundTransparency", "ScrollBarImageTransparency" }
	elseif inst:IsA("GuiObject") then
		return { "BackgroundTransparency" }
	elseif inst:IsA("UIStroke") then
		return { "Transparency" }
	end
	return nil
end

local function capture(root: GuiObject): { Entry }
	local list = {}
	local function add(inst: Instance)
		local names = propsFor(inst)
		if names then
			local props = {}
			for _, name in names do
				props[name] = (inst :: any)[name]
			end
			table.insert(list, { Instance = inst, Props = props })
		end
	end
	-- "FaderSkip" attribute'lu alt ağaçlar atlanır (ör. binlerce parçalı harita tuvali)
	local function walk(inst: Instance)
		add(inst)
		for _, child in inst:GetChildren() do
			if not child:GetAttribute("FaderSkip") then
				walk(child)
			end
		end
	end
	walk(root)
	return list
end

local function setAll(base: { Entry }, value: number?)
	for _, entry in base do
		if entry.Instance.Parent then
			for name, baseValue in entry.Props do
				(entry.Instance :: any)[name] = value or baseValue
			end
		end
	end
end

-- show=true: görünür yap ve içeri sol; show=false: dışarı sol ve gizle.
-- duration 0 → anında. slide: X yönünde kayma (tasarım pikseli). onDone isteğe bağlı.
function Fader.Fade(root: GuiObject, show: boolean, duration: number, slide: number?, onDone: (() -> ())?)
	tokenCounter += 1
	local token = tokenCounter
	local state = states[root]
	if state then
		for _, tween in state.Tweens do
			tween:Cancel()
		end
		table.clear(state.Tweens)
		state.Token = token
	else
		state = { Base = capture(root), BasePosition = root.Position, Tweens = {}, Token = token }
		states[root] = state
	end
	local base, basePosition = state.Base, state.BasePosition
	local offset = UDim2.fromOffset(slide or 0, 0)

	local function finish()
		if states[root] ~= state or state.Token ~= token then
			return
		end
		states[root] = nil
		-- Önce bu geçişin tween'lerini durdur: task.delay ile tween'in son karesinin sırası garanti değildir.
		-- Durdurulmazsa geç gelen son kare, aşağıda geri yazılan taban değerlerin üzerine "saydam" yazar
		-- ve gizlenen ekranın yazıları bir sonraki açılışta kalıcı olarak görünmez kalır.
		for _, tween in state.Tweens do
			tween:Cancel()
		end
		table.clear(state.Tweens)
		setAll(base)
		root.Position = basePosition
		root.Visible = show
		if onDone then
			onDone()
		end
	end

	if duration <= 0 then
		finish()
		return
	end

	local info = TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	if show then
		if not root.Visible then
			setAll(base, 1)
			root.Position = basePosition + offset
			root.Visible = true
		end
		for _, entry in base do
			if entry.Instance.Parent then
				table.insert(state.Tweens, TweenService:Create(entry.Instance, info, entry.Props))
			end
		end
		table.insert(state.Tweens, TweenService:Create(root, info, { Position = basePosition }))
	else
		for _, entry in base do
			if entry.Instance.Parent then
				local goal = {}
				for name in entry.Props do
					goal[name] = 1
				end
				table.insert(state.Tweens, TweenService:Create(entry.Instance, info, goal))
			end
		end
		table.insert(state.Tweens, TweenService:Create(root, info, { Position = basePosition - offset }))
	end
	for _, tween in state.Tweens do
		tween:Play()
	end
	task.delay(duration, finish)
end

-- Tek bir GuiObject'in arka plan saydamlığını tween'ler (perde, arka plan katmanları için)
function Fader.Tween(inst: Instance, props: { [string]: any }, duration: number): Tween?
	if duration <= 0 then
		for name, value in props do
			(inst :: any)[name] = value
		end
		return nil
	end
	local tween = TweenService:Create(inst, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

return Fader
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0CBFD799N"><Properties>
<string name="Name">Focus</string>

<ProtectedString name="Source"><![CDATA[-- Focus: klavye, gamepad ve fare için TEK odak modeli.
-- Roblox'un GuiService.SelectedObject seçimini kullanmıyoruz; kaydırıcı/seçici satırlarda
-- sol/sağ "değer değiştirir", yukarı/aşağı "satır değiştirir" olmalı. Fare üzerine gelince de odak taşınır,
-- böylece fare ve klavye aynı vurguyu paylaşır.
--
-- Öğe (item):
--   Gui         GuiObject         görünürlük + kaydırma hesabı için
--   OnFocus     (focused, showHighlight) -> ()
--   OnActivate  () -> ()?          Enter / A / tıklama
--   OnAdjust    (dir: -1|1) -> ()? Sol/sağ (kaydırıcı, seçici, anahtar, sekme çubuğu)
--   Scroller    ScrollingFrame?    odaklanınca görünür alana kaydırılır
--   IsEnabled   () -> boolean?     false ise atlanır

local TweenService = game:GetService("TweenService")

local Focus = {}
Focus.__index = Focus

export type Item = {
	Gui: GuiObject,
	OnFocus: (boolean, boolean) -> (),
	OnActivate: (() -> ())?,
	OnAdjust: ((number) -> ())?,
	Scroller: ScrollingFrame?,
	IsEnabled: (() -> boolean)?,
}

-- getScale: ekranın UIScale değeri (CanvasPosition ölçeksiz birimdedir)
function Focus.new(getScale: () -> number, onMove: (() -> ())?)
	return setmetatable({
		_items = {} :: { Item },
		_index = 0,
		_highlight = true,
		_getScale = getScale,
		_onMove = onMove,
	}, Focus)
end

local function enabled(item: Item?): boolean
	return item ~= nil and (item.IsEnabled == nil or item.IsEnabled())
end

function Focus:_ensureVisible(item: Item)
	local scroller = item.Scroller
	if not scroller or not item.Gui.Parent then
		return
	end
	local scale = math.max(self._getScale(), 0.01)
	local top = (item.Gui.AbsolutePosition.Y - scroller.AbsolutePosition.Y) / scale + scroller.CanvasPosition.Y
	local bottom = top + item.Gui.AbsoluteSize.Y / scale
	local view = scroller.AbsoluteWindowSize.Y / scale
	local y = scroller.CanvasPosition.Y
	local margin = 12
	if top - margin < y then
		y = top - margin
	elseif bottom + margin > y + view then
		y = bottom + margin - view
	else
		return
	end
	TweenService:Create(scroller, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CanvasPosition = Vector2.new(0, math.max(0, y)),
	}):Play()
end

function Focus:SetItems(items: { Item }, index: number?)
	local current = self._items[self._index]
	if current then
		current.OnFocus(false, self._highlight)
	end
	self._items = items
	self._index = 0
	if #items > 0 then
		self:Select(index or 1, true)
	end
end

function Focus:Select(index: number, silent: boolean?)
	local count = #self._items
	if count == 0 then
		return
	end
	index = math.clamp(index, 1, count)
	if index == self._index then
		return
	end
	local old = self._items[self._index]
	if old then
		old.OnFocus(false, self._highlight)
	end
	self._index = index
	local item = self._items[index]
	item.OnFocus(true, self._highlight)
	self:_ensureVisible(item)
	if not silent and self._onMove then
		self._onMove()
	end
end

-- delta: -1 yukarı, +1 aşağı. Devre dışı öğeler atlanır, listenin sonunda durur (sarmaz).
function Focus:Move(delta: number): boolean
	local i = self._index
	repeat
		i += delta
	until i < 1 or i > #self._items or enabled(self._items[i])
	if i >= 1 and i <= #self._items then
		self:Select(i)
		return true
	end
	return false
end

function Focus:Adjust(dir: number): boolean
	local item = self._items[self._index]
	if enabled(item) and item.OnAdjust then
		item.OnAdjust(dir)
		return true
	end
	return false
end

function Focus:Activate(): boolean
	local item = self._items[self._index]
	if enabled(item) and item.OnActivate then
		item.OnActivate()
		return true
	end
	return false
end

-- Fare üzerine geldi
function Focus:Hover(item: Item)
	local index = table.find(self._items, item)
	if index and enabled(item) then
		self:Select(index)
	end
end

function Focus:Current(): Item?
	return self._items[self._index]
end

function Focus:GetIndex(): number
	return self._index
end

-- Dokunmatikte odak çerçevesi gizlenir (parmakla seçimde gereksiz), klavye/gamepad'de görünür
function Focus:SetHighlight(show: boolean)
	if self._highlight == show then
		return
	end
	self._highlight = show
	local item = self._items[self._index]
	if item then
		item.OnFocus(true, show)
	end
end

-- Odaklı öğenin görünümünü yeniden uygula (geçiş sonrası)
function Focus:Refresh()
	for i, item in self._items do
		item.OnFocus(i == self._index, self._highlight)
	end
end

return Focus
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX0AE23E45N"><Properties>
<string name="Name">Map</string>
</Properties>
<Item class="ModuleScript" referent="RBXC0B5DA12N"><Properties>
<string name="Name">MapCanvas</string>

<ProtectedString name="Source"><![CDATA[-- MapCanvas: harita çizimi (minimap ve tam ekran harita ortak kullanır). Aşama 4.
--
-- Koordinat: MapDefinitions dünya stud'u. Tuval birimi = 1 stud; (0,0) haritanın kuzeybatı köşesi (-HalfSize).
-- Ekran = tuval × UIScale (piksel/stud). Kuzey yukarı (-Z ekranda yukarı).
--
-- Performans kuralları ("tüm haritayı yeniden çizme"):
--   * Yollar, su, bölgeler BİR KEZ çizilir. Kaydırma = Root.Position, yakınlaştırma = UIScale.Scale.
--   * Yollar 1024 stud'luk karolara bölünür; görüş alanı dışındaki karolar Visible=false (yerleşim/çizim yükü yok).
--     Karo görünürlüğü sadece görünen karo aralığı değişince güncellenir.
--   * Sabit piksel boyutlu öğeler (simgeler, rota kalınlığı) sadece yakınlaştırma değişince yeniden ölçeklenir.
--   * Rota sadece yeni rota geldiğinde yeniden çizilir.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapDefinitions"))
local MapView = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapView"))
local FrontEnd = script.Parent.Parent
local Theme = require(FrontEnd:WaitForChild("Theme"))
local Strings = require(FrontEnd:WaitForChild("Strings"))

local MapCanvas = {}
MapCanvas.__index = MapCanvas

local TILE = 1024
local rgb = Color3.fromRGB

local COLORS = {
	Land = rgb(22, 25, 32),
	Water = rgb(14, 34, 56),
	District = rgb(30, 34, 44),
	freeway = rgb(118, 128, 150),
	highway = rgb(104, 112, 132),
	ramp = rgb(104, 112, 132),
	avenue = rgb(82, 88, 104),
	street = rgb(64, 70, 84),
	country = rgb(70, 78, 66),
	Route = Theme.Colors.AccentAlt,
	RouteOffroad = rgb(160, 230, 240),
}

MapCanvas.LandColor = COLORS.Land -- mini haritanın kabı bu renkle boyanır

-- POI türü → kategori (simge rengi + kısa harf Strings'ten)
local POI_CATEGORY = {
	supermarket = "Shop", grocery = "Shop", convenience = "Shop", general = "Shop", mall = "Shop",
	restaurant = "Food", fastfood = "Food", cafe = "Food",
	gas = "Fuel", hospital = "Health", police = "Police",
	hotel = "Hotel",
	garage = "Vehicle", dealership_car = "Vehicle", dealership_moto = "Vehicle", parking = "Vehicle",
	cinema = "Leisure", arcade = "Leisure", park = "Leisure", golf = "Leisure", plaza = "Leisure", marina = "Leisure",
	airport = "Transport", airport_tower = "Transport", port = "Transport",
	lighthouse = "Landmark", observatory = "Landmark", construction = "Landmark",
	farm = "Rural", ranger = "Rural",
}
local CATEGORY_COLOR = {
	Shop = rgb(110, 210, 150), Food = rgb(242, 120, 160), Fuel = rgb(255, 170, 60), Health = rgb(235, 87, 87),
	Police = rgb(90, 150, 255), Hotel = rgb(180, 140, 255), Vehicle = rgb(64, 196, 214), Leisure = rgb(255, 214, 110),
	Transport = rgb(200, 200, 210), Landmark = rgb(255, 122, 69), Rural = rgb(150, 190, 110),
}
MapCanvas.POICategory = POI_CATEGORY
MapCanvas.CategoryColor = CATEGORY_COLOR

local function frame(parent: Instance, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

local function corner(parent: Instance, scale: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale or 0.5, 0)
	c.Parent = parent
end

-- Hata düzeltme 5: Roblox'un eski davranışında ClipsDescendants DÖNDÜRÜLMÜŞ öğeleri kırpmaz. Yollar ve rota
-- eskiden Rotation ile çiziliyordu (dikey yol = 90°) ve mini haritanın dışına, yönlendirme panelinin üstüne
-- taşıyordu. Harita artık hiç döndürülmüş öğe kullanmaz: eksene paralel çizgi = tek dikdörtgen, eğik çizgi =
-- üst üste binen yuvarlak noktalar. Böylece kırpma her cihazda ve her Roblox sürümünde güvenilir.
local DOT_STEP = 0.45 -- eğik çizgide nokta aralığı / çizgi kalınlığı

-- a→b çizgisini döndürmesiz parçalara böler. emit(x, z, along, length): along "X" | "Z" (dikdörtgen, uzunluk
-- boyunca) veya "D" (nokta; boyut = kalınlık). width: nokta aralığı için kalınlık.
local function lineParts(ax: number, az: number, bx: number, bz: number, width: number, emit: (number, number, string, number) -> ())
	local dx, dz = bx - ax, bz - az
	if math.abs(dz) < 0.05 then
		emit((ax + bx) / 2, (az + bz) / 2, "X", math.abs(dx))
	elseif math.abs(dx) < 0.05 then
		emit((ax + bx) / 2, (az + bz) / 2, "Z", math.abs(dz))
	else
		local length = math.sqrt(dx * dx + dz * dz)
		local n = math.max(math.ceil(length / math.max(width * DOT_STEP, 0.5)), 1)
		for i = 0, n do
			local t = i / n
			emit(ax + dx * t, az + dz * t, "D", 0)
		end
	end
end

local function partSize(along: string, length: number, width: number, extend: number): UDim2
	if along == "X" then
		return UDim2.fromOffset(length + extend, width)
	elseif along == "Z" then
		return UDim2.fromOffset(width, length + extend)
	end
	return UDim2.fromOffset(width, width)
end

-- opts: Detail = "Mini" | "Full"
function MapCanvas.new(parent: GuiObject, opts)
	local self = setmetatable({}, MapCanvas)
	local data = MapDefinitions.GetData()
	local half = data.Meta.HalfSize
	self.Half = half
	self.Detail = opts.Detail or "Mini"
	self.Scale = -1 -- tuvale uygulanan ölçek (UIScale ile her zaman aynı)
	self.IconScale = -1 -- sabit piksel boyutlu öğelerin en son boyutlandığı ölçek
	self.OffsetX, self.OffsetY = nil, nil
	self.TileX0, self.TileX1, self.TileZ0, self.TileZ1 = nil, nil, nil, nil
	self.Tiles = {}
	self.FixedIcons = {} -- { Gui, PixelSize } sabit piksel boyutlu öğeler
	self.RouteSegments = {}
	self.POIs = {}

	local root = frame(parent, {
		Name = "MapRoot",
		BackgroundColor3 = COLORS.Land,
		-- Mini haritada tuval saydam: zemin rengini kırpan kap verir. Böylece kırpma bir şekilde bozulsa bile
		-- 10240×10240'lık koyu bir kare ekranı kaplamaz (Hata düzeltme 4). Tam haritada opak kalır.
		BackgroundTransparency = if self.Detail == "Mini" then 1 else 0,
		Size = UDim2.fromOffset(half * 2, half * 2),
		ZIndex = 1,
	})
	root:SetAttribute("FaderSkip", true) -- menü geçişleri binlerce yol parçasını tek tek soldurmasın
	self.Root = root
	self.UIScale = Instance.new("UIScale")
	self.UIScale.Parent = root

	local function layer(name: string, z: number): Frame
		return frame(root, { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z })
	end
	local waterLayer = layer("Water", 2)
	local districtLayer = layer("Districts", 3)
	local roadLayer = layer("Roads", 4)
	self.RouteLayer = layer("Route", 5)
	self.MarkerLayer = layer("Markers", 6)

	-- Su
	for _, w in data.Water do
		frame(waterLayer, {
			BackgroundColor3 = COLORS.Water,
			Position = UDim2.fromOffset(w.X0 + half, w.Z0 + half),
			Size = UDim2.fromOffset(w.X1 - w.X0, w.Z1 - w.Z0),
		})
	end
	-- Bölgeler (tam haritada isim)
	if self.Detail == "Full" then
		for _, d in data.Districts do
			local cx, cz = (d.Min.X + d.Max.X) / 2 + half, (d.Min.Y + d.Max.Y) / 2 + half
			local w = math.max(d.Max.X - d.Min.X, 200)
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromOffset(cx, cz)
			label.Size = UDim2.fromOffset(w * 0.8, math.min(w * 0.08, 90))
			label.TextScaled = true
			label.FontFace = Theme.Fonts.Title
			label.TextColor3 = Theme.Colors.TextMuted
			label.TextTransparency = 0.45
			label.AutoLocalize = false
			label.Text = string.upper(d.Name)
			label.ZIndex = 3
			label.Parent = districtLayer
		end
	end

	-- Yollar: karolara bölünmüş
	local function tileFor(x: number, z: number): Frame
		local tx, tz = math.floor((x + half) / TILE), math.floor((z + half) / TILE)
		local key = tx * 1000 + tz
		local tile = self.Tiles[key]
		if not tile then
			tile = frame(roadLayer, { Name = "Tile_" .. tx .. "_" .. tz, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4 })
			self.Tiles[key] = tile
			tile:SetAttribute("TX", tx)
			tile:SetAttribute("TZ", tz)
		end
		return tile
	end
	local nodeWidth = {}
	for _, e in data.EdgeList do
		local a, b = data.Nodes[e.A], data.Nodes[e.B]
		if a and b then
			local ax, az, bx, bz = a.Position.X, a.Position.Z, b.Position.X, b.Position.Z
			local width = math.max(e.Width, 16)
			local color = COLORS[e.Kind] or COLORS.street
			local z = if e.Kind == "freeway" or e.Kind == "ramp" then 5 else 4
			lineParts(ax, az, bx, bz, width, function(x, zz, along, length)
				local part = frame(tileFor(x, zz), {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x + half, zz + half),
					Size = partSize(along, length, width, 0),
					BackgroundColor3 = color,
					ZIndex = z,
				})
				if along == "D" then
					corner(part)
				end
			end)
			nodeWidth[e.A] = math.max(nodeWidth[e.A] or 0, width)
			nodeWidth[e.B] = math.max(nodeWidth[e.B] or 0, width)
		end
	end
	-- Kavşak yuvarlakları (yol uçlarındaki boşlukları kapatır)
	for id, w in nodeWidth do
		local n = data.Nodes[id]
		local dot = frame(tileFor(n.Position.X, n.Position.Z), {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(n.Position.X + half, n.Position.Z + half),
			Size = UDim2.fromOffset(w, w),
			BackgroundColor3 = COLORS.street,
			ZIndex = 4,
		})
		corner(dot)
	end

	-- Önemli yerler (simge: kategori rengi + kısa harf)
	for _, poi in data.POIs do
		local category = POI_CATEGORY[poi.Type] or "Landmark"
		local icon = frame(self.MarkerLayer, {
			Name = "POI_" .. poi.Id,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(poi.Entrance.X + half, poi.Entrance.Z + half),
			BackgroundColor3 = CATEGORY_COLOR[category],
			ZIndex = 7,
		})
		corner(icon)
		local stroke = Instance.new("UIStroke")
		stroke.Color = rgb(10, 12, 16)
		stroke.Thickness = 1.5
		stroke.Parent = icon
		local letter = Instance.new("TextLabel")
		letter.BackgroundTransparency = 1
		letter.Size = UDim2.fromScale(0.8, 0.8)
		letter.AnchorPoint = Vector2.new(0.5, 0.5)
		letter.Position = UDim2.fromScale(0.5, 0.5)
		letter.TextScaled = true
		letter.FontFace = Theme.Fonts.Title
		letter.TextColor3 = rgb(16, 18, 24)
		letter.AutoLocalize = false
		letter.Text = Strings.Get("POICat." .. category .. ".Short")
		letter.ZIndex = 8
		letter.Parent = icon
		table.insert(self.FixedIcons, { Gui = icon, Pixels = if self.Detail == "Full" then 20 else 13 })
		table.insert(self.POIs, { Poi = poi, Gui = icon, Category = category })
	end

	-- Hedef işareti (iğne)
	self.Pin = frame(self.MarkerLayer, {
		Name = "Destination",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Colors.Accent,
		Visible = false,
		ZIndex = 9,
	})
	corner(self.Pin)
	local pinStroke = Instance.new("UIStroke")
	pinStroke.Color = rgb(255, 255, 255)
	pinStroke.Thickness = 2
	pinStroke.Parent = self.Pin
	table.insert(self.FixedIcons, { Gui = self.Pin, Pixels = if self.Detail == "Full" then 18 else 12 })

	-- Oyuncu işareti (tam haritada; minimapte sabit merkez oku kullanılır)
	if self.Detail == "Full" then
		self.Player = MapCanvas.MakeArrow(self.MarkerLayer, 10)
		table.insert(self.FixedIcons, { Gui = self.Player, Pixels = 26 })
	end
	return self
end

-- Yukarıyı gösteren ok (iki çubuk + nokta). Döndürmek için Rotation kullanılır (0 = kuzey).
function MapCanvas.MakeArrow(parent: Instance, zIndex: number): Frame
	local holder = frame(parent, { Name = "PlayerArrow", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = zIndex })
	local dot = frame(holder, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(0.42, 0.42),
		BackgroundColor3 = rgb(255, 255, 255),
		ZIndex = zIndex,
	})
	corner(dot)
	for _, sign in { -1, 1 } do
		local bar = frame(holder, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + sign * 0.15, 0.3),
			Size = UDim2.fromScale(0.16, 0.5),
			Rotation = sign * 30,
			BackgroundColor3 = Theme.Colors.AccentAlt,
			ZIndex = zIndex + 1,
		})
		corner(bar)
	end
	return holder
end

-- Görünüm: dünya merkezi (cx, cz), ölçek (piksel/stud), görüntü alanı (ebeveyn biriminde)
-- GPS/harita kararlılık düzeltmesi: UIScale ve kök konumu HER ZAMAN aynı ölçekle (bu çağrının ölçeğiyle) yazılır.
-- Eskiden UIScale sadece %1 değişimde güncellenip konum yeni ölçekle hesaplanıyordu → araçta harita merkezi
-- oyuncudan kayıp geri zıplıyordu. Pahalı yakınlık adımlarını seyreltmek çağıranın işidir (MapView.ZoomStep).
-- Özellikler sadece değişince yazılır.
function MapCanvas:SetView(cx: number, cz: number, scale: number, viewport: Vector2)
	if scale <= 0 then
		return
	end
	local half = self.Half
	if scale ~= self.Scale then
		self.Scale = scale
		self.UIScale.Scale = scale
	end
	-- Sabit piksel boyutlu öğeler (simgeler, rota kalınlığı): %1'lik boyut farkı görünmez, sadece daha büyük
	-- değişimde yeniden boyutlandır (konumu etkilemez).
	if math.abs(scale - self.IconScale) > self.IconScale * 0.01 then
		self.IconScale = scale
		for _, item in self.FixedIcons do
			item.Gui.Size = UDim2.fromOffset(item.Pixels / scale, item.Pixels / scale)
		end
		local thickness = (if self.Detail == "Full" then 5 else 4) / scale
		if self.RouteDotThickness and thickness < self.RouteDotThickness * 0.6 then
			-- yakınlaşınca eğik rota noktaları arasında boşluk kalmasın: noktaları yeni kalınlıkla yeniden diz
			self:SetRoute(self.CurrentRoute)
		else
			for _, seg in self.RouteSegments do
				local t = thickness * (seg:GetAttribute("Weight") or 1)
				seg.Size = partSize(seg:GetAttribute("Along") or "X", seg:GetAttribute("Length") or 0, t, t)
			end
		end
	end
	self.ViewX, self.ViewZ, self.Viewport = cx, cz, viewport
	local ox, oy = MapView.RootOffset(cx, cz, scale, viewport.X, viewport.Y, half)
	if ox ~= self.OffsetX or oy ~= self.OffsetY then
		self.OffsetX, self.OffsetY = ox, oy
		self.Root.Position = UDim2.fromOffset(ox, oy)
	end
	-- Karo görünürlüğü: sadece aralık değişince
	local halfW, halfH = viewport.X / 2 / scale + 200, viewport.Y / 2 / scale + 200
	local tx0, tx1 = math.floor((cx - halfW + half) / TILE), math.floor((cx + halfW + half) / TILE)
	local tz0, tz1 = math.floor((cz - halfH + half) / TILE), math.floor((cz + halfH + half) / TILE)
	if tx0 ~= self.TileX0 or tx1 ~= self.TileX1 or tz0 ~= self.TileZ0 or tz1 ~= self.TileZ1 then
		self.TileX0, self.TileX1, self.TileZ0, self.TileZ1 = tx0, tx1, tz0, tz1
		for _, tile in self.Tiles do
			local tx, tz = tile:GetAttribute("TX"), tile:GetAttribute("TZ")
			tile.Visible = tx >= tx0 and tx <= tx1 and tz >= tz0 and tz <= tz1
		end
	end
end

function MapCanvas:SetPlayer(x: number, z: number, headingDeg: number)
	if self.Player then
		self.Player.Position = UDim2.fromOffset(x + self.Half, z + self.Half)
		self.Player.Rotation = headingDeg
		-- Ok döndürülmüş bir öğedir; görüntü alanının dışındaysa gizle (kırpmaya güvenme)
		local viewport = self.Viewport
		if viewport then
			local scale = math.max(self.Scale, 0.0001)
			local px = (x - self.ViewX) * scale + viewport.X / 2
			local py = (z - self.ViewZ) * scale + viewport.Y / 2
			local r = 14
			self.Player.Visible = px >= r and px <= viewport.X - r and py >= r and py <= viewport.Y - r
		end
	end
end

function MapCanvas:SetDestination(position: Vector3?)
	if position then
		self.Pin.Position = UDim2.fromOffset(position.X + self.Half, position.Z + self.Half)
		self.Pin.Visible = true
	else
		self.Pin.Visible = false
	end
end

-- route: Navigation rota nesnesi ya da nil
function MapCanvas:SetRoute(route)
	for _, seg in self.RouteSegments do
		seg:Destroy()
	end
	table.clear(self.RouteSegments)
	self.CurrentRoute = route
	self.RouteDotThickness = nil
	if not route then
		return
	end
	local half = self.Half
	local scale = math.max(self.IconScale, 0.01) -- SetView'in yeniden boyutlandırma ölçeğiyle aynı
	local thickness = (if self.Detail == "Full" then 5 else 4) / scale
	local function segment(a, b, color: Color3, weight: number, transparency: number)
		local dx, dz = b.X - a.X, b.Z - a.Z
		if dx * dx + dz * dz < 0.25 then
			return
		end
		local t = thickness * weight
		lineParts(a.X, a.Z, b.X, b.Z, t, function(x, z, along, length)
			local seg = frame(self.RouteLayer, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x + half, z + half),
				Size = partSize(along, length, t, t),
				BackgroundColor3 = color,
				BackgroundTransparency = transparency,
				ZIndex = 6,
			})
			seg:SetAttribute("Weight", weight)
			seg:SetAttribute("Along", along)
			seg:SetAttribute("Length", length)
			corner(seg)
			table.insert(self.RouteSegments, seg)
			if along == "D" then
				self.RouteDotThickness = thickness
			end
		end)
	end
	local points = route.Points
	for i = 1, #points - 1 do
		segment(points[i], points[i + 1], COLORS.Route, 1, 0)
	end
	if route.Offroad then
		-- son kısım yol dışında: ince, yarı saydam düz çizgi
		segment(points[#points], route.Destination, COLORS.RouteOffroad, 0.5, 0.35)
	end
end

-- Ekran noktası (ebeveyn biriminde, görüntü alanının sol üstüne göre) → dünya
function MapCanvas:ViewToWorld(local2: Vector2, cx: number, cz: number, viewport: Vector2): (number, number)
	local scale = math.max(self.Scale, 0.0001)
	return cx + (local2.X - viewport.X / 2) / scale, cz + (local2.Y - viewport.Y / 2) / scale
end

-- Dünya noktasına en yakın POI (piksel yarıçapı içinde)
function MapCanvas:POINear(x: number, z: number, radiusPixels: number)
	local limit = radiusPixels / math.max(self.Scale, 0.0001)
	local best, bestD = nil, limit
	for _, item in self.POIs do
		local p = item.Poi.Entrance
		local d = math.sqrt((p.X - x) ^ 2 + (p.Z - z) ^ 2)
		if d < bestD then
			best, bestD = item.Poi, d
		end
	end
	return best
end

function MapCanvas:Destroy()
	self.Root:Destroy()
end

return MapCanvas
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBXB042BD25N"><Properties>
<string name="Name">MenuCamera</string>

<ProtectedString name="Source"><![CDATA[-- MenuCamera: ana menü kamera çekimleri. CameraController:RequestScripted için "supplier" üretir;
-- kameranın CFrame'ini yine SADECE CameraController yazar (mimari kuralı korunur).
--
--   Title  : şehir merkezinin kulelerine bakan, yörüngede yavaşça kayan hava çekimi.
--   Pause  : oyun içi menüde oyuncunun etrafında yavaş dönen çekim (her zaman akmış bölgede kalır).
-- "Hareketi azalt" açıkken iki çekim de sabit durur.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEndConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FrontEndConfig"))

local MenuCamera = {}

local DEG = math.pi / 180

local function easeInOut(t: number): number
	return t * t * (3 - 2 * t)
end

-- Yörüngede açıya göre kamera konumu
local function titlePosition(angleDeg: number): Vector3
	local shot = FrontEndConfig.MenuShot
	local a = angleDeg * DEG
	return Vector3.new(shot.Pivot.X + shot.Radius * math.cos(a), shot.Height, shot.Pivot.Z + shot.Radius * math.sin(a))
end

function MenuCamera.TitleCFrame(t: number, reduceMotion: boolean): CFrame
	local shot = FrontEndConfig.MenuShot
	local alpha
	if reduceMotion then
		alpha = 0.5
	else
		local phase = (t / shot.Period) % 2
		alpha = easeInOut(if phase <= 1 then phase else 2 - phase)
	end
	local angle = shot.StartAngle + (shot.EndAngle - shot.StartAngle) * alpha
	return CFrame.lookAt(titlePosition(angle), shot.Target)
end

-- Akış ve şehir-hazır kontrolü için çekimin ortası
function MenuCamera.TitleProbe(): (Vector3, Vector3)
	local shot = FrontEndConfig.MenuShot
	return titlePosition((shot.StartAngle + shot.EndAngle) / 2), shot.Target
end

-- getReduceMotion: () -> boolean
function MenuCamera.TitleSupplier(getReduceMotion: () -> boolean)
	local elapsed = 0
	local shot = FrontEndConfig.MenuShot
	local focus = CFrame.new(shot.Target)
	return function(dt: number)
		elapsed += dt
		return MenuCamera.TitleCFrame(elapsed, getReduceMotion()), shot.FieldOfView, focus
	end
end

-- getRoot: () -> BasePart? (oyuncunun HumanoidRootPart'ı). Yoksa son bilinen noktada kalır.
function MenuCamera.PauseSupplier(getRoot: () -> BasePart?, getReduceMotion: () -> boolean, startYaw: number)
	local shot = FrontEndConfig.PauseShot
	local yaw = startYaw
	local lastCenter: Vector3? = nil
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	params.IgnoreWater = true
	return function(dt: number)
		local root = getRoot()
		if root and root.Parent then
			lastCenter = root.Position
			params.FilterDescendantsInstances = { root.Parent }
		end
		local center = (lastCenter or FrontEndConfig.MenuShot.Target) + Vector3.new(0, shot.LookHeight, 0)
		if not getReduceMotion() then
			yaw += shot.DegreesPerSecond * DEG * dt
		end
		local offset = Vector3.new(math.sin(yaw) * shot.Radius, shot.Height, math.cos(yaw) * shot.Radius)
		-- Duvar/bina arkasına girmesin: merkezden dışarı küre atışı
		local position = center + offset
		local hit = workspace:Spherecast(center, shot.CollisionRadius, offset, params)
		if hit then
			position = center + offset.Unit * math.max(hit.Distance - 0.5, 3)
		end
		return CFrame.lookAt(position, center), shot.FieldOfView, CFrame.new(center)
	end
end

return MenuCamera
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX88593D8BN"><Properties>
<string name="Name">MenuInput</string>

<ProtectedString name="Source"><![CDATA[-- MenuInput: menü gezinme girişleri (klavye, gamepad tuşları ve sol çubuk).
-- InputController'ın "Menu" bağlamı eylemlerini dinler; yön tuşları basılı tutulunca tekrar eder.
-- Hangi ekranın neyi yapacağına karar vermez, sadece niyeti iletir (handlers).
--
-- handlers:
--   IsActive  () -> boolean          menü açık ve giriş kabul ediyor mu
--   Navigate  (kind: "Move"|"Adjust", dir: -1|1) -> ()
--   Accept    () -> ()
--   Back      () -> ()
--   Tab       (dir: -1|1) -> ()
--   Close     () -> ()
--   Open      () -> ()               oyun içinde "OpenMenu" eylemi

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEndConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FrontEndConfig"))

local MenuInput = {}

local NAV = {
	MenuUp = { "Move", -1 },
	MenuDown = { "Move", 1 },
	MenuLeft = { "Adjust", -1 },
	MenuRight = { "Adjust", 1 },
}

function MenuInput.connect(inputController, handlers)
	local held: string? = nil -- tekrar edilen gezinme eylemi (ör. "MenuDown")
	local nextAt = 0
	local stickV, stickH = 0, 0

	local function perform(action: string)
		local nav = NAV[action]
		if nav then
			handlers.Navigate(nav[1], nav[2])
		end
	end

	local function startHold(action: string)
		perform(action)
		held = action
		nextAt = os.clock() + FrontEndConfig.NavRepeatDelay
	end

	inputController.ActionBegan:Connect(function(action: string)
		if action == "OpenMenu" then
			handlers.Open()
			return
		elseif action == "OpenMap" then
			if handlers.OpenMap then
				handlers.OpenMap()
			end
			return
		end
		if not handlers.IsActive() then
			return
		end
		if NAV[action] then
			startHold(action)
		elseif action == "MenuAccept" then
			handlers.Accept()
		elseif action == "MenuBack" then
			handlers.Back()
		elseif action == "MenuTabPrev" then
			handlers.Tab(-1)
		elseif action == "MenuTabNext" then
			handlers.Tab(1)
		elseif action == "MenuClose" then
			handlers.Close()
		end
	end)

	inputController.ActionEnded:Connect(function(action: string)
		if held == action then
			held = nil
		end
	end)

	-- Sol çubuk: eşik aşılınca bir adım, tutulursa tekrar
	local function onStick(position: Vector3)
		if not handlers.IsActive() then
			stickV, stickH, held = 0, 0, nil
			return
		end
		local threshold = FrontEndConfig.StickThreshold
		local v = if position.Y > threshold then -1 elseif position.Y < -threshold then 1 else 0
		local h = if position.X > threshold then 1 elseif position.X < -threshold then -1 else 0
		if v ~= stickV then
			stickV = v
			if v ~= 0 then
				startHold(if v < 0 then "MenuUp" else "MenuDown")
			elseif held == "MenuUp" or held == "MenuDown" then
				held = nil
			end
		end
		if h ~= stickH then
			stickH = h
			if h ~= 0 then
				startHold(if h < 0 then "MenuLeft" else "MenuRight")
			elseif held == "MenuLeft" or held == "MenuRight" then
				held = nil
			end
		end
	end

	UserInputService.InputChanged:Connect(function(io)
		if io.KeyCode == Enum.KeyCode.Thumbstick1 then
			onStick(io.Position)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.KeyCode == Enum.KeyCode.Thumbstick1 then
			onStick(Vector3.zero)
		end
	end)

	RunService.Heartbeat:Connect(function()
		if not held then
			return
		end
		if not handlers.IsActive() then
			held = nil
			return
		end
		local now = os.clock()
		if now >= nextAt then
			nextAt = now + FrontEndConfig.NavRepeatRate
			perform(held)
		end
	end)
end

return MenuInput
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBXA87115B9N"><Properties>
<string name="Name">Screens</string>
</Properties>
<Item class="ModuleScript" referent="RBXA9058019N"><Properties>
<string name="Name">GarageScreen</string>

<ProtectedString name="Source"><![CDATA[-- GarageScreen: garaj GİRİŞ NOKTASI. Araç sahipliği/satın alma henüz YOK; ekran bunu açıkça söyler.
-- Gerçek veriyi gösterir: VehicleDefinitions kataloğundaki araçlar ve değerleri (sahte fiyat/buton yok).
-- Garaj sistemi geldiğinde bu ekranın sağ panelindeki "yakında" kutusu gerçek eylemlerle değişecek.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEnd = script.Parent.Parent
local Theme = require(FrontEnd.Theme)
local Widgets = require(FrontEnd.Widgets)
local Strings = require(FrontEnd.Strings)
local Focus = require(FrontEnd.Focus)
local VehicleDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VehicleDefinitions"))

local C = Theme.Colors
local new = Widgets.new
local tween = Widgets.tween

local GarageScreen = {}
GarageScreen.__index = GarageScreen

local LIST_WIDTH = 300

local function sortedCatalog()
	local list = {}
	for id, def in VehicleDefinitions.Catalog do
		table.insert(list, { Id = id, Def = def })
	end
	table.sort(list, function(a, b)
		if a.Def.Type ~= b.Def.Type then
			return a.Def.Type == "Car" -- önce otomobiller
		end
		return a.Def.DisplayName < b.Def.DisplayName
	end)
	return list
end

-- Katalog içindeki en yüksek değerlere göre 0..1
local function maxima(list)
	local m = { MaxSpeed = 1, Accel = 1, Grip = 1, Brake = 1 }
	for _, entry in list do
		for key in m do
			m[key] = math.max(m[key], entry.Def[key] or 0)
		end
	end
	return m
end

local function statBar(parent: Instance, labelKey: string, order: number)
	local holder = new("Frame", {
		Name = labelKey,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Widgets.Label({
		Text = Strings.Get(labelKey),
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		Size = UDim2.new(0.5, 0, 0, 16),
		Parent = holder,
	})
	local value = Widgets.Label({
		Text = "",
		FontFace = Theme.Fonts.Mono,
		TextSize = Theme.Text.Small,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, 0, 0, 16),
		Parent = holder,
	})
	local rail = new("Frame", {
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = C.SurfaceHigh,
		BorderSizePixel = 0,
		Parent = holder,
	}, { Widgets.Round() })
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = rail,
	}, { Widgets.Round(), Widgets.Gradient(Theme.AccentGradient, 0) })
	return function(t: number, text: string)
		value.Text = text
		tween(fill, { Size = UDim2.fromScale(math.clamp(t, 0.04, 1), 1) }, Theme.Tween.Normal)
	end
end

-- ctx: Parent, GetScale, OnMove, Back
function GarageScreen.new(ctx)
	local self = setmetatable({}, GarageScreen)
	self.Focus = Focus.new(ctx.GetScale, ctx.OnMove)
	self._catalog = sortedCatalog()
	self._max = maxima(self._catalog)

	self.Root = new("Frame", {
		Name = "GarageScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ctx.Parent,
	})
	local panel = Widgets.Panel({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -64, 1, -48),
		Parent = self.Root,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(980, 660) }).Parent = panel
	Widgets.Padding(28, 28, 20, 20).Parent = panel

	-- Başlık + YAKINDA rozeti + geri
	local title = Widgets.Label({
		Name = "Title",
		Text = Strings.Get("Garage.Title"),
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Heading,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		Parent = panel,
	})
	local badge = new("Frame", {
		Name = "Badge",
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.fromOffset(0, 24),
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = panel,
	}, { Widgets.Round(), Widgets.Stroke(C.Accent, 0.3), Widgets.Padding(10, 10, 0, 0) })
	Widgets.Label({
		Text = Strings.Get("Garage.Badge"),
		FontFace = Theme.Fonts.Title,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.Accent,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Parent = badge,
	})
	-- rozet başlığın hemen sağında
	local function placeBadge()
		badge.Position = UDim2.fromOffset(title.AbsoluteSize.X / math.max(ctx.GetScale(), 0.01) + 14, 20)
	end
	title:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeBadge)
	task.defer(placeBadge)

	Widgets.SmallButton(panel, {
		Name = "Back",
		Text = "‹  " .. Strings.Get("Settings.Back"),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		OnActivate = ctx.Back,
	})
	Widgets.Label({
		Name = "Intro",
		Text = Strings.Get("Garage.Intro"),
		FontFace = Theme.Fonts.Light,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = panel,
	})

	-- Sol: araç listesi
	self._list = new("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, 100),
		Size = UDim2.new(0, LIST_WIDTH, 1, -100),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.White,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
		Parent = panel,
	}, { Widgets.List(6), Widgets.Padding(0, 8, 2, 8) })

	-- Sağ: ayrıntı
	local detail = new("Frame", {
		Name = "Detail",
		Position = UDim2.fromOffset(LIST_WIDTH + 24, 100),
		Size = UDim2.new(1, -(LIST_WIDTH + 24), 1, -100),
		BackgroundColor3 = C.Surface,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Parent = panel,
	}, { Widgets.Corner(12), Widgets.Padding(22, 22, 18, 18) })
	local detailBody = new("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Selectable = false,
		Parent = detail,
	}, { Widgets.List(10) })
	self._name = Widgets.Label({
		Name = "Name",
		FontFace = Theme.Fonts.Display,
		TextSize = 34,
		Size = UDim2.new(1, -8, 0, 38),
		LayoutOrder = 1,
		Parent = detailBody,
	})
	self._meta = Widgets.Label({
		Name = "Meta",
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		Size = UDim2.new(1, -8, 0, 18),
		LayoutOrder = 2,
		Parent = detailBody,
	})
	local stats = new("Frame", {
		Name = "Stats",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -8, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = detailBody,
	}, { Widgets.List(6) })
	self._bars = {
		TopSpeed = statBar(stats, "Garage.TopSpeed", 1),
		Acceleration = statBar(stats, "Garage.Acceleration", 2),
		Handling = statBar(stats, "Garage.Handling", 3),
		Braking = statBar(stats, "Garage.Braking", 4),
	}
	Widgets.Label({
		Text = Strings.Get("Garage.Colors"),
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		Size = UDim2.new(1, -8, 0, 16),
		LayoutOrder = 4,
		Parent = detailBody,
	})
	self._swatches = new("Frame", {
		Name = "Swatches",
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = detailBody,
	}, { Widgets.List(8, true) })
	-- "Yakında" kutusu: dürüst bilgi + şimdilik nasıl araç kullanılır
	local soon = new("Frame", {
		Name = "ComingSoon",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -8, 0, 0),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		LayoutOrder = 6,
		Parent = detailBody,
	}, { Widgets.Corner(10), Widgets.Stroke(C.White, 0.88), Widgets.Padding(14, 14, 12, 12), Widgets.List(6) })
	Widgets.Label({
		Text = Strings.Get("Garage.Unavailable"),
		FontFace = Theme.Fonts.Title,
		TextSize = Theme.Text.Small,
		TextColor3 = C.Accent,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = soon,
	})
	Widgets.Label({
		Text = Strings.Get("Garage.HowTo"),
		FontFace = Theme.Fonts.Light,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 2,
		Parent = soon,
	})

	-- Liste öğeleri
	local items = {}
	for index, entry in self._catalog do
		local def = entry.Def
		local row = Widgets.HitButton({
			Name = "Vehicle_" .. entry.Id,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = C.SurfaceHigh,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = self._list,
		})
		Widgets.Corner(8).Parent = row
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = row,
		}, { Widgets.Corner(2) })
		new("Frame", {
			Name = "Swatch",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 16, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = def.Colors[1],
			BorderSizePixel = 0,
			Parent = row,
		}, { Widgets.Round() })
		Widgets.Label({
			Text = def.DisplayName,
			FontFace = Theme.Fonts.Title,
			TextSize = Theme.Text.Body - 1,
			Position = UDim2.fromOffset(40, 8),
			Size = UDim2.new(1, -110, 0, 22),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		Widgets.Label({
			Text = Strings.Get("VehicleCategory." .. def.Category) .. "  ·  " .. Strings.Get("Type." .. def.Type),
			FontFace = Theme.Fonts.Light,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.TextMuted,
			Position = UDim2.fromOffset(40, 31),
			Size = UDim2.new(1, -110, 0, 16),
			Parent = row,
		})
		Widgets.Label({
			Text = tostring(math.floor(VehicleDefinitions.ToKmh(def.MaxSpeed) + 0.5)),
			FontFace = Theme.Fonts.Mono,
			TextSize = Theme.Text.Small,
			TextColor3 = C.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(60, 20),
			Parent = row,
		})
		local item
		item = {
			Gui = row,
			Scroller = self._list,
			OnFocus = function(isFocused: boolean, showHighlight: boolean)
				local on = isFocused and showHighlight
				tween(row, { BackgroundTransparency = if isFocused then (if on then 0.45 else 0.7) else 1 })
				tween(bar, { BackgroundTransparency = if isFocused then 0 else 1 })
				if isFocused then
					self:_showDetail(entry)
				end
			end,
		}
		row.Activated:Connect(function()
			self.Focus:Hover(item)
		end)
		row.MouseEnter:Connect(function()
			self.Focus:Hover(item)
		end)
		table.insert(items, item)
	end
	self.Focus:SetItems(items, 1)
	return self
end

function GarageScreen:_showDetail(entry)
	local def, m = entry.Def, self._max
	self._name.Text = def.DisplayName
	local parts = {
		Strings.Get("VehicleCategory." .. def.Category),
		Strings.Get("Type." .. def.Type),
		Strings.Get("Garage.Seats", #def.Seats),
		Strings.Get("Garage.Drive", def.Drive or "?"),
	}
	self._meta.Text = table.concat(parts, "  ·  ")
	local kmh = math.floor(VehicleDefinitions.ToKmh(def.MaxSpeed) + 0.5)
	self._bars.TopSpeed(def.MaxSpeed / m.MaxSpeed, kmh .. " " .. Strings.Get("Unit.Kmh"))
	self._bars.Acceleration(def.Accel / m.Accel, string.format("%d", math.floor(def.Accel / m.Accel * 100 + 0.5)))
	self._bars.Handling(def.Grip / m.Grip, string.format("%d", math.floor(def.Grip / m.Grip * 100 + 0.5)))
	self._bars.Braking(def.Brake / m.Brake, string.format("%d", math.floor(def.Brake / m.Brake * 100 + 0.5)))
	for _, child in self._swatches:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i, color in def.Colors do
		new("Frame", {
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = self._swatches,
		}, { Widgets.Round(), Widgets.Stroke(C.White, 0.6) })
	end
end

function GarageScreen:SetCompact(_compact: boolean) end

function GarageScreen:OnShow()
	self.Focus:Refresh()
end

function GarageScreen:OnHide() end

function GarageScreen:HandleTab(_dir: number): boolean
	return false
end

return GarageScreen
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXFA1ACF4CN"><Properties>
<string name="Name">MainScreen</string>

<ProtectedString name="Source"><![CDATA[-- MainScreen: logo + OYNA / GARAJ / AYARLAR + durum satırı + oyuncu kartı.
-- Ekran nesnesi sözleşmesi (FrontEndController kullanır):
--   Root: GuiObject, Focus: Focus, OnShow(), OnHide(), HandleTab(dir) -> boolean, SetCompact(bool)

local Players = game:GetService("Players")

local FrontEnd = script.Parent.Parent
local Theme = require(FrontEnd.Theme)
local Widgets = require(FrontEnd.Widgets)
local Strings = require(FrontEnd.Strings)
local Focus = require(FrontEnd.Focus)

local C = Theme.Colors
local new = Widgets.new

local MainScreen = {}
MainScreen.__index = MainScreen

-- ctx: Parent, GetScale, OnMove, Actions = { Play, Garage, Settings }
function MainScreen.new(ctx)
	local self = setmetatable({}, MainScreen)
	self.Focus = Focus.new(ctx.GetScale, ctx.OnMove)
	local hover = function(item)
		self.Focus:Hover(item)
	end

	self.Root = new("Frame", {
		Name = "MainScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ctx.Parent,
	})

	-- ===== Sol sütun =====
	local column = new("Frame", {
		Name = "Column",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 80, 0.5, 0),
		Size = UDim2.fromOffset(Theme.Size.ColumnWidth, 486),
		BackgroundTransparency = 1,
		Parent = self.Root,
	})
	self._column = column

	-- Logo: çizgili güneş + SOLARA yazısı + alt başlık
	local logo = new("Frame", {
		Name = "Logo",
		Size = UDim2.new(1, 0, 0, 124),
		BackgroundTransparency = 1,
		Parent = column,
	})
	local sun = Widgets.Sun(64, C.Panel)
	sun.Position = UDim2.fromOffset(0, 10)
	sun.Parent = logo
	local wordmark = Widgets.Label({
		Name = "Wordmark",
		Text = "SOLARA",
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Logo,
		Position = UDim2.fromOffset(80, -2),
		Size = UDim2.new(1, -80, 0, 84),
		Parent = logo,
	})
	Widgets.Gradient(Theme.WordmarkGradient, 90).Parent = wordmark
	local subtitleRow = new("Frame", {
		Name = "SubtitleRow",
		Position = UDim2.fromOffset(84, 84),
		Size = UDim2.new(1, -84, 0, 20),
		BackgroundTransparency = 1,
		Parent = logo,
	})
	new("Frame", {
		Name = "Rule",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(28, 2),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Parent = subtitleRow,
	}, { Widgets.Gradient(Theme.AccentGradient, 0) })
	Widgets.Label({
		Text = Strings.Get("Main.Subtitle"),
		FontFace = Theme.Fonts.Title,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -38, 1, 0),
		Parent = subtitleRow,
	})

	-- Butonlar
	local list = new("Frame", {
		Name = "Buttons",
		Position = UDim2.fromOffset(0, 150),
		Size = UDim2.new(1, 0, 0, 4 * Theme.Size.MainButton + 24),
		BackgroundTransparency = 1,
		Parent = column,
	}, { Widgets.List(8) })
	self._play = Widgets.MenuButton(list, {
		Index = "01",
		Text = Strings.Get("Main.Play"),
		Sub = Strings.Get("Main.Play.Sub"),
		Primary = true,
		LayoutOrder = 1,
		OnActivate = ctx.Actions.Play,
		OnHover = hover,
	})
	self._garage = Widgets.MenuButton(list, {
		Index = "02",
		Text = Strings.Get("Main.Garage"),
		Sub = Strings.Get("Main.Garage.Sub"),
		LayoutOrder = 2,
		OnActivate = ctx.Actions.Garage,
		OnHover = hover,
	})
	self._map = Widgets.MenuButton(list, {
		Index = "03",
		Text = Strings.Get("Main.Map"),
		Sub = Strings.Get("Main.Map.Sub"),
		LayoutOrder = 3,
		OnActivate = ctx.Actions.Map,
		OnHover = hover,
	})
	self._settings = Widgets.MenuButton(list, {
		Index = "04",
		Text = Strings.Get("Main.Settings"),
		Sub = Strings.Get("Main.Settings.Sub"),
		LayoutOrder = 4,
		OnActivate = ctx.Actions.Settings,
		OnHover = hover,
	})

	-- Durum satırı (şehir hazır mı / bağlanılıyor / hata)
	local status = new("Frame", {
		Name = "Status",
		Position = UDim2.fromOffset(20, 150 + 4 * Theme.Size.MainButton + 24 + 18),
		Size = UDim2.new(1, -20, 0, 20),
		BackgroundTransparency = 1,
		Parent = column,
	})
	self._statusDot = new("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = C.TextMuted,
		BorderSizePixel = 0,
		Parent = status,
	}, { Widgets.Round() })
	self._statusText = Widgets.Label({
		Name = "Text",
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextMuted,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -18, 1, 0),
		Parent = status,
	})

	-- ===== Oyuncu kartı (sağ üst) =====
	local player = Players.LocalPlayer
	local card = new("Frame", {
		Name = "PlayerCard",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -32, 0, 20),
		Size = UDim2.fromOffset(260, 48),
		BackgroundTransparency = 1,
		Parent = self.Root,
	})
	local avatar = new("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.SurfaceHigh,
		BackgroundTransparency = 0.3,
		Image = "",
		Parent = card,
	}, { Widgets.Round(), Widgets.Stroke(C.White, 0.7, 1.5) })
	Widgets.Label({
		Name = "DisplayName",
		Text = player.DisplayName,
		FontFace = Theme.Fonts.Title,
		TextSize = Theme.Text.Body - 2,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, -56, 0, 20),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	Widgets.Label({
		Name = "UserName",
		Text = "@" .. player.Name,
		FontFace = Theme.Fonts.Light,
		TextSize = Theme.Text.Tiny + 1,
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(0, 25),
		Size = UDim2.new(1, -56, 0, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and image and avatar.Parent then
			avatar.Image = image
		end
	end)

	self._items = { self._play.Item, self._garage.Item, self._map.Item, self._settings.Item }
	self.Focus:SetItems(self._items, 1)
	return self
end

-- "Title" (henüz oyunda değil) | "Paused" (oyun içi menü)
function MainScreen:SetMode(mode: string)
	if mode == "Paused" then
		self._play.SetText(Strings.Get("Main.Resume"), Strings.Get("Main.Resume.Sub"))
	else
		self._play.SetText(Strings.Get("Main.Play"), Strings.Get("Main.Play.Sub"))
	end
end

function MainScreen:SetBusy(busy: boolean)
	self._play.SetBusy(busy)
end

-- kind: "ok" | "busy" | "error" | "info"
function MainScreen:SetStatus(text: string, kind: string)
	self._statusKind = kind
	self._statusText.Text = text
	local color = if kind == "ok" then C.Success elseif kind == "error" then C.Danger elseif kind == "busy" then C.Accent else C.TextMuted
	self._statusDot.BackgroundColor3 = color
	self._statusText.TextColor3 = if kind == "error" then C.Danger else C.TextMuted
end

-- Hata mesajı, oyuncu tekrar OYNA'ya basana kadar şehir durumu tarafından ezilmesin
function MainScreen:IsShowingError(): boolean
	return self._statusKind == "error"
end

function MainScreen:SetCompact(compact: boolean)
	self._column.Position = UDim2.new(0, if compact then 36 else 80, 0.5, 0)
end

function MainScreen:OnShow()
	self.Focus:Select(1, true)
	self.Focus:Refresh()
end

function MainScreen:OnHide() end

function MainScreen:HandleTab(_dir: number): boolean
	return false
end

return MainScreen
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXCA0FF700N"><Properties>
<string name="Name">MapScreen</string>

<ProtectedString name="Source"><![CDATA[-- MapScreen: tam ekran harita ve hedef seçimi (Aşama 4). FrontEnd menüsünün bir ekranıdır (M tuşu,
-- menüdeki HARİTA butonu ya da köşe haritasına dokunma ile açılır).
--
-- Girişler:
--   Fare      sürükle = kaydır, tekerlek = imlecin altına yakınlaş, tıkla = hedef (simgeye tıklarsan o yer)
--   Dokunmatik sürükle = kaydır, iki parmak = yakınlaş, dokun = hedef
--   Klavye/gamepad  WASD / ok / sol çubuk = kaydır, Q E / LB RB = yakınlaş, Enter / A = artı işaretine hedef koy
-- Sağ panel: mevcut hedef, rota uzunluğu, "temizle", "konumuma dön" ve uzaklığa göre sıralı yerler listesi.
-- Harita bir kez çizilir (ilk açılışta); kaydırma/yakınlaştırma sadece konum/ölçek değiştirir.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEnd = script.Parent.Parent
local Theme = require(FrontEnd.Theme)
local Widgets = require(FrontEnd.Widgets)
local Strings = require(FrontEnd.Strings)
local Focus = require(FrontEnd.Focus)
local MapCanvas = require(FrontEnd:WaitForChild("Map"):WaitForChild("MapCanvas"))
local MapDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapDefinitions"))

local C = Theme.Colors
local new = Widgets.new

local MapScreen = {}
MapScreen.__index = MapScreen

local PANEL_WIDTH = 330
local MIN_ZOOM, MAX_ZOOM = 0.03, 1.2
local PAN_STEP = 60 -- tasarım pikseli / tuş tekrarı

-- ctx: Parent, GetScale, OnMove, Back, Navigation (NavigationController), IsTouch () -> boolean
function MapScreen.new(ctx)
	local self = setmetatable({}, MapScreen)
	self._ctx = ctx
	self._nav = ctx.Navigation
	self.Focus = Focus.new(ctx.GetScale, ctx.OnMove)
	self.Focus:SetItems({})
	self._zoom = 0.15
	self._cx, self._cz = 0, 0
	self._canvas = nil

	self.Root = new("Frame", { Name = "MapScreen", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = ctx.Parent })

	-- Harita görünümü
	self._view = new("Frame", {
		Name = "MapView",
		Position = UDim2.fromOffset(24, 20),
		Size = UDim2.new(1, -(PANEL_WIDTH + 64), 1, -76),
		BackgroundColor3 = C.Background,
		ClipsDescendants = true,
		Active = true,
		Parent = self.Root,
	}, { Widgets.Stroke(C.White, 0.85) })
	self._crosshair = new("Frame", {
		Name = "Crosshair", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1, ZIndex = 20, Parent = self._view,
	}, { Widgets.Round(), Widgets.Stroke(C.White, 0.1, 2) })
	new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = C.White, BorderSizePixel = 0, ZIndex = 21, Parent = self._crosshair }, { Widgets.Round() })

	-- Sağ panel
	local panel = Widgets.Panel({ Name = "Panel", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 20), Size = UDim2.new(0, PANEL_WIDTH, 1, -76), Parent = self.Root })
	Widgets.Padding(18, 18, 16, 16).Parent = panel
	Widgets.Label({ Text = Strings.Get("Map.Title"), FontFace = Theme.Fonts.Display, TextSize = Theme.Text.Heading, Size = UDim2.new(1, -110, 0, 36), Parent = panel })
	Widgets.SmallButton(panel, { Name = "Back", Text = "‹  " .. Strings.Get("Settings.Back"), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), OnActivate = ctx.Back })

	self._destName = Widgets.Label({ FontFace = Theme.Fonts.Title, TextSize = Theme.Text.Body, Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = panel })
	self._destInfo = Widgets.Label({ FontFace = Theme.Fonts.Light, TextSize = Theme.Text.Small, TextColor3 = C.TextMuted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 36), Parent = panel })
	local buttons = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 36), Parent = panel }, { Widgets.List(8, true) })
	Widgets.SmallButton(buttons, { Text = Strings.Get("Map.Clear"), LayoutOrder = 1, OnActivate = function()
		self._nav:ClearDestination()
	end })
	Widgets.SmallButton(buttons, { Text = Strings.Get("Map.Recenter"), LayoutOrder = 2, OnActivate = function()
		self:_recenter()
	end })
	Widgets.SectionLabel(panel, Strings.Get("Map.Places"), 0, false).Position = UDim2.fromOffset(0, 160)
	self._list = new("ScrollingFrame", {
		Name = "Places", Position = UDim2.fromOffset(0, 186), Size = UDim2.new(1, 0, 1, -186), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 4, ScrollBarImageTransparency = 0.6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Selectable = false, Parent = panel,
	}, { Widgets.List(4) })

	self:_connectInput()
	self._nav.RouteChanged:Connect(function()
		self:_refreshCard()
		if self._canvas and self._shown then
			self._canvas:SetRoute(self._nav:GetRoute())
		else
			-- Harita kapalı: sürüşte her yeniden rotada gizli tuvaldeki rota parçalarını silip yeniden yaratma;
			-- harita açılınca bir kez çizilir.
			self._routeDirty = true
		end
	end)
	self._nav.DestinationChanged:Connect(function(destination)
		self:_refreshCard()
		if self._canvas then
			self._canvas:SetDestination(destination and destination.Position)
		end
	end)
	return self
end

-- ===== Yardımcılar =====
function MapScreen:_viewport(): Vector2
	local s = math.max(self._ctx.GetScale(), 0.01)
	return self._view.AbsoluteSize / s -- MapCanvas birimleri FrontEnd tuvalinin (UIScale öncesi) birimleridir
end

function MapScreen:_apply()
	if self._canvas then
		self._canvas:SetView(self._cx, self._cz, self._zoom, self:_viewport())
	end
end

function MapScreen:_recenter()
	local subject = self._nav:GetSubject()
	if subject then
		self._cx, self._cz = subject.Position.X, subject.Position.Z
	end
	self:_apply()
end

function MapScreen:_zoomAt(factor: number, localPoint: Vector2?)
	local viewport = self:_viewport()
	local point = localPoint or viewport / 2
	local wx, wz = self._canvas:ViewToWorld(point, self._cx, self._cz, viewport)
	self._zoom = math.clamp(self._zoom * factor, MIN_ZOOM, MAX_ZOOM)
	-- imlecin altındaki dünya noktası yerinde kalsın
	self._cx = wx - (point.X - viewport.X / 2) / self._zoom
	self._cz = wz - (point.Y - viewport.Y / 2) / self._zoom
	self:_apply()
end

function MapScreen:_selectAt(localPoint: Vector2)
	local viewport = self:_viewport()
	local x, z = self._canvas:ViewToWorld(localPoint, self._cx, self._cz, viewport)
	local poi = self._canvas:POINear(x, z, 16)
	if poi then
		self._nav:SetDestinationPOI(poi.Id)
	else
		self._nav:SetWaypoint(x, z)
	end
end

function MapScreen:_localFromScreen(screen: Vector3 | Vector2): Vector2
	local s = math.max(self._ctx.GetScale(), 0.01)
	local p = Vector2.new(screen.X, screen.Y) - self._view.AbsolutePosition
	return p / s
end

function MapScreen:_refreshCard()
	local destination = self._nav:GetDestination()
	local route = self._nav:GetRoute()
	local status = self._nav:GetStatus()
	if not destination then
		self._destName.Text = Strings.Get("Map.Title")
		self._destInfo.Text = Strings.Get(if status == "Arrived" then "Map.Arrived" else "Map.NoDestination")
		return
	end
	self._destName.Text = destination.Name or Strings.Get("Map.Waypoint")
	if route then
		local info = Strings.Get("Map.Route", Strings.Distance(route.Length))
		if route.Offroad then
			local last = route.Points[#route.Points]
			local gap = math.sqrt((route.Destination.X - last.X) ^ 2 + (route.Destination.Z - last.Z) ^ 2)
			info ..= "  ·  " .. Strings.Get("Map.Offroad", Strings.Distance(gap))
		end
		self._destInfo.Text = info
	elseif status == "NoRoadNearStart" then
		self._destInfo.Text = Strings.Get("Map.NoRoad")
	else
		self._destInfo.Text = Strings.Get("Map.Unreachable")
	end
end

-- Yerler listesi: oyuncuya uzaklığa göre (her açılışta yeniden sıralanır)
function MapScreen:_buildList()
	for _, child in self._list:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local subject = self._nav:GetSubject()
	local origin = if subject then subject.Position else Vector3.zero
	local entries = {}
	for _, poi in MapDefinitions.GetPOIs() do
		local d = (Vector3.new(poi.Entrance.X, 0, poi.Entrance.Z) - Vector3.new(origin.X, 0, origin.Z)).Magnitude
		table.insert(entries, { Poi = poi, Distance = d })
	end
	table.sort(entries, function(a, b)
		return a.Distance < b.Distance
	end)
	for i, entry in entries do
		local poi = entry.Poi
		local category = MapCanvas.POICategory[poi.Type] or "Landmark"
		local row = Widgets.HitButton({ Name = poi.Id, Size = UDim2.new(1, -8, 0, 40), BackgroundColor3 = C.SurfaceHigh, BackgroundTransparency = 0.6, LayoutOrder = i, Parent = self._list })
		Widgets.Corner(8).Parent = row
		new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = MapCanvas.CategoryColor[category], BorderSizePixel = 0, Parent = row }, { Widgets.Round() })
		Widgets.Label({ Text = poi.Name, FontFace = Theme.Fonts.Body, TextSize = Theme.Text.Small, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -100, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		Widgets.Label({ Text = Strings.Distance(entry.Distance), FontFace = Theme.Fonts.Mono, TextSize = Theme.Text.Tiny, TextColor3 = C.TextMuted, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(70, 40), Parent = row })
		row.Activated:Connect(function()
			self._nav:SetDestinationPOI(poi.Id)
			self._cx, self._cz = poi.Entrance.X, poi.Entrance.Z
			self:_apply()
		end)
	end
end

-- ===== Giriş =====
function MapScreen:_connectInput()
	local drag = nil -- { Input, Start (Vector2 ekran), Cx, Cz, Moved }
	self._view.InputBegan:Connect(function(io)
		if not self.Root.Visible or not self._canvas then
			return
		end
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			if drag == nil then
				drag = { Input = io, Start = Vector2.new(io.Position.X, io.Position.Y), Cx = self._cx, Cz = self._cz, Moved = false }
			end
		end
	end)
	self._view.InputChanged:Connect(function(io)
		if self.Root.Visible and self._canvas and io.UserInputType == Enum.UserInputType.MouseWheel then
			self:_zoomAt(if io.Position.Z > 0 then 1.2 else 1 / 1.2, self:_localFromScreen(io.Position))
		end
	end)
	UserInputService.InputChanged:Connect(function(io)
		if not drag then
			return
		end
		local mouse = drag.Input.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseMovement
		if mouse or io == drag.Input then
			local delta = Vector2.new(io.Position.X, io.Position.Y) - drag.Start
			if delta.Magnitude > 6 then
				drag.Moved = true
			end
			local s = math.max(self._ctx.GetScale(), 0.01)
			self._cx = drag.Cx - delta.X / s / self._zoom
			self._cz = drag.Cz - delta.Y / s / self._zoom
			self:_apply()
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if not drag then
			return
		end
		local mouse = drag.Input.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseButton1
		if mouse or io == drag.Input then
			local finished = drag
			drag = nil
			if not finished.Moved and self.Root.Visible then
				self:_selectAt(self:_localFromScreen(io.Position))
				self._ctx.OnMove()
			end
		end
	end)
	local lastPinch = nil
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if not self.Root.Visible or not self._canvas then
			return
		end
		if state == Enum.UserInputState.Begin then
			lastPinch = scale
			drag = nil -- iki parmak: kaydırma iptal
		elseif state == Enum.UserInputState.Change and lastPinch then
			self:_zoomAt(scale / math.max(lastPinch, 0.01))
			lastPinch = scale
		else
			lastPinch = nil
		end
	end)
end

-- FrontEnd MenuInput kancaları (klavye/gamepad)
function MapScreen:HandleNavigate(kind: string, dir: number): boolean
	if not self._canvas then
		return true
	end
	local step = PAN_STEP / self._zoom
	if kind == "Move" then
		self._cz += dir * step
	else
		self._cx += dir * step
	end
	self:_apply()
	return true
end

function MapScreen:HandleAccept(): boolean
	if self._canvas then
		self:_selectAt(self:_viewport() / 2)
	end
	return true
end

function MapScreen:HandleTab(dir: number): boolean
	if self._canvas then
		self:_zoomAt(if dir > 0 then 1.35 else 1 / 1.35)
	end
	return true
end

function MapScreen:SetCompact(compact: boolean)
	-- dar ekranda panel daha dar
	local width = if compact then 270 else PANEL_WIDTH
	self._view.Size = UDim2.new(1, -(width + 64), 1, -76)
	local panel = self.Root:FindFirstChild("Panel")
	if panel then
		(panel :: Frame).Size = UDim2.new(0, width, 1, -76)
	end
end

function MapScreen:OnShow()
	if not self._canvas then
		self._canvas = MapCanvas.new(self._view, { Detail = "Full" }) -- ilk açılışta bir kez çizilir
		self._canvas.Root.ZIndex = 1
		self._canvas:SetRoute(self._nav:GetRoute())
		local destination = self._nav:GetDestination()
		self._canvas:SetDestination(destination and destination.Position)
	elseif self._routeDirty then
		self._canvas:SetRoute(self._nav:GetRoute())
	end
	self._routeDirty = false
	self._shown = true
	self._crosshair.Visible = not self._ctx.IsTouch()
	self:_buildList()
	self:_refreshCard()
	self:_recenter()
	if self._render then
		self._render:Disconnect()
	end
	self._render = RunService.RenderStepped:Connect(function()
		local subject = self._nav:GetSubject()
		if subject and self._canvas then
			self._canvas:SetPlayer(subject.Position.X, subject.Position.Z, self._nav:GetHeading())
		end
	end)
	self.Focus:Refresh()
end

function MapScreen:OnHide()
	self._shown = false
	if self._render then
		self._render:Disconnect()
		self._render = nil
	end
end

return MapScreen
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4A5A6936N"><Properties>
<string name="Name">SettingsScreen</string>

<ProtectedString name="Source"><![CDATA[-- SettingsScreen: sekmeli ayarlar paneli. Satırlar Shared/SettingsSchema'dan ÜRETİLİR;
-- yeni ayar eklemek için bu dosyaya dokunmak gerekmez (şema + Strings yeter).
-- Değişiklikler anında uygulanır (SettingsController.Changed → ilgili sistemler).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEnd = script.Parent.Parent
local Theme = require(FrontEnd.Theme)
local Widgets = require(FrontEnd.Widgets)
local Strings = require(FrontEnd.Strings)
local Focus = require(FrontEnd.Focus)
local Maid = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Utilities"):WaitForChild("Maid"))

local C = Theme.Colors
local new = Widgets.new

local SettingsScreen = {}
SettingsScreen.__index = SettingsScreen

-- Sayısal ayarların gösterimi
local FORMAT = {
	CameraSensitivity = function(v)
		return string.format("%.1fx", v)
	end,
	FieldOfViewOffset = function(v)
		return (if v > 0 then "+" else "") .. tostring(math.floor(v + 0.5)) .. "°"
	end,
}
local function formatNumber(key: string, v: number): string
	local f = FORMAT[key]
	if f then
		return f(v)
	end
	return tostring(math.floor(v * 100 + 0.5)) .. "%" -- 0..1 hacimler
end

-- Kontroller sekmesindeki tuş listesi (salt okunur). Klavye | gamepad metinleri.
local BINDINGS = {
	{ "Bindings.Move", "W A S D", "LS" },
	{ "Bindings.Sprint", "Shift", "L3" },
	{ "Bindings.Walk", "Ctrl", "R3" },
	{ "Bindings.Camera", "V", "D-Pad Up" },
	{ "Bindings.Menu", "P", "D-Pad Left" },
	{ "Bindings.Enter", "F", "Y" },
	{ "Bindings.Drive", "W / S", "RT / LT" },
	{ "Bindings.Steer", "A / D", "LS" },
	{ "Bindings.Handbrake", "Space", "X" },
	{ "Bindings.Exit", "F", "Y" },
	{ "Bindings.Lights", "L", "D-Pad Down" },
	{ "Bindings.Indicators", "Q / E", "D-Pad Left / Right" },
	{ "Bindings.Horn", "H", "L3" },
	{ "Bindings.Flip", "R", "B" },
}

-- ctx: Parent, GetScale, OnMove, Settings (SettingsController), Back
function SettingsScreen.new(ctx)
	local self = setmetatable({}, SettingsScreen)
	self._ctx = ctx
	self._settings = ctx.Settings
	self._schema = ctx.Settings:GetSchema()
	self._categories = self._schema.Categories
	self._category = 1
	self._rowMaid = Maid.new()
	self._refreshers = {} :: { [string]: () -> () }
	self.Focus = Focus.new(ctx.GetScale, ctx.OnMove)

	self.Root = new("Frame", {
		Name = "SettingsScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ctx.Parent,
	})
	local panel = Widgets.Panel({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -64, 1, -48),
		Parent = self.Root,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(920, 660) }).Parent = panel
	Widgets.Padding(28, 28, 20, 18).Parent = panel

	-- Başlık + geri
	Widgets.Label({
		Name = "Title",
		Text = Strings.Get("Settings.Title"),
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Heading,
		Size = UDim2.new(1, -140, 0, 40),
		Parent = panel,
	})
	self._back = Widgets.SmallButton(panel, {
		Name = "Back",
		Text = "‹  " .. Strings.Get("Settings.Back"),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		OnActivate = ctx.Back,
	})

	-- Sekmeler
	local tabsHolder = new("Frame", {
		Name = "TabsHolder",
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, Theme.Size.Tab),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local labels = {}
	for i, category in self._categories do
		labels[i] = Strings.Get("Category." .. category)
	end
	self._tabs = Widgets.TabBar(tabsHolder, {
		Labels = labels,
		OnSelect = function(index)
			self:SelectCategory(index, true)
		end,
		OnHover = function(item)
			self.Focus:Hover(item)
		end,
	})

	-- Satır listesi
	self._scroller = new("ScrollingFrame", {
		Name = "Rows",
		Position = UDim2.fromOffset(0, 52 + Theme.Size.Tab + 12),
		Size = UDim2.new(1, 0, 1, -(52 + Theme.Size.Tab + 12 + 46)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.White,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
		Parent = panel,
	}, { Widgets.List(6), Widgets.Padding(0, 10, 2, 8) })

	-- Alt bilgi: sıfırla + kalıcılık notu
	local footer = new("Frame", {
		Name = "Footer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	self._reset = Widgets.SmallButton(footer, {
		Name = "Reset",
		Text = Strings.Get("Settings.Reset"),
		OnActivate = function()
			self._settings:ResetToDefaults(self._categories[self._category])
		end,
		OnHover = function(item)
			self.Focus:Hover(item)
		end,
	})
	Widgets.Label({
		Name = "PersistNote",
		Text = Strings.Get("Settings.PersistNote"),
		FontFace = Theme.Fonts.Light,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(1, -240, 1, 0),
		Parent = footer,
	})

	-- Başka yerden değişen ayar (ör. V tuşu, sıfırlama) satıra yansısın
	self._changedConn = self._settings.Changed:Connect(function(key)
		local refresh = self._refreshers[key]
		if refresh then
			refresh()
		end
	end)

	self:SelectCategory(1, false)
	return self
end

function SettingsScreen:_buildRows()
	self._rowMaid:Clean()
	table.clear(self._refreshers)
	local settings = self._settings
	local category = self._categories[self._category]
	local hover = function(item)
		self.Focus:Hover(item)
	end
	local items = { self._tabs.Item }
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local note = Strings.Get("Note." .. category)
	if note ~= "Note." .. category then
		self._rowMaid:Give(Widgets.SectionLabel(self._scroller, note, nextOrder(), true))
	end

	for _, def in self._schema.GetByCategory(category) do
		local opts = {
			Key = def.Key,
			Label = Strings.Get("Setting." .. def.Key),
			Desc = Strings.Get("Setting." .. def.Key .. ".Desc"),
			LayoutOrder = nextOrder(),
			Scroller = self._scroller,
			OnHover = hover,
			Get = function()
				return settings:Get(def.Key)
			end,
			Set = function(value)
				settings:Set(def.Key, value)
			end,
		}
		local widget
		if def.Type == "boolean" then
			opts.OnText = Strings.Get("Option.On")
			opts.OffText = Strings.Get("Option.Off")
			widget = Widgets.ToggleRow(self._scroller, opts)
		elseif def.Type == "enum" then
			opts.Options = def.Options
			opts.Format = function(value)
				return Strings.Option(def.Key, value)
			end
			widget = Widgets.StepperRow(self._scroller, opts)
		elseif def.Type == "number" then
			opts.Min, opts.Max, opts.Step = def.Min, def.Max, def.Step
			opts.Format = function(value)
				return formatNumber(def.Key, value)
			end
			widget = Widgets.SliderRow(self._scroller, opts)
		end
		if widget then
			self._rowMaid:Give(widget.Row)
			self._refreshers[def.Key] = widget.Refresh
			table.insert(items, widget.Item)
		end
	end

	if category == "Controls" then
		self._rowMaid:Give(Widgets.SectionLabel(self._scroller, Strings.Get("Bindings.Title"), nextOrder(), false))
		for _, b in BINDINGS do
			local info = Widgets.InfoRow(self._scroller, {
				Key = b[1],
				Label = Strings.Get(b[1]),
				Value = b[2] .. "   ·   " .. b[3],
				LayoutOrder = nextOrder(),
				Scroller = self._scroller,
				OnHover = hover,
			})
			self._rowMaid:Give(info.Row)
			table.insert(items, info.Item)
		end
	end

	table.insert(items, self._reset.Item)
	return items
end

-- keepTabFocus: sekme çubuğundan geçildiyse odak sekmede kalsın
function SettingsScreen:SelectCategory(index: number, keepTabFocus: boolean)
	index = math.clamp(index, 1, #self._categories)
	local changed = index ~= self._category or self._items == nil
	self._category = index
	self._tabs.SetSelected(index)
	if changed then
		self._items = self:_buildRows()
		self._scroller.CanvasPosition = Vector2.zero
		self.Focus:SetItems(self._items, if keepTabFocus then 1 else 2)
		if self._ctx.OnMove and keepTabFocus then
			self._ctx.OnMove()
		end
	end
end

function SettingsScreen:HandleTab(dir: number): boolean
	local index = self._category + dir
	if index >= 1 and index <= #self._categories then
		self:SelectCategory(index, self.Focus:GetIndex() == 1)
	end
	return true
end

function SettingsScreen:SetCompact(_compact: boolean) end

function SettingsScreen:OnShow()
	for _, refresh in self._refreshers do
		refresh()
	end
	self.Focus:Refresh()
end

function SettingsScreen:OnHide() end

return SettingsScreen
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBXACB8EB9BN"><Properties>
<string name="Name">Shell</string>

<ProtectedString name="Source"><![CDATA[-- Shell: ön yüzün TEK ScreenGui'si ve kalıcı katmanları.
--
--   SolaraFrontEnd (ScreenGui, ResetOnSpawn = false, ScreenInsets = None)
--     Backdrop      arka plan (yedek sahne + vignette)            — sadece menü açıkken görünür
--     Safe          Roblox üst çubuğu/çentik dışındaki alan          — sadece menü açıkken görünür
--       Canvas      UIScale ile ölçeklenen tasarım tuvali (ekranlar + alt bilgi)
--     MenuButton    dokunmatik ☰ (oyun içi menü)                    — küçük, tek başına
--     Toast         kısa bildirim                                   — Active değil
--     Veil          geçiş perdesi                                   — saydamken gizli
--
-- Menü kapalıyken ekranı kaplayan hiçbir çerçeve görünür değildir; böylece oyunun dokunmatik
-- kamera sürüklemesi ve butonları etkilenmez.

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrontEndConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FrontEndConfig"))
local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)
local Strings = require(script.Parent.Strings)
local Fader = require(script.Parent.Fader)
local Backdrop = require(script.Parent.Backdrop)

local C = Theme.Colors
local new = Widgets.new

local Shell = {}
Shell.__index = Shell

local GUI_NAME = "SolaraFrontEnd"

-- opts: OnPauseButton () -> (), OnLayout (compact: boolean) -> ()
function Shell.new(opts)
	local self = setmetatable({}, Shell)
	self._opts = opts
	self.Compact = false
	self._veilToken = 0
	self._toastToken = 0

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(GUI_NAME)
	if existing then
		existing:Destroy() -- olası eski kopya; ikinci bir ScreenGui asla tutulmaz
	end

	self.Gui = new("ScreenGui", {
		Name = GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = FrontEndConfig.DisplayOrder,
		AutoLocalize = false,
	})

	self.Backdrop = Backdrop.new(self.Gui)

	self.Safe = new("Frame", {
		Name = "Safe",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = self.Gui,
	})
	self.Canvas = new("Frame", {
		Name = "Canvas",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = self.Safe,
	})
	self.Scale = new("UIScale", { Parent = self.Canvas })

	-- Alt bilgi: sürüm (sol) + tuş ipuçları (sağ)
	self.Footer = new("Frame", {
		Name = "Footer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 3,
		Parent = self.Canvas,
	}, { Widgets.Padding(32, 32, 0, 0) })
	self._version = Widgets.Label({
		Name = "Version",
		FontFace = Theme.Fonts.Light,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.TextDim,
		Size = UDim2.new(0.4, 0, 1, 0),
		Parent = self.Footer,
	})
	self._hints = new("Frame", {
		Name = "Hints",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.6, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = self.Footer,
	}, { Widgets.List(18, true, Enum.HorizontalAlignment.Right) })

	-- Bildirim (ölçek elle; Safe gizliyken de görünmeli)
	self._toast = new("Frame", {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 5,
		Parent = self.Gui,
	}, { Widgets.Round(), Widgets.Stroke(C.Accent, 0.5), Widgets.Padding(20, 20, 0, 0) })
	self._toastLabel = Widgets.Label({
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small + 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Parent = self._toast,
	})

	-- Dokunmatik ☰: oyun içinde menüyü açar
	self.PauseButton = Widgets.HitButton({
		Name = "MenuButton",
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 3,
		Parent = self.Gui,
	})
	self._pauseScale = new("UIScale", { Parent = self.PauseButton })
	Widgets.Round().Parent = self.PauseButton
	Widgets.Stroke(C.White, 0.7).Parent = self.PauseButton
	for i = -1, 1 do
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, i * 7),
			Size = UDim2.fromOffset(18, 2),
			BackgroundColor3 = C.Text,
			BorderSizePixel = 0,
			Parent = self.PauseButton,
		}, { Widgets.Corner(1) })
	end
	self.PauseButton.Activated:Connect(function()
		opts.OnPauseButton()
	end)

	-- Perde: başlangıçta opak (menü kurulurken boş dünya görünmesin)
	self._veil = new("Frame", {
		Name = "Veil",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 20,
		Parent = self.Gui,
	})

	self.Gui.Parent = playerGui
	self:UpdateLayout()
	self.Safe:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:UpdateLayout()
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
			self:UpdateLayout()
		end)
	end)
	return self
end

function Shell:GetScale(): number
	return self.Scale.Scale
end

-- Güvenli alan + tasarım ölçeği. Masaüstü tasarımı 1280×720, kompakt (telefon) 900×500.
function Shell:UpdateLayout()
	local topLeft, bottomRight = GuiService:GetGuiInset()
	self.Safe.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
	self.Safe.Size = UDim2.new(1, -(topLeft.X + bottomRight.X), 1, -(topLeft.Y + bottomRight.Y))
	local size = self.Safe.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		return
	end
	local compact = size.Y < 560 or size.X < 900
	local s = if compact then math.min(size.X / 900, size.Y / 500) else math.min(size.X / 1280, size.Y / 720)
	s = math.clamp(s, 0.5, 1.6)
	self.Scale.Scale = s
	self.Canvas.Size = UDim2.fromScale(1 / s, 1 / s)
	-- Sağ üst (sol üst köşe haritasına ait)
	local width = self.Gui.AbsoluteSize.X
	self.PauseButton.Position = UDim2.fromOffset(width - bottomRight.X - math.floor(60 * s), topLeft.Y + math.floor(10 * s))
	self._pauseScale.Scale = s
	self._toast.Position = UDim2.new(0.5, 0, 1, -(bottomRight.Y + math.floor(90 * s)))
	self._toast.Size = UDim2.fromOffset(0, math.floor(40 * s))
	self._toastLabel.TextSize = math.max(12, math.floor((Theme.Text.Small + 1) * s))
	if compact ~= self.Compact then
		self.Compact = compact
	end
	self._opts.OnLayout(compact)
end

-- Menü katmanlarını göster/gizle (Safe gizliyken tam ekran çerçeve kalmaz)
function Shell:SetMenuShown(shown: boolean, seconds: number)
	self._menuShown = shown
	if shown then
		self.Safe.Visible = true
		Fader.Fade(self.Backdrop.Root, true, seconds, 0)
		Fader.Fade(self.Footer, true, seconds, 0)
	else
		Fader.Fade(self.Footer, false, seconds, 0)
		Fader.Fade(self.Backdrop.Root, false, seconds, 0)
		task.delay(seconds, function()
			if not self._menuShown then
				self.Safe.Visible = false
			end
		end)
	end
end

-- Perde: geçişlerde ekranı karartır; tamamen saydamken gizlenir
function Shell:SetVeil(opaque: boolean, seconds: number)
	self._veilToken += 1
	local token = self._veilToken
	self._veil.Visible = true
	Fader.Tween(self._veil, { BackgroundTransparency = if opaque then 0 else 1 }, seconds)
	if not opaque then
		task.delay(seconds, function()
			if token == self._veilToken then
				self._veil.Visible = false
			end
		end)
	end
end

function Shell:Toast(text: string, fadeSeconds: number)
	self._toastToken += 1
	local token = self._toastToken
	self._toastLabel.Text = text
	Fader.Fade(self._toast, true, fadeSeconds, 0)
	task.delay(2.6, function()
		if token == self._toastToken then
			Fader.Fade(self._toast, false, fadeSeconds, 0)
		end
	end)
end

function Shell:SetVersion(text: string)
	self._version.Text = text
end

function Shell:SetPauseButtonVisible(visible: boolean)
	self.PauseButton.Visible = visible
end

-- device: "KeyboardMouse" | "Gamepad" | "Touch"; screen: "Main" | "Settings" | "Garage"
function Shell:SetHints(device: string, screen: string?, paused: boolean)
	for _, child in self._hints:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if device == "Touch" or screen == nil then
		return
	end
	local pad = device == "Gamepad"
	local order = 0
	local function hint(key: string, labelKey: string)
		order += 1
		Widgets.KeyHint(self._hints, key, Strings.Get(labelKey), order, pad and #key == 1)
	end
	if screen == "Settings" then
		hint(if pad then "LB RB" else "Q E", "Hint.Tabs")
		hint(if pad then "D-Pad" else "A D", "Hint.Adjust")
	end
	if screen == "Map" then
		hint(if pad then "LB RB" else "Q E", "Hint.Zoom")
		hint(if pad then "A" else "Enter", "Hint.SetDestination")
		hint(if pad then "B" else "Backspace", "Hint.Back")
		return
	end
	hint(if pad then "A" else "Enter", "Hint.Select")
	if screen ~= "Main" then
		hint(if pad then "B" else "Backspace", "Hint.Back")
	elseif paused then
		hint(if pad then "B" else "P", "Hint.Close")
	end
end

return Shell
]]></ProtectedString>
</Properties>
</Item>
