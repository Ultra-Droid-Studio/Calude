		Width = 2, Length = 7.6, WheelRadius = 1.3, WheelWidth = 0.9, Wheelbase = 6, Clearance = 0.5, Travel = 0.9,
		Mass = 30, MaxSpeed = 120, ReverseSpeed = 8, Accel = 40, Brake = 80, MaxSteer = 26, MinSteer = 5, Grip = 1.45,
