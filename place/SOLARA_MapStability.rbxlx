<Item class="ModuleScript" referent="RBX0000000E"><Properties>
<string name="Name">MapDefinitions</string>

<ProtectedString name="Source"><![CDATA[-- MapDefinitions: dünyanın TEK koordinat kaynağı (Bölüm 3.3).
-- Dünya inşacısı, minimap, tam ekran harita, GPS, trafik ve yaya sistemleri bu modülü okur.
-- Veri tools/mapgen.py tarafından üretilen MapData'dan bir kez ayrıştırılır ve önbelleğe alınır.

local MapData = require(script.Parent.MapData)

local MapDefinitions = {}

export type District = {
	Id: string, Name: string, Type: string,
	Min: Vector2, Max: Vector2, -- (x, z)
	DayDensity: number, NightDensity: number,
}
export type Node = {
	Id: number, Position: Vector3,
	Signal: boolean, Stop: boolean, Crosswalk: boolean, Elevated: boolean,
	Edges: { number },
}
export type Edge = {
	Id: number, A: number, B: number, Kind: string, Width: number,
	LanesForward: number, LanesBackward: number, Speed: number, Name: string,
	Bridge: boolean, Sidewalk: boolean, Length: number,
	BridgeSpan: { number }?, -- köprünün su üstündeki bölümü (0..1 kenar oranı)
}
export type Lot = {
	Id: number, District: string, Style: string, Use: string,
	Center: Vector3, Width: number, Depth: number, Rotation: number, Height: number,
	Seed: number, PoiId: string?, BaseY: number,
}
export type POI = {
	Id: string, Type: string, Name: string, Position: Vector3, Entrance: Vector3,
	District: string, LotId: number,
}

local parsed = nil

local function num(s: string): number
	return tonumber(s) or 0
end

local function parse()
	local data = {
		Meta = {},
		Districts = {} :: { District },
		DistrictById = {} :: { [string]: District },
		Nodes = {} :: { [number]: Node },
		NodeList = {} :: { Node },
		Edges = {} :: { [number]: Edge },
		EdgeList = {} :: { Edge },
		Blocks = {},
		Lots = {} :: { Lot },
		POIs = {} :: { POI },
		POIById = {} :: { [string]: POI },
		Props = {},
		Hills = {},
		Ground = {},
		Water = {},
		Spawns = {},
		Coast = {},
		VehicleSpots = {},
	}

	for line in string.gmatch(MapData, "[^\n]+") do
		local f = string.split(line, "|")
		local t = f[1]
		if t == "N" then
			local flags = f[6] or ""
			local n: Node = {
				Id = num(f[2]),
				Position = Vector3.new(num(f[3]), num(f[4]), num(f[5])),
				Signal = string.find(flags, "s", 1, true) ~= nil,
				Stop = string.find(flags, "t", 1, true) ~= nil,
				Crosswalk = string.find(flags, "c", 1, true) ~= nil,
				Elevated = string.find(flags, "f", 1, true) ~= nil,
				Edges = {},
			}
			data.Nodes[n.Id] = n
			table.insert(data.NodeList, n)
		elseif t == "E" then
			-- Satır biçimi: E|id|a|b|tür|genişlik|ileri|geri|hız|ad|bayraklar|köprü0|köprü1
			-- (Düzeltme, kullanıcı onayıyla: bayraklar eskiden f[12], köprü aralığı f[13..14] okunuyordu →
			-- kaldırımlar ve köprü korkulukları hiç üretilmiyordu.)
			local flags = f[11] or ""
			local e: Edge = {
				Id = num(f[2]), A = num(f[3]), B = num(f[4]), Kind = f[5], Width = num(f[6]),
				LanesForward = num(f[7]), LanesBackward = num(f[8]), Speed = num(f[9]), Name = f[10] or "",
				Bridge = string.find(flags, "b", 1, true) ~= nil,
				Sidewalk = string.find(flags, "w", 1, true) ~= nil,
				Length = 0,
				BridgeSpan = if f[12] and f[12] ~= "" then { num(f[12]), num(f[13]) } else nil,
			}
			data.Edges[e.Id] = e
			table.insert(data.EdgeList, e)
		elseif t == "L" then
			table.insert(data.Lots, {
				Id = num(f[2]), District = f[3], Style = f[4], Use = f[5],
				Center = Vector3.new(num(f[6]), 0, num(f[7])), Width = num(f[8]), Depth = num(f[9]),
				Rotation = num(f[10]), Height = num(f[11]), Seed = num(f[12]),
				PoiId = if f[13] ~= nil and f[13] ~= "" then f[13] else nil,
				BaseY = num(f[14]),
			})
		elseif t == "P" then
			local p: POI = {
				Id = f[2], Type = f[3], Name = f[4],
				Position = Vector3.new(num(f[5]), 0, num(f[6])),
				Entrance = Vector3.new(num(f[7]), 0, num(f[8])),
				District = f[9], LotId = num(f[10]),
			}
			table.insert(data.POIs, p)
			data.POIById[p.Id] = p
		elseif t == "X" then
			table.insert(data.Props, { Kind = f[2], X = num(f[3]), Z = num(f[4]), Yaw = num(f[5]), Y = num(f[6]), Extra = f[7] or "", Extra2 = f[8] })
		elseif t == "B" then
			table.insert(data.Blocks, { District = f[2], X0 = num(f[3]), Z0 = num(f[4]), X1 = num(f[5]), Z1 = num(f[6]), Material = f[7] })
		elseif t == "D" then
			local d: District = {
				Id = f[2], Name = f[3], Type = f[4],
				Min = Vector2.new(num(f[5]), num(f[6])), Max = Vector2.new(num(f[7]), num(f[8])),
				DayDensity = num(f[9]), NightDensity = num(f[10]),
			}
			table.insert(data.Districts, d)
			data.DistrictById[d.Id] = d
		elseif t == "H" then
			table.insert(data.Hills, { X = num(f[2]), Z = num(f[3]), Radius = num(f[4]), CenterY = num(f[5]) })
		elseif t == "G" then
			table.insert(data.Ground, { X0 = num(f[2]), Z0 = num(f[3]), X1 = num(f[4]), Z1 = num(f[5]) })
		elseif t == "W" then
			table.insert(data.Water, { Kind = f[2], X0 = num(f[3]), Z0 = num(f[4]), X1 = num(f[5]), Z1 = num(f[6]) })
		elseif t == "V" then
			table.insert(data.VehicleSpots, { DefId = f[2], Position = Vector3.new(num(f[3]), 0, num(f[4])), Yaw = num(f[5]) })
		elseif t == "Q" then
			table.insert(data.Coast, { Kind = f[2], X0 = num(f[3]), Z0 = num(f[4]), X1 = num(f[5]), Z1 = num(f[6]), Dir = f[7] or "" })
		elseif t == "S" then
			table.insert(data.Spawns, { Group = f[2], Position = Vector3.new(num(f[3]), 0, num(f[4])), Yaw = num(f[5]) })
		elseif t == "M" then
			data.Meta = {
				HalfSize = num(f[2]), RoadTop = num(f[3]), BlockTop = num(f[4]), Sidewalk = num(f[5]),
				FreewayHeight = num(f[6]), CoastX = num(f[7]), BeachZ0 = num(f[8]), BeachZ1 = num(f[9]),
				RiverX0 = num(f[10]), RiverX1 = num(f[11]), BayX = num(f[12]), BayZ = num(f[13]),
			}
		end
	end

	-- Komşuluk ve uzunluklar
	for _, e in data.EdgeList do
		local a, b = data.Nodes[e.A], data.Nodes[e.B]
		if a and b then
			e.Length = (b.Position - a.Position).Magnitude
			table.insert(a.Edges, e.Id)
			table.insert(b.Edges, e.Id)
		end
	end
	return data
end

local function get()
	if not parsed then
		parsed = parse()
	end
	return parsed
end

-- ===== Genel API =====
function MapDefinitions.GetData()
	return get()
end

function MapDefinitions.GetMeta()
	return get().Meta
end

function MapDefinitions.GetBounds(): (Vector2, Vector2)
	local h = get().Meta.HalfSize
	return Vector2.new(-h, -h), Vector2.new(h, h)
end

-- Dünya konumu → harita koordinatı (0..1). Minimap ve tam harita bunu kullanır.
function MapDefinitions.WorldToMap(position: Vector3): Vector2
	local h = get().Meta.HalfSize
	return Vector2.new((position.X + h) / (2 * h), (position.Z + h) / (2 * h))
end

function MapDefinitions.MapToWorld(uv: Vector2): Vector3
	local h = get().Meta.HalfSize
	return Vector3.new(uv.X * 2 * h - h, 0, uv.Y * 2 * h - h)
end

function MapDefinitions.GetDistricts(): { District }
	return get().Districts
end

function MapDefinitions.GetDistrict(id: string): District?
	return get().DistrictById[id]
end

-- Önce kentsel bölgeler (listede önce gelir), sonra kırsal
function MapDefinitions.GetDistrictAt(position: Vector3): District?
	for _, d in get().Districts do
		if position.X >= d.Min.X and position.X <= d.Max.X and position.Z >= d.Min.Y and position.Z <= d.Max.Y then
			return d
		end
	end
	return nil
end

function MapDefinitions.GetNode(id: number): Node?
	return get().Nodes[id]
end

function MapDefinitions.GetEdge(id: number): Edge?
	return get().Edges[id]
end

function MapDefinitions.GetNodes(): { Node }
	return get().NodeList
end

function MapDefinitions.GetEdges(): { Edge }
	return get().EdgeList
end

-- Bir düğümün komşuları: { { Node = id, Edge = id, CanTravel = bool } }
-- CanTravel: tek yönlü yollarda (rampalar) bu yönde gidilebilir mi
function MapDefinitions.GetNeighbors(nodeId: number)
	local data = get()
	local node = data.Nodes[nodeId]
	local list = {}
	if not node then
		return list
	end
	for _, edgeId in node.Edges do
		local e = data.Edges[edgeId]
		local forward = e.A == nodeId
		local other = if forward then e.B else e.A
		local canTravel = if forward then e.LanesForward > 0 else e.LanesBackward > 0
		table.insert(list, { Node = other, Edge = edgeId, CanTravel = canTravel })
	end
	return list
end

function MapDefinitions.GetNearestNode(position: Vector3, filter: ((Node) -> boolean)?): Node?
	local best, bestDist = nil, math.huge
	for _, n in get().NodeList do
		if not filter or filter(n) then
			local d = (n.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = n, d
			end
		end
	end
	return best
end

function MapDefinitions.GetLots(): { Lot }
	return get().Lots
end

function MapDefinitions.GetPOIs(): { POI }
	return get().POIs
end

function MapDefinitions.GetPOI(id: string): POI?
	return get().POIById[id]
end

function MapDefinitions.GetPOIsByType(poiType: string): { POI }
	local list = {}
	for _, p in get().POIs do
		if p.Type == poiType then
			table.insert(list, p)
		end
	end
	return list
end

function MapDefinitions.GetSpawns(group: string?)
	local list = {}
	for _, s in get().Spawns do
		if group == nil or s.Group == group then
			table.insert(list, s)
		end
	end
	return list
end

-- Park halindeki araç noktaları (Aşama 3 VehicleService)
function MapDefinitions.GetVehicleSpots()
	return get().VehicleSpots
end

-- Dükkân tipleri (Aşama 7 ShopService bunları kullanacak)
MapDefinitions.ShopTypes = table.freeze({
	supermarket = true, convenience = true, grocery = true, restaurant = true,
	fastfood = true, cafe = true, gas = true, general = true,
})

return MapDefinitions
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties>
<string name="Name">RemoteRegistry</string>

<ProtectedString name="Source"><![CDATA[-- RemoteRegistry: TÜM remote'ların tek tanım noktası (Bölüm 25 / 26).
-- Sunucu :Build() ile ReplicatedStorage.Remotes altında oluşturur,
-- istemci :Get(grup, isim) ile bekleyerek alır. Elle remote oluşturmak yasak.
--
-- Yön etiketi sadece dokümantasyon içindir:
--   C2S = istemci → sunucu (sunucu MUTLAKA doğrular)
--   S2C = sunucu → istemci

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteRegistry = {}

RemoteRegistry.Definitions = {
	PlayerRemotes = {
		ClientReady = { Class = "RemoteEvent", Direction = "C2S" }, -- istemci yüklendi
		SessionInfo = { Class = "RemoteEvent", Direction = "S2C" }, -- mod, sürüm, sunucu saati
		Notify = { Class = "RemoteEvent", Direction = "S2C" }, -- kısa bildirim metni
		-- Ana menü (Aşama 1 / ön yüz): karakter artık otomatik doğmaz; "OYNA" ile sunucudan istenir.
		RequestSpawn = { Class = "RemoteEvent", Direction = "C2S" }, -- doğ / etkinleş (sunucu doğrular, tek karakter)
		SpawnStatus = { Class = "RemoteEvent", Direction = "S2C" }, -- (durum, ayrıntı): "Queued" | "Spawned" | "Rejected"
	},
	-- Aşağıdaki gruplar sonraki aşamalarda doldurulacak; klasörleri şimdiden açılıyor
	VehicleRemotes = {
		RequestExit = { Class = "RemoteEvent", Direction = "C2S" }, -- araçtan in
		DriveState = { Class = "RemoteEvent", Direction = "C2S" }, -- far/sinyal/fren/korna durumu (sadece sürücü)
		RequestFlip = { Class = "RemoteEvent", Direction = "C2S" }, -- ters dönen aracı düzelt
	},
	NPCRemotes = {},
	ShopRemotes = {},
	InventoryRemotes = {},
	TradeRemotes = {},
	MultiplayerRemotes = {},
}

local ROOT_NAME = "Remotes"

function RemoteRegistry.Build()
	assert(RunService:IsServer(), "RemoteRegistry.Build sadece sunucuda çağrılır")
	local root = ReplicatedStorage:FindFirstChild(ROOT_NAME)
	if not root then
		root = Instance.new("Folder")
		root.Name = ROOT_NAME
		root.Parent = ReplicatedStorage
	end
	for groupName, remotes in RemoteRegistry.Definitions do
		local group = root:FindFirstChild(groupName)
		if not group then
			group = Instance.new("Folder")
			group.Name = groupName
			group.Parent = root
		end
		for remoteName, def in remotes do
			local existing = group:FindFirstChild(remoteName)
			if existing and existing.ClassName ~= def.Class then
				existing:Destroy()
				existing = nil
			end
			if not existing then
				local remote = Instance.new(def.Class)
				remote.Name = remoteName
				remote.Parent = group
			end
		end
	end
	return root
end

-- İstemci ve sunucu ikisi de kullanabilir. Tanımda olmayan bir remote istenirse hata verir
-- (yazım hatası sessizce sonsuz beklemeye dönüşmesin).
function RemoteRegistry.Get(groupName: string, remoteName: string, timeout: number?): Instance
	local group = RemoteRegistry.Definitions[groupName]
	assert(group, "Bilinmeyen remote grubu: " .. tostring(groupName))
	assert(group[remoteName], "Bilinmeyen remote: " .. groupName .. "." .. tostring(remoteName))

	local waitTime = timeout or 30
	local root = ReplicatedStorage:WaitForChild(ROOT_NAME, waitTime)
	assert(root, "Remotes klasörü bulunamadı (sunucu Build etmedi mi?)")
	local folder = root:WaitForChild(groupName, waitTime)
	assert(folder, "Remote grubu oluşmadı: " .. groupName)
	local remote = folder:WaitForChild(remoteName, waitTime)
	assert(remote, "Remote oluşmadı: " .. groupName .. "." .. remoteName)
	return remote
end

return RemoteRegistry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties>
<string name="Name">Types</string>

<ProtectedString name="Source"><![CDATA[-- Types: sistemler arası paylaşılan Luau tipleri.

export type GameMode = "Normal" | "Sandbox"
export type RigType = "R6" | "R15"
export type MovementState = "Walk" | "Run" | "Sprint"
export type DeviceType = "KeyboardMouse" | "Touch" | "Gamepad"

export type CameraProfile = {
	Distance: number,
	MinDistance: number,
	MaxDistance: number,
	ShoulderOffset: Vector3, -- X: sağ/sol omuz, Y: pivot üstü yükseklik
	FieldOfView: number,
	MinPitch: number, -- derece
	MaxPitch: number, -- derece
	FollowSharpness: number, -- pivot takibi (yüksek = daha sıkı)
	RotationSharpness: number,
	CollisionRadius: number,
	HideCharacter: boolean,
	SprintFovBoost: number,
	-- Sürüş kamerası (Aşama 3; sadece araç profillerinde)
	VerticalSharpness: number?,
	RoofClearance: number?,
	LengthFactor: number?,
	DistancePad: number?,
	AutoFollowSharpness: number?,
	AutoPitch: number?,
	PitchFollow: number?,
	RollFollow: number?,
	SpeedFovBoost: number?,
	SpeedDistanceBoost: number?,
}

export type SessionInfo = {
	GameMode: GameMode,
	Version: string,
	ServerTime: number,
}

-- ModuleScript tam olarak bir değer döndürmeli; tipler `Types.X` şeklinde kullanılır.
return {}
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00000011"><Properties>
<string name="Name">Utilities</string>

</Properties>
<Item class="ModuleScript" referent="RBX00000012"><Properties>
<string name="Name">Log</string>

<ProtectedString name="Source"><![CDATA[-- Log: sistem adıyla etiketlenmiş çıktı. Output penceresinde hangi sistemin ne dediği belli olur.

local RunService = game:GetService("RunService")
local Config = require(script.Parent.Parent.Config)

local Log = {}

local side = if RunService:IsServer() then "S" else "C"

function Log.new(systemName: string)
	local prefix = string.format("[%s][%s]", side, systemName)
	local logger = {}
	function logger.Info(...: any)
		if Config.Debug.VerboseLogging then
			print(prefix, ...)
		end
	end
	function logger.Warn(...: any)
		warn(prefix, ...)
	end
	function logger.Error(...: any)
		-- error() fırlatmaz; sadece kırmızı olmadan görünür uyarı + traceback
		warn(prefix, "ERROR:", ...)
		warn(debug.traceback(nil, 2))
	end
	return table.freeze(logger)
end

return Log
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties>
<string name="Name">Maid</string>

<ProtectedString name="Source"><![CDATA[-- Maid: bağlantıları, instance'ları ve temizlik fonksiyonlarını tek yerde toplar.
-- Karakter ölünce / sistem kapanınca :Clean() çağrılır → bellek sızıntısı olmaz (Bölüm 27.5).

export type Task = RBXScriptConnection | Instance | (() -> ()) | { Destroy: (any) -> () }

local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable({} :: { _tasks: { [any]: Task } }, Maid))

function Maid.new(): Maid
	return setmetatable({ _tasks = {} }, Maid)
end

local function cleanTask(task: any)
	local kind = typeof(task)
	if kind == "RBXScriptConnection" then
		task:Disconnect()
	elseif kind == "Instance" then
		task:Destroy()
	elseif kind == "function" then
		local ok, err = pcall(task)
		if not ok then
			warn("[Maid] cleanup function error:", err)
		end
	elseif kind == "table" and typeof(task.Destroy) == "function" then
		task:Destroy()
	end
end

-- Anonim görev ekler, görevi geri döndürür.
function Maid.Give(self: Maid, task: Task): Task
	table.insert(self._tasks, task)
	return task
end

-- İsimli görev: aynı isimle yenisi verilince eskisi temizlenir.
function Maid.Set(self: Maid, name: string, task: Task?)
	local old = self._tasks[name]
	if old ~= nil and old ~= task then
		self._tasks[name] = nil
		cleanTask(old)
	end
	self._tasks[name] = task
end

function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for _, task in tasks do
		cleanTask(task)
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties>
<string name="Name">MathUtil</string>

<ProtectedString name="Source"><![CDATA[-- MathUtil: kamera ve hareket için kare hızından bağımsız yumuşatma yardımcıları.

local MathUtil = {}

-- Kare hızından bağımsız üstel yaklaşım katsayısı. sharpness büyüdükçe hedefe hızlı varır.
function MathUtil.SmoothAlpha(sharpness: number, dt: number): number
	return 1 - math.exp(-sharpness * dt)
end

function MathUtil.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Açıyı (radyan) en kısa yoldan yaklaştırır
function MathUtil.LerpAngle(a: number, b: number, t: number): number
	local diff = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + diff * t
end

function MathUtil.FlatVector(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

return MathUtil
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties>
<string name="Name">RateLimiter</string>

<ProtectedString name="Source"><![CDATA[-- RateLimiter: oyuncu başına token-bucket. Hassas remote'lar için (Bölüm 26).
-- Örnek: RateLimiter.new(5, 1) → saniyede 1 dolan, en fazla 5 birikebilen hak.

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type RateLimiter = typeof(setmetatable(
	{} :: { _capacity: number, _refillPerSecond: number, _buckets: { [any]: { tokens: number, last: number } } },
	RateLimiter
))

function RateLimiter.new(capacity: number, refillPerSecond: number): RateLimiter
	return setmetatable({
		_capacity = capacity,
		_refillPerSecond = refillPerSecond,
		_buckets = {},
	}, RateLimiter)
end

-- true → işleme izin ver, false → reddet
function RateLimiter.Check(self: RateLimiter, key: any, cost: number?): boolean
	local now = os.clock()
	local bucket = self._buckets[key]
	if not bucket then
		bucket = { tokens = self._capacity, last = now }
		self._buckets[key] = bucket
	end
	local elapsed = now - bucket.last
	bucket.tokens = math.min(self._capacity, bucket.tokens + elapsed * self._refillPerSecond)
	bucket.last = now
	local price = cost or 1
	if bucket.tokens >= price then
		bucket.tokens -= price
		return true
	end
	return false
end

-- Oyuncu ayrılınca çağrılır (bellek temizliği)
function RateLimiter.Forget(self: RateLimiter, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties>
<string name="Name">Signal</string>

<ProtectedString name="Source"><![CDATA[-- Signal: modüller arası hafif olay sistemi (BindableEvent'e gerek kalmadan).
-- Her dinleyici kendi thread'inde çalışır; biri hata verirse diğerleri etkilenmez.

local Signal = {}
Signal.__index = Signal

export type Connection = { Connected: boolean, Disconnect: (Connection) -> () }
export type Signal = typeof(setmetatable({} :: { _handlers: { [number]: any } }, Signal))

function Signal.new(): Signal
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	local handler = { fn = fn, Connected = true }
	table.insert(self._handlers, handler)
	local handlers = self._handlers
	local connection = {} :: any
	connection.Connected = true
	function connection.Disconnect(conn: Connection)
		if not conn.Connected then
			return
		end
		conn.Connected = false
		handler.Connected = false
		local index = table.find(handlers, handler)
		if index then
			table.remove(handlers, index)
		end
	end
	return connection
end

function Signal.Once(self: Signal, fn: (...any) -> ()): Connection
	local connection: Connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal.Fire(self: Signal, ...: any)
	-- Kopya üzerinden dön: dinleyici çalışırken bağlantı kopsa da döngü bozulmaz.
	for _, handler in table.clone(self._handlers) do
		if handler.Connected then
			task.spawn(handler.fn, ...)
		end
	end
end

function Signal.Wait(self: Signal): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: Signal)
	for _, handler in self._handlers do
		handler.Connected = false
	end
	table.clear(self._handlers)
end

Signal.Destroy = Signal.DisconnectAll

return Signal
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties>
<string name="Name">VehicleDefinitions</string>

<ProtectedString name="Source"><![CDATA[-- VehicleDefinitions: tüm araç ve motosiklet modellerinin veri tanımı (Bölüm 8 / 9).
-- Yeni araç eklemek = buraya bir tablo eklemek. Fizik değerleri birim olarak:
--   uzunluk: stud, hız: stud/sn (≈ km/s göstergesi için x1), ivme: stud/sn², açı: derece, kütle: Roblox kütle birimi.
-- İsimler ve tasarımlar özgündür.

local VehicleDefinitions = {}

-- Tekerlek motoru yön işareti: Hinge ekseni aracın sağına (+X) bakar; ileri sürüş için açısal hız negatif.
-- Studio testinde araç geri gidiyorsa bunu 1 yapmak yeterli.
VehicleDefinitions.DriveSign = -1

local rgb = Color3.fromRGB

-- ======================= OTOMOBİL FİZİK MODELİ (Aşama 2) =======================
-- Birim politikası: 1 stud = 0.28 m (HUD km/s göstergesiyle aynı). Karakterler Roblox'un 196.2 stud/sn²
-- yerçekimini kullanmaya devam eder; OTOMOBİLLER ise kendilerine uygulanan kaldırma kuvvetiyle
-- "EffectiveGravity" altında yaşar. Böylece yay frekansı, yük transferi, lastik tutuşu ve fren mesafesi
-- gerçek dünya değerleriyle aynı ölçekte tasarlanabilir. Motosikletler bu modelin DIŞINDADIR (eski fizik).
-- Ayrıntılı açıklama: docs/SOLARA_Phase2_CarPhysics.md
VehicleDefinitions.MetersPerStud = 0.28

VehicleDefinitions.CarPhysics = {
	-- Araçlara etkiyen yerçekimi (stud/sn²). Gerçek 1 g = 9.81 / 0.28 = 35.0 stud/sn².
	-- 42 = 1.2 g: biraz daha "tok" süspansiyon ve tutuş; atlamalar aşırı süzülmez.
	EffectiveGravity = 42,
	RollingResistance = 0.012, -- × g (asfalt). Zemin tablosu çarpar.
	MinSlipSpeed = 1.5, -- stud/sn: kalkışta tekerin zeminden hızlı dönebileceği en küçük fark
	AbsSlip = 0.10, -- ABS'in izin verdiği kayma oranı (tekerlek kilitlenmez → direksiyon çalışır)
	KineticGrip = 0.82, -- kayma başlayınca tutuş katsayısı (statik → kinetik)
	SlideEnterAngle = 9, -- derece: bu kayma açısından sonra teker "kayıyor" sayılır
	SlideExitAngle = 5, -- derece: altına inince tutuş geri gelir (histerezis)
	SlideEnterRatio = 0.22, -- boyuna kayma oranı (patinaj / kilit) eşiği
	SlideExitRatio = 0.10,
	LoadSensitivity = 0.12, -- yük arttıkça μ azalır (gerçek lastik davranışı; viraj dengesini yük transferine bağlar)
	AckermannFactor = 0.6, -- 0 = paralel teker, 1 = tam Ackermann
	BumpFraction = 0.6, -- süspansiyon kursunun sürüş yüksekliğinin ÜSTÜNDE kalan payı
	GearSpread = 0.7, -- vites üst hızları: üst × (i/N)^0.7 (alt vitesler kısa)
	BallastFraction = 0.35, -- şasi kütlesinin ağırlık dağılımı için kaydırılan kısmı
	HoldSpeed = 0.8, -- stud/sn: bunun altında gaz yoksa araç yerinde tutulur (yokuşta kaymaz)
	EngineBrakeG = 0.035, -- gaz kesilince motor freni
	ReverseSpeed = 0.9, -- tanımdaki ReverseSpeed çarpanı
	ReverseG = 0.28,
	ShiftCut = 0.2, -- vites değişimi sırasında kalan çekiş oranı
	SurfaceProbeInterval = 1, -- her karede bir teker; 4 tekerli araçta tekerlek başına ~15 Hz zemin okuması
}

-- Otomobil "Physics" alanları (her biri tek bir fiziksel anlam taşır; hepsi VehiclePhysics.Derive'da kullanılır):
--   MassKg, PowerKW      Güç/ağırlık oranı → güçle sınırlı ivme a = P / (m·v). Kütlenin Roblox değeri "Mass"tır;
--                        kg sadece oranı ifade eder. Azami hız SABİT KALIR (MaxSpeed): sürtünme katsayısı,
--                        motor gücü tam MaxSpeed×1.03'te tükenecek şekilde türetilir (hız tavanı doğal oluşur).
--   LaunchG              Kalkışta tekerlere verilen en büyük çekiş ivmesi (g). Düşük hızda gücü sınırlar.
--   Gears, ShiftTime     Sanal vites sayısı ve vites değişim süresi (sn). Değişimde çekiş ShiftCut'a düşer.
--   WeightFront          Ön aksa düşen statik ağırlık oranı. Balast parçasıyla gerçekten kütle merkezi kaydırılır.
--   CoGOffset            Balastın şasi tabanına göre yüksekliği (stud). Büyük → ağırlık merkezi yüksek → daha çok yatış.
--   TireGrip             Lastik sürtünme katsayısı μ (EffectiveGravity altında gerçek değerle aynı anlamda).
--   GripFront/GripRear   Aks başına μ çarpanı: viraj dengesinin (önden/arkadan kayma) ince ayarı.
--   SpringHzFront/Rear   Yay doğal frekansı (Hz). Sertlik k = m_köşe·(2πf)²; çökme = g/(2πf)².
--   Damping              Sönüm oranı ζ (0.3 yumuşak … 0.5 sıkı). Sönüm c = 2ζ·√(k·m_köşe).
--   BrakeG, BrakeBiasFront  Azami fren ivmesi (g) ve ön akstaki fren payı. ABS kilitlenmeyi önler.
--   HandbrakeG, HandbrakeGrip  El freni kuvveti (g, sadece arka) ve el freni çekiliyken arka μ çarpanı (drift).
--   TractionSlip         Çekiş kontrolünün izin verdiği patinaj oranı. KineticGrip eşiğini aşarsa güçle kayma olur.
--   DriveSplitFront      Çekişin ön aksa düşen payı (FWD 1, RWD 0, AWD arası).
--   ThrottleRise/Fall    Gaz pedalı tepki hızı (1/sn). Dijital klavye girişini yumuşatır.
--   SteerRateLow/High    Direksiyon dönüş hızı (1/sn) düşük/yüksek hızda. Ani direksiyon sıçramasını önler.
--   LatLimitScale        Hıza bağlı direksiyon sınırı: tam direksiyon ≈ yanal tutuş sınırı × bu değer.
--   SlipAllowanceDeg     Yüksek hızda sınırın üstüne eklenen pay (lastik kayma açısı).
--   CounterSteer         Arka kayarken (oyuncu direksiyonu bırakınca) kendiliğinden karşı direksiyon oranı.
--   StabilityGain        Savrulma (yaw) denge yardımı kazancı (1/sn). Spor araçta düşük = daha fazla serbestlik.
--   DownforceAt100       100 stud/sn'de yere basma kuvveti (g). Hızın karesiyle artar.
VehicleDefinitions.Catalog = {
	-- ======================= OTOMOBİLLER =======================
	compact_pico = {
		Type = "Car", Category = "Civilian", DisplayName = "Pico", Style = "compact",
		Width = 6.2, Length = 12, CabinHeight = 2.2, LowerHeight = 1.9,
		WheelRadius = 1.35, WheelWidth = 1.1, Wheelbase = 7.6, Track = 5.6, Clearance = 0.9, Travel = 1.2,
		Mass = 60, MaxSpeed = 95, ReverseSpeed = 25, Accel = 34, Brake = 72, MaxSteer = 34, MinSteer = 9, Grip = 1.25,
		Drive = "FWD",
		-- Hafif, çevik şehir aracı. Önde motor + önden çekiş → sınırda hafif önden kayma (güvenli).
		Physics = {
			MassKg = 1050, PowerKW = 70, LaunchG = 0.38, Gears = 4, ShiftTime = 0.22,
			WeightFront = 0.62, CoGOffset = 0, TireGrip = 0.95, GripFront = 1.0, GripRear = 1.02,
			SpringHzFront = 1.6, SpringHzRear = 1.75, Damping = 0.4,
			BrakeG = 0.95, BrakeBiasFront = 0.68, HandbrakeG = 0.6, HandbrakeGrip = 0.55,
			TractionSlip = 0.08, DriveSplitFront = 1,
			ThrottleRise = 4.5, ThrottleFall = 8, SteerRateLow = 5.5, SteerRateHigh = 2.6,
			LatLimitScale = 1.05, SlipAllowanceDeg = 3.5, CounterSteer = 0.35, StabilityGain = 6, DownforceAt100 = 0,
		},
		Seats = { { X = -1.3, Z = 0.6, Driver = true }, { X = 1.3, Z = 0.6 } },
		Colors = { rgb(236, 90, 70), rgb(90, 160, 220), rgb(250, 210, 80), rgb(240, 240, 236), rgb(110, 190, 120) },
	},
	sedan_vela = {
		Type = "Car", Category = "Sedan", DisplayName = "Vela", Style = "sedan",
		Width = 6.6, Length = 14, CabinHeight = 2.3, LowerHeight = 2.0,
		WheelRadius = 1.45, WheelWidth = 1.2, Wheelbase = 8.6, Track = 6.0, Clearance = 1.0, Travel = 1.2,
		Mass = 80, MaxSpeed = 110, ReverseSpeed = 28, Accel = 36, Brake = 76, MaxSteer = 32, MinSteer = 8, Grip = 1.3,
		Drive = "RWD",
		-- Dengeli, konforlu arkadan itişli sedan. Yumuşak süspansiyon, öngörülebilir sınır davranışı.
		Physics = {
			MassKg = 1450, PowerKW = 125, LaunchG = 0.45, Gears = 5, ShiftTime = 0.25,
			WeightFront = 0.54, CoGOffset = 0, TireGrip = 1.0, GripFront = 1.0, GripRear = 1.0,
			SpringHzFront = 1.35, SpringHzRear = 1.5, Damping = 0.38,
			BrakeG = 1.0, BrakeBiasFront = 0.64, HandbrakeG = 0.6, HandbrakeGrip = 0.5,
			TractionSlip = 0.1, DriveSplitFront = 0,
			ThrottleRise = 3.8, ThrottleFall = 7, SteerRateLow = 4.6, SteerRateHigh = 2.2,
			LatLimitScale = 1.05, SlipAllowanceDeg = 3, CounterSteer = 0.3, StabilityGain = 6, DownforceAt100 = 0,
		},
		Seats = { { X = -1.4, Z = 0, Driver = true }, { X = 1.4, Z = 0 }, { X = -1.4, Z = 2.6 }, { X = 1.4, Z = 2.6 } },
		Colors = { rgb(40, 44, 52), rgb(230, 230, 226), rgb(150, 30, 40), rgb(70, 90, 130), rgb(160, 160, 164) },
	},
	sports_rayo = {
		Type = "Car", Category = "Sports", DisplayName = "Rayo GT", Style = "sports",
		Width = 6.8, Length = 14.4, CabinHeight = 1.8, LowerHeight = 1.6,
		WheelRadius = 1.5, WheelWidth = 1.4, Wheelbase = 8.8, Track = 6.2, Clearance = 0.7, Travel = 0.8,
		Mass = 75, MaxSpeed = 150, ReverseSpeed = 30, Accel = 56, Brake = 98, MaxSteer = 30, MinSteer = 6, Grip = 1.6,
		Drive = "AWD", Spoiler = true,
		-- Sert, alçak, keskin GT. Arka ağırlıklı dört çeker; yüksek tutuş + hafif yere basma kuvveti.
		Physics = {
			MassKg = 1350, PowerKW = 270, LaunchG = 0.7, Gears = 6, ShiftTime = 0.1,
			WeightFront = 0.46, CoGOffset = -0.15, TireGrip = 1.2, GripFront = 1.0, GripRear = 1.0,
			SpringHzFront = 2.1, SpringHzRear = 2.3, Damping = 0.5,
			BrakeG = 1.2, BrakeBiasFront = 0.6, HandbrakeG = 0.7, HandbrakeGrip = 0.45,
			TractionSlip = 0.14, DriveSplitFront = 0.35,
			ThrottleRise = 7, ThrottleFall = 10, SteerRateLow = 6.5, SteerRateHigh = 3.0,
			LatLimitScale = 1.12, SlipAllowanceDeg = 4, CounterSteer = 0.25, StabilityGain = 3.5, DownforceAt100 = 0.12,
		},
		Seats = { { X = -1.4, Z = 0.8, Driver = true }, { X = 1.4, Z = 0.8 } },
		Colors = { rgb(255, 122, 69), rgb(230, 30, 50), rgb(250, 220, 40), rgb(30, 30, 34), rgb(64, 196, 214) },
	},
	suv_terra = {
		Type = "Car", Category = "SUV", DisplayName = "Terra", Style = "suv",
		Width = 7.2, Length = 15, CabinHeight = 2.6, LowerHeight = 2.6,
		WheelRadius = 1.75, WheelWidth = 1.4, Wheelbase = 9.2, Track = 6.4, Clearance = 1.4, Travel = 1.6,
		Mass = 105, MaxSpeed = 105, ReverseSpeed = 26, Accel = 34, Brake = 70, MaxSteer = 32, MinSteer = 8, Grip = 1.35,
		Drive = "AWD", RoofRack = true,
		-- Ağır, yüksek ağırlık merkezli SUV. Yumuşak, gövde yatar, uzun fren, sınırda belirgin önden kayma.
		Physics = {
			MassKg = 2050, PowerKW = 175, LaunchG = 0.45, Gears = 5, ShiftTime = 0.3,
			WeightFront = 0.55, CoGOffset = 0.45, TireGrip = 0.88, GripFront = 0.97, GripRear = 1.03,
			SpringHzFront = 1.2, SpringHzRear = 1.35, Damping = 0.36,
			BrakeG = 0.88, BrakeBiasFront = 0.66, HandbrakeG = 0.5, HandbrakeGrip = 0.6,
			TractionSlip = 0.08, DriveSplitFront = 0.45,
			ThrottleRise = 3.2, ThrottleFall = 6, SteerRateLow = 4.0, SteerRateHigh = 1.8,
			LatLimitScale = 0.98, SlipAllowanceDeg = 2.5, CounterSteer = 0.35, StabilityGain = 8, DownforceAt100 = 0,
		},
		Seats = { { X = -1.5, Z = 0, Driver = true }, { X = 1.5, Z = 0 }, { X = -1.5, Z = 2.8 }, { X = 1.5, Z = 2.8 } },
		Colors = { rgb(60, 70, 60), rgb(240, 240, 236), rgb(30, 34, 40), rgb(140, 110, 80), rgb(90, 110, 140) },
	},
	pickup_mesa = {
		Type = "Car", Category = "Pickup", DisplayName = "Mesa", Style = "pickup",
		Width = 7.2, Length = 16.5, CabinHeight = 2.6, LowerHeight = 2.5,
		WheelRadius = 1.75, WheelWidth = 1.4, Wheelbase = 10.4, Track = 6.4, Clearance = 1.4, Travel = 1.6,
		Mass = 110, MaxSpeed = 100, ReverseSpeed = 26, Accel = 32, Brake = 68, MaxSteer = 32, MinSteer = 8, Grip = 1.3,
		Drive = "RWD",
		-- Boş kasalı arkadan itişli pikap: hafif arka aks, sert arka yay → gazla arkası kolay kayar.
		Physics = {
			MassKg = 1950, PowerKW = 165, LaunchG = 0.42, Gears = 4, ShiftTime = 0.3,
			WeightFront = 0.58, CoGOffset = 0.3, TireGrip = 0.9, GripFront = 1.0, GripRear = 0.95,
			SpringHzFront = 1.3, SpringHzRear = 1.7, Damping = 0.33,
			BrakeG = 0.88, BrakeBiasFront = 0.7, HandbrakeG = 0.6, HandbrakeGrip = 0.5,
			TractionSlip = 0.22, DriveSplitFront = 0,
			ThrottleRise = 4.0, ThrottleFall = 7, SteerRateLow = 4.2, SteerRateHigh = 2.0,
