#!/bin/sh
# NEXUS VR - Gradle Wrapper başlatıcı.
# gradle-wrapper.jar yoksa ilk çalıştırmada otomatik indirir (curl veya wget gerekir).
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
JAR_URL="https://raw.githubusercontent.com/gradle/gradle/v8.7.0/gradle/wrapper/gradle-wrapper.jar"

if [ ! -s "$JAR" ]; then
  echo "gradle-wrapper.jar indiriliyor..." >&2
  mkdir -p "$(dirname "$JAR")"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$JAR_URL" -o "$JAR" || rm -f "$JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$JAR_URL" -O "$JAR" || rm -f "$JAR"
  fi
  if [ ! -s "$JAR" ]; then
    echo "HATA: gradle-wrapper.jar indirilemedi. Internet baglantisini kontrol edin veya Android Studio ile acin." >&2
    exit 1
  fi
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD=java
  command -v java >/dev/null 2>&1 || { echo "HATA: Java (JDK 17+) bulunamadi. JAVA_HOME ayarlayin." >&2; exit 1; }
fi

exec "$JAVACMD" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew \
  -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
